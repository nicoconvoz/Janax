#!/usr/bin/env -S awk -f
# Every combination of every Janax instruction (Capitan: "a program with all the possible combinations, so
# you know it is the same byte by byte"). A word is the union of independent fields (op, rd, ra, imm16), so
# this covers every bit of every field and every crossing between fields:
#   - every register combination of each instruction (16 x 16 x 16 for the three-register ones);
#   - the 65,536 values of the immediate (and of the jump distance), with every register bit at 1 (j15), so
#     a negative value that spills into the register bits shows up.
# Immediates are written in decimal in the first half and in hexadecimal in the second one, so both ways of
# writing a number are covered too. A source holds at most 32,768 lines (it must fit the assembler's 1 MiB).
# Usage: awk -f combinaciones.awk -v dir=<folder> -v inc=<path of janax.inc as the sources will include it>
# (awk instead of Perl: Capitan, 2026-11-06, "no Perl, it burns the PC").
function open_source(name) { out = dir "/" name ".jsm"; printf "; Generated by so/herramientas/combinaciones.awk: %s\ninclude '%s'\n", name, inc > out }
function line(s) { print s > out }
function close_source() { close(out) }
function hex16(v) { return sprintf("0%04Xh", v) }
function target(d,   bytes) { bytes = 4 * d + 4; return bytes < 0 ? "$ - " (-bytes) : "$ + " bytes }
BEGIN {
  if (dir == "" || inc == "") { print "usage: awk -f combinaciones.awk -v dir=<folder> -v inc=<janax.inc>" > "/dev/stderr"; exit 1 }
  system("mkdir -p '" dir "'")
  # three registers
  n = split("jadd jsub jmul jdiv jshl jshr jsar jand jor jxor", alu, " ")
  for (k = 1; k <= n; k++) {
    open_source("alu_" alu[k])
    for (d = 0; d < 16; d++) for (a = 0; a < 16; a++) for (b = 0; b < 16; b++) line(alu[k] " j" d ", j" a ", j" b)
    close_source()
  }
  # register and immediate: every register, then the 65,536 immediates in two halves
  split("jldi jshi", inm, " ")
  for (k = 1; k <= 2; k++) {
    op = inm[k]
    open_source("inm_" op "_a")
    for (d = 0; d < 16; d++) line(op " j" d ", 0")
    for (v = -32768; v <= -1; v++) line(op " j15, " v)
    close_source()
    open_source("inm_" op "_b")
    for (v = 0; v <= 32767; v++) line(op " j15, " hex16(v))
    close_source()
  }
  # memory: every register pair, then the immediates
  split("jld jst jldb jstb", mem, " ")
  for (k = 1; k <= 4; k++) {
    op = mem[k]
    open_source("mem_" op "_a")
    for (d = 0; d < 16; d++) for (a = 0; a < 16; a++) line(op " j" d ", j" a ", 0")
    for (v = -32768; v <= -1; v++) line(op " j15, j15, " v)
    close_source()
    open_source("mem_" op "_b")
    for (v = 0; v <= 32767; v++) line(op " j15, j15, " hex16(v))
    close_source()
  }
  # jumps: every distance, written as $ plus the bytes to the target (distance d = words from the next one)
  split("jjmp jcall", sal, " ")
  for (k = 1; k <= 2; k++) {
    op = sal[k]
    open_source("salto_" op "_a")
    for (v = -32768; v <= -1; v++) line(op " " target(v))
    close_source()
    open_source("salto_" op "_b")
    for (v = 0; v <= 32767; v++) line(op " " target(v))
    close_source()
  }
  split("jjz jjnz", con, " ")
  for (k = 1; k <= 2; k++) {
    op = con[k]
    open_source("salto_" op "_a")
    for (d = 0; d < 16; d++) line(op " j" d ", $")
    for (v = -32768; v <= -1; v++) line(op " j15, " target(v))
    close_source()
    open_source("salto_" op "_b")
    for (v = 0; v <= 32767; v++) line(op " j15, " target(v))
    close_source()
  }
  # the rest: jsys, jhost, no operands, while, jfirst, dd
  ns = split("0 1 8 32767 32768 32769 65535 65536 1193046 2147483647 -1 -32768", sizes, " ")
  nw = split("0 1 -1 2147483647 -2147483648 2147483648 4294967295 305419896", words, " ")
  open_source("otras")
  for (d = 0; d < 16; d++) for (a = 0; a < 16; a++) line("jsys j" d ", j" a)
  for (d = 0; d < 16; d++) for (a = 0; a < 16; a++) line("jhost j" d ", j" a)
  line("jhalt"); line("jret")
  for (d = 0; d < 16; d++) { line("jwhile j" d); line("jldi j0, 1"); line("jwend"); line("jwhilez j" d); line("jwend")
    line("jwhile j" d); line("jldi j0, 1"); line("jwcheck"); line("jor j" d ", j0, j1"); line("jwend") }
  for (d = 0; d < 16; d++) for (k = 1; k <= ns; k++) line("jfirst j" d ", " sizes[k])
  for (k = 1; k <= nw; k++) line("dd " words[k])
  close_source()
}
