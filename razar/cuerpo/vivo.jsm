  jsub j3, j1, j9
  jld j9, j14, 0238h
  jsub j4, j2, j9
  jldi j10, -48
  jsub j11, j3, j10
  jjnn j11, low_15
  jadd j3, j10, j14
low_15:
  jldi j10, 094h
  jsub j11, j10, j3
  jjnn j11, high_16
  jadd j3, j10, j14
high_16:
  jldi j10, 0
  jsub j11, j4, j10
  jjnn j11, low_17
  jadd j4, j10, j14
low_17:
  jldi j10, 057h
  jsub j11, j10, j4
  jjnn j11, high_18
  jadd j4, j10, j14
high_18:
  jldi j10, 8
  jshl j3, j3, j10
  jshl j4, j4, j10
  jst j3, j14, 0480h
  jst j4, j14, 0488h
  jldi j9, 1
  jst j9, j14, 0218h
  jret
move_out:
