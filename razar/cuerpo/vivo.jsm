up:                             ; a window held is let go: every spring as it was
  jld j9, j14, 0228h
  jjz j9, up_out
  jldi j10, 1
  jsub j9, j9, j10
  jldi j10, 128
  jmul j10, j9, j10
  jldi j11, 0400h
