  jjn j10, not_close_4
  jldi j10, 87
  jsub j10, j3, j10
  jjnn j10, not_close_4
  jldi j10, 2
  jsub j10, j4, j10
  jjn j10, not_close_4
  jldi j10, 7
  jsub j10, j4, j10
  jjnn j10, not_close_4
  jld j1, j14, 0410h
  jld j2, j14, 0418h
  jldi j3, 02D00h
  jldi j4, 02100h
  jcall explode
  jldi j9, 0
  jst j9, j14, 0420h   ; flying
  jld j9, j14, 0228h
  jldi j10, 1
