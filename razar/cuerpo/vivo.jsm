  jjn j4, hit_0_no
  jldi j10, 90
  jsub j10, j3, j10
  jjnn j10, hit_0_no
  jldi j10, 66
  jsub j10, j4, j10
  jjnn j10, hit_0_no
  jldi j0, 1
  ; to the front
  jld j9, j14, 0258h
  jldi j10, 0
  jsub j10, j9, j10
  jjz j10, front_3
  jst j9, j14, 0250h
  jldi j10, 0
  jst j10, j14, 0258h
front_3:
  ; the close button: it flies apart
