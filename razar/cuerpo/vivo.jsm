; ---- exploration: one push it has not tried, among those whose piece is alive; none left: it rests
explore:
  jldi j2, 0                     ; how many it may still try
  jldi j1, 0
explore_count:
  jcall untried
  jadd j2, j2, j9
  jldi j9, 1
  jadd j1, j1, j9
  jldi j9, 96
  jsub j9, j1, j9
  jjnz j9, explore_count
  jjnz j2, explore_pick
  jst j14, j14, 0240h   ; all tried: it rests
  jret
explore_pick:                   ; the r-th untried one, r from the generator
  jcall rand
  jldi j9, 1
  jshr j10, j10, j9
  jdiv j11, j10, j2
  jmul j11, j11, j2
  jsub j3, j10, j11
  jldi j1, 0
explore_find:
  jcall untried
  jjz j9, explore_next
  jjz j3, explore_found
  jldi j9, 1
  jsub j3, j3, j9
explore_next:
  jldi j9, 1
  jadd j1, j1, j9
  jjmp explore_find
explore_found:
  jldi j9, 0800h
  jadd j9, j9, j1
  jldi j10, 1
  jstb j10, j9, 0   ; never again in this round
  ; combination j1: part = j1 >> 4, push = (j1 >> 2) & 3, variant = j1 & 3
  jldi j9, 4
  jshr j4, j1, j9
  jldi j9, 6
  jshl j4, j4, j9
  jldi j9, 0600h
  jadd j4, j4, j9
  jld j5, j4, 0
  jldi j9, 7
  jshl j5, j5, j9
  jldi j9, 0400h
  jadd j5, j5, j9
  jld j9, j5, 16
  jst j9, j14, 0278h
  jld j9, j5, 24
  jst j9, j14, 0280h
  jld j9, j4, 8
  jst j9, j14, 0288h
  jld j9, j4, 16
  jst j9, j14, 0290h
  jld j9, j4, 24
  jst j9, j14, 0298h
  jst j14, j14, 02A0h
  jst j14, j14, 02A8h
  jst j14, j14, 02B0h
  jst j14, j14, 02B8h
  jst j14, j14, 02C0h
  jst j14, j14, 02C8h
  jldi j9, 2
  jshr j6, j1, j9
  jldi j9, 3
  jand j6, j6, j9
  jand j7, j1, j9
  jldi j9, 1
  jand j8, j7, j9                ; strength (or sign, for a shear)
  jld j3, j4, 32
  jjz j8, explore_m
  jld j3, j4, 40
explore_m:
  jldi j9, 2
  jand j8, j7, j9
  jjz j8, explore_sign
  jsub j3, j14, j3    ; the other way
explore_sign:
  jjnz j6, explore_not_shove
  ; shove: one of four directions
  jld j3, j4, 48
  jldi j9, 2
  jand j8, j7, j9
  jjz j8, explore_shove
  jsub j3, j14, j3
explore_shove:
  jldi j9, 1
  jand j8, j7, j9
  jjnz j8, explore_down
  jst j3, j14, 02C0h
  jjmp explore_push
explore_down:
  jst j3, j14, 02C8h
  jjmp explore_push
explore_not_shove:
  jldi j9, 1
  jsub j9, j6, j9
  jjnz j9, explore_not_pulse
  ; pulse: out or in, small or big
  jst j3, j14, 02A0h
  jst j3, j14, 02B8h
  jjmp explore_push
explore_not_pulse:
  jldi j9, 2
  jsub j9, j6, j9
  jjnz j9, explore_shear
  ; twist: one way or the other, small or big
  jsub j9, j14, j3
  jst j9, j14, 02A8h
  jst j3, j14, 02B0h
  jjmp explore_push
explore_shear:                  ; shear: across (x by y) or along (y by x), one way or the other
  jld j3, j4, 40
  jldi j9, 1
  jand j8, j7, j9
  jjz j8, explore_shear_sign
  jsub j3, j14, j3
explore_shear_sign:
  jldi j9, 2
  jand j8, j7, j9
  jjnz j8, explore_along
  jst j3, j14, 02A8h
  jjmp explore_push
explore_along:
  jst j3, j14, 02B0h
explore_push:
  jcall push
  jret
untried:                        ; j1 = a combination -> j9 = 1 if it was not tried and its piece is alive
  jldi j9, 0800h
  jadd j9, j9, j1
  jldb j9, j9, 0
  jjnz j9, untried_no
  jldi j9, 4
  jshr j10, j1, j9
  jldi j9, 6
  jshl j10, j10, j9
  jldi j9, 0600h
  jadd j10, j10, j9
  jld j10, j10, 0
  jldi j9, 7
  jshl j10, j10, j9
  jldi j9, 0420h
  jadd j10, j10, j9
  jld j10, j10, 0
  jldi j9, 1
  jsub j9, j10, j9
  jjnz j9, untried_no
  jldi j9, 1
  jret
untried_no:
  jldi j9, 0
  jret
novelty:                        ; a new round: nothing tried yet
  jldi j9, 0800h
  jldi j10, 0860h
  jldi j11, 1
novelty_lap:
  jstb j14, j9, 0
  jadd j9, j9, j11
  jsub j12, j10, j9
  jjnz j12, novelty_lap
  jldi j9, 1
  jst j9, j14, 0240h
  jret
kick:                           ; a pulse on group j1 of piece j2 around j3, j4 with m = j5
  jldi j10, 128
  jmul j10, j2, j10
  jldi j11, 0400h
  jadd j10, j10, j11
  jld j9, j10, 16
  jst j9, j14, 0278h
  jld j9, j10, 24
  jst j9, j14, 0280h
  jst j1, j14, 0288h
  jst j3, j14, 0290h
  jst j4, j14, 0298h
  jst j5, j14, 02A0h
  jst j5, j14, 02B8h
  jst j14, j14, 02A8h
  jst j14, j14, 02B0h
  jst j14, j14, 02C0h
  jst j14, j14, 02C8h
  jcall push
  jret
push:                           ; dv = A (home - centre) >> 8 + C, on the particles of the group (0: all)
  jld j1, j14, 0278h
  jld j2, j14, 0280h
  jld j3, j14, 0288h
  jld j4, j14, 0290h
  jld j5, j14, 0298h
  jldi j13, 64
  jldi j15, 8
push_lap:
  jjz j3, push_it
  jldb j9, j1, 60
  jsub j9, j9, j3
  jjnz j9, push_next
push_it:
  jld j6, j1, 0
  jsub j6, j6, j4
  jld j7, j1, 8
  jsub j7, j7, j5
  jld j8, j14, 02A0h
  jmul j8, j8, j6
  jld j9, j14, 02A8h
  jmul j9, j9, j7
  jadd j8, j8, j9
  jsar j8, j8, j15
  jld j9, j14, 02C0h
  jadd j8, j8, j9
  jld j9, j1, 32
  jadd j9, j9, j8
  jst j9, j1, 32
  jld j8, j14, 02B0h
  jmul j8, j8, j6
  jld j9, j14, 02B8h
  jmul j9, j9, j7
  jadd j8, j8, j9
  jsar j8, j8, j15
  jld j9, j14, 02C8h
  jadd j8, j8, j9
  jld j9, j1, 40
  jadd j9, j9, j8
  jst j9, j1, 40
push_next:
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, push_lap
  jret
revive:                         ; the windows that flew apart come back: alive, home, still, springs as born
  jld j9, j14, 0420h
  jldi j10, 1
  jsub j10, j9, j10
  jjz j10, alive_19
  jldi j9, 1
  jst j9, j14, 0420h
  jld j9, j14, 0428h
  jst j9, j14, 0400h
  jld j9, j14, 0430h
  jst j9, j14, 0408h
  jld j1, j14, 0410h
  jld j2, j14, 0418h
  jcall still
alive_19:
  jld j9, j14, 04A0h
  jldi j10, 1
  jsub j10, j9, j10
  jjz j10, alive_20
  jldi j9, 1
  jst j9, j14, 04A0h
  jld j9, j14, 04A8h
  jst j9, j14, 0480h
  jld j9, j14, 04B0h
  jst j9, j14, 0488h
  jld j1, j14, 0490h
  jld j2, j14, 0498h
  jcall still
alive_20:
  jret
still:                          ; j1..j2: in, still, k as born
  jldi j13, 64
  jldi j3, 20
still_lap:
  jstb j14, j1, 61
  jst j14, j1, 32
  jst j14, j1, 40
  jst j3, j1, 48
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, still_lap
  jret
setk:                           ; j1..j2: every spring k = j3
  jldi j13, 64
setk_lap:
  jst j3, j1, 48
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, setk_lap
  jret
stiffen:                        ; j1..j2 grabbed at the cell j3, j4 of its window: k = 8 + 672 / (12 + d)
  jldi j5, 8
  jldi j6, 12
  jldi j7, 02A0h
  jldi j13, 64
stiffen_lap:
  jld j8, j1, 0
  jsar j8, j8, j5
  jsub j8, j8, j3
  jjnn j8, stiffen_x
  jsub j8, j14, j8
stiffen_x:
  jld j9, j1, 8
  jsar j9, j9, j5
  jsub j9, j9, j4
  jjnn j9, stiffen_y
  jsub j9, j14, j9
stiffen_y:
  jadd j8, j8, j9
  jadd j8, j8, j6
  jdiv j8, j7, j8
  jldi j9, 8
  jadd j8, j8, j9
  jst j8, j1, 48
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, stiffen_lap
  jret
explode:                        ; j1..j2 fly apart from the centre j3, j4: v = r / 16 + noise, at least 1 cell/frame
  jldi j13, 64
explode_lap:
  jld j8, j1, 0
  jsub j8, j8, j3
  jldi j0, 4
  jsar j8, j8, j0
  jcall rand
  jldi j0, 511
  jand j10, j10, j0
  jadd j8, j8, j10
  jldi j0, 256
  jsub j8, j8, j0
  jjn j8, inwards_21
  jadd j8, j8, j0
  jjmp away_22
inwards_21:
  jsub j8, j8, j0
away_22:
  jst j8, j1, 32
  jld j8, j1, 8
  jsub j8, j8, j4
  jldi j0, 4
  jsar j8, j8, j0
  jcall rand
  jldi j0, 511
  jand j10, j10, j0
  jadd j8, j8, j10
  jldi j0, 256
  jsub j8, j8, j0
  jjn j8, inwards_23
  jadd j8, j8, j0
  jjmp away_24
inwards_23:
  jsub j8, j8, j0
away_24:
  jst j8, j1, 40
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, explode_lap
  jret
; ---- one step of every piece: springs for the living, flight for the closed; MOVING = the ones not at rest
step:
  jst j14, j14, 0220h
  jld j9, j14, 0420h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, fly_25
  jld j1, j14, 0410h
  jld j2, j14, 0418h
  jld j3, j14, 0400h
  jld j4, j14, 0408h
  jcall spring
  jjmp stepped_26
fly_25:
  jjnz j9, stepped_26                ; (2: all of it gone)
  jld j1, j14, 0410h
  jld j2, j14, 0418h
  jcall fly
  jjnz j0, stepped_26
  jldi j9, 2
  jst j9, j14, 0420h   ; every particle left the screen
stepped_26:
  jld j9, j14, 04A0h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, fly_27
  jld j1, j14, 0490h
  jld j2, j14, 0498h
  jld j3, j14, 0480h
  jld j4, j14, 0488h
  jcall spring
  jjmp stepped_28
fly_27:
  jjnz j9, stepped_28                ; (2: all of it gone)
  jld j1, j14, 0490h
  jld j2, j14, 0498h
  jcall fly
  jjnz j0, stepped_28
  jldi j9, 2
  jst j9, j14, 04A0h   ; every particle left the screen
stepped_28:
  jld j9, j14, 0520h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, fly_29
  jld j1, j14, 0510h
  jld j2, j14, 0518h
  jld j3, j14, 0500h
  jld j4, j14, 0508h
  jcall spring
  jjmp stepped_30
fly_29:
  jjnz j9, stepped_30                ; (2: all of it gone)
  jld j1, j14, 0510h
  jld j2, j14, 0518h
  jcall fly
  jjnz j0, stepped_30
  jldi j9, 2
  jst j9, j14, 0520h   ; every particle left the screen
stepped_30:
  jret
spring:                         ; j1..j2 towards the origin j3, j4
  jldi j0, 0
  jldi j6, 40
  jldi j7, 8
  jldi j13, 32
spring_lap:
  jld j5, j1, 48                 ; k
  jld j8, j1, 0
  jadd j8, j8, j3           ; its home
  jld j9, j1, 16
  jsub j10, j8, j9
  jmul j10, j10, j5
  jsar j10, j10, j7
  jld j11, j1, 32
  jadd j11, j11, j10
  jmul j10, j11, j6
  jsar j10, j10, j7
  jsub j11, j11, j10
  jadd j9, j9, j11
  jst j9, j1, 16
  jst j11, j1, 32
  jldi j15, 0                   ; at rest? (distance and speed under 32)
  jsub j12, j8, j9
  jadd j10, j12, j13
  jjn j10, spring_x_moves
  jsub j10, j13, j12
  jjn j10, spring_x_moves
  jadd j10, j11, j13
  jjn j10, spring_x_moves
  jsub j10, j13, j11
  jjnn j10, spring_x_rests
spring_x_moves:
  jldi j15, 1
spring_x_rests:
  jld j8, j1, 8
  jadd j8, j8, j4           ; its home
  jld j9, j1, 24
  jsub j10, j8, j9
  jmul j10, j10, j5
  jsar j10, j10, j7
  jld j11, j1, 40
  jadd j11, j11, j10
  jmul j10, j11, j6
  jsar j10, j10, j7
  jsub j11, j11, j10
  jadd j9, j9, j11
  jst j9, j1, 24
  jst j11, j1, 40
  jsub j12, j8, j9
  jadd j10, j12, j13
  jjn j10, spring_y_moves
  jsub j10, j13, j12
  jjn j10, spring_y_moves
  jadd j10, j11, j13
  jjn j10, spring_y_moves
  jsub j10, j13, j11
  jjnn j10, spring_y_rests
spring_y_moves:
  jldi j15, 1
spring_y_rests:
  jjnz j15, spring_moves
  jld j8, j1, 0                 ; at rest: exactly home, still
  jadd j8, j8, j3
  jst j8, j1, 16
  jld j8, j1, 8
  jadd j8, j8, j4
  jst j8, j1, 24
  jst j14, j1, 32
  jst j14, j1, 40
  jjmp spring_next
spring_moves:
  jldi j10, 1
  jadd j0, j0, j10
spring_next:
  jldi j10, 64
  jadd j1, j1, j10
  jsub j10, j2, j1
  jjnz j10, spring_lap
  jld j10, j14, 0220h
  jadd j10, j10, j0
  jst j10, j14, 0220h
  jret
fly:                            ; j1..j2 fly straight on; one that leaves the screen is out -> j0 = those still in
  jldi j0, 0
  jldi j3, 256
  jldi j4, 0
  jshi j4, 0A100h
  jldi j5, 06500h
  jldi j13, 64
fly_lap:
  jldb j9, j1, 61
  jjnz j9, fly_next
  jld j9, j1, 16
  jld j10, j1, 32
  jadd j9, j9, j10
  jst j9, j1, 16
  jld j11, j1, 24
  jld j10, j1, 40
  jadd j11, j11, j10
  jst j11, j1, 24
  jadd j10, j9, j3
  jjn j10, fly_out
  jsub j10, j9, j4
  jjnn j10, fly_out
  jadd j10, j11, j3
  jjn j10, fly_out
  jsub j10, j11, j5
  jjnn j10, fly_out
  jldi j10, 1
  jadd j0, j0, j10
  jjmp fly_next
fly_out:
  jldi j10, 1
  jstb j10, j1, 61
fly_next:
  jadd j1, j1, j13
  jsub j10, j2, j1
  jjnz j10, fly_lap
  jld j10, j14, 0220h
  jadd j10, j10, j0
  jst j10, j14, 0220h
  jret
fill:                           ; the desktop's colour, 24 bytes (8 cells) at a time
  jldi j1, 017F0h
  jldi j2, 0
  jshi j2, 0D370h
  jldi j3, 04E1Fh
  jshi j3, 05A4Eh
  jshi j3, 01F5Ah
  jshi j3, 04E1Fh
  jldi j4, 01F5Ah
  jshi j4, 04E1Fh
  jshi j4, 05A4Eh
  jshi j4, 01F5Ah
  jldi j5, 05A4Eh
  jshi j5, 01F5Ah
  jshi j5, 04E1Fh
  jshi j5, 05A4Eh
  jldi j6, 24
fill_lap:
  jst j3, j1, 0
  jst j4, j1, 8
  jst j5, j1, 16
  jadd j1, j1, j6
  jsub j7, j2, j1
  jjnz j7, fill_lap
  jret
draw:                           ; j1..j2 at their rounded cells, on the screen only
  jldi j3, 128
  jldi j4, 8
  jldi j5, 160
  jldi j6, 100
  jldi j7, 3
  jldi j8, 017F0h
  jldi j13, 64
draw_lap:
  jldb j9, j1, 61
  jjnz j9, draw_next
  jld j9, j1, 16
  jadd j9, j9, j3
  jsar j9, j9, j4
  jjn j9, draw_next
  jsub j10, j9, j5
  jjnn j10, draw_next
  jld j10, j1, 24
  jadd j10, j10, j3
  jsar j10, j10, j4
  jjn j10, draw_next
  jsub j11, j10, j6
  jjnn j11, draw_next
  jmul j11, j10, j5
  jadd j11, j11, j9
  jmul j11, j11, j7
  jadd j11, j11, j8
  jldb j12, j1, 56
  jstb j12, j11, 0
  jldb j12, j1, 57
  jstb j12, j11, 1
  jldb j12, j1, 58
  jstb j12, j11, 2
draw_next:
  jadd j1, j1, j13
  jsub j9, j2, j1
  jjnz j9, draw_lap
  jret
born:                           ; one particle per cell of x j1..j3, y j2..j4 (exclusive) of the piece being built,
                                ; colour j5 j6 j7, group j8; it is born somewhere on the screen
  jadd j9, j2, j14
born_row:
  jadd j13, j1, j14
born_cell:
  jld j15, j14, 0260h
  jldi j0, 8
  jshl j10, j13, j0
  jst j10, j15, 0
  jshl j10, j9, j0
  jst j10, j15, 8
  jcall rand
  jldi j0, 0
  jshi j0, 0FFFFh
  jand j10, j10, j0
  jldi j0, 160
  jmul j10, j10, j0
  jldi j0, 8
  jshr j10, j10, j0
  jst j10, j15, 16
  jcall rand
  jldi j0, 0
  jshi j0, 0FFFFh
  jand j10, j10, j0
  jldi j0, 100
  jmul j10, j10, j0
  jldi j0, 8
  jshr j10, j10, j0
  jst j10, j15, 24
  jst j14, j15, 32
  jst j14, j15, 40
  jldi j0, 20
  jst j0, j15, 48
  jst j14, j15, 56               ; (colour, group and out, cleared)
  jstb j5, j15, 56
  jstb j6, j15, 57
  jstb j7, j15, 58
  jstb j8, j15, 60
  jldi j0, 64
  jadd j15, j15, j0
  jst j15, j14, 0260h
  jldi j0, 1
  jadd j13, j13, j0
  jsub j0, j3, j13
  jjnz j0, born_cell
  jldi j0, 1
  jadd j9, j9, j0
  jsub j0, j4, j9
  jjnz j0, born_row
  jret
rand:                           ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 0248h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 0248h
  jret
tocar:                          ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
