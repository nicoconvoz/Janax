  jsub j11, j10, j3
  jjnn j11, high_12
  jadd j3, j10, j14
high_12:
  jldi j10, 0
  jsub j11, j4, j10
  jjnn j11, low_13
  jadd j4, j10, j14
low_13:
  jldi j10, 056h
  jsub j11, j10, j4
  jjnn j11, high_14
  jadd j4, j10, j14
high_14:
