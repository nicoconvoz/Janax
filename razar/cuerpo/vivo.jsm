  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, hit_1_no
  jld j9, j14, 0480h
  jldi j10, 8
  jsar j9, j9, j10
  jld j11, j14, 0488h
  jsar j11, j11, j10
  jsub j3, j1, j9               ; the cell in the window
