; ---- the living loop: wait for an event or for the time to run out, then a frame
main:
  jld j12, j14, 0200h
  jld j9, j14, 0208h
  jjz j9, main_wait
  jldi j12, -1                   ; for ever
main_wait:
  jldi j10, 41
  jldi j11, 0140h
  jcall tocar
  jst j12, j14, 0268h   ; what was left of the wait
  jjn j13, main_bad
  jjz j13, main_time
  jst j14, j14, 0218h
  jcall handle
  jld j9, j14, 0208h
  jld j10, j14, 0210h
  jor j9, j9, j10
  jjz j9, main_frames
  jld j9, j14, 0218h
  jjnz j9, main_wake
  jld j12, j14, 0268h
  jst j12, j14, 0200h   ; nothing changed: the same wait goes on
  jjmp main
main_wake:                      ; something changed while it rested: frames again
  jst j14, j14, 0208h
  jst j14, j14, 0210h
  jjmp frame
main_frames:                    ; between two frames: what is left of this one
  jld j12, j14, 0268h
  jst j12, j14, 0200h
  jjz j12, frame
  jjmp main
main_time:
  jld j9, j14, 0208h
  jjz j9, main_timed
  jld j0, j14, 0270h   ; for ever ran out: there is no window to wait on (JANAX_SIN_VENTANA)
  jhalt
main_timed:
  jld j9, j14, 0210h
  jjz j9, frame
  jst j14, j14, 0210h
  jcall explore                  ; the pause is over: one more exploration
frame:
  jcall step
  jcall fill
  ; the window at Z0
  jld j9, j14, 0250h
  jldi j10, 128
  jmul j10, j9, j10
  jldi j11, 0400h
  jadd j10, j10, j11
  jld j11, j10, 32
  jldi j12, 2
  jsub j12, j11, j12
  jjz j12, gone_1
  jld j1, j10, 16
  jld j2, j10, 24
  jcall draw
gone_1:
  ; the window at Z1
  jld j9, j14, 0258h
  jldi j10, 128
  jmul j10, j9, j10
  jldi j11, 0400h
  jadd j10, j10, j11
  jld j11, j10, 32
  jldi j12, 2
  jsub j12, j11, j12
  jjz j12, gone_2
  jld j1, j10, 16
  jld j2, j10, 24
  jcall draw
gone_2:
  ; the taskbar, always in front
  jld j1, j14, 0510h
  jld j2, j14, 0518h
  jcall draw
  jldi j10, 40                   ; show
  jldi j11, 01004h
  jldi j12, 0
  jshi j12, 0C36Ch
  jcall tocar
  jld j9, j14, 0270h
  jldi j10, 1
  jadd j9, j9, j10
  jst j9, j14, 0270h
  jld j9, j14, 0220h
  jjz j9, frame_rest
  jldi j9, 33
  jst j9, j14, 0200h   ; something moves: the next frame
  jst j14, j14, 0208h
  jjmp main
frame_rest:
  jld j9, j14, 0228h
  jjnz j9, frame_forever
  jld j9, j14, 0240h
  jjz j9, frame_forever
  jldi j9, 300
  jst j9, j14, 0200h   ; at rest, still exploring: a pause, then the next push
  jldi j9, 1
  jst j9, j14, 0210h
  jst j14, j14, 0208h
  jjmp main
frame_forever:                  ; at rest and nothing left to explore: wait for ever (nothing is spent)
  jldi j9, 1
  jst j9, j14, 0208h
  jjmp main
main_bad:
  jldi j0, 0BADh
  jhalt
; ---- one event (the record at 140h): 5 the window closed, 2 a button down, 3 up, 1 the pointer moved
handle:
  jld j9, j14, 0140h
  jldi j10, 5
  jsub j10, j9, j10
  jjnz j10, handle_open
  jld j0, j14, 0270h   ; closed: j0 = the frames drawn
  jhalt
handle_open:
  jld j1, j14, 0148h
  jld j2, j14, 0150h
  jldi j10, 2
  jsub j10, j9, j10
  jjz j10, down
  jldi j10, 3
  jsub j10, j9, j10
  jjz j10, up
  jldi j10, 1
  jsub j10, j9, j10
  jjz j10, move
  jret
down:                           ; j1, j2 = the cell
  jld j9, j14, 0158h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, down_out   ; only the left button
  jjn j1, down_out
  jldi j9, 1
  jst j9, j14, 0218h
  jcall novelty                  ; a click: a new round of novelty
  ; the taskbar first (it is in front): the start button brings the closed windows back
  jldi j10, 94
  jsub j10, j2, j10
  jjn j10, down_windows
  jldi j10, 2
  jsub j10, j1, j10
  jjn j10, down_out
  jldi j10, 18
  jsub j10, j1, j10
  jjnn j10, down_out
  jldi j10, 95
  jsub j10, j2, j10
  jjn j10, down_out
  jldi j10, 99
  jsub j10, j2, j10
  jjnn j10, down_out
  jcall revive
  jldi j1, 3                     ; and the start button itself pulses
  jldi j2, 2
  jldi j3, 0A00h
  jldi j4, 0300h
  jldi j5, 020h
  jcall kick
  jret
down_windows:                   ; the windows, front to back
  jld j9, j14, 0258h
  jcall hit
  jjnz j0, down_out
  jld j9, j14, 0250h
  jcall hit
down_out:
  jret
hit:                            ; the window j9 at the cell j1, j2: j0 = 1 if it was hit (and what it did)
  jjnz j9, hit_1
  jjmp hit_0
hit_0:                          ; Razar's window
