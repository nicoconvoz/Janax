; ---- the tried table: an FNV-1a hash of each recipe judged in this population (2^15 slots, open addressing)
r_hash:                         ; j1 = a recipe -> j0 = its hash (never 0; uses j2..j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
  jldb j2, j1, 0
  jldi j10, 1
  jadd j2, j2, j10
  jadd j3, j1, j14
hash_lap:
  jldb j10, j3, 0
  jxor j0, j0, j10
  jmul j0, j0, j4
  jldi j10, 1
  jadd j3, j3, j10
  jsub j2, j2, j10
  jjnz j2, hash_lap
  jldi j10, 1
  jor j0, j0, j10
  jret
r_tried:                        ; j0 = a hash -> j0 = 1 it was there, 0 it is now, 2 the table is half full
  jldi j10, 07FFFh
  jand j1, j0, j10
tried_lap:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 2
  jshi j10, 0
  jadd j2, j2, j10
  jld j3, j2, 0
  jjz j3, tried_new
  jsub j3, j3, j0
  jjz j3, tried_was
  jldi j10, 1
  jadd j1, j1, j10
  jldi j10, 07FFFh
  jand j1, j1, j10
  jjmp tried_lap
tried_was:
  jldi j0, 1
  jret
tried_new:
  jld j3, j14, 02C0h
  jldi j10, 04000h
  jsub j10, j3, j10
  jjnn j10, tried_full
  jst j0, j2, 0
  jldi j10, 1
  jadd j3, j3, j10
  jst j3, j14, 02C0h
  jldi j0, 0
  jret
tried_full:
  jldi j0, 2
  jret
r_clear_hash:                   ; a new population: nothing tried in it yet, but its own forms count as tried
  jldi j1, 2
  jshi j1, 0
  jldi j2, 0
  jshi j2, 08000h
  jldi j3, 8
  jldi j4, 1
clear_lap:
  jst j14, j1, 0
  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, clear_lap
  jst j14, j14, 02C0h
  jst j14, j14, 0498h
clear_forms:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j1, j1, j10
  jldi j10, 0800h
  jadd j1, j1, j10
  jldi j10, 192
  jadd j1, j1, j10
  jcall r_hash
  jcall r_tried
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, clear_forms
  jret
; ---- exploration: a walk over every op of every form that may mutate, with a random start and a stride coprime
;      to their number, so it visits each once in an order it does not repeat
r_new_walk:
  jst j14, j14, 02A0h
  jst j14, j14, 02B8h
  jldi j10, 1
  jst j10, j14, 0290h
  jst j14, j14, 0498h
nw_count:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjnz j10, nw_next
  jldb j1, j9, 192
  jcall r_count
  jld j10, j14, 02A0h
  jadd j10, j10, j0
  jst j10, j14, 02A0h
nw_next:
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, nw_count
  jld j1, j14, 02A0h
  jjz j1, nw_none
  jcall r_randmod
  jst j0, j14, 02A8h
  jld j1, j14, 02A0h
  jcall r_randmod
  jjnz j0, nw_stride
  jldi j0, 1
nw_stride:                      ; the next one coprime to the total
  jst j0, j14, 02B0h
  jld j1, j14, 02A0h
nw_gcd:
  jjz j1, nw_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp nw_gcd
nw_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, nw_go
  jld j0, j14, 02B0h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 02A0h
  jsub j10, j0, j1
  jjn j10, nw_stride
  jldi j0, 1
  jjmp nw_stride
nw_go:
  jldi j10, 1
  jst j10, j14, 0230h
  jret
nw_none:                        ; every form rests: nothing to try
  jst j14, j14, 0230h
  jret
r_explore_frame:                ; up to 8 thoughts; a win ends the frame (the population changed)
  jldi j10, 8
  jst j10, j14, 02E0h
ex_lap:
  jcall r_trial
  jjz j0, ex_calm
  jldi j10, 2
  jsub j10, j0, j10
  jjz j10, ex_done
  jld j10, j14, 02E0h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 02E0h
  jjnz j10, ex_lap
ex_done:
  jret
ex_calm:
  jst j14, j14, 0230h
  jret
r_trial:                        ; one candidate -> j0 = 0 nothing left to try, 1 lost (or already tried), 2 won
  jld j9, j14, 0290h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, tr_jump
tr_walk:
  jld j9, j14, 02B8h
  jld j10, j14, 02A0h
  jsub j10, j9, j10
  jjnn j10, tr_none
  jld j1, j14, 02B0h
  jmul j1, j1, j9
  jld j10, j14, 02A8h
  jadd j1, j1, j10
  jld j2, j14, 02A0h
  jdiv j3, j1, j2
  jmul j3, j3, j2
  jsub j1, j1, j3
  jst j1, j14, 04B0h
  jld j10, j14, 02B8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02B8h
  jst j14, j14, 0498h
tr_map:                         ; the op FN -> its form and its op in that form
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjnz j10, tr_map_next
  jldb j1, j9, 192
  jcall r_count
  jld j1, j14, 04B0h
  jsub j10, j1, j0
  jjn j10, tr_map_found
  jadd j1, j10, j14
  jst j1, j14, 04B0h
tr_map_next:
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jjmp tr_map
tr_map_found:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j3, j1, j10
  jldi j10, 0800h
  jadd j3, j3, j10
  jldi j10, 192
  jadd j3, j3, j10
  jld j2, j14, 04B0h
  jldi j4, 01400h
  jcall r_apply
  jldb j1, j14, 01400h
  jldi j10, 32
  jsub j10, j1, j10
  jjnn j10, tr_walk
  jldi j1, 01400h
  jcall r_hash
  jcall r_tried
  jjz j0, tr_judge
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, tr_walk
  jjmp tr_none
tr_judge:
  jld j1, j14, 0498h
  jst j1, j14, 0388h
  jcall r_judge
  jret
tr_none:
  jldi j0, 0
  jret
tr_jump:                        ; a round of longer jumps: RADIUS random edits on one form, BUDGET of them
  jld j9, j14, 0298h
  jjz j9, tr_none
  jldi j10, 1
  jsub j9, j9, j10
  jst j9, j14, 0298h
  jldi j1, 8
  jcall r_randmod
  jst j0, j14, 0498h
  jldi j10, 8
  jst j10, j14, 0490h
tr_pick:                        ; the first form from there that may mutate
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjz j10, tr_picked
  jld j1, j14, 0498h
  jldi j10, 1
  jadd j1, j1, j10
  jldi j10, 7
  jand j1, j1, j10
  jst j1, j14, 0498h
  jld j10, j14, 0490h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 0490h
  jjz j10, tr_none
  jjmp tr_pick
tr_picked:
  jld j10, j9, 192
  jst j10, j14, 01440h
  jld j10, j9, 200
  jst j10, j14, 01448h
  jld j10, j9, 208
  jst j10, j14, 01450h
  jld j10, j9, 216
  jst j10, j14, 01458h
  jldi j10, 0
  jst j10, j14, 01460h
  jldi j10, 0
  jst j10, j14, 01468h
  jld j9, j14, 0290h
  jst j9, j14, 04A0h
tr_edit:
  jldb j1, j14, 01440h
  jcall r_count
  jadd j1, j0, j14
  jcall r_randmod
  jadd j2, j0, j14
  jld j1, j14, 0498h
  jldi j3, 01440h
  jldi j4, 01400h
  jcall r_apply
  jldb j1, j14, 01400h
  jldi j10, 32
  jsub j10, j1, j10
  jjnn j10, tr_lost
  jld j10, j14, 01400h
  jst j10, j14, 01440h
  jld j10, j14, 01408h
  jst j10, j14, 01448h
  jld j10, j14, 01410h
  jst j10, j14, 01450h
  jld j10, j14, 01418h
  jst j10, j14, 01458h
  jld j10, j14, 01420h
  jst j10, j14, 01460h
  jld j10, j14, 01428h
  jst j10, j14, 01468h
  jld j10, j14, 04A0h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 04A0h
  jjnz j10, tr_edit
  jldi j1, 01400h
  jcall r_hash
  jcall r_tried
  jjz j0, tr_judge
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, tr_lost
  jjmp tr_none
tr_lost:
  jldi j0, 1
  jret
; ---- the folder: "formas" (the population, rewritten whole after each win) and "archivo" (a line per verdict)
r_put_num:                      ; j1 = a number >= 0, j2 = digits, j3 = where (uses j4, j5, j10)
pn_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, pn_done
  jldi j10, 10
  jdiv j4, j1, j10
  jmul j5, j4, j10
  jsub j5, j1, j5
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jadd j1, j4, j14
  jjmp pn_lap
pn_done:
  jret
r_put_rec:                      ; j1 = a recipe, j3 = where: its 31 letters as digits, '.' where it has none
  jldb j2, j1, 0
  jldi j4, 0
pr_lap:
  jldi j5, 46
  jsub j10, j4, j2
  jjnn j10, pr_put
  jadd j5, j1, j4
  jldb j5, j5, 1
  jldi j10, 48
  jadd j5, j5, j10
pr_put:
  jadd j10, j3, j4
  jstb j5, j10, 0
  jldi j10, 1
  jadd j4, j4, j10
  jldi j10, 31
  jsub j10, j4, j10
  jjnz j10, pr_lap
  jret
r_get_num:                      ; j1 = where, j2 = digits -> j0 (a non-digit counts as 0; uses j3, j10)
  jldi j0, 0
gn_lap:
  jjz j2, gn_done
  jldi j10, 10
  jmul j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 48
  jsub j3, j3, j10
  jjn j3, gn_skip
  jldi j10, 10
  jsub j10, j3, j10
  jjnn j10, gn_skip
  jadd j0, j0, j3
gn_skip:
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp gn_lap
gn_done:
  jret
r_get_rec:                      ; j1 = 31 characters, j3 = a recipe: the digits 1-9 up to the first other one
  jldi j4, 0
gr_lap:
  jldi j10, 31
  jsub j10, j4, j10
  jjz j10, gr_done
  jadd j5, j1, j4
  jldb j5, j5, 0
  jldi j10, 49
  jsub j5, j5, j10
  jjn j5, gr_done
  jldi j10, 9
  jsub j10, j5, j10
  jjnn j10, gr_done
  jldi j10, 1
  jadd j5, j5, j10
  jadd j10, j3, j4
  jstb j5, j10, 1
  jldi j10, 1
  jadd j4, j4, j10
  jjmp gr_lap
gr_done:
  jstb j4, j3, 0
  jret
r_file:                         ; j10 = request (5 read, 6 write, 7 close), FH = the handle, j11, j12 -> j13
  jldi j9, 32
  jld j8, j14, 04A8h
  jshl j8, j8, j9
  jor j10, j10, j8
  jcall r_tocar
  jret
r_archive:                      ; a line: round, slot, loser, the other, reason, the totals (loser's, winner's), radius
  jldi j1, 01980h
  jldi j2, 02020h
  jshi j2, 02020h
  jshi j2, 02020h
  jshi j2, 02020h
  jldi j3, 14
