ap_cross:                       ; its first c letters, then another form's letters from c on
  jsub j2, j2, j6
  jdiv j7, j2, j5
  jmul j8, j7, j5
  jsub j8, j2, j8
  jldi j10, 1
  jadd j8, j8, j10
  jld j1, j14, 0420h
