  jst j1, j9, 176
  jldi j1, 9
  jst j1, j9, 56
  jldi j1, 7
  jcall r_regrow
  jcall r_recompute
  jcall r_clear_hash
  jcall r_load_archive
  jcall r_new_walk
  jcall r_save_forms             ; the folder holds the population from the start
; ---- the living loop: wait for an event or for the time to run out, then a frame
main:
  jld j12, j14, 0200h
  jld j9, j14, 0208h
  jjz j9, main_wait
  jldi j12, -1                   ; for ever
main_wait:
  jldi j10, 41
  jldi j11, 0140h
  jcall r_tocar
  jst j12, j14, 0220h   ; what was left of the wait
  jjn j13, main_bad
  jjz j13, main_time
  jst j14, j14, 0210h
  jcall r_handle
  jld j9, j14, 0208h
  jjz j9, main_frames
  jld j9, j14, 0210h
  jjz j9, main
  jst j14, j14, 0208h
  jjmp frame
main_frames:                    ; between two frames: what is left of this one
  jld j12, j14, 0220h
  jst j12, j14, 0200h
  jjz j12, frame
  jjmp main
main_time:
  jld j9, j14, 0208h
  jjz j9, frame
  jld j0, j14, 0288h   ; for ever ran out: there is no window to wait on (JANAX_SIN_VENTANA)
  jhalt
frame:
  jst j14, j14, 02D8h
  jcall r_step
  jld j9, j14, 0218h
  jjnz j9, frame_draw
  jld j9, j14, 0240h
  jjnz j9, frame_draw
  jld j9, j14, 0230h
  jjz j9, frame_draw
  jcall r_explore_frame
frame_draw:
  jcall r_fill
  jcall r_draw_ghosts
  jcall r_draw_all
  jldi j10, 40                   ; show
  jldi j11, 02004h
  jldi j12, 0
  jshi j12, 0C36Ch
  jcall r_tocar
  jld j10, j14, 0228h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0228h
  jld j9, j14, 0218h
  jld j10, j14, 02D8h
  jor j9, j9, j10
  jld j10, j14, 0240h
  jjnz j10, frame_held
  jld j10, j14, 0230h
  jor j9, j9, j10
frame_held:
  jjz j9, frame_forever
  jldi j10, 021h
  jst j10, j14, 0200h
  jst j14, j14, 0208h
  jjmp main
frame_forever:                  ; at rest, nothing left to try: wait for ever (nothing is spent)
  jldi j10, 1
  jst j10, j14, 0208h
  jjmp main
main_bad:
  jldi j0, 0BADh
  jhalt
; ---- one event (the record at 140h): 5 closed, 2 a button down, 3 up, 1 the pointer moved, 4 a key
r_handle:
  jld j9, j14, 0140h
  jldi j10, 5
  jsub j10, j9, j10
  jjnz j10, h_open
  jld j0, j14, 0288h   ; closed: j0 = the forms it created in this run
  jhalt
h_open:
  jld j1, j14, 0148h
  jld j2, j14, 0150h
  jld j3, j14, 0158h
  jldi j10, 2
  jsub j10, j9, j10
  jjz j10, h_down
  jldi j10, 3
  jsub j10, j9, j10
  jjz j10, h_up
  jldi j10, 1
  jsub j10, j9, j10
  jjz j10, h_move
  jldi j10, 4
  jsub j10, j9, j10
  jjz j10, h_key
  jret
h_down:                         ; j1, j2 the cell, j3 the button
  jjn j1, h_ret
  jst j3, j14, 04A8h
  jst j1, j14, 0478h
  jst j2, j14, 0480h
  jcall r_gesture
  jcall r_hit
  jld j3, j14, 04A8h
  jldi j10, 2
  jsub j10, j3, j10
  jjz j10, h_right
  jjn j0, h_ret
  jst j0, j14, 0270h
  jldi j10, 1
  jadd j9, j0, j10
  jst j9, j14, 0240h
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jld j1, j14, 0478h
  jldi j10, 8
  jshl j1, j1, j10
  jld j11, j9, 0
  jsub j1, j1, j11
  jst j1, j14, 0248h
  jld j2, j14, 0480h
  jshl j2, j2, j10
  jld j11, j9, 8
  jsub j2, j2, j11
  jst j2, j14, 0250h
  jld j1, j14, 0478h
  jst j1, j14, 0258h
  jld j1, j14, 0480h
  jst j1, j14, 0260h
  jst j14, j14, 0268h
  jcall r_stiffen
h_ret:
  jret
h_right:                        ; push: the form under the pointer pulses out
  jjn j0, h_ret
  jst j0, j14, 0270h
  jldi j3, 040h
  jcall r_pulse
  jret
h_up:
  jldi j10, 2
  jsub j10, j3, j10
  jjnz j10, h_up_left
  ; pop: the focused form pulses in
  jldi j10, 1
  jst j10, j14, 0210h
  jldi j3, -64
  jcall r_pulse
  jret
h_up_left:
  jld j9, j14, 0240h
  jjz j9, h_ret
  jldi j10, 1
  jsub j0, j9, j10
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jldi j3, 20
  jcall r_setk
  jst j14, j14, 0240h
  jldi j10, 1
  jst j10, j14, 0210h
  jld j9, j14, 0268h
  jjnz j9, h_ret
  ; a click without moving: open~close
  jld j9, j14, 0488h
  jld j10, j9, 80
  jldi j11, 1
  jxor j10, j10, j11
  jst j10, j9, 80
  jcall r_set_transform
  jret
h_move:                         ; the form held follows the pointer (its seed kept on the screen)
  jld j9, j14, 0240h
  jjz j9, h_ret
  jjn j1, h_ret
  jjn j2, h_ret
  jld j10, j14, 0268h
  jjnz j10, h_moving
  jld j10, j14, 0258h
  jsub j10, j1, j10
  jld j11, j14, 0260h
  jsub j11, j2, j11
  jor j10, j10, j11
  jjz j10, h_ret
h_moving:
  jldi j10, 1
  jst j10, j14, 0268h
  jldi j10, 1
  jst j10, j14, 0210h
  jldi j10, 1
  jsub j0, j9, j10
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jldi j10, 8
  jshl j1, j1, j10
  jshl j2, j2, j10
  jld j10, j14, 0248h
  jsub j1, j1, j10
  jld j10, j14, 0250h
  jsub j2, j2, j10
  jjnn j1, lo_1
  jldi j1, 0
lo_1:
  jldi j10, 0
  jshi j10, 09F00h
  jsub j11, j10, j1
  jjnn j11, hi_2
  jadd j1, j10, j14
hi_2:
  jjnn j2, lo_3
  jldi j2, 0
lo_3:
  jldi j10, 06300h
  jsub j11, j10, j2
  jjnn j11, hi_4
  jadd j2, j10, j14
hi_4:
  jst j1, j9, 0
  jst j2, j9, 8
  jret
h_key:                          ; j3 = the key: an action on the focused form
  jst j3, j14, 04A8h
  jcall r_gesture
  jld j0, j14, 0270h
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jld j3, j14, 04A8h
  jldi j10, 025h
  jsub j10, j3, j10
  jjz j10, k_mirror_on
  jldi j10, 027h
  jsub j10, j3, j10
  jjz j10, k_mirror_off
  jldi j10, 026h
  jsub j10, j3, j10
  jjz j10, k_flip_off
  jldi j10, 028h
  jsub j10, j3, j10
  jjz j10, k_flip_on
  jldi j10, 0BBh
  jsub j10, j3, j10
  jjz j10, k_max
  jldi j10, 06Bh
  jsub j10, j3, j10
  jjz j10, k_max
  jldi j10, 0BDh
  jsub j10, j3, j10
  jjz j10, k_min
  jldi j10, 06Dh
  jsub j10, j3, j10
  jjz j10, k_min
  jldi j10, 057h
  jsub j10, j3, j10
  jjz j10, k_width
  jldi j10, 048h
  jsub j10, j3, j10
  jjz j10, k_height
  jldi j10, 04Fh
  jsub j10, j3, j10
  jjz j10, k_open
  jldi j10, 043h
  jsub j10, j3, j10
  jjz j10, k_close
  jldi j10, 02Dh
  jsub j10, j3, j10
  jjz j10, k_show
  jldi j10, 02Eh
  jsub j10, j3, j10
  jjz j10, k_hide
  jldi j10, 021h
  jsub j10, j3, j10
  jjz j10, k_top
  jldi j10, 022h
  jsub j10, j3, j10
  jjz j10, k_bottom
  jldi j10, 024h
  jsub j10, j3, j10
  jjz j10, k_first
  jldi j10, 023h
  jsub j10, j3, j10
  jjz j10, k_last
  jldi j10, 042h
  jsub j10, j3, j10
  jjz j10, k_begin
  jldi j10, 045h
  jsub j10, j3, j10
  jjz j10, k_end
  jldi j10, 044h
  jsub j10, j3, j10
  jjz j10, k_disable
  jldi j10, 0Dh
  jsub j10, j3, j10
  jjz j10, k_enable
  jret
k_mirror_on:
  jldi j10, 1
  jst j10, j9, 104
  jcall r_set_transform
  jret
k_mirror_off:
  jldi j10, 0
  jst j10, j9, 104
  jcall r_set_transform
  jret
k_flip_off:
  jldi j10, 0
  jst j10, j9, 112
  jcall r_set_transform
  jret
k_flip_on:
  jldi j10, 1
  jst j10, j9, 112
  jcall r_set_transform
  jret
k_open:
  jldi j10, 0
  jst j10, j9, 80
  jcall r_set_transform
  jret
k_close:
  jldi j10, 1
  jst j10, j9, 80
  jcall r_set_transform
  jret
k_max:                          ; one step, never past double or half
  jld j10, j9, 88
  jldi j11, 1
  jadd j10, j10, j11
  jldi j11, 2
  jsub j11, j10, j11
  jjz j11, clamp_5
  jst j10, j9, 88
clamp_5:
  jcall r_set_transform
  jret
k_min:                          ; one step, never past double or half
  jld j10, j9, 88
  jldi j11, -1
  jadd j10, j10, j11
  jldi j11, -2
  jsub j11, j10, j11
  jjz j11, clamp_6
  jst j10, j9, 88
clamp_6:
  jcall r_set_transform
  jret
k_width:                          ; one step, never past double or half
  jld j10, j9, 96
  jldi j11, 1
  jadd j10, j10, j11
  jldi j11, 2
  jsub j11, j10, j11
  jjz j11, clamp_7
  jst j10, j9, 96
clamp_7:
  jcall r_set_transform
  jret
k_height:                          ; one step, never past double or half
  jld j10, j9, 96
  jldi j11, -1
  jadd j10, j10, j11
  jldi j11, -2
  jsub j11, j10, j11
  jjz j11, clamp_8
  jst j10, j9, 96
clamp_8:
  jcall r_set_transform
  jret
k_show:
  jst j14, j9, 120
  jret
k_hide:
  jldi j10, 1
  jst j10, j9, 120
  jret
k_first:
  jst j14, j14, 0270h
  jret
k_last:
  jldi j10, 7
  jst j10, j14, 0270h
  jret
k_begin:                        ; it grows again from its seed
  jst j14, j9, 48
  jldi j10, 9
  jst j10, j9, 56
  jret
k_end:                          ; it is grown at once
  jldb j10, j9, 192
  jst j10, j9, 48
  jret
k_disable:
  jldi j10, 1
  jst j10, j9, 128
  jjmp k_able
k_enable:
  jst j14, j9, 128
k_able:                         ; its colour, and the walk over the forms that may mutate
  jcall r_colour
  jcall r_new_walk
  jret
k_top:                          ; drawn last
  jld j0, j14, 0270h
  jldi j1, 0
k_top_find:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01340h
  jadd j2, j2, j10
  jld j3, j2, 0
  jsub j3, j3, j0
  jjz j3, k_top_shift
  jldi j10, 1
  jadd j1, j1, j10
  jjmp k_top_find
k_top_shift:
  jldi j10, 7
  jsub j10, j1, j10
  jjz j10, k_top_put
  jld j3, j2, 8
  jst j3, j2, 0
  jldi j10, 8
  jadd j2, j2, j10
  jldi j10, 1
  jadd j1, j1, j10
  jjmp k_top_shift
k_top_put:
  jst j0, j2, 0
  jret
k_bottom:                       ; drawn first
  jld j0, j14, 0270h
  jldi j1, 7
k_bottom_find:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01340h
  jadd j2, j2, j10
  jld j3, j2, 0
  jsub j3, j3, j0
  jjz j3, k_bottom_shift
  jldi j10, 1
  jsub j1, j1, j10
  jjmp k_bottom_find
k_bottom_shift:
  jjz j1, k_bottom_put
  jldi j10, 8
  jsub j5, j2, j10
  jld j3, j5, 0
  jst j3, j2, 0
  jadd j2, j5, j14
  jldi j10, 1
  jsub j1, j1, j10
  jjmp k_bottom_shift
k_bottom_put:
  jst j0, j2, 0
  jret
r_gesture:                      ; a gesture: something changed; if it was calm, a new round of longer jumps
  jldi j10, 1
  jst j10, j14, 0210h
  jld j9, j14, 0230h
  jjnz j9, g_ret
  jld j9, j14, 02A0h
  jjz j9, g_ret
  jld j10, j14, 0290h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0290h
  jld j9, j14, 02A0h
  jst j9, j14, 0298h   ; as many jumps as the round of single edits had
  jldi j10, 1
  jst j10, j14, 0230h
g_ret:
  jret
r_hit:                          ; the cell HX, HY -> j0 = the front form with a grown particle within its stroke T, or -1
  jldi j10, 7
  jst j10, j14, 0498h
hit_form:
  jld j1, j14, 0498h
  jjn j1, hit_none
  jldi j10, 3
  jshl j1, j1, j10
  jldi j10, 01340h
  jadd j1, j1, j10
  jld j0, j1, 0
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j3, j9, 16
  jld j4, j9, 24
  jldi j10, 7
  jshl j4, j4, j10
  jadd j4, j4, j3
  jld j5, j9, 48
  jld j12, j9, 160
  jld j6, j14, 0478h
  jld j7, j14, 0480h
hit_lap:
  jsub j10, j4, j3
  jjz j10, hit_next_form
  jld j10, j3, 64
  jsub j10, j5, j10
  jjn j10, hit_next
  jld j8, j3, 16
  jldi j10, 128
  jadd j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j8, j8, j6
  jadd j11, j8, j12
  jjn j11, hit_next
  jsub j11, j12, j8
  jjn j11, hit_next
  jld j8, j3, 24
  jldi j10, 128
  jadd j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j8, j8, j7
  jadd j11, j8, j12
  jjn j11, hit_next
  jsub j11, j12, j8
  jjn j11, hit_next
  jret
hit_next:
  jldi j10, 128
  jadd j3, j3, j10
  jjmp hit_lap
hit_next_form:
  jld j10, j14, 0498h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jjmp hit_form
hit_none:
  jldi j0, -1
  jret
r_stiffen:                      ; the form DFA grabbed at HX, HY: k = 8 + 672 / (12 + d), d = cells from the grab
  jld j9, j14, 0488h
  jld j1, j9, 16
  jld j2, j9, 24
  jldi j10, 7
  jshl j2, j2, j10
  jadd j2, j2, j1
  jld j3, j14, 0478h
  jld j4, j14, 0480h
  jldi j5, 8
  jldi j6, 12
  jldi j7, 02A0h
stiff_lap:
  jsub j10, j2, j1
  jjz j10, stiff_done
  jld j8, j1, 16
  jsar j8, j8, j5
  jsub j8, j8, j3
  jjnn j8, stiff_x
  jsub j8, j14, j8
stiff_x:
  jld j9, j1, 24
  jsar j9, j9, j5
  jsub j9, j9, j4
  jjnn j9, stiff_y
  jsub j9, j14, j9
stiff_y:
  jadd j8, j8, j9
  jadd j8, j8, j6
  jdiv j8, j7, j8
  jldi j9, 8
  jadd j8, j8, j9
  jst j8, j1, 48
  jldi j10, 128
  jadd j1, j1, j10
  jjmp stiff_lap
stiff_done:
  jret
r_setk:                         ; the form DFA: every spring k = j3
  jld j9, j14, 0488h
  jld j1, j9, 16
  jld j2, j9, 24
  jldi j10, 7
  jshl j2, j2, j10
  jadd j2, j2, j1
setk_lap:
  jsub j10, j2, j1
  jjz j10, setk_done
  jst j3, j1, 48
  jldi j10, 128
  jadd j1, j1, j10
  jjmp setk_lap
setk_done:
  jret
r_pulse:                        ; the focused form: dv = (p - seed) * j3 >> 8 (out when j3 > 0, in when < 0)
  jldi j10, 1
  jst j10, j14, 0210h
  jld j0, j14, 0270h
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j1, j9, 16
  jld j2, j9, 24
  jldi j10, 7
  jshl j2, j2, j10
  jadd j2, j2, j1
  jld j4, j9, 0
  jld j5, j9, 8
  jldi j6, 8
pulse_lap:
  jsub j10, j2, j1
  jjz j10, pulse_done
  jld j7, j1, 16
  jsub j7, j7, j4
  jmul j7, j7, j3
  jsar j7, j7, j6
  jld j8, j1, 32
  jadd j8, j8, j7
  jst j8, j1, 32
  jld j7, j1, 24
  jsub j7, j7, j5
  jmul j7, j7, j3
  jsar j7, j7, j6
  jld j8, j1, 40
  jadd j8, j8, j7
  jst j8, j1, 40
  jldi j10, 128
  jadd j1, j1, j10
  jjmp pulse_lap
pulse_done:
  jret
r_set_transform:                ; the form j9: MX, MY from its fold, size, stretch, mirror and flip (x256)
  jld j1, j9, 184
  jld j2, j9, 88
  jldi j5, 1
  jjz j2, st_scaled
  jshl j1, j1, j5
  jjnn j2, st_scaled
  jldi j5, 2
  jsar j1, j1, j5
st_scaled:
  jadd j3, j1, j14
  jadd j4, j1, j14
  jldi j5, 1
  jld j2, j9, 96
  jjz j2, st_aspect
  jjn j2, st_tall
  jshl j3, j3, j5
  jjmp st_aspect
st_tall:
  jshl j4, j4, j5
st_aspect:
  ; the stroke: T = min(|MX|, |MY|) ARM / 2 cells, rounded up (the stretched axis does not thicken it)
  jsub j2, j4, j3
  jadd j5, j3, j14
  jjnn j2, st_thin
  jadd j5, j4, j14
st_thin:
  jldi j2, 5
  jmul j5, j5, j2
  jldi j2, 511
  jadd j5, j5, j2
  jldi j2, 9
  jsar j5, j5, j2
  jjnz j5, st_t
  jldi j5, 1
st_t:
  jst j5, j9, 160
  jld j2, j9, 104
  jjz j2, st_mirror
  jsub j3, j14, j3
st_mirror:
  jld j2, j9, 112
  jjz j2, st_flip
  jsub j4, j14, j4
st_flip:
  jld j2, j9, 80
  jjz j2, st_open
  jldi j3, 0
  jldi j4, 0
st_open:
  jst j3, j9, 64
  jst j4, j9, 72
  jret
; ---- grow: the recipe GREC into the particles at GREG (one per cell of the room) and the bitmap GBMP -> GCOUNT.
;      Particles below GKEEP keep their place and speed (a form that transforms flows from what it was); a new one
;      is born where its parent is (the seed: at GOX, GOY). Its parent is the cell before it in its arm, so it is
;      drawn joined to it however far the springs pull them apart.
r_grow:
  jld j1, j14, 0300h
  jldi j2, 50
  jldi j3, 8
  jldi j4, 1
grow_clear_bmp:
  jst j14, j1, 0
  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, grow_clear_bmp
  jldi j1, 1
  jshi j1, 0800h
  jldi j2, 07D0h
grow_clear_grid:
  jst j14, j1, 0
  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, grow_clear_grid
  jst j14, j14, 0320h
  jst j14, j14, 0328h
  jst j14, j14, 0330h
  jst j14, j14, 0340h
  jldi j1, 0
  jldi j2, 0
  jldi j3, -1
  jldi j4, 0
  jcall r_cell
  jst j0, j14, 0338h
grow_letter:
  jld j10, j14, 0340h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0340h
  jld j9, j14, 0340h
  jld j1, j14, 02F0h
  jldb j2, j1, 0
  jsub j10, j2, j9
  jjn j10, grow_done
  jadd j1, j1, j9
  jldb j5, j1, 0
  jst j5, j14, 0348h
  jldi j10, 5
  jsub j10, j5, j10
  jjn j10, grow_arm
  jldi j10, 9
  jsub j10, j5, j10
  jjn j10, grow_hole
  jjmp grow_mirror
grow_arm:                       ; 1-4: an arm towards direction k
  jldi j10, 1
  jsub j5, j5, j10
  jldi j10, 4
  jshl j5, j5, j10
  jldi j10, 013C0h
  jadd j5, j5, j10
  jld j6, j5, 0
  jst j6, j14, 0350h
  jld j6, j5, 8
  jst j6, j14, 0358h
  jldi j10, 5
  jst j10, j14, 0360h
grow_arm_lap:
  jld j1, j14, 0328h
  jld j10, j14, 0350h
  jadd j1, j1, j10
  jst j1, j14, 0328h
  jld j2, j14, 0330h
  jld j10, j14, 0358h
  jadd j2, j2, j10
  jst j2, j14, 0330h
  jld j3, j14, 0338h
  jld j4, j14, 0340h
  jcall r_cell
  jst j0, j14, 0338h
  jld j10, j14, 0360h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 0360h
  jjnz j10, grow_arm_lap
  jjmp grow_letter
grow_hole:                      ; 5-8: back to the seed and over an opening towards direction k
  jldi j10, 5
  jsub j5, j5, j10
  jldi j10, 4
  jshl j5, j5, j10
  jldi j10, 013C0h
  jadd j5, j5, j10
  jldi j10, 5
  jld j6, j5, 0
  jmul j1, j6, j10
  jld j6, j5, 8
  jmul j2, j6, j10
  jst j1, j14, 0328h
  jst j2, j14, 0330h
  jldi j4, -1
  jcall r_cell
  jst j0, j14, 0338h
  jjmp grow_letter
grow_mirror:                    ; 9: every cell so far, mirrored across the seed's column (joined to its parent's mirror)
  jld j9, j14, 0320h
  jst j9, j14, 0368h
  jst j14, j14, 0370h
grow_mirror_lap:
  jld j9, j14, 0370h
  jld j10, j14, 0368h
  jsub j10, j9, j10
  jjnn j10, grow_mirror_done
  jldi j10, 7
  jshl j11, j9, j10
  jld j10, j14, 02F8h
  jadd j11, j11, j10
  jst j11, j14, 0378h
  jld j12, j11, 56
  jldi j10, 8
  jld j1, j12, 0
  jsar j1, j1, j10
  jsub j1, j14, j1
  jld j2, j12, 8
  jsar j2, j2, j10
  jldi j4, -1
  jcall r_cell
  jst j0, j14, 0380h
  jld j11, j14, 0378h
  jldi j10, 8
  jld j1, j11, 0
  jsar j1, j1, j10
  jsub j1, j14, j1
  jld j2, j11, 8
  jsar j2, j2, j10
  jld j3, j14, 0380h
  jld j4, j14, 0340h
  jcall r_cell
  jld j10, j14, 0370h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0370h
  jjmp grow_mirror_lap
grow_mirror_done:
  jld j1, j14, 0328h
  jsub j1, j14, j1
  jst j1, j14, 0328h
  jld j2, j14, 0330h
  jldi j4, -1
  jcall r_cell
  jst j0, j14, 0338h
  jjmp grow_letter
grow_done:
  jret
r_cell:                         ; the cell j1, j2 (from the seed) of the form being grown, parent j3 (-1: itself),
                                ; birth j4 (-1: only look) -> j0 = its particle, or -1 (outside the room, or empty)
  jldi j0, -1
  jldi j10, 20
  jadd j5, j1, j10
  jjn j5, cell_out
  jldi j10, 40
  jsub j10, j5, j10
  jjnn j10, cell_out
  jldi j10, 25
  jadd j6, j2, j10
  jjn j6, cell_out
  jldi j10, 50
  jsub j10, j6, j10
  jjnn j10, cell_out
  jldi j10, 40
  jmul j7, j6, j10
  jadd j7, j7, j5
  jldi j10, 3
  jshl j7, j7, j10
  jldi j10, 1
  jshi j10, 0800h
  jadd j7, j7, j10
  jld j8, j7, 0
  jjz j8, cell_new
  jldi j10, 1
  jsub j0, j8, j10
  jret
cell_new:
  jjn j4, cell_out
  jld j0, j14, 0320h
  jldi j10, 7
  jshl j9, j0, j10
  jld j10, j14, 02F8h
  jadd j9, j9, j10
  jldi j10, 8
  jshl j11, j1, j10
  jst j11, j9, 0
  jshl j11, j2, j10
  jst j11, j9, 8
  jadd j11, j9, j14
  jjn j3, cell_parent
  jldi j10, 7
  jshl j11, j3, j10
  jld j10, j14, 02F8h
  jadd j11, j11, j10
cell_parent:
  jst j11, j9, 56
  jst j4, j9, 64
  jldi j10, 20
  jst j10, j9, 48
  jld j10, j14, 0308h
  jsub j10, j0, j10
  jjn j10, cell_kept
  jst j14, j9, 32
  jst j14, j9, 40
  jsub j10, j11, j9
  jjz j10, cell_seed
  jld j10, j11, 16
  jst j10, j9, 16
  jld j10, j11, 24
  jst j10, j9, 24
  jjmp cell_kept
cell_seed:
  jld j10, j14, 0310h
  jst j10, j9, 16
  jld j10, j14, 0318h
  jst j10, j9, 24
cell_kept:
  jldi j10, 3
  jshl j12, j6, j10
  jld j10, j14, 0300h
  jadd j12, j12, j10
  jld j13, j12, 0
  jldi j10, 1
  jshl j10, j10, j5
  jor j13, j13, j10
  jst j13, j12, 0
  jldi j10, 1
  jadd j8, j0, j10
  jst j8, j7, 0
  jst j8, j14, 0320h
cell_out:
  jret
r_regrow:                       ; form j1 from its recipe, its particles keeping their places (all of them grown)
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jldi j10, 192
  jadd j10, j9, j10
  jst j10, j14, 02F0h
  jld j10, j9, 16
  jst j10, j14, 02F8h
  jld j10, j9, 176
  jst j10, j14, 0300h
  jld j10, j9, 24
  jst j10, j14, 0308h
  jld j10, j9, 0
  jst j10, j14, 0310h
  jld j10, j9, 8
  jst j10, j14, 0318h
  jcall r_grow
  jld j9, j14, 0488h
  jld j10, j14, 0320h
  jst j10, j9, 24
  ; its body: the scale that fills the room, from its own extent, and the centre it is drawn around
  jld j1, j9, 16
  jld j2, j9, 24
  jldi j10, 7
  jshl j2, j2, j10
  jadd j2, j2, j1
  jldi j3, 0100h
  jshi j3, 0
  jshi j3, 0
  jldi j4, -256
  jshi j4, 0
  jshi j4, 0
  jldi j5, 0100h
  jshi j5, 0
  jshi j5, 0
  jldi j6, -256
  jshi j6, 0
  jshi j6, 0
fit_lap:
  jsub j10, j2, j1
  jjz j10, fit_done
  jld j7, j1, 0
  jsub j10, j7, j3
  jjnn j10, fit_lo_9
  jadd j3, j7, j14
fit_lo_9:
  jsub j10, j4, j7
  jjnn j10, fit_hi_10
  jadd j4, j7, j14
fit_hi_10:
  jld j7, j1, 8
  jsub j10, j7, j5
  jjnn j10, fit_lo_11
  jadd j5, j7, j14
fit_lo_11:
  jsub j10, j6, j7
  jjnn j10, fit_hi_12
  jadd j6, j7, j14
fit_hi_12:
  jldi j10, 128
  jadd j1, j1, j10
  jjmp fit_lap
fit_done:
  jadd j7, j3, j4
  jldi j10, 1
  jsar j7, j7, j10
  jst j7, j9, 168
  jadd j7, j5, j6
  jsar j7, j7, j10
  jst j7, j9, 240
  ; S = room * 512 / (2 (w - 1) + ARM), per axis (w - 1 = (max - min) / 256), the smaller
  jsub j7, j4, j3
  jldi j10, 7
  jsar j7, j7, j10
  jldi j10, 5
  jadd j7, j7, j10
  jldi j10, 05000h
  jdiv j7, j10, j7
  jsub j8, j6, j5
  jldi j10, 7
  jsar j8, j8, j10
  jldi j10, 5
  jadd j8, j8, j10
  jldi j10, 06400h
  jdiv j8, j10, j8
  jsub j10, j8, j7
  jjnn j10, fit_x
  jadd j7, j8, j14
fit_x:
  jst j7, j9, 184
  jcall r_set_transform
  jret
; ---- the judge: overlaps (cells two forms share, seed on seed), worth = comp * nov, the population's total
r_overlap:                      ; j1, j2 = two bitmaps -> j0 = the cells they share (uses j3..j8, j10)
  jldi j0, 0
  jldi j3, 50
  jldi j7, 01000h
  jldi j8, 255
ov_lap:
  jld j4, j1, 0
  jld j5, j2, 0
  jand j4, j4, j5
  jjz j4, ov_next
  jand j5, j4, j8
  jadd j5, j5, j7
  jldb j5, j5, 0
  jadd j0, j0, j5
  jldi j10, 8
  jshr j4, j4, j10
  jand j5, j4, j8
  jadd j5, j5, j7
  jldb j5, j5, 0
  jadd j0, j0, j5
  jldi j10, 8
  jshr j4, j4, j10
  jand j5, j4, j8
  jadd j5, j5, j7
  jldb j5, j5, 0
  jadd j0, j0, j5
  jldi j10, 8
  jshr j4, j4, j10
  jand j5, j4, j8
  jadd j5, j5, j7
  jldb j5, j5, 0
  jadd j0, j0, j5
  jldi j10, 8
  jshr j4, j4, j10
  jand j5, j4, j8
  jadd j5, j5, j7
  jldb j5, j5, 0
  jadd j0, j0, j5
  jldi j10, 8
  jshr j4, j4, j10
ov_next:
  jldi j10, 8
  jadd j1, j1, j10
  jadd j2, j2, j10
  jldi j10, 1
  jsub j3, j3, j10
  jjnz j3, ov_lap
  jret
r_worth:                        ; j1 cells, j2 letters, j3 most shared -> j5 comp = j1 / (j2 log2 9) (x1000),
                                ; j6 nov = 1000 - 1000 j3 / j1, j0 = j5 j6 / 1000 (uses j7, j10)
  jldi j10, 013Dh   ; log2 9 = 3.17 bits a letter (x100)
  jmul j7, j2, j10
  jldi j10, 1
  jshi j10, 086A0h
  jmul j5, j1, j10
  jdiv j5, j5, j7
  jldi j10, 03E8h
  jmul j6, j3, j10
  jdiv j6, j6, j1
  jsub j6, j10, j6
  jmul j0, j5, j6
  jdiv j0, j0, j10
  jret
r_recompute:                    ; every overlap, every worth, the total, the best, the colours
  jldi j1, 0
  jshi j1, 0E400h
  jldi j2, 0
  jshi j2, 0E600h
  jcall r_overlap
