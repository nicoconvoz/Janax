  jadd j1, j1, j4
  jsub j5, j2, j1
  jjnz j5, init_bits
; ---- the bit count of every byte: pc(i) = pc(i >> 1) + (i & 1)
  jldi j1, 01000h
  jstb j14, j1, 0
  jldi j2, 1
  jldi j3, 1
init_popc:
  jshr j4, j2, j3
  jadd j4, j4, j1
  jldb j4, j4, 0
  jand j5, j2, j3
  jadd j4, j4, j5
  jadd j5, j1, j2
  jstb j4, j5, 0
  jadd j2, j2, j3
  jldi j5, 256
  jsub j5, j5, j2
  jjnz j5, init_popc
