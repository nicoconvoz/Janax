  jcall r_put_num
  jld j1, j14, 0290h
  jldi j2, 1
  jldi j3, 019E9h
  jcall r_put_num
  jldi j1, 10
  jstb j1, j14, 019EFh
  jld j9, j14, 02E8h
  jjn j9, ar_done
  jst j9, j14, 04A8h
  jldi j10, 6
  jldi j11, 01980h
  jldi j12, 070h
  jcall r_file
ar_done:
