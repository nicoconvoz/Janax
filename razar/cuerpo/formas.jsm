r_open:                         ; j11 = a label, j12 = its bytes -> FH = the handle (or -1)
  jldi j10, 4
  jcall r_tocar
  jst j13, j14, 04A8h
  jret
r_save_forms:                   ; "formas1 " round(6) generator(16 hex) wins(6), then per form: recipe worth(7) cells(4)
