rc_lap:
  jld j1, j14, 0498h
  jldi j9, -1
  jldi j3, 0
  jldi j11, 0
rc_max:
  jsub j10, j11, j1
  jjz j10, rc_max_n
  jsub j10, j11, j9
  jjz j10, rc_max_n
  jldi j10, 3
  jshl j12, j1, j10
  jadd j12, j12, j11
  jshl j12, j12, j10
  jldi j10, 01100h
  jadd j12, j12, j10
  jld j12, j12, 0
  jsub j13, j12, j3
  jjn j13, rc_max_n
  jadd j3, j12, j14
rc_max_n:
  jldi j10, 1
  jadd j11, j11, j10
  jldi j10, 8
  jsub j10, j11, j10
  jjnz j10, rc_max
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j1, j9, 24
  jldb j2, j9, 192
  jcall r_worth
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j0, j9, 40
  jst j5, j9, 224
