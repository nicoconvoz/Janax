; ---- the mutations of a recipe: op k of form j1, from the recipe j3 into j4 (k counts, in this order:)
;      change letter i to another (8n), insert a letter (9(n+1)), delete one (n, if n > 1), insert a tower
;      (2(n+1)), cross: its first c letters and the rest of another form (7 n)
r_count:                        ; j1 = n letters -> j0 = how many ops (uses j10)
  jldi j10, 26
  jmul j0, j1, j10
  jldi j10, 11
  jadd j0, j0, j10
  jldi j10, 1
  jsub j10, j1, j10
  jjz j10, count_one
  jadd j0, j0, j1
count_one:
  jret
r_cat:                          ; append the letters [j1, j2) of the recipe j3 to the recipe ADST (uses j4..j6, j10)
  jld j4, j14, 0430h
cat_lap:
  jsub j10, j1, j2
  jjnn j10, cat_done
  jadd j5, j3, j1
  jldb j5, j5, 1
  jldb j6, j4, 0
  jldi j10, 46
  jsub j10, j6, j10
  jjnn j10, cat_done
  jadd j10, j4, j6
  jstb j5, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jldi j10, 1
  jadd j1, j1, j10
  jjmp cat_lap
cat_done:
  jret
r_app:                          ; append the letter j1 to the recipe ADST (uses j4, j6, j10)
  jld j4, j14, 0430h
  jldb j6, j4, 0
  jadd j10, j4, j6
  jstb j1, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jret
r_apply:                        ; j1 form, j2 op, j3 from, j4 into
  jst j1, j14, 0420h
  jst j2, j14, 0440h
  jst j3, j14, 0428h
  jst j4, j14, 0430h
  jstb j14, j4, 0
  jldb j5, j3, 0
  jst j5, j14, 0438h
  ; change
  jldi j10, 8
  jmul j6, j5, j10
  jsub j10, j2, j6
  jjnn j10, ap_insert
  jld j10, j3, 0
  jst j10, j4, 0
  jld j10, j3, 8
  jst j10, j4, 8
  jld j10, j3, 16
  jst j10, j4, 16
  jld j10, j3, 24
  jst j10, j4, 24
  jld j10, j3, 32
  jst j10, j4, 32
  jld j10, j3, 40
  jst j10, j4, 40
  jldi j10, 3
  jshr j7, j2, j10
  jldi j10, 7
  jand j8, j2, j10
  jldi j10, 1
  jadd j8, j8, j10
  jadd j9, j3, j7
  jldb j9, j9, 1
  jsub j10, j8, j9
  jjn j10, ap_change
  jldi j10, 1
  jadd j8, j8, j10
ap_change:
  jadd j9, j4, j7
  jstb j8, j9, 1
  jret
ap_insert:
  jsub j2, j2, j6
  jldi j10, 1
  jadd j7, j5, j10
  jldi j10, 9
  jmul j6, j7, j10
  jsub j10, j2, j6
  jjnn j10, ap_delete
  jldi j10, 9
  jdiv j7, j2, j10
  jmul j8, j7, j10
  jsub j8, j2, j8
  jldi j10, 1
  jadd j8, j8, j10
  jst j7, j14, 0440h
  jst j8, j14, 04B8h
  jld j3, j14, 0428h
  jldi j1, 0
  jadd j2, j7, j14
  jcall r_cat
  jld j1, j14, 04B8h
  jcall r_app
  jld j1, j14, 0440h
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
ap_delete:
  jsub j2, j2, j6
  jldi j10, 1
  jsub j10, j5, j10
  jjz j10, ap_tower
  jsub j10, j2, j5
  jjnn j10, ap_delete_no
  jst j2, j14, 0440h
  jld j3, j14, 0428h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 0440h
  jldi j10, 1
  jadd j1, j1, j10
  jld j2, j14, 0438h
  jld j3, j14, 0428h
