  jsar j6, j6, j10
  jld j12, j3, 56
  jld j7, j12, 16
  jldi j10, 128
  jadd j7, j7, j10
  jldi j10, 8
  jsar j7, j7, j10
  jsub j7, j7, j5
  jld j8, j12, 24
  jldi j10, 128
  jadd j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j8, j8, j6
  jadd j9, j7, j14
  jjnn j9, df_ax
  jsub j9, j14, j9
df_ax:
  jadd j12, j8, j14
  jjnn j12, df_ay
  jsub j12, j14, j12
df_ay:
  jsub j10, j9, j12
  jjnn j10, df_n
  jadd j9, j12, j14
df_n:                           ; j9 = the cells to its parent; stamped every half stroke, the body stays closed
  jld j10, j14, 04C8h
  jldi j11, 1
  jsar j10, j10, j11
  jjnz j10, df_half
  jldi j10, 1
df_half:
  jadd j9, j9, j10
  jsub j9, j9, j11
  jdiv j9, j9, j10
  jadd j1, j5, j14
  jadd j2, j6, j14
  jcall r_brush
  jjz j9, df_next
  jldi j13, 1
df_line:
  jmul j1, j7, j13
  jdiv j1, j1, j9
  jadd j1, j1, j5
  jmul j2, j8, j13
  jdiv j2, j2, j9
  jadd j2, j2, j6
  jcall r_brush
  jldi j10, 1
  jadd j13, j13, j10
  jsub j10, j9, j13
  jjnn j10, df_line
df_next:
  jldi j10, 128
  jadd j3, j3, j10
  jjmp df_lap
df_done:
  ; the focused form: its seed in white
  jld j1, j14, 0498h
  jld j2, j14, 0270h
  jsub j1, j1, j2
  jjnz j1, da_next
  jldi j1, 0FFh
  jst j1, j14, 0460h
  jst j1, j14, 0468h
  jst j1, j14, 0470h
  jld j9, j14, 0488h
  jld j3, j9, 16
  jld j1, j3, 16
  jldi j10, 128
  jadd j1, j1, j10
  jldi j10, 8
  jsar j1, j1, j10
  jld j2, j3, 24
  jldi j10, 128
  jadd j2, j2, j10
  jldi j10, 8
  jsar j2, j2, j10
  jld j10, j14, 04C8h
  jldi j11, 3
  jdiv j10, j10, j11
  jjnz j10, da_dot
  jldi j10, 1
da_dot:
  jst j10, j14, 04C8h
  jcall r_brush
da_next:
  jld j10, j14, 0490h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0490h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, da_lap
  jret
r_randmod:                      ; j1 = n > 0 -> j0 = a number from the generator in [0, n) (uses j10..j12)
  jcall r_rand
  jldi j11, 1
  jshr j10, j10, j11
  jdiv j0, j10, j1
  jmul j0, j0, j1
  jsub j0, j10, j0
  jret
r_rand:                         ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 0238h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 0238h
  jret
r_tocar:                        ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
