  jst j10, j14, 02C8h
  jld j10, j14, 02D0h
  jsub j11, j0, j10
  jjn j11, rc_less
  jst j0, j14, 02D0h
rc_less:
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, rc_lap
  jst j14, j14, 0498h
rc_colour:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
