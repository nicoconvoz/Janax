  jst j8, j14, 04B8h
  jld j3, j14, 0428h
  jldi j1, 0
  jadd j2, j7, j14
  jcall r_cat
  jld j8, j14, 04B8h
  jldi j10, 0
  jsub j10, j8, j10
  jjnz j10, tower_13
  jldi j1, 1
