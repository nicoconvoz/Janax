  jmul j1, j1, j10
  jld j9, j14, 02380h
  jld j2, j9, 80
  jadd j1, j1, j2
  jld j3, j9, 56
  jldi j10, 32
  jmul j2, j3, j10
  jld j4, j9, 88
  jadd j2, j2, j4
  jldi j10, 1
  jadd j3, j3, j10
  jst j3, j9, 56
  jldi j3, 1
  jcall v_r_copym
  jjmp v_ow_round
v_ow_done:
