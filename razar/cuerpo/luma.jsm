  jst j14, j14, 01D18h
  jldi j10, -1
  jst j10, j14, 01AE8h
  jldi j10, 8
  jst j10, j14, 01A70h
  jldi j11, 01E40h
  jldi j12, 8
  jcall r_open
  jld j9, j14, 04A8h
  jjn j9, fl_nofood
  jldi j10, 5
  jldi j11, 01E00h
  jldi j12, 37
  jcall r_file
  jldi j10, 37
  jsub j10, j13, j10
  jjnz j10, fl_close
  jldi j1, 01E0Ah
  jldi j2, 6
  jcall r_get_num
  jst j0, j14, 01A58h
  jldi j1, 01E11h
  jldi j2, 9
  jcall r_get_num
  jst j0, j14, 01A70h
  jldi j1, 01E1Bh
  jldi j2, 9
  jcall r_get_num
  jst j0, j14, 01A78h
  jld j1, j14, 01A78h
  jcall r_alloc
  jst j0, j14, 01A60h
  jld j11, j14, 01A60h
  jld j12, j14, 01A78h
  jcall r_read_all
  jst j0, j14, 01A78h
fl_close:
  jldi j10, 7
  jcall r_file
  jld j1, j14, 01A58h
  jldi j10, 40
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01A68h
  ; the entries: {path, its bytes, the file's bytes, the path's print, eaten}
  jld j1, j14, 01A60h
  jst j1, j14, 01BC8h
  jst j14, j14, 01BD0h
fl_line:
  jld j9, j14, 01BD0h
  jld j10, j14, 01A58h
  jsub j10, j9, j10
  jjnn j10, fl_lines_done
  jld j1, j14, 01BC8h
  jld j10, j14, 01A60h
  jsub j2, j1, j10
  jld j10, j14, 01A78h
  jsub j10, j2, j10
  jjnn j10, fl_lines_done
  jld j9, j14, 01BD0h
  jldi j10, 40
  jmul j9, j9, j10
  jld j10, j14, 01A68h
  jadd j9, j9, j10
  jst j9, j14, 01BD8h
  jld j1, j14, 01BC8h
  jldi j2, 9
  jcall r_get_num
  jld j9, j14, 01BD8h
  jst j0, j9, 16
  jst j14, j9, 32
  jld j1, j14, 01BC8h
  jldi j10, 10
