  jld j1, j14, 0480h
  jst j1, j14, 0260h
  jst j14, j14, 0268h
  jcall r_stiffen
h_ret:
  jret
h_right:                        ; push: the form under the pointer pulses out
  jjn j0, h_ret
  jst j0, j14, 0270h
  jldi j3, 040h
  jcall r_pulse
  jret
h_up:
  jldi j10, 2
  jsub j10, j3, j10
  jjnz j10, h_up_left
  ; pop: the focused form pulses in
  jldi j10, 1
  jst j10, j14, 0210h
  jldi j3, -64
  jcall r_pulse
  jret
h_up_left:
  jld j9, j14, 0240h
  jjz j9, h_ret
  jldi j10, 1
  jsub j0, j9, j10
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jldi j3, 20
  jcall r_setk
  jst j14, j14, 0240h
  jldi j10, 1
  jst j10, j14, 0210h
  jld j9, j14, 0268h
  jjnz j9, h_ret
  ; a click without moving: open~close
  jld j9, j14, 0488h
  jld j10, j9, 80
  jldi j11, 1
  jxor j10, j10, j11
  jst j10, j9, 80
  jcall r_set_transform
  jret
h_move:                         ; the form held follows the pointer (its seed kept on the screen)
  jld j9, j14, 0240h
  jjz j9, h_ret
  jjn j1, h_ret
  jjn j2, h_ret
  jld j10, j14, 0268h
  jjnz j10, h_moving
  jld j10, j14, 0258h
  jsub j10, j1, j10
  jld j11, j14, 0260h
  jsub j11, j2, j11
  jor j10, j10, j11
  jjz j10, h_ret
h_moving:
  jldi j10, 1
  jst j10, j14, 0268h
  jldi j10, 1
  jst j10, j14, 0210h
  jldi j10, 1
  jsub j0, j9, j10
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jldi j10, 8
  jshl j1, j1, j10
  jshl j2, j2, j10
  jld j10, j14, 0248h
  jsub j1, j1, j10
  jld j10, j14, 0250h
  jsub j2, j2, j10
  jjnn j1, lo_1
  jldi j1, 0
lo_1:
  jldi j10, 0
  jshi j10, 09F00h
  jsub j11, j10, j1
  jjnn j11, hi_2
  jadd j1, j10, j14
hi_2:
  jjnn j2, lo_3
  jldi j2, 0
lo_3:
  jldi j10, 06300h
  jsub j11, j10, j2
  jjnn j11, hi_4
  jadd j2, j10, j14
hi_4:
  jst j1, j9, 0
  jst j2, j9, 8
  jret
h_key:                          ; j3 = the key: an action on the focused form
  jcall r_nombre_key
  jjnz j0, h_ret
  jst j3, j14, 04A8h
  jcall r_gesture
  jld j0, j14, 0270h
  jldi j10, 8
  jshl j9, j0, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jld j3, j14, 04A8h
  jldi j10, 025h
  jsub j10, j3, j10
  jjz j10, k_mirror_on
  jldi j10, 027h
  jsub j10, j3, j10
  jjz j10, k_mirror_off
  jldi j10, 026h
  jsub j10, j3, j10
  jjz j10, k_flip_off
  jldi j10, 028h
  jsub j10, j3, j10
  jjz j10, k_flip_on
  jldi j10, 0BBh
  jsub j10, j3, j10
  jjz j10, k_max
  jldi j10, 06Bh
  jsub j10, j3, j10
  jjz j10, k_max
  jldi j10, 0BDh
