; ---- the living loop: wait for an event or for the time to run out, then a frame
main:
  jld j12, j14, 0200h
  jld j9, j14, 0208h
  jjz j9, main_wait
  jldi j12, -1                   ; for ever
main_wait:
  jldi j10, 41
  jldi j11, 0140h
  jcall r_tocar
  jst j12, j14, 0220h   ; what was left of the wait
  jjn j13, main_bad
  jjz j13, main_time
  jst j14, j14, 0210h
  jcall r_handle
  jld j9, j14, 0208h
  jjz j9, main_frames
  jld j9, j14, 0210h
  jjz j9, main
  jst j14, j14, 0208h
  jjmp frame
main_frames:                    ; between two frames: what is left of this one
  jld j12, j14, 0220h
  jst j12, j14, 0200h
  jjz j12, frame
  jjmp main
main_time:
  ; (no event and time left: her doorbell rang, her reader asks, says or ended)
  jld j9, j14, 0220h
  jjz j9, main_timed
  jcall r_read_poll
  jld j12, j14, 0220h
  jst j12, j14, 0200h
  jjmp main
main_timed:
  jld j9, j14, 0208h
  jjz j9, frame
  jld j0, j14, 0288h   ; for ever ran out: there is no window to wait on (JANAX_SIN_VENTANA)
  jhalt
frame:
  jst j14, j14, 02D8h
  jcall r_read_poll              ; (and once a frame while it reads: a doorbell at the last instant is not lost)
  jcall r_step
  jcall r_meal_step
  jcall v_frame
  jld j9, j14, 0218h
  jjnz j9, frame_draw
  jld j9, j14, 0240h
  jjnz j9, frame_draw
  jld j9, j14, 0230h
  jjz j9, frame_draw
  jcall r_explore_frame
frame_draw:
  jcall r_fill
  jcall r_draw_ghosts
  jcall r_draw_all
  jcall r_nombre_draw            ; her name, or her question (gen_leer.py)
  jcall r_draw_meal
  jcall v_show                  ; the forms beside the creatures, one screen
  jld j10, j14, 0228h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0228h
  jld j9, j14, 0218h
  jld j10, j14, 02D8h
  jor j9, j9, j10
  jld j10, j14, 0240h
  jjnz j10, frame_held
  jld j10, j14, 0230h
  jor j9, j9, j10
frame_held:
  jld j10, j14, 01A00h
  jor j9, j9, j10
  jjz j9, frame_forever
frame_go:
  jldi j10, 021h
  jst j10, j14, 0200h
  jst j14, j14, 0208h
  jjmp main
frame_forever:                  ; at rest, nothing left to try: wait for ever (nothing is spent)
  jcall r_hungry
  jjnz j0, frame_go
  jcall r_free                   ; free (luma): she rests, thinks or gives, as she chooses; the frames go on
  jjmp frame_go
  jldi j10, 1
  jst j10, j14, 0208h
  jjmp main
main_bad:
  jldi j0, 0BADh
  jhalt
; ---- one event (the record at 140h): 5 closed, 2 a button down, 3 up, 1 the pointer moved, 4 a key
r_handle:
  jcall v_event
  jjz j0, h_go
  jret                          ; the creatures' side took it
h_go:
  jld j9, j14, 0140h
  jldi j10, 5
  jsub j10, j9, j10
  jjnz j10, h_open
  jcall r_read_end
  jld j0, j14, 0288h   ; closed: j0 = the forms it created in this run
  jhalt
h_open:
  jld j1, j14, 0148h
  jld j2, j14, 0150h
  jld j3, j14, 0158h
  jldi j10, 2
  jsub j10, j9, j10
  jjz j10, h_down
  jldi j10, 3
  jsub j10, j9, j10
  jjz j10, h_up
  jldi j10, 1
  jsub j10, j9, j10
  jjz j10, h_move
  jldi j10, 4
  jsub j10, j9, j10
  jjz j10, h_key
  jldi j10, 7
  jsub j10, j9, j10
  jjz j10, h_char
  jret
h_char:                         ; j3 = a character typed: hers, where she listens
  jcall r_char
  jret
h_down:                         ; j1, j2 the cell, j3 the button
  jjn j1, h_ret
  jst j3, j14, 04A8h
  jst j1, j14, 0478h
  jst j2, j14, 0480h
  jcall r_gesture
  jcall r_hit
  jld j3, j14, 04A8h
  jldi j10, 2
  jsub j10, j3, j10
  jjz j10, h_right
  jjn j0, h_ret
  jst j0, j14, 0270h
