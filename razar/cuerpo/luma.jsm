  jadd j1, j1, j10
  jadd j2, j9, j1
  jldb j3, j2, 0
  jjz j3, v_bd_bad
  jldi j10, 17
  jadd j1, j1, j10
  jadd j2, j9, j1
  jldb j3, j2, -4
  jldb j4, j2, -3
  jldi j10, 8
  jshl j4, j4, j10
  jor j3, j3, j4
  jst j3, j14, 023E0h
  jldb j3, j2, -2
  jldb j4, j2, -1
  jshl j4, j4, j10
  jor j3, j3, j4
  jst j3, j14, 023E8h
  jst j1, j14, 023F0h
  jld j3, j14, 023E0h
  jjz j3, v_bd_bad
  jld j4, j14, 023E8h
  jjz j4, v_bd_bad
  jmul j3, j3, j4
  jldi j10, 7
  jadd j3, j3, j10
  jldi j10, 3
  jshr j3, j3, j10
  jadd j3, j3, j1
  jst j3, j14, 023F8h
  jld j9, j14, 02380h
  jld j10, j9, 200
  jsub j10, j10, j3
  jjn j10, v_bd_bad
  ; the scale that fits B x B, never above 1; centred
  jld j1, j14, 02230h
  jld j3, j14, 023E0h
  jld j4, j14, 023E8h
  jmul j7, j1, j4
  jmul j8, j1, j3
  jsub j10, j8, j7
  jjn j10, v_bd_h
  jadd j5, j1, j14
  jadd j6, j3, j14
  jjmp v_bd_cap
v_bd_h:
  jadd j5, j1, j14
  jadd j6, j4, j14
v_bd_cap:
  jsub j10, j6, j5
  jjnn j10, v_bd_ok
  jldi j5, 1
  jldi j6, 1
v_bd_ok:
  jst j5, j14, 02400h
  jst j6, j14, 02408h
  jld j1, j14, 023E0h
  jmul j1, j1, j5
  jdiv j1, j1, j6
  jld j2, j14, 02230h
  jsub j1, j2, j1
  jldi j10, 1
  jsar j1, j1, j10
  jst j1, j14, 02410h
  jld j1, j14, 023E8h
  jmul j1, j1, j5
  jdiv j1, j1, j6
  jld j2, j14, 02230h
  jsub j1, j2, j1
  jldi j10, 1
  jsar j1, j1, j10
  jst j1, j14, 02418h
  jld j1, j14, 022B8h
  jld j2, j14, 02230h
  jmul j2, j2, j2
  jldi j10, 5
  jmul j2, j2, j10
v_bd_clr:
  jjz j2, v_bd_clr_done
  jst j14, j1, 0
  jldi j10, 8
  jadd j1, j1, j10
  jldi j10, 1
  jsub j2, j2, j10
  jjmp v_bd_clr
v_bd_clr_done:
  ; every cell of the cloud, in reading order: its body cell counts it (area), a particle adds itself and its colour
  jld j9, j14, 02290h
  jld j10, j14, 023F8h
  jadd j8, j9, j10
  jld j10, j14, 023F0h
  jadd j7, j9, j10
  jldi j6, 0
  jst j14, j14, 02338h
v_bd_row:
  jld j1, j14, 02338h
  jld j10, j14, 023E8h
  jsub j10, j1, j10
  jjnn j10, v_bd_rows_done
  jld j2, j14, 02400h
  jmul j1, j1, j2
  jld j2, j14, 02408h
  jdiv j1, j1, j2
  jld j10, j14, 02418h
  jadd j1, j1, j10
  jld j10, j14, 02230h
  jmul j1, j1, j10
  jst j1, j14, 02340h
  jldi j5, 0
v_bd_cell:
  jld j1, j14, 02400h
  jmul j1, j1, j5
  jld j2, j14, 02408h
