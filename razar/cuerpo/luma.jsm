  jld j2, j14, 02780h
  jldi j10, 064C0h
  jadd j5, j10, j2
  jldb j6, j5, 0
  jadd j7, j10, j0
  jldb j8, j7, 1
  jstb j8, j5, 0
  jstb j6, j7, 1
