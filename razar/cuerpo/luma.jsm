; ---- small things
v_r_isqrt:                        ; j1 = n >= 0 (< 2^62) -> j0 = floor sqrt n (uses j1, j2, j3, j10)
  jldi j0, 0
  jldi j2, 1
  jldi j10, 62
  jshl j2, j2, j10
v_is_hi:
  jjz j2, v_is_done
  jsub j10, j1, j2
  jjnn j10, v_is_lap
  jldi j10, 2
  jshr j2, j2, j10
  jjmp v_is_hi
v_is_lap:
  jjz j2, v_is_done
  jadd j3, j0, j2
  jsub j10, j1, j3
  jjn j10, v_is_no
  jadd j1, j10, j14
  jldi j10, 1
  jshr j0, j0, j10
  jadd j0, j0, j2
  jjmp v_is_step
v_is_no:
  jldi j10, 1
  jshr j0, j0, j10
v_is_step:
  jldi j10, 2
  jshr j2, j2, j10
  jjmp v_is_lap
v_is_done:
  jret
v_r_alloc:                        ; j1 = bytes -> j0 = a new environment of that size (request 2), its address
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, v_alloc_go
  jldi j1, 8
v_alloc_go:
  jadd j11, j1, j14
  jldi j10, 2
  jldi j12, 0
  jcall v_r_tocar
  jadd j0, j13, j14
  jjnn j0, v_alloc_ok
  jldi j0, 0BADh
  jhalt
v_alloc_ok:
  jret
v_r_read_all:                     ; FH, j11 = where, j12 = bytes -> j0 = bytes read (reads until all or none)
  jst j11, j14, 02368h
  jst j12, j14, 02370h
  jst j14, j14, 02378h
v_ra_lap:
  jld j12, j14, 02370h
  jld j10, j14, 02378h
  jsub j12, j12, j10
  jjz j12, v_ra_done
  jld j11, j14, 02368h
  jld j10, j14, 02378h
  jadd j11, j11, j10
  jldi j10, 5
  jcall v_r_file
  jjn j13, v_ra_done
  jjz j13, v_ra_done
  jld j10, j14, 02378h
  jadd j10, j10, j13
  jst j10, j14, 02378h
  jjmp v_ra_lap
v_ra_done:
  jld j0, j14, 02378h
  jret
v_r_fnv:                          ; j1 = bytes, j2 = how many -> j0 = their FNV-1a print, never 0 (uses j3, j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
v_fnv_lap:
  jjz j2, v_fnv_done
  jldb j3, j1, 0
  jxor j0, j0, j3
  jmul j0, j0, j4
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp v_fnv_lap
v_fnv_done:
  jldi j10, 1
  jor j0, j0, j10
  jret
v_r_put_hex:                      ; j1 = a number, j2 = hex digits, j3 = where (uses j4, j5, j10)
v_ph_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, v_ph_done
  jldi j10, 15
  jand j5, j1, j10
  jldi j10, 10
  jsub j10, j5, j10
  jjn j10, v_ph_digit
  jldi j10, 39
  jadd j5, j5, j10
v_ph_digit:
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jldi j10, 4
  jshr j1, j1, j10
  jjmp v_ph_lap
v_ph_done:
  jret
v_r_get_hex:                      ; j1 = where, j2 = hex digits -> j0 (uses j3, j10)
  jldi j0, 0
v_gh_lap:
  jjz j2, v_gh_done
  jldi j10, 4
  jshl j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 58
  jsub j10, j3, j10
  jjn j10, v_gh_digit
  jldi j10, 39
  jsub j3, j3, j10
v_gh_digit:
  jldi j10, 48
  jsub j3, j3, j10
  jldi j10, 15
  jand j3, j3, j10
  jor j0, j0, j3
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp v_gh_lap
v_gh_done:
  jret
v_r_put_num:                      ; j1 = a number >= 0, j2 = digits, j3 = where (uses j4, j5, j10)
v_pn_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, v_pn_done
  jldi j10, 10
  jdiv j4, j1, j10
  jmul j5, j4, j10
  jsub j5, j1, j5
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jadd j1, j4, j14
  jjmp v_pn_lap
v_pn_done:
  jret
v_r_get_num:                      ; j1 = where, j2 = digits -> j0 (a non-digit counts as 0; uses j3, j10)
  jldi j0, 0
v_gnm_lap:
  jjz j2, v_gnm_done
  jldi j10, 10
  jmul j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 48
  jsub j3, j3, j10
  jjn j3, v_gnm_skip
  jldi j10, 10
  jsub j10, j3, j10
  jjnn j10, v_gnm_skip
  jadd j0, j0, j3
v_gnm_skip:
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp v_gnm_lap
v_gnm_done:
  jret
v_r_open:                         ; j11 = a label, j12 = its bytes -> FH = the handle (or -1)
  jldi j10, 4
  jcall v_r_tocar
  jst j13, j14, 02328h
  jret
v_r_file:                         ; j10 = request (5 read, 6 write, 7 close, 38 go to), FH = the handle, j11, j12 -> j13
  jldi j9, 32
  jld j8, j14, 02328h
  jshl j8, j8, j9
  jor j10, j10, j8
  jcall v_r_tocar
  jret
v_r_coprime:                      ; j1 = a total > 0 -> j0 = a random stride coprime to it
  jst j1, j14, 02360h
  jcall v_r_randmod
  jjnz j0, v_cp_try
  jldi j0, 1
v_cp_try:
  jst j0, j14, 02358h
  jld j1, j14, 02360h
v_cp_gcd:
  jjz j1, v_cp_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp v_cp_gcd
v_cp_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, v_cp_go
  jld j0, j14, 02358h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 02360h
  jsub j10, j0, j1
  jjn j10, v_cp_try
  jldi j0, 1
  jjmp v_cp_try
v_cp_go:
  jld j0, j14, 02358h
  jret
v_r_randmod:                      ; j1 = n > 0 -> j0 in [0, n) from the generator (uses j10..j12)
  jcall v_r_rand
  jldi j11, 1
  jshr j10, j10, j11
  jdiv j0, j10, j1
  jmul j0, j0, j1
  jsub j0, j10, j0
  jret
v_r_rand:                         ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 02220h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 02220h
  jret
v_r_tocar:                        ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
