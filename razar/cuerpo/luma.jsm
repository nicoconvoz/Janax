v_born:                         ; TI landed: news (its description / 16), a body offered to the forms
  jld j9, j14, 02380h
  jld j1, j9, 72
  jldi j10, 100
  jmul j1, j1, j10
  jldi j10, 16
  jdiv j1, j1, j10
