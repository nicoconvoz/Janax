  jstb j1, j14, 01E53h
  jldi j1, 064h
  jstb j1, j14, 01E54h
  jldi j1, 061h
  jstb j1, j14, 01E55h
  jldi j1, 073h
  jstb j1, j14, 01E56h
  jldi j1, 06Ch
  jstb j1, j14, 01E60h
  jldi j1, 061h
  jstb j1, j14, 01E61h
  jldi j1, 064h
  jstb j1, j14, 01E62h
  jldi j1, 072h
  jstb j1, j14, 01E63h
  jldi j1, 069h
  jstb j1, j14, 01E64h
  jldi j1, 06Ch
  jstb j1, j14, 01E65h
  jldi j1, 06Ch
  jstb j1, j14, 01E66h
  jldi j1, 06Fh
  jstb j1, j14, 01E67h
  jldi j1, 073h
  jstb j1, j14, 01E68h
  jcall r_food_load
  jcall r_load_former
  jcall v_init                  ; the creatures' world: its list, what they learned, who was eaten
; ---- the forms: what the folder kept, or the seeds; each at the centre of its room, every particle at its seed
  jcall r_load_forms
  jldi j9, 0800h
  jldi j1, 01400h
  jst j1, j9, 0
  jldi j1, 01900h
  jst j1, j9, 8
  jldi j1, 8
