  jldi j1, 0
  jcall r_regrow
  jldi j9, 0900h
  jldi j1, 03C00h
  jst j1, j9, 0
  jldi j1, 01900h
  jst j1, j9, 8
  jldi j1, 0Bh
  jshi j1, 0E800h
  jst j1, j9, 16
  jldi j1, 0
  jshi j1, 0E600h
  jst j1, j9, 176
  jldi j1, 9
  jst j1, j9, 56
  jldi j1, 1
  jcall r_regrow
  jldi j9, 0A00h
  jldi j1, 06400h
  jst j1, j9, 0
  jldi j1, 01900h
  jst j1, j9, 8
  jldi j1, 0Fh
  jshi j1, 0D000h
  jst j1, j9, 16
