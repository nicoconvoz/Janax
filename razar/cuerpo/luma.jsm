  jadd j6, j6, j8
  jld j7, j1, 32
  jstb j7, j6, 0
  jldi j10, 8
  jshr j7, j7, j10
  jstb j7, j6, 1
  jshr j7, j7, j10
  jstb j7, j6, 2
v_dr_p_next:
  jldi j10, 48
  jadd j1, j1, j10
  jldi j10, 1
  jsub j2, j2, j10
  jjmp v_dr_p
v_dr_next:
  jld j10, j14, 02338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02338h
  jjmp v_dr_lap
v_dr_done:
