v_shuffle:                      ; j1 = a recipe -> SHUF: its letters shuffled by the generator (used by the control)
  jldb j2, j1, 0
  jstb j2, j14, 064C0h
  jldi j3, 0
v_vsf_cp:
  jsub j10, j3, j2
  jjnn j10, v_vsf_mix
  jadd j10, j1, j3
  jldb j4, j10, 1
  jldi j10, 064C1h
  jadd j10, j10, j3
  jstb j4, j10, 0
