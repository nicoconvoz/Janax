  jld j10, j9, 64
  jst j10, j14, 04E8h
  jld j10, j9, 72
  jst j10, j14, 04F0h
  jcall r_anchor
  ; the room's corner cell (-20, -25), drawn: anchor - (20 MX, 25 MY)
  jld j10, j14, 04E8h
  jldi j11, 20
  jmul j10, j10, j11
  jsub j5, j3, j10
  jld j10, j14, 04F0h
  jldi j11, 25
  jmul j10, j10, j11
  jsub j6, j4, j10
  jld j1, j14, 0498h
  jldi j10, 9
  jshl j3, j1, j10
  jldi j10, 0
  jshi j10, 0F600h
  jadd j3, j3, j10
  jldi j4, 0
dg_row:
  jld j7, j3, 0
  jldi j8, 0
dg_bit:
  jjz j7, dg_row_next
  jldi j10, 1
  jand j10, j7, j10
  jjz j10, dg_bit_next
  jld j10, j14, 04E8h
  jmul j1, j8, j10
  jadd j1, j1, j5
  jldi j10, 128
  jadd j1, j1, j10
  jldi j10, 8
  jsar j1, j1, j10
  jld j10, j14, 04F0h
  jmul j2, j4, j10
  jadd j2, j2, j6
  jldi j10, 128
  jadd j2, j2, j10
  jldi j10, 8
  jsar j2, j2, j10
  jcall r_brush
dg_bit_next:
  jldi j10, 1
  jshr j7, j7, j10
  jadd j8, j8, j10
  jjmp dg_bit
dg_row_next:
  jldi j10, 8
  jadd j3, j3, j10
  jldi j10, 1
  jadd j4, j4, j10
  jldi j10, 50
  jsub j10, j4, j10
  jjnz j10, dg_row
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jjmp dg_lap
dg_done:
  jret
r_draw_all:                     ; the forms back to front: each grown particle joined to its parent
  jst j14, j14, 0490h
da_lap:
  jld j1, j14, 0490h
  jldi j10, 3
  jshl j1, j1, j10
  jldi j10, 01340h
  jadd j1, j1, j10
  jld j1, j1, 0
  jst j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jst j9, j14, 0488h
  jld j10, j9, 120
  jjz j10, da_full
  jld j1, j9, 136
  jldi j10, 03Eh
  jadd j1, j1, j10
  jldi j10, 3
  jdiv j1, j1, j10
  jst j1, j14, 0460h
  jld j1, j9, 144
  jldi j10, 09Ch
  jadd j1, j1, j10
  jldi j10, 3
  jdiv j1, j1, j10
  jst j1, j14, 0468h
  jld j1, j9, 152
  jldi j10, 0B4h
  jadd j1, j1, j10
  jldi j10, 3
  jdiv j1, j1, j10
  jst j1, j14, 0470h
  jjmp da_coloured
da_full:
  jld j1, j9, 136
  jst j1, j14, 0460h
  jld j1, j9, 144
  jst j1, j14, 0468h
  jld j1, j9, 152
  jst j1, j14, 0470h
da_coloured:
  jld j10, j9, 48
  jst j10, j14, 0458h
  jld j10, j9, 160
  jst j10, j14, 04C8h
  jld j3, j9, 16
  jld j4, j9, 24
  jldi j10, 7
  jshl j4, j4, j10
  jadd j4, j4, j3
df_lap:
  jsub j10, j4, j3
  jjz j10, df_done
  jld j10, j3, 64
  jld j11, j14, 0458h
  jsub j10, j11, j10
  jjn j10, df_next
  jld j5, j3, 16
  jldi j10, 128
  jadd j5, j5, j10
  jldi j10, 8
  jsar j5, j5, j10
  jld j6, j3, 24
  jldi j10, 128
  jadd j6, j6, j10
  jldi j10, 8
  jsar j6, j6, j10
  jld j12, j3, 56
  jld j7, j12, 16
  jldi j10, 128
  jadd j7, j7, j10
  jldi j10, 8
  jsar j7, j7, j10
  jsub j7, j7, j5
  jld j8, j12, 24
  jldi j10, 128
  jadd j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j8, j8, j6
  jadd j9, j7, j14
  jjnn j9, df_ax
  jsub j9, j14, j9
df_ax:
  jadd j12, j8, j14
  jjnn j12, df_ay
  jsub j12, j14, j12
df_ay:
  jsub j10, j9, j12
  jjnn j10, df_n
  jadd j9, j12, j14
df_n:                           ; j9 = the cells to its parent; stamped every half stroke, the body stays closed
  jld j10, j14, 04C8h
  jldi j11, 1
  jsar j10, j10, j11
  jjnz j10, df_half
  jldi j10, 1
df_half:
  jadd j9, j9, j10
  jsub j9, j9, j11
  jdiv j9, j9, j10
  jadd j1, j5, j14
  jadd j2, j6, j14
  jcall r_brush
  jjz j9, df_next
  jldi j13, 1
df_line:
  jmul j1, j7, j13
  jdiv j1, j1, j9
  jadd j1, j1, j5
  jmul j2, j8, j13
  jdiv j2, j2, j9
  jadd j2, j2, j6
  jcall r_brush
  jldi j10, 1
  jadd j13, j13, j10
  jsub j10, j9, j13
  jjnn j10, df_line
df_next:
  jldi j10, 128
  jadd j3, j3, j10
  jjmp df_lap
df_done:
  ; the focused form: its seed in white
  jld j1, j14, 0498h
  jld j2, j14, 0270h
  jsub j1, j1, j2
  jjnz j1, da_next
  jldi j1, 0FFh
  jst j1, j14, 0460h
  jst j1, j14, 0468h
  jst j1, j14, 0470h
  jld j9, j14, 0488h
  jld j3, j9, 16
  jld j1, j3, 16
  jldi j10, 128
  jadd j1, j1, j10
  jldi j10, 8
  jsar j1, j1, j10
  jld j2, j3, 24
  jldi j10, 128
  jadd j2, j2, j10
  jldi j10, 8
  jsar j2, j2, j10
  jld j10, j14, 04C8h
  jldi j11, 3
  jdiv j10, j10, j11
  jjnz j10, da_dot
  jldi j10, 1
da_dot:
  jst j10, j14, 04C8h
  jcall r_brush
da_next:
  jld j10, j14, 0490h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0490h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, da_lap
  jret
r_randmod:                      ; j1 = n > 0 -> j0 = a number from the generator in [0, n) (uses j10..j12)
  jcall r_rand
  jldi j11, 1
  jshr j10, j10, j11
  jdiv j0, j10, j1
  jmul j0, j0, j1
  jsub j0, j10, j0
  jret
r_rand:                         ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 0238h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 0238h
  jret
r_tocar:                        ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
; =================================================================================== eating
r_alloc:                        ; j1 = bytes -> j0 = a new environment of that size (request 2), its address
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, alloc_go
  jldi j1, 8
alloc_go:
  jadd j11, j1, j14
  jldi j10, 2
  jldi j12, 0
  jcall r_tocar
  jadd j0, j13, j14
  jjnn j0, alloc_ok
  jldi j0, 0BADh
  jhalt
alloc_ok:
  jret
r_read_all:                     ; FH, j11 = where, j12 = bytes -> j0 = bytes read (reads until all or none)
  jst j11, j14, 01BF8h
  jst j12, j14, 01C00h
  jst j14, j14, 01C08h
ra_lap:
  jld j12, j14, 01C00h
  jld j10, j14, 01C08h
  jsub j12, j12, j10
  jjz j12, ra_done
  jld j11, j14, 01BF8h
  jld j10, j14, 01C08h
  jadd j11, j11, j10
  jldi j10, 5
  jcall r_file
  jjn j13, ra_done
  jjz j13, ra_done
  jld j10, j14, 01C08h
  jadd j10, j10, j13
  jst j10, j14, 01C08h
  jjmp ra_lap
ra_done:
  jld j0, j14, 01C08h
  jret
r_fnv:                          ; j1 = bytes, j2 = how many -> j0 = their FNV-1a print, never 0 (uses j3, j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
fnv_lap:
  jjz j2, fnv_done
  jldb j3, j1, 0
  jxor j0, j0, j3
  jmul j0, j0, j4
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp fnv_lap
fnv_done:
  jldi j10, 1
  jor j0, j0, j10
  jret
r_put_hex:                      ; j1 = a number, j2 = hex digits, j3 = where (uses j4, j5, j10)
ph_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, ph_done
  jldi j10, 15
  jand j5, j1, j10
  jldi j10, 10
  jsub j10, j5, j10
  jjn j10, ph_digit
  jldi j10, 39
  jadd j5, j5, j10
ph_digit:
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jldi j10, 4
  jshr j1, j1, j10
  jjmp ph_lap
ph_done:
  jret
r_get_hex:                      ; j1 = where, j2 = hex digits -> j0 (uses j3, j10)
  jldi j0, 0
gh_lap:
  jjz j2, gh_done
  jldi j10, 4
  jshl j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 58
  jsub j10, j3, j10
  jjn j10, gh_digit
  jldi j10, 39
  jsub j3, j3, j10
gh_digit:
  jldi j10, 48
  jsub j3, j3, j10
  jldi j10, 15
  jand j3, j3, j10
  jor j0, j0, j3
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp gh_lap
gh_done:
  jret
r_coprime:                      ; j1 = a total > 0 -> j0 = a random stride coprime to it (uses j1..j3, j10..j12)
  jst j1, j14, 01BF0h
  jcall r_randmod
  jjnz j0, cp_try
  jldi j0, 1
cp_try:
  jst j0, j14, 01BE8h
  jld j1, j14, 01BF0h
cp_gcd:
  jjz j1, cp_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp cp_gcd
cp_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, cp_go
  jld j0, j14, 01BE8h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 01BF0h
  jsub j10, j0, j1
  jjn j10, cp_try
  jldi j0, 1
  jjmp cp_try
cp_go:
  jld j0, j14, 01BE8h
  jret
r_log2:                         ; j1 = x in [1, 2^31) -> j0 = log2 x, 16 bits of fraction (uses j2, j3, j10..j12)
  jldi j0, 0
  jadd j2, j1, j14
  jldi j10, 1
lg_e:
  jshr j2, j2, j10
  jjz j2, lg_norm
  jadd j0, j0, j10
  jjmp lg_e
lg_norm:                        ; m = x in [2^30, 2^31), then 16 squarings: each says one bit of the fraction
  jldi j10, 30
  jsub j10, j10, j0
  jshl j2, j1, j10
  jldi j11, 0
  jldi j3, 16
lg_bit:
  jmul j2, j2, j2
  jldi j10, 30
  jshr j2, j2, j10
  jldi j10, 1
  jshl j11, j11, j10
  jldi j10, 31
  jshr j12, j2, j10
  jjz j12, lg_next
  jldi j10, 1
  jshr j2, j2, j10
  jor j11, j11, j10
lg_next:
  jldi j10, 1
  jsub j3, j3, j10
  jjnz j3, lg_bit
  jldi j10, 16
  jshl j0, j0, j10
  jor j0, j0, j11
  jret
; ---- the pantry ("despensa": a header and a line per cloud, "<its bytes> <its path on the host>"), what it
;      ate ("comidas"), its bricks ("ladrillos"); every table sized from the pantry (plastic)
r_food_load:
  jst j14, j14, 01A58h
  jst j14, j14, 01B50h
  jst j14, j14, 01A30h
  jst j14, j14, 01A50h
  jst j14, j14, 01A38h
  jst j14, j14, 01A00h
