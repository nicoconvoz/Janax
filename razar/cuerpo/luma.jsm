grow_heart:                     ; 7, her heart: her body's bolita through the gear, asked of the kernel (20), which
                                ; cuts it down to the one she was launched with; at rest again at the next hole
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 01900h
