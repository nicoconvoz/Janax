  jjn j2, fr_rest
  jjmp fr_think
fr_talk:                        ; she speaks first (gen_leer.py: HER WORD)
  jcall r_dlg_talk
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 080h
  jldi j6, 015Eh
  jshi j6, 0
  jld j2, j6, 088h
  jadd j1, j1, j2
  jcall r_randmod
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 080h
  jsub j2, j0, j1
  jjn j2, fr_rest
  jjmp fr_think
fr_sleep:                       ; she sleeps, when she feels like it (the Capitan: "operacion dormir: cuando Luma duerma
                                ; renace con la pieza nueva incluida; puede dormir cuando se le de la gana"). She
                                ; leaves a sign in her house ("dormir") and stays still; who watches over her
                                ; (luma_vive.sh) closes her eyes and wakes her: born again, built again if her
                                ; source changed. It pays if she woke made of something new (her build's print).
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 5120
  jldi j10, 1
  jadd j1, j1, j10
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 5120
