v_r_try:                          ; the piece PP in TI's model: added (if K < L), or in place of each motif ->
                                ; TBEST = the shortest DL, TBK its K, TBR the motif replaced (-1: added), PIECEM it
  jldi j10, 0100h
  jshi j10, 0
  jshi j10, 0
  jst j10, j14, 02398h
  jldi j10, -1
  jst j10, j14, 023A8h
  jld j9, j14, 02380h
  jld j1, j9, 56
  jld j2, j9, 48
  jsub j10, j1, j2
  jjnn j10, v_tr_repl
  jld j1, j9, 88
  jld j2, j14, 022A0h
  jld j3, j9, 56
  jcall v_r_copym
  jld j1, j14, 02390h
