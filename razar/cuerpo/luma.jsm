  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, grow_clear_bmp
  jldi j1, 1
  jshi j1, 0800h
  jldi j2, 07D0h
grow_clear_grid:
  jst j14, j1, 0
  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, grow_clear_grid
  jst j14, j14, 0320h
  jst j14, j14, 0328h
  jst j14, j14, 0330h
  jst j14, j14, 0340h
  jst j14, j14, 04F8h
  jldi j1, 0
  jldi j2, 0
  jldi j3, -1
  jldi j4, 0
  jcall r_cell
  jst j0, j14, 0338h
grow_letter:
  jld j10, j14, 0500h
