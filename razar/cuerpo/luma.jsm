v_rebody:                       ; TI's body drawn again at its size (her own cloud rewritten), growing from its centre
  jcall v_size
  jcall v_remember
  jjz j0, v_vrb_ret
  jcall v_r_body
  jjz j0, v_vrb_ret
  jld j9, j14, 02380h
  jld j1, j9, 120
  jld j2, j9, 128
v_vrb_p:
