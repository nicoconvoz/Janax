v_r_in_band:                      ; TI's height kept inside its stratum (it wraps there, as the world wraps)
  jld j9, j14, 02380h
  jld j1, j14, 026D0h
  jjz j1, v_ib_ret
  jld j1, j9, 272
  jldi j10, 3
