  jjnn j10, v_hb_wdone
  jldi j10, 320
  jmul j9, j1, j10
  jld j10, j14, 02258h
  jadd j9, j9, j10
  jld j1, j9, 136
  jldi j2, 16
  jldi j3, 049F0h
  jcall v_r_put_hex
  jldi j1, 32
  jstb j1, j14, 04A00h
  jld j9, j14, 02338h
  jldi j10, 320
  jmul j9, j9, j10
  jld j10, j14, 02258h
  jadd j9, j9, j10
  jld j1, j9, 272
  jldi j2, 1
  jldi j3, 04A01h
  jcall v_r_put_num
  jldi j1, 10
  jstb j1, j14, 04A02h
  jldi j10, 6
  jldi j11, 049F0h
  jldi j12, 19
