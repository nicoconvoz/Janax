  jsub j11, j11, j10
  jst j11, j2, 24
  jldi j10, 48
  jadd j2, j2, j10
  jldi j10, 1
  jadd j0, j0, j10
v_bd_pnext:
  jldi j10, 40
  jadd j1, j1, j10
  jldi j10, 1
  jadd j5, j5, j10
  jsub j10, j5, j13
  jjnz j10, v_bd_pcell
  jldi j10, 1
  jadd j3, j3, j10
  jsub j10, j3, j13
  jjnz j10, v_bd_prow
  jst j0, j9, 128
  jjz j0, v_bd_bad
  jldi j0, 1
  jret
v_bd_bad:
  jldi j0, 0
  jret
; ---- the judge: the description length of a gait, in whole bits
v_r_gam:                          ; j10 = n >= 0 -> j12 = 2 bitlen(n + 1) - 1, the Elias gamma code (uses j13)
  jldi j13, 1
  jadd j13, j10, j13
  jldi j12, 0
  jldi j10, 1
v_gm_lap:
  jjz j13, v_gm_done
  jshr j13, j13, j10
  jadd j12, j12, j10
  jjmp v_gm_lap
v_gm_done:
  jadd j12, j12, j12
  jsub j12, j12, j10
  jret
v_r_bitlen:                       ; j10 = n >= 0 -> j12 = its bits (the bits to name one of n + 1; uses j13)
  jadd j13, j10, j14
  jldi j12, 0
  jldi j10, 1
v_bl_lap:
  jjz j13, v_bl_done
  jshr j13, j13, j10
  jadd j12, j12, j10
  jjmp v_bl_lap
v_bl_done:
  jret
v_r_zz:                           ; j10 = a difference -> its zigzag (0, -1, 1, -2... -> 0, 1, 2, 3...; uses j13)
  jjn j10, v_zz_neg
  jadd j10, j10, j10
  jret
v_zz_neg:
  jsub j10, j14, j10
  jadd j10, j10, j10
  jldi j13, 1
  jsub j10, j10, j13
  jret
v_r_mcost:                        ; j11 = a rhythm -> j15 = its bits said whole: gamma(P) + gamma(q) + 4
  jld j10, j11, 0
  jcall v_r_gam
  jadd j15, j12, j14
  jld j10, j11, 8
  jcall v_r_gam
  jadd j15, j15, j12
  jldi j10, 4
  jadd j15, j15, j10
  jret
v_r_dist:                         ; j6 = a limb, j9 = a motif -> j15 = the bits to say the limb from the motif
  jld j10, j6, 0
  jld j13, j9, 0
  jsub j10, j10, j13
  jcall v_r_zz
  jcall v_r_gam
  jadd j15, j12, j14
  jld j10, j6, 8
  jld j13, j9, 8
  jsub j10, j10, j13
  jcall v_r_zz
  jcall v_r_gam
  jadd j15, j15, j12
  jld j10, j6, 16
  jld j13, j9, 16
  jsub j10, j10, j13
  jldi j13, 15
  jand j10, j10, j13
  jldi j13, 8
  jsub j13, j10, j13
  jjn j13, v_ds_s
  jldi j13, 16
  jsub j10, j10, j13
v_ds_s:
  jcall v_r_zz
  jcall v_r_gam
  jadd j15, j15, j12
  jret
v_r_dl:                           ; j1 = a model, j2 = K, j3 = the limbs, j4 = L -> j0 = DL (j1..j4 kept)
  jadd j10, j2, j14
  jcall v_r_gam
  jadd j0, j12, j14
  jadd j9, j1, j14
  jadd j8, j2, j14
v_dl_mot:
  jjz j8, v_dl_mot_done
  jadd j11, j9, j14
  jcall v_r_mcost
  jadd j0, j0, j15
  jldi j10, 32
  jadd j9, j9, j10
  jldi j10, 1
  jsub j8, j8, j10
  jjmp v_dl_mot
v_dl_mot_done:
  jadd j10, j2, j14
  jcall v_r_bitlen
  jadd j5, j12, j14
  jadd j6, j3, j14
  jadd j7, j4, j14
v_dl_limb:
  jjz j7, v_dl_done
  jadd j11, j6, j14
  jcall v_r_mcost
  jadd j8, j15, j14
  jadd j9, j1, j14
  jadd j11, j2, j14
v_dl_m:
  jjz j11, v_dl_m_done
  jcall v_r_dist
  jsub j10, j15, j8
  jjnn j10, v_dl_m_next
  jadd j8, j15, j14
v_dl_m_next:
  jldi j10, 32
  jadd j9, j9, j10
  jldi j10, 1
  jsub j11, j11, j10
  jjmp v_dl_m
v_dl_m_done:
  jadd j0, j0, j5
  jadd j0, j0, j8
  jldi j10, 32
  jadd j6, j6, j10
  jldi j10, 1
  jsub j7, j7, j10
  jjmp v_dl_limb
v_dl_done:
  jret
v_r_copym:                        ; j1 -> j2, j3 rhythms (uses j10)
v_cm_lap:
  jjz j3, v_cm_done
  jld j10, j1, 0
  jst j10, j2, 0
  jld j10, j1, 8
  jst j10, j2, 8
  jld j10, j1, 16
  jst j10, j2, 16
  jldi j10, 32
  jadd j1, j1, j10
  jadd j2, j2, j10
  jldi j10, 1
  jsub j3, j3, j10
  jjmp v_cm_lap
v_cm_done:
  jret
v_r_inlist:                       ; j1 = a rhythm, j2 = a list, j3 = its count -> j0 = 1 if the rhythm is in it
v_il_lap:
  jjz j3, v_il_no
  jld j4, j1, 0
  jld j5, j2, 0
  jsub j4, j4, j5
  jjnz j4, v_il_next
  jld j4, j1, 8
  jld j5, j2, 8
  jsub j4, j4, j5
  jjnz j4, v_il_next
  jld j4, j1, 16
  jld j5, j2, 16
  jsub j4, j4, j5
  jjnz j4, v_il_next
  jldi j0, 1
  jret
v_il_next:
  jldi j10, 32
  jadd j2, j2, j10
  jldi j10, 1
  jsub j3, j3, j10
  jjmp v_il_lap
v_il_no:
  jldi j0, 0
  jret
v_r_own:                          ; TI's first model: add the own limb that shortens DL most, while one does
  jld j9, j14, 02380h
  jst j14, j9, 56
v_ow_round:
  jld j9, j14, 02380h
  jld j1, j9, 88
  jld j2, j9, 56
  jld j3, j9, 80
  jld j4, j9, 48
