; ---- the mutations of a recipe (form j1, or -1 for the meal being digested), op j2, from the recipe j3 into j4.
;      The kind (WKIND for the walks, AKIND set by the caller of r_apply_k) says which groups are on:
;      0 all (a full walk), 1 what a meal brought (the meal's ops and the new bricks), 2 digesting (no meal ops).
;      Groups, in this order: the meal (kinds 0, 1: its recipe in place of this one (1), this one's first c
;      letters and the meal's rest (n), the meal's first c and this one's rest (m)); the new bricks (kind 1:
;      NNEW (n+1)); every brick (kinds 0, 2: NB (n+1); the towers 16, 38 first, then the learned ones);
;      change a letter (8n), insert one (9(n+1)), cross with each form (8 n: its first c letters and the
;      form's rest; with itself it gives itself, already tried), delete one (n, if n > 1).
r_count:                        ; j1 = n -> j0 = how many ops of the walk's kind
  jld j2, j14, 01A38h
r_count_k:                      ; j1 = n, j2 = kind -> j0 (uses j3, j10, j11)
  jldi j0, 0
  jldi j10, 2
  jsub j10, j2, j10
  jjz j10, cnt_nomeal
  jld j3, j14, 01A30h
  jjz j3, cnt_nomeal
  jadd j0, j0, j3
  jadd j0, j0, j1
  jldi j10, 1
  jadd j0, j0, j10
cnt_nomeal:
  jldi j10, 1
  jadd j11, j1, j10
  jsub j10, j2, j10
  jjnz j10, cnt_full
  jld j3, j14, 01A50h
  jmul j3, j3, j11
  jadd j0, j0, j3
  jret
cnt_full:
  jld j3, j14, 01A48h
  jmul j3, j3, j11
  jadd j0, j0, j3
  jldi j10, 16
  jmul j3, j1, j10
  jadd j0, j0, j3
  jldi j10, 9
  jmul j3, j11, j10
  jadd j0, j0, j3
  jldi j10, 1
  jsub j10, j1, j10
  jjz j10, cnt_one
  jadd j0, j0, j1
cnt_one:
  jret
r_cat:                          ; append the letters [j1, j2) of the recipe j3 to the recipe ADST (uses j4..j6, j10)
  jld j4, j14, 0430h
cat_lap:
  jsub j10, j1, j2
  jjnn j10, cat_done
  jadd j5, j3, j1
  jldb j5, j5, 1
  jldb j6, j4, 0
  jldi j10, 46
  jsub j10, j6, j10
  jjnn j10, cat_done
  jadd j10, j4, j6
  jstb j5, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jldi j10, 1
  jadd j1, j1, j10
  jjmp cat_lap
cat_done:
  jret
r_app:                          ; append the letter j1 to the recipe ADST (uses j4, j6, j10)
  jld j4, j14, 0430h
  jldb j6, j4, 0
  jadd j10, j4, j6
  jstb j1, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jret
r_apply:                        ; j1 form, j2 op, j3 from, j4 into: the walk's kind
  jld j5, j14, 01A38h
  jst j5, j14, 01A40h
r_apply_k:
  jst j1, j14, 0420h
  jst j2, j14, 0440h
  jst j3, j14, 0428h
  jst j4, j14, 0430h
  jstb j14, j4, 0
  jldb j5, j3, 0
  jst j5, j14, 0438h
  jld j6, j14, 01A40h
  jldi j10, 2
  jsub j10, j6, j10
  jjz j10, ap_bricks
  jld j7, j14, 01A30h
  jjz j7, ap_newb
  ; the meal
  jjnz j2, ap_meal1
  jld j3, j14, 0428h
  jldi j1, 01D40h
  jld j10, j1, 0
  jst j10, j4, 0
  jld j10, j1, 8
  jst j10, j4, 8
  jld j10, j1, 16
  jst j10, j4, 16
  jld j10, j1, 24
  jst j10, j4, 24
  jret
ap_meal1:
  jldi j10, 1
  jsub j2, j2, j10
  jsub j10, j2, j5
  jjnn j10, ap_meal2
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 04B8h
  jld j3, j14, 0428h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 04B8h
  jld j2, j14, 01A30h
  jldi j3, 01D40h
  jcall r_cat
  jret
ap_meal2:
