  jld j1, j3, 16
  jldi j10, 128
  jadd j1, j1, j10
  jldi j10, 8
  jsar j1, j1, j10
  jld j2, j3, 24
  jldi j10, 128
  jadd j2, j2, j10
  jldi j10, 8
  jsar j2, j2, j10
  jld j10, j14, 04C8h
  jldi j11, 3
  jdiv j10, j10, j11
  jjnz j10, da_dot
  jldi j10, 1
da_dot:
  jst j10, j14, 04C8h
  jcall r_brush
da_next:
  jld j10, j14, 0490h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0490h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, da_lap
  jret
r_randmod:                      ; j1 = n > 0 -> j0 = a number from the generator in [0, n) (uses j10..j12)
  jcall r_rand
  jldi j11, 1
  jshr j10, j10, j11
  jdiv j0, j10, j1
  jmul j0, j0, j1
  jsub j0, j10, j0
  jret
r_rand:                         ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 0238h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 0238h
  jret
r_tocar:                        ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
; =================================================================================== eating
r_alloc:                        ; j1 = bytes -> j0 = a new environment of that size (request 2), its address
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, alloc_go
  jldi j1, 8
alloc_go:
  jadd j11, j1, j14
  jldi j10, 2
  jldi j12, 0
  jcall r_tocar
  jadd j0, j13, j14
  jjnn j0, alloc_ok
  jldi j0, 0BADh
  jhalt
alloc_ok:
  jret
r_read_all:                     ; FH, j11 = where, j12 = bytes -> j0 = bytes read (reads until all or none)
  jst j11, j14, 01BF8h
  jst j12, j14, 01C00h
  jst j14, j14, 01C08h
ra_lap:
  jld j12, j14, 01C00h
  jld j10, j14, 01C08h
  jsub j12, j12, j10
  jjz j12, ra_done
  jld j11, j14, 01BF8h
  jld j10, j14, 01C08h
  jadd j11, j11, j10
  jldi j10, 5
  jcall r_file
  jjn j13, ra_done
  jjz j13, ra_done
  jld j10, j14, 01C08h
  jadd j10, j10, j13
  jst j10, j14, 01C08h
  jjmp ra_lap
ra_done:
  jld j0, j14, 01C08h
  jret
r_fnv:                          ; j1 = bytes, j2 = how many -> j0 = their FNV-1a print, never 0 (uses j3, j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
fnv_lap:
  jjz j2, fnv_done
  jldb j3, j1, 0
  jxor j0, j0, j3
  jmul j0, j0, j4
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp fnv_lap
fnv_done:
  jldi j10, 1
  jor j0, j0, j10
  jret
r_put_hex:                      ; j1 = a number, j2 = hex digits, j3 = where (uses j4, j5, j10)
ph_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, ph_done
  jldi j10, 15
  jand j5, j1, j10
  jldi j10, 10
  jsub j10, j5, j10
  jjn j10, ph_digit
  jldi j10, 39
  jadd j5, j5, j10
ph_digit:
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jldi j10, 4
  jshr j1, j1, j10
  jjmp ph_lap
ph_done:
  jret
r_get_hex:                      ; j1 = where, j2 = hex digits -> j0 (uses j3, j10)
  jldi j0, 0
gh_lap:
  jjz j2, gh_done
  jldi j10, 4
  jshl j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 58
  jsub j10, j3, j10
  jjn j10, gh_digit
  jldi j10, 39
  jsub j3, j3, j10
gh_digit:
  jldi j10, 48
  jsub j3, j3, j10
  jldi j10, 15
  jand j3, j3, j10
  jor j0, j0, j3
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp gh_lap
gh_done:
  jret
r_coprime:                      ; j1 = a total > 0 -> j0 = a random stride coprime to it (uses j1..j3, j10..j12)
  jst j1, j14, 01BF0h
  jcall r_randmod
  jjnz j0, cp_try
  jldi j0, 1
cp_try:
  jst j0, j14, 01BE8h
  jld j1, j14, 01BF0h
cp_gcd:
  jjz j1, cp_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp cp_gcd
cp_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, cp_go
  jld j0, j14, 01BE8h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 01BF0h
  jsub j10, j0, j1
  jjn j10, cp_try
  jldi j0, 1
  jjmp cp_try
cp_go:
  jld j0, j14, 01BE8h
  jret
r_log2:                         ; j1 = x in [1, 2^31) -> j0 = log2 x, 16 bits of fraction (uses j2, j3, j10..j12)
  jldi j0, 0
  jadd j2, j1, j14
  jldi j10, 1
lg_e:
  jshr j2, j2, j10
  jjz j2, lg_norm
  jadd j0, j0, j10
  jjmp lg_e
lg_norm:                        ; m = x in [2^30, 2^31), then 16 squarings: each says one bit of the fraction
  jldi j10, 30
  jsub j10, j10, j0
  jshl j2, j1, j10
  jldi j11, 0
  jldi j3, 16
lg_bit:
  jmul j2, j2, j2
  jldi j10, 30
  jshr j2, j2, j10
  jldi j10, 1
  jshl j11, j11, j10
  jldi j10, 31
  jshr j12, j2, j10
  jjz j12, lg_next
  jldi j10, 1
  jshr j2, j2, j10
  jor j11, j11, j10
lg_next:
  jldi j10, 1
  jsub j3, j3, j10
  jjnz j3, lg_bit
  jldi j10, 16
  jshl j0, j0, j10
  jor j0, j0, j11
  jret
; ---- the pantry ("despensa": a header and a line per cloud, "<its bytes> <its path on the host>"), what it
;      ate ("comidas"), its bricks ("ladrillos"); every table sized from the pantry (plastic)
r_food_load:
  jst j14, j14, 01A58h
  jst j14, j14, 01B50h
  jst j14, j14, 01A30h
  jst j14, j14, 01A50h
  jst j14, j14, 01A38h
  jst j14, j14, 01A00h
  jst j14, j14, 01BB8h
  jst j14, j14, 01CC0h
  jst j14, j14, 01D18h
  jldi j10, -1
  jst j10, j14, 01AE8h
  jldi j10, 8
  jst j10, j14, 01A70h
  jldi j11, 01E40h
  jldi j12, 8
  jcall r_open
  jld j9, j14, 04A8h
  jjn j9, fl_nofood
  jldi j10, 5
  jldi j11, 01E00h
  jldi j12, 37
  jcall r_file
  jldi j10, 37
  jsub j10, j13, j10
  jjnz j10, fl_close
  jldi j1, 01E0Ah
  jldi j2, 6
  jcall r_get_num
  jst j0, j14, 01A58h
  jldi j1, 01E11h
  jldi j2, 9
  jcall r_get_num
  jst j0, j14, 01A70h
  jldi j1, 01E1Bh
  jldi j2, 9
  jcall r_get_num
  jst j0, j14, 01A78h
  jld j1, j14, 01A78h
  jcall r_alloc
  jst j0, j14, 01A60h
  jld j11, j14, 01A60h
  jld j12, j14, 01A78h
  jcall r_read_all
  jst j0, j14, 01A78h
fl_close:
  jldi j10, 7
  jcall r_file
  jld j1, j14, 01A58h
  jldi j10, 40
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01A68h
  ; the entries: {path, its bytes, the file's bytes, the path's print, eaten}
  jld j1, j14, 01A60h
  jst j1, j14, 01BC8h
  jst j14, j14, 01BD0h
fl_line:
  jld j9, j14, 01BD0h
  jld j10, j14, 01A58h
  jsub j10, j9, j10
  jjnn j10, fl_lines_done
  jld j1, j14, 01BC8h
  jld j10, j14, 01A60h
  jsub j2, j1, j10
  jld j10, j14, 01A78h
  jsub j10, j2, j10
  jjnn j10, fl_lines_done
  jld j9, j14, 01BD0h
  jldi j10, 40
  jmul j9, j9, j10
  jld j10, j14, 01A68h
  jadd j9, j9, j10
  jst j9, j14, 01BD8h
  jld j1, j14, 01BC8h
  jldi j2, 9
  jcall r_get_num
  jld j9, j14, 01BD8h
  jst j0, j9, 16
  jst j14, j9, 32
  jld j1, j14, 01BC8h
  jldi j10, 10
  jadd j1, j1, j10
  jst j1, j9, 0
  jadd j2, j1, j14
fl_eol:
  jldb j3, j2, 0
  jldi j10, 10
  jsub j10, j3, j10
  jjz j10, fl_eol_found
  jldi j10, 1
  jadd j2, j2, j10
  jjmp fl_eol
fl_eol_found:
  jsub j3, j2, j1
  jst j3, j9, 8
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 01BC8h
  ; a self-contained casa names a meal by its print alone ("#" and 16 hex): no path on the host
  jldb j4, j1, 0
  jldi j10, 35
  jsub j10, j4, j10
  jjnz j10, fl_fnv
  jldi j10, 1
  jadd j1, j1, j10
  jldi j2, 16
  jcall r_get_hex
  jjmp fl_print
fl_fnv:
  jadd j2, j3, j14
  jcall r_fnv
fl_print:
  jld j9, j14, 01BD8h
  jst j0, j9, 24
  jld j10, j14, 01BD0h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 01BD0h
  jjmp fl_line
fl_lines_done:
  jld j9, j14, 01BD0h
  jst j9, j14, 01A58h
fl_nofood:
  ; the tables: recipes <= the lines read (at most one per entry) + the meals still to eat (at most the entries);
  ; tokens <= recipes x (31 letters + a separator); a merge takes two tokens or more, so symbols <= half
  jld j1, j14, 01A58h
  jldi j10, 64
  jmul j1, j1, j10
  jst j1, j14, 01BA8h
  jldi j10, 1
  jshr j1, j1, j10
  jldi j10, 12
  jadd j1, j1, j10
  jst j1, j14, 01BB0h
  jld j1, j14, 01A70h
  jcall r_alloc
  jst j0, j14, 01A80h
  jld j1, j14, 01A58h
  jldi j10, 537
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01A88h
  jld j1, j14, 01A58h
  jldi j10, 64
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01A90h
  jld j1, j14, 01BA8h
  jldi j10, 3
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01A98h
  jld j1, j14, 01BA8h
  jldi j10, 3
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AA0h
  jld j1, j14, 01BA8h
  jldi j10, 3
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AC0h
  jld j1, j14, 01BB0h
  jldi j10, 32
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AA8h
  jld j1, j14, 01BB0h
  jldi j10, 3
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AB0h
  jld j1, j14, 01BB0h
  jldi j10, 48
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AD0h
  jld j1, j14, 01BB0h
  jldi j10, 48
  jmul j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AD8h
  jld j1, j14, 01BB0h
  jldi j10, 3
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AE0h
  ; the pairs' table: the smallest power of two at least twice the tokens (a slot: the pair + 1, its count)
  jldi j1, 1
  jld j2, j14, 01BA8h
  jldi j10, 1
  jshl j2, j2, j10
fl_phn:
  jsub j10, j1, j2
  jjnn j10, fl_phn_ok
  jldi j10, 1
  jshl j1, j1, j10
  jjmp fl_phn
fl_phn_ok:
  jst j1, j14, 01AC8h
  jldi j10, 4
  jshl j1, j1, j10
  jcall r_alloc
  jst j0, j14, 01AB8h
  ; the towers are the first bricks
  jld j9, j14, 01AD0h
  jldi j1, 2
  jstb j1, j9, 0
  jldi j1, 1
  jstb j1, j9, 1
  jldi j1, 6
  jstb j1, j9, 2
  jst j14, j9, 40
  jldi j1, 2
  jstb j1, j9, 48
  jldi j1, 3
  jstb j1, j9, 49
  jldi j1, 8
  jstb j1, j9, 50
  jst j14, j9, 88
  jldi j10, 2
  jst j10, j14, 01A48h
  jcall r_load_meals
  jcall r_load_bricks
  ; the order of the meals: a start and a stride coprime to the pantry, from its own generator (never twice)
  jld j1, j14, 01A58h
  jjz j1, fl_done
  jld j9, j14, 0238h
  jst j9, j14, 01CB8h
  jldi j10, -25033
  jshi j10, 079B9h
  jshi j10, 07F4Ah
  jshi j10, 07C15h
  jst j10, j14, 0238h
  jld j1, j14, 01A58h
  jcall r_randmod
  jst j0, j14, 01AF0h
  jld j1, j14, 01A58h
  jcall r_coprime
  jst j0, j14, 01AF8h
  jld j9, j14, 01CB8h
  jst j9, j14, 0238h
fl_done:
  jret
r_load_meals:                   ; "comidas": mark the eaten, the corpus of recipes, the slots' colours, the last meal
  jldi j11, 01E50h
  jldi j12, 7
  jcall r_open
  jld j9, j14, 04A8h
  jst j9, j14, 01AE8h
  jjn j9, lm_done
  jld j1, j14, 01A58h
  jjz j1, lm_done
  jld j11, j14, 01A88h
  jld j1, j14, 01A58h
  jldi j10, 537
  jmul j12, j1, j10
  jcall r_read_all
  jldi j10, 537
  jdiv j0, j0, j10
  jst j0, j14, 01BB8h
  jst j14, j14, 01BC8h
lm_line:
  jld j9, j14, 01BC8h
  jld j10, j14, 01BB8h
  jsub j10, j9, j10
  jjnn j10, lm_done
  jldi j10, 537
  jmul j9, j9, j10
  jld j10, j14, 01A88h
  jadd j9, j9, j10
  jst j9, j14, 01BD0h
  jldi j10, 5
  jadd j1, j9, j10
  jldi j2, 16
  jcall r_get_hex
  jst j0, j14, 01BD8h
  ; eaten: the entry with that print
  jst j14, j14, 01BE0h
lm_find:
  jld j9, j14, 01BE0h
  jld j10, j14, 01A58h
  jsub j10, j9, j10
  jjnn j10, lm_rec
  jldi j10, 40
  jmul j9, j9, j10
  jld j10, j14, 01A68h
  jadd j9, j9, j10
  jld j1, j9, 24
  jld j2, j14, 01BD8h
  jsub j1, j1, j2
  jjnz j1, lm_find_next
  jldi j1, 1
  jst j1, j9, 32
lm_find_next:
  jld j10, j14, 01BE0h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 01BE0h
  jjmp lm_find
lm_rec:
  jld j9, j14, 01BD0h
  jldi j10, 22
  jadd j1, j9, j10
  jldi j3, 01DC0h
  jcall r_get_rec
  jldb j1, j14, 01DC0h
  jjz j1, b_lm_next
  jldi j3, 01DC0h
  jldi j4, 01D40h
  jld j10, j3, 0
  jst j10, j4, 0
  jld j10, j3, 8
  jst j10, j4, 8
  jld j10, j3, 16
  jst j10, j4, 16
  jld j10, j3, 24
  jst j10, j4, 24
  jld j4, j14, 01B50h
  jldi j10, 5
  jshl j4, j4, j10
  jld j10, j14, 01A90h
  jadd j4, j4, j10
  jld j10, j3, 0
  jst j10, j4, 0
  jld j10, j3, 8
  jst j10, j4, 8
  jld j10, j3, 16
  jst j10, j4, 16
  jld j10, j3, 24
  jst j10, j4, 24
  jld j10, j14, 01B50h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 01B50h
  ; the slot it fed takes the meal's first colour
  jld j9, j14, 01BD0h
  jldb j1, j9, 76
  jldi j10, 48
  jsub j1, j1, j10
  jjn j1, b_lm_next
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, b_lm_next
  jst j1, j14, 01BE0h
  jldi j10, 78
  jadd j1, j9, j10
  jldi j2, 2
  jcall r_get_num
  jjz j0, b_lm_next
  jld j9, j14, 01BD0h
  jldi j10, 81
  jadd j1, j9, j10
  jldi j2, 6
  jcall r_get_hex
  jld j1, j14, 01BE0h
  jcall r_set_hue
b_lm_next:
  jld j10, j14, 01BC8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 01BC8h
  jjmp lm_line
lm_done:
  jldb j1, j14, 01D40h
  jst j1, j14, 01A30h
  jret
r_set_hue:                      ; slot j1 takes the colour j0 = 0xRRGGBB (uses j2, j3, j10)
  jldi j10, 24
  jmul j2, j1, j10
  jldi j10, 01840h
  jadd j2, j2, j10
  jldi j10, 16
  jshr j3, j0, j10
  jldi j10, 255
  jand j3, j3, j10
  jst j3, j2, 0
  jldi j10, 8
  jshr j3, j0, j10
  jldi j10, 255
  jand j3, j3, j10
  jst j3, j2, 8
  jldi j10, 255
  jand j3, j0, j10
  jst j3, j2, 16
  jret
r_load_bricks:                  ; "ladrillos": the learned bricks after the towers
  jldi j11, 01E60h
  jldi j12, 9
  jcall r_open
  jld j9, j14, 04A8h
  jjn j9, b_lb_done
  jldi j10, 5
  jldi j11, 01EA0h
  jldi j12, 18
  jcall r_file
  jldi j10, 18
  jsub j10, j13, j10
  jjnz j10, lb_close
  jldi j1, 01EABh
  jldi j2, 6
  jcall r_get_num
  jst j0, j14, 01BC8h
lb_line:
  jld j9, j14, 01BC8h
  jjz j9, lb_close
  jld j9, j14, 01A48h
  jld j10, j14, 01BB0h
  jsub j10, j9, j10
  jjnn j10, lb_close
  jldi j10, 5
  jldi j11, 01E70h
  jldi j12, 40
  jcall r_file
  jldi j10, 40
  jsub j10, j13, j10
  jjnz j10, lb_close
  jld j3, j14, 01A48h
  jldi j10, 48
