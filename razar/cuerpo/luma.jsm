v_r_eff:                          ; TI's limbs as its model says them (the motion), and the list of distinct ones
  jld j9, j14, 02380h
  jst j14, j9, 64
  jst j14, j14, 02338h
v_ef_lap:
  jld j9, j14, 02380h
  jld j1, j14, 02338h
  jld j2, j9, 48
  jsub j10, j1, j2
  jjnn j10, v_ef_done
