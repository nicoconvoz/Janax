  jadd j1, j4, j14
  jjmp pn_lap
pn_done:
  jret
r_put_rec:                      ; j1 = a recipe, j3 = where: its 31 letters as digits, '.' where it has none
  jldb j2, j1, 0
  jldi j4, 0
pr_lap:
  jldi j5, 46
  jsub j10, j4, j2
  jjnn j10, pr_put
