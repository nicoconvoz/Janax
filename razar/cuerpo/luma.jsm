v_r_habitats:                     ; at the start, with her memory: every creature's mode, the strata sized by how
                                ; many live in each (as the world was sized by how many there are), written down
  jst j14, j14, 02698h
  jst j14, j14, 026A0h
  jst j14, j14, 026A8h
  jst j14, j14, 026D0h
  jld j1, j14, 02668h
  jjz j1, v_hb_equal
