  jld j1, j14, 02748h
  jst j1, j14, 02F0h
  jcall r_fit_cost
  jret
v_size:                         ; TI's side from what it learned: isqrt(B^2 + B bits), at most 2B (each bit learned
                                ; adds a row of B cells to its area; criterion)
  jld j9, j14, 02380h
  jld j1, j14, 02230h
  jmul j2, j1, j1
  jld j3, j9, 304
  jmul j3, j3, j1
