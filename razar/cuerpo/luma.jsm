  jmul j5, j5, j4
  jld j6, j14, 02340h
  jdiv j5, j5, j6
  jld j6, j14, 02230h
  jldi j10, 131072
  jmul j6, j6, j10
  jsub j10, j5, j6
  jjnn j10, v_hb_min0
  jadd j5, j6, j14
v_hb_min0:
  jld j3, j14, 026B0h
  jadd j3, j3, j5
  jst j3, j14, 026B8h
  jld j5, j14, 026A0h
  jmul j5, j5, j4
  jld j6, j14, 02340h
  jdiv j5, j5, j6
  jld j6, j14, 02230h
  jldi j10, 131072
  jmul j6, j6, j10
  jsub j10, j5, j6
  jjnn j10, v_hb_min1
