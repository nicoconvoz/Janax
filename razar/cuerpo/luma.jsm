  jadd j3, j3, j5
  jst j3, j14, 026C0h
  jldi j3, 0C8h
  jshi j3, 0
  jst j3, j14, 026C8h
  jldi j10, 1
  jst j10, j14, 026D0h
  ; the bands as (top, bottom): sky BY1..BY2, land BY2..BY3, low BY3..H; r_in_band reads BY1 + 8 mode
  ; written down: "vida-habitat", every creature's mode
  jldi j11, 049E0h
  jldi j12, 12
  jcall v_r_open
  jld j9, j14, 02328h
  jjn j9, v_hb_done
  jst j14, j14, 02338h
v_hb_w:
  jld j1, j14, 02338h
  jld j2, j14, 02228h
