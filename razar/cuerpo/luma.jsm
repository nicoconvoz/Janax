  jld j2, j14, 02228h
  jsub j10, j1, j2
  jjnn j10, v_vsh_ret
  jldi j10, 384
  jmul j9, j1, j10
  jld j10, j14, 02258h
  jadd j9, j9, j10
  jld j1, j9, 8
  jldi j10, 2
  jsub j1, j1, j10
  jjnz j1, v_vsh_next
  jld j1, j9, 304
  jjz j1, v_vsh_next
  jld j2, j14, 02320h
