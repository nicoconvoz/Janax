  jadd j1, j10, j14
  jst j1, j14, 04B0h
tr_map_next:
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jjmp tr_map
tr_map_found:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j3, j1, j10
  jldi j10, 0800h
  jadd j3, j3, j10
  jldi j10, 192
  jadd j3, j3, j10
  jld j2, j14, 04B0h
  jldi j4, 01400h
  jcall r_apply
  jldb j1, j14, 01400h
  jldi j10, 32
  jsub j10, j1, j10
  jjnn j10, tr_walk
  jldi j1, 01400h
  jcall r_hash
  jcall r_tried
  jjz j0, tr_judge
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, tr_walk
  jjmp tr_none
tr_judge:
  jld j1, j14, 0498h
  jst j1, j14, 0388h
  jcall r_judge
  jret
tr_none:
  jldi j0, 0
  jret
tr_jump:                        ; a round of longer jumps: RADIUS random edits on one form, BUDGET of them
  jld j9, j14, 0298h
  jjz j9, tr_none
  jldi j10, 1
  jsub j9, j9, j10
  jst j9, j14, 0298h
  jldi j1, 8
  jcall r_randmod
  jst j0, j14, 0498h
  jldi j10, 8
  jst j10, j14, 0490h
tr_pick:                        ; the first form from there that may mutate
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjz j10, tr_picked
  jld j1, j14, 0498h
  jldi j10, 1
  jadd j1, j1, j10
  jldi j10, 7
  jand j1, j1, j10
  jst j1, j14, 0498h
  jld j10, j14, 0490h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 0490h
  jjz j10, tr_none
  jjmp tr_pick
tr_picked:
