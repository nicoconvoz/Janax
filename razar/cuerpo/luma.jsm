  jldi j10, 5
  jsub j10, j4, j10
  jjz j10, grow_pen
  jldi j10, 7
  jsub j10, j4, j10
  jjz j10, grow_heart
  jldi j10, 6
  jsub j10, j4, j10
  jjz j10, grow_head
  ; any other tissue: here it has a word that only carries what her cells say
  jldi j10, 3
  jshl j4, j4, j10
  jldi j7, 015Eh
  jshi j7, 01A40h
  jadd j7, j7, j4
  jld j1, j7, 0
  jcall r_talk
  jld j4, j14, 0368h
