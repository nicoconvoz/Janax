v_r_draw:                         ; every body that is here (later ones in front), on the torus
  jst j14, j14, 02338h
v_dr_lap:
  jld j1, j14, 02338h
  jld j2, j14, 02228h
  jsub j10, j1, j2
  jjnn j10, v_dr_done
  jldi j10, 320
  jmul j9, j1, j10
  jld j10, j14, 02258h
  jadd j9, j9, j10
  jld j10, j9, 8
  jjz j10, v_dr_next
  jld j3, j9, 16
  jldi j10, 8
  jsar j3, j3, j10
  jld j4, j9, 24
  jsar j4, j4, j10
  jld j1, j9, 120
  jld j2, j9, 128
  jldi j8, 0157h
  jshi j8, 03EA0h
v_dr_p:
