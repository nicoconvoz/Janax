  jld j10, j14, 02338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02338h
  jjmp v_hb_cr
v_hb_equal:                       ; without her memory the modes come at each arrival: equal strata (criterion)
  jldi j10, 1
  jst j10, j14, 02698h
  jldi j10, 1
  jst j10, j14, 026A0h
  jldi j10, 1
  jst j10, j14, 026A8h
v_hb_sized:
  ; the strata under the universe: each its share of the rows by how many live there (at least 2 bodies tall)
  jld j1, j14, 02698h
  jld j2, j14, 026A0h
  jadd j1, j1, j2
  jld j2, j14, 026A8h
  jadd j1, j1, j2
