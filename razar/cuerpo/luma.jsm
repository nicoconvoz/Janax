  jld j10, j14, 0218h
  jadd j10, j10, j0
  jst j10, j14, 0218h
  jld j10, j14, 0448h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0448h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, step_form
  jret
r_anchor:                       ; the form j9 -> j3, j4 = where its home 0 is drawn: OX - CX*MX >> 8 (uses j8, j10)
  jld j3, j9, 0
  jld j8, j9, 168
  jld j10, j9, 64
  jmul j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j3, j3, j8
  jld j4, j9, 8
  jld j8, j9, 240
  jld j10, j9, 72
  jmul j8, j8, j10
  jldi j10, 8
  jsar j8, j8, j10
  jsub j4, j4, j8
  jret
r_brush:                        ; a square of DT x DT cells centred on the cell j1, j2 (uses j0, j10, j11, BX, BY)
  jld j10, j14, 04C8h
  jldi j11, 1
  jsar j10, j10, j11
  jsub j1, j1, j10
  jsub j2, j2, j10
  jst j1, j14, 04D0h
  jst j2, j14, 04D8h
  jld j10, j14, 04C8h
  jst j10, j14, 04E0h
brush_row:
  jld j1, j14, 04D0h
  jldi j0, 0
brush_cell:
  jcall r_plot
  jldi j10, 1
  jadd j1, j1, j10
  jadd j0, j0, j10
  jld j10, j14, 04C8h
  jsub j10, j0, j10
  jjn j10, brush_cell
  jld j2, j14, 04D8h
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 04D8h
  jld j10, j14, 04E0h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 04E0h
  jjnz j10, brush_row
  jret
r_fill:                         ; the background, 24 bytes (8 cells) at a time
  jldi j1, 0156h
  jshi j1, 07F0h
  jldi j2, 0156h
  jshi j2, 0C370h
  jldi j3, 04E1Fh
  jshi j3, 05A4Eh
  jshi j3, 01F5Ah
  jshi j3, 04E1Fh
  jldi j4, 01F5Ah
  jshi j4, 04E1Fh
  jshi j4, 05A4Eh
  jshi j4, 01F5Ah
  jldi j5, 05A4Eh
  jshi j5, 01F5Ah
  jshi j5, 04E1Fh
  jshi j5, 05A4Eh
  jldi j6, 24
fill_lap:
  jst j3, j1, 0
  jst j4, j1, 8
  jst j5, j1, 16
  jadd j1, j1, j6
  jsub j7, j2, j1
  jjnz j7, fill_lap
  jret
r_plot:                         ; the cell j1, j2 in the colour PR PG PB, on the screen only (uses j10, j11)
  jjn j1, plot_out
  jjn j2, plot_out
  jldi j10, 160
  jsub j11, j1, j10
  jjnn j11, plot_out
  jldi j11, 100
  jsub j11, j2, j11
  jjnn j11, plot_out
  jmul j11, j2, j10
  jadd j11, j11, j1
  jldi j10, 3
  jmul j11, j11, j10
