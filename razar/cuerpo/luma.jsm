  jsub j10, j2, j7
  jjnn j10, ap_meal3
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 04B8h
  jldi j3, 01D40h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 04B8h
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
