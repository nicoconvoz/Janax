  jshl j2, j2, j10
  jor j1, j1, j2
  jldi j10, 04542h
  jshi j10, 0554Eh
  jsub j10, j1, j10
  jjnz j10, v_bd_bad
  jldb j1, j9, 4
  jldi j10, 3
  jsub j10, j1, j10
  jjnz j10, v_bd_bad
  ; the bones (42 bytes each, as NubeViva.cs reads them) are skipped; the levels' count, then level 0's header
  jldb j1, j9, 9
  jldb j2, j9, 10
  jldi j10, 8
  jshl j2, j2, j10
  jor j1, j1, j2
  jldi j10, 42
  jmul j1, j1, j10
