  jadd j1, j1, j10
v_dc_flap:
  jjz j4, v_dc_rest
  jldb j2, j1, 0
  jldi j10, 48
  jsub j2, j2, j10
  jjn j2, v_dc_pad
  jldi j10, 10
  jsub j10, j2, j10
  jjnn j10, v_dc_pad
  jldi j10, 10
  jmul j0, j0, j10
  jadd j0, j0, j2
  jldi j10, 1
  jadd j1, j1, j10
  jsub j4, j4, j10
  jjmp v_dc_flap
v_dc_pad:
  jjz j4, v_dc_rest
  jldi j10, 10
  jmul j0, j0, j10
  jldi j10, 1
  jsub j4, j4, j10
  jjmp v_dc_pad
v_dc_rest:                        ; more decimals than five: skipped (the rest of this token only)
  jldb j2, j1, 0
  jldi j10, 33
  jsub j10, j2, j10
  jjn j10, v_dc_sign
  jldi j10, 1
  jadd j1, j1, j10
  jjmp v_dc_rest
v_dc_sign:
  jjz j3, v_dc_done
  jsub j0, j14, j0
v_dc_done:
  jret
v_r_body:                         ; NUBB -> TI's body: its finest level fitted relative to its own size into B x B,
                                ; a particle per cell where at least half is particle, its mean colour -> j0 = 1
  jld j9, j14, 02290h
  jldb j1, j9, 0
  jldb j2, j9, 1
  jldi j10, 8
  jshl j2, j2, j10
  jor j1, j1, j2
  jldb j2, j9, 2
  jldi j10, 16
  jshl j2, j2, j10
  jor j1, j1, j2
  jldb j2, j9, 3
