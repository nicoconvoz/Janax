  jldi j10, 48
  jsub j1, j1, j10
  jjn j1, fr_p_done
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, fr_p_done
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 216
  jldi j6, 015Eh
  jshi j6, 0
  jld j9, j6, 208
  jldi j10, 78
  jadd j1, j9, j10
  jldi j2, 2
  jcall r_get_num
  jjz j0, fr_p_done
  jadd j1, j0, j14
  jcall r_randmod
  jldi j10, 7
  jmul j0, j0, j10
  jldi j10, 81
  jadd j0, j0, j10
  jldi j6, 015Eh
  jshi j6, 0
  jld j9, j6, 208
  jadd j1, j9, j0
  jldi j2, 6
