  jldi j10, 02Dh
  jsub j10, j3, j10
  jjz j10, k_show
  jldi j10, 02Eh
  jsub j10, j3, j10
  jjz j10, k_hide
  jldi j10, 021h
  jsub j10, j3, j10
  jjz j10, b_k_top
  jldi j10, 022h
  jsub j10, j3, j10
