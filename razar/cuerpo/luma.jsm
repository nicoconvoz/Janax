  jsub j11, j5, j10
  jjn j11, v_dr_x_hi
  jadd j5, j11, j14
v_dr_x_hi:
  jjn j5, v_dr_p_next
  jldi j10, 320
  jsub j11, j5, j10
  jjnn j11, v_dr_p_next
  jld j6, j1, 24
  jadd j6, j6, j4
  jldi j10, 128
  jadd j6, j6, j10
  jldi j10, 8
  jsar j6, j6, j10
  jjnn j6, v_dr_y_lo
  jldi j10, 200
  jadd j6, j6, j10
v_dr_y_lo:
  jldi j10, 200
  jsub j11, j6, j10
  jjn j11, v_dr_y_hi
  jadd j6, j11, j14
v_dr_y_hi:
  jjn j6, v_dr_p_next
  jldi j10, 200
  jsub j11, j6, j10
  jjnn j11, v_dr_p_next
  jldi j10, 640
  jmul j6, j6, j10
  jadd j6, j6, j5
  jldi j10, 320
  jadd j6, j6, j10
  jldi j10, 3
