  jld j10, j1, 32
  jadd j10, j10, j2
  jst j10, j1, 32
  jldi j10, 3
  jadd j8, j8, j10
v_bd_cell_next:
  jadd j6, j6, j13
  jadd j5, j5, j13
  jld j10, j14, 023E0h
  jsub j10, j5, j10
  jjnz j10, v_bd_cell
  jld j10, j14, 02338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02338h
  jjmp v_bd_row
v_bd_rows_done:
  ; the particles: home at the cell's centre relative to the body's (x256), born FALL_B bodies above it
  jld j9, j14, 02380h
  jld j2, j9, 120
  jld j1, j14, 022B8h
  jldi j3, 0
  jldi j4, 0
  jldi j0, 0
  jld j13, j14, 02230h
v_bd_prow:
  jldi j5, 0
v_bd_pcell:
  jld j6, j1, 0
  jjz j6, v_bd_pnext
  jld j7, j1, 8
  jadd j8, j7, j7
  jsub j8, j8, j6
  jjn j8, v_bd_pnext
  jld j8, j1, 16
  jdiv j8, j8, j7
  jld j11, j1, 24
  jdiv j11, j11, j7
  jldi j10, 8
  jshl j11, j11, j10
  jor j8, j8, j11
  jld j11, j1, 32
  jdiv j11, j11, j7
  jldi j10, 16
  jshl j11, j11, j10
  jor j8, j8, j11
  jst j8, j2, 32
  jldi j10, 8
  jshl j11, j5, j10
  jldi j10, 128
  jadd j11, j11, j10
  jldi j10, 7
  jshl j10, j13, j10
  jsub j11, j11, j10
  jst j11, j2, 0
  jst j11, j2, 16
  jldi j10, 8
  jshl j11, j3, j10
  jldi j10, 128
  jadd j11, j11, j10
  jldi j10, 7
  jshl j10, j13, j10
  jsub j11, j11, j10
  jst j11, j2, 8
  jldi j10, 1024
