  jld j9, j14, 02380h
  jld j1, j14, 022A0h
  jld j2, j9, 56
  jldi j10, 1
  jadd j2, j2, j10
  jld j3, j9, 80
  jld j4, j9, 48
  jcall v_r_dl
  jld j1, j14, 02398h
  jsub j10, j0, j1
  jjnn j10, v_ow_next
  jst j0, j14, 02398h
  jld j1, j14, 02338h
  jst j1, j14, 023A8h
v_ow_next:
