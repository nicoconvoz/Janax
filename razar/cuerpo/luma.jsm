  jjn j3, v_vcm_x4
  jadd j2, j3, j14
v_vcm_x4:
  jst j2, j14, 02700h
  ; up and down: towards the news, but the view never leaves the world (the strata stay in place)
  jld j1, j14, 02720h
  jld j2, j14, 02708h
  jsub j1, j1, j2
  jldi j10, 3
  jsar j1, j1, j10
  jadd j2, j2, j1
  jldi j3, 064h
  jshi j3, 0
  jld j10, j14, 02710h
  jdiv j3, j3, j10
  jsub j10, j2, j3
  jjnn j10, v_vcm_y1
  jadd j2, j3, j14
