  jldi j10, 024h
  jsub j10, j3, j10
  jjz j10, k_first
  jldi j10, 023h
  jsub j10, j3, j10
  jjz j10, k_last
  jldi j10, 042h
  jsub j10, j3, j10
  jjz j10, k_begin
  jldi j10, 045h
  jsub j10, j3, j10
  jjz j10, k_end
  jldi j10, 044h
  jsub j10, j3, j10
  jjz j10, k_disable
  jldi j10, 0Dh
  jsub j10, j3, j10
  jjz j10, k_enable
  jret
k_mirror_on:
  jldi j10, 1
  jst j10, j9, 104
  jcall r_set_transform
  jret
k_mirror_off:
  jldi j10, 0
  jst j10, j9, 104
  jcall r_set_transform
  jret
k_flip_off:
  jldi j10, 0
  jst j10, j9, 112
  jcall r_set_transform
  jret
k_flip_on:
  jldi j10, 1
  jst j10, j9, 112
  jcall r_set_transform
  jret
b_k_open:
  jldi j10, 0
  jst j10, j9, 80
  jcall r_set_transform
  jret
k_close:
  jldi j10, 1
  jst j10, j9, 80
  jcall r_set_transform
  jret
k_max:                          ; one step, never past double or half
  jld j10, j9, 88
  jldi j11, 1
  jadd j10, j10, j11
  jldi j11, 2
  jsub j11, j10, j11
  jjz j11, clamp_5
  jst j10, j9, 88
clamp_5:
  jcall r_set_transform
  jret
k_min:                          ; one step, never past double or half
  jld j10, j9, 88
  jldi j11, -1
  jadd j10, j10, j11
  jldi j11, -2
  jsub j11, j10, j11
  jjz j11, clamp_6
  jst j10, j9, 88
clamp_6:
  jcall r_set_transform
  jret
k_width:                          ; one step, never past double or half
  jld j10, j9, 96
  jldi j11, 1
  jadd j10, j10, j11
  jldi j11, 2
  jsub j11, j10, j11
  jjz j11, clamp_7
  jst j10, j9, 96
clamp_7:
  jcall r_set_transform
  jret
k_height:                          ; one step, never past double or half
  jld j10, j9, 96
  jldi j11, -1
  jadd j10, j10, j11
  jldi j11, -2
  jsub j11, j10, j11
  jjz j11, clamp_8
  jst j10, j9, 96
clamp_8:
  jcall r_set_transform
  jret
k_show:
  jst j14, j9, 120
  jret
k_hide:
  jldi j10, 1
  jst j10, j9, 120
  jret
k_first:
  jst j14, j14, 0270h
  jret
k_last:
  jldi j10, 7
  jst j10, j14, 0270h
  jret
k_begin:                        ; it grows again from its seed
  jst j14, j9, 48
  jldi j10, 9
  jst j10, j9, 56
  jret
k_end:                          ; it is grown at once
  jldb j10, j9, 192
  jst j10, j9, 48
  jret
k_disable:
  jldi j10, 1
  jst j10, j9, 128
  jjmp k_able
k_enable:
  jst j14, j9, 128
k_able:                         ; its colour, and the walk over the forms that may mutate
  jcall r_colour
  jcall r_new_walk
  jret
b_k_top:                          ; drawn last
  jld j0, j14, 0270h
  jldi j1, 0
k_top_find:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01340h
  jadd j2, j2, j10
  jld j3, j2, 0
  jsub j3, j3, j0
  jjz j3, k_top_shift
  jldi j10, 1
  jadd j1, j1, j10
  jjmp k_top_find
k_top_shift:
  jldi j10, 7
  jsub j10, j1, j10
  jjz j10, k_top_put
  jld j3, j2, 8
  jst j3, j2, 0
  jldi j10, 8
  jadd j2, j2, j10
  jldi j10, 1
  jadd j1, j1, j10
  jjmp k_top_shift
k_top_put:
  jst j0, j2, 0
  jret
k_bottom:                       ; drawn first
  jld j0, j14, 0270h
  jldi j1, 7
k_bottom_find:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01340h
  jadd j2, j2, j10
  jld j3, j2, 0
  jsub j3, j3, j0
  jjz j3, k_bottom_shift
  jldi j10, 1
  jsub j1, j1, j10
  jjmp k_bottom_find
k_bottom_shift:
  jjz j1, k_bottom_put
  jldi j10, 8
  jsub j5, j2, j10
  jld j3, j5, 0
  jst j3, j2, 0
  jadd j2, j5, j14
  jldi j10, 1
  jsub j1, j1, j10
  jjmp k_bottom_shift
k_bottom_put:
  jst j0, j2, 0
  jret
r_gesture:                      ; a gesture: something changed; if it was calm, a new round of longer jumps
  jldi j10, 1
  jst j10, j14, 0210h
  jld j9, j14, 0230h
  jjnz j9, g_ret
  jld j9, j14, 02A0h
  jjz j9, g_ret
