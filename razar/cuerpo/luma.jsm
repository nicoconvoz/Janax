v_r_open:                         ; j11 = a label, j12 = its bytes -> FH = the handle (or -1)
  jldi j10, 4
  jcall v_r_tocar
  jst j13, j14, 02328h
  jret
v_r_file:                         ; j10 = request (5 read, 6 write, 7 close, 38 go to), FH = the handle, j11, j12 -> j13
  jldi j9, 32
  jld j8, j14, 02328h
  jshl j8, j8, j9
  jor j10, j10, j8
