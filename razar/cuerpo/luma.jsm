  jsub j13, j12, j3
  jjn j13, jd_okeep
  jadd j3, j12, j14
jd_okeep:
  jld j1, j14, 03A8h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j1, j9, 24
  jldb j2, j9, 192
  jcall r_worth
  jld j10, j14, 03E0h
  jadd j10, j10, j0
  jst j10, j14, 03E0h
jd_others_n:
  jld j10, j14, 03A8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 03A8h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, jd_others
  jcall r_read_cand              ; the best reading with the candidate in the parent's place
  jld j10, j14, 03E0h
  jadd j10, j10, j0
  jst j10, j14, 03E0h
  jld j9, j14, 03E0h
  jld j10, j14, 02C8h
  jsub j9, j10, j9
  jld j10, j14, 01D18h
  jsub j9, j9, j10
  jjn j9, jd_win
  ; it lost: why
  jldi j9, 5
  jld j1, j14, 03B0h
  jld j2, j14, 03C8h
  jsub j1, j2, j1
  jjnn j1, jd_r1
  jldi j9, 4
jd_r1:
  jldi j8, 0
  jld j1, j14, 03C0h
  jld j2, j14, 03D8h
  jsub j1, j1, j2
  jjnn j1, jd_r2
  jldi j9, 3
  jldi j8, 1
jd_r2:
  jld j1, j14, 03B8h
  jld j2, j14, 03D0h
  jsub j1, j1, j2
  jjnn j1, jd_r3
  jldi j9, 2
  jjz j8, jd_r3
  jldi j9, 1
jd_r3:
  jst j9, j14, 0400h
  jldi j10, 01400h
  jst j10, j14, 03F0h
  jld j9, j14, 0390h
  jldi j10, 192
  jadd j9, j9, j10
  jst j9, j14, 03F8h
  jld j9, j14, 03E0h
  jst j9, j14, 0408h
  jld j9, j14, 02C8h
  jst j9, j14, 0410h
  jcall r_archive
  ; its ghost, for this frame
  jld j1, j14, 02D8h
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, jd_noghost
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01380h
  jadd j2, j2, j10
  jld j10, j14, 0388h
  jst j10, j2, 0
  jldi j10, 9
  jshl j2, j1, j10
  jldi j10, 0
  jshi j10, 0F600h
  jadd j2, j2, j10
  jldi j3, 0
  jshi j3, 0F400h
  jldi j4, 50
jd_ghost:
  jld j5, j3, 0
  jst j5, j2, 0
  jldi j10, 8
  jadd j2, j2, j10
  jadd j3, j3, j10
  jldi j10, 1
  jsub j4, j4, j10
  jjnz j4, jd_ghost
  jld j10, j14, 02D8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02D8h
jd_noghost:
  jldi j0, 1
  jret
jd_win:                         ; it won: the parent goes to the archive, the form transforms
  jcall r_linaje
  jst j14, j14, 0400h
  jld j9, j14, 0390h
  jldi j10, 192
  jadd j9, j9, j10
  jst j9, j14, 03F0h
  jldi j10, 01400h
  jst j10, j14, 03F8h
  jld j9, j14, 02C8h
  jst j9, j14, 0408h
  jld j9, j14, 03E0h
  jst j9, j14, 0410h
  jcall r_archive
  jld j9, j14, 0390h
  jld j10, j14, 01400h
  jst j10, j9, 192
  jld j10, j14, 01408h
  jst j10, j9, 200
  jld j10, j14, 01410h
  jst j10, j9, 208
  jld j10, j14, 01418h
  jst j10, j9, 216
  jld j1, j14, 0388h
  jcall r_regrow
  jld j9, j14, 0488h
  jldb j10, j9, 192
  jst j10, j9, 48
  jcall r_recompute
  jld j10, j14, 0278h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0278h
  jld j10, j14, 0280h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0280h
  jld j10, j14, 0288h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0288h
  jldi j10, 1
  jst j10, j14, 0290h
  jldi j10, 1
  jst j10, j14, 0210h
  jcall r_meal_won
  jcall r_clear_hash
  jcall r_new_walk
  jcall r_save_forms
  jldi j0, 2
  jret
; ---- the mutations of a recipe (form j1, or -1 for the meal being digested), op j2, from the recipe j3 into j4.
;      The kind (WKIND for the walks, AKIND set by the caller of r_apply_k) says which groups are on:
;      0 all (a full walk), 1 what a meal brought (the meal's ops and the new bricks), 2 digesting (no meal ops).
;      Groups, in this order: the meal (kinds 0, 1: its recipe in place of this one (1), this one's first c
;      letters and the meal's rest (n), the meal's first c and this one's rest (m)); the new bricks (kind 1:
;      NNEW (n+1)); every brick (kinds 0, 2: NB (n+1); the towers 16, 38 first, then the learned ones);
;      change a letter (8n), insert one (15(n+1): any letter of the organ, its senses and its eye too), cross with each form (8 n: its first c letters and the
;      form's rest; with itself it gives itself, already tried), delete one (n, if n > 1).
r_count:                        ; j1 = n -> j0 = how many ops of the walk's kind
  jld j2, j14, 01A38h
r_count_k:                      ; j1 = n, j2 = kind -> j0 (uses j3, j10, j11)
  jldi j0, 0
  jldi j10, 2
  jsub j10, j2, j10
  jjz j10, cnt_nomeal
  jld j3, j14, 01A30h
  jjz j3, cnt_nomeal
  jadd j0, j0, j3
  jadd j0, j0, j1
  jldi j10, 1
  jadd j0, j0, j10
cnt_nomeal:
  jldi j10, 1
  jadd j11, j1, j10
  jsub j10, j2, j10
  jjnz j10, cnt_full
  jld j3, j14, 01A50h
  jmul j3, j3, j11
  jadd j0, j0, j3
  jret
cnt_full:
  jld j3, j14, 01A48h
  jmul j3, j3, j11
  jadd j0, j0, j3
  jldi j10, 16
  jmul j3, j1, j10
  jadd j0, j0, j3
  jldi j10, 15
  jmul j3, j11, j10
  jadd j0, j0, j3
  jldi j10, 1
  jsub j10, j1, j10
  jjz j10, cnt_one
  jadd j0, j0, j1
cnt_one:
  jret
r_cat:                          ; append the letters [j1, j2) of the recipe j3 to the recipe ADST (uses j4..j6, j10)
  jld j4, j14, 0430h
cat_lap:
  jsub j10, j1, j2
  jjnn j10, cat_done
  jadd j5, j3, j1
  jldb j5, j5, 1
  jldb j6, j4, 0
  jldi j10, 46
  jsub j10, j6, j10
  jjnn j10, cat_done
  jadd j10, j4, j6
  jstb j5, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jldi j10, 1
  jadd j1, j1, j10
  jjmp cat_lap
cat_done:
  jret
r_app:                          ; append the letter j1 to the recipe ADST (uses j4, j6, j10)
  jld j4, j14, 0430h
  jldb j6, j4, 0
  jadd j10, j4, j6
  jstb j1, j10, 1
  jldi j10, 1
  jadd j6, j6, j10
  jstb j6, j4, 0
  jret
r_apply:                        ; j1 form, j2 op, j3 from, j4 into: the walk's kind
  jld j5, j14, 01A38h
  jst j5, j14, 01A40h
r_apply_k:
  jst j1, j14, 0420h
  jst j2, j14, 0440h
  jst j3, j14, 0428h
  jst j4, j14, 0430h
  jstb j14, j4, 0
  jldb j5, j3, 0
  jst j5, j14, 0438h
  jld j6, j14, 01A40h
  jldi j10, 2
  jsub j10, j6, j10
  jjz j10, ap_bricks
  jld j7, j14, 01A30h
  jjz j7, ap_newb
  ; the meal
  jjnz j2, ap_meal1
  jld j3, j14, 0428h
  jldi j1, 01D40h
  jld j10, j1, 0
  jst j10, j4, 0
  jld j10, j1, 8
  jst j10, j4, 8
  jld j10, j1, 16
  jst j10, j4, 16
  jld j10, j1, 24
  jst j10, j4, 24
  jret
ap_meal1:
  jldi j10, 1
  jsub j2, j2, j10
  jsub j10, j2, j5
  jjnn j10, ap_meal2
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 04B8h
  jld j3, j14, 0428h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 04B8h
  jld j2, j14, 01A30h
  jldi j3, 01D40h
  jcall r_cat
  jret
ap_meal2:
  jsub j2, j2, j5
  jsub j10, j2, j7
  jjnn j10, ap_meal3
  jldi j10, 1
  jadd j2, j2, j10
  jst j2, j14, 04B8h
  jldi j3, 01D40h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 04B8h
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
ap_meal3:
  jsub j2, j2, j7
ap_newb:
  jld j6, j14, 01A40h
  jldi j10, 1
  jsub j10, j6, j10
  jjnz j10, ap_bricks
  ; a new brick: NEWL[op / (n+1)] at op % (n+1)
  jldi j10, 1
  jadd j8, j5, j10
  jdiv j7, j2, j8
  jmul j9, j7, j8
  jsub j9, j2, j9
  jld j10, j14, 01A50h
  jsub j10, j7, j10
  jjnn j10, ap_none
  jldi j10, 3
  jshl j7, j7, j10
  jld j10, j14, 01AE0h
  jadd j7, j7, j10
  jld j7, j7, 0
  jjmp ap_brick_at
ap_bricks:
  jldi j10, 1
  jadd j8, j5, j10
  jld j7, j14, 01A48h
  jmul j9, j7, j8
  jsub j10, j2, j9
  jjnn j10, ap_change
  jdiv j7, j2, j8
  jmul j9, j7, j8
  jsub j9, j2, j9
ap_brick_at:                    ; brick j7 at position j9
  jst j9, j14, 04B8h
  jldi j10, 48
  jmul j7, j7, j10
  jld j10, j14, 01AD0h
  jadd j7, j7, j10
  jst j7, j14, 0440h
  jld j3, j14, 0428h
  jldi j1, 0
  jld j2, j14, 04B8h
  jcall r_cat
  jld j3, j14, 0440h
  jldi j1, 0
  jldb j2, j3, 0
  jcall r_cat
  jld j1, j14, 04B8h
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
ap_change:
  jsub j2, j2, j9
  jldi j10, 8
  jmul j6, j5, j10
  jsub j10, j2, j6
  jjnn j10, ap_insert
  jld j3, j14, 0428h
  jld j4, j14, 0430h
  jld j10, j3, 0
  jst j10, j4, 0
  jld j10, j3, 8
  jst j10, j4, 8
  jld j10, j3, 16
  jst j10, j4, 16
  jld j10, j3, 24
  jst j10, j4, 24
  jld j10, j3, 32
  jst j10, j4, 32
  jld j10, j3, 40
  jst j10, j4, 40
  jldi j10, 3
  jshr j7, j2, j10
  jldi j10, 7
  jand j8, j2, j10
  jldi j10, 1
  jadd j8, j8, j10
  jadd j9, j3, j7
  jldb j9, j9, 1
  jsub j10, j8, j9
  jjn j10, ap_change_put
  jldi j10, 1
  jadd j8, j8, j10
ap_change_put:
  jadd j9, j4, j7
  jstb j8, j9, 1
  jret
ap_insert:
  jsub j2, j2, j6
  jldi j10, 1
  jadd j7, j5, j10
  jldi j10, 15
  jmul j6, j7, j10
  jsub j10, j2, j6
  jjnn j10, ap_cross
  jldi j10, 15
  jdiv j7, j2, j10
  jmul j8, j7, j10
  jsub j8, j2, j8
  jldi j10, 1
  jadd j8, j8, j10
  jst j7, j14, 0440h
  jst j8, j14, 04B8h
  jld j3, j14, 0428h
  jldi j1, 0
  jadd j2, j7, j14
  jcall r_cat
  jld j1, j14, 04B8h
  jcall r_app
  jld j1, j14, 0440h
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
ap_cross:                       ; its first c letters, then form k's letters from c on
  jsub j2, j2, j6
  jldi j10, 8
  jmul j6, j5, j10
  jsub j10, j2, j6
  jjnn j10, ap_delete
  jdiv j7, j2, j5
  jmul j8, j7, j5
  jsub j8, j2, j8
  jldi j10, 1
  jadd j8, j8, j10
  jst j7, j14, 04B8h
  jst j8, j14, 0440h
  jld j3, j14, 0428h
  jldi j1, 0
  jadd j2, j8, j14
  jcall r_cat
  jld j7, j14, 04B8h
  jldi j10, 8
  jshl j3, j7, j10
  jldi j10, 0800h
  jadd j3, j3, j10
  jldi j10, 192
  jadd j3, j3, j10
  jldb j2, j3, 0
  jld j1, j14, 0440h
  jcall r_cat
  jret
ap_delete:
  jsub j2, j2, j6
  jldi j10, 1
  jsub j10, j5, j10
  jjz j10, ap_none
  jsub j10, j2, j5
  jjnn j10, ap_none
  jst j2, j14, 0440h
  jld j3, j14, 0428h
  jldi j1, 0
  jcall r_cat
  jld j1, j14, 0440h
  jldi j10, 1
  jadd j1, j1, j10
  jld j2, j14, 0438h
  jld j3, j14, 0428h
  jcall r_cat
  jret
ap_none:                        ; past the ops: an empty recipe (never judged)
  jld j4, j14, 0430h
  jstb j14, j4, 0
  jret
; ---- the tried table: an FNV-1a hash of each recipe judged in this population (2^21 slots, open addressing)
r_hash:                         ; j1 = a recipe -> j0 = its hash (never 0; uses j2..j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
  jldb j2, j1, 0
  jldi j10, 1
  jadd j2, j2, j10
  jadd j3, j1, j14
hash_lap:
  jldb j10, j3, 0
  jxor j0, j0, j10
  jmul j0, j0, j4
  jldi j10, 1
  jadd j3, j3, j10
  jsub j2, j2, j10
  jjnz j2, hash_lap
  jldi j10, 1
  jor j0, j0, j10
  jret
r_tried:                        ; j0 = a hash -> j0 = 1 it was there, 0 it is now, 2 the table is half full
  jldi j10, 01Fh
  jshi j10, 0FFFFh
  jand j1, j0, j10
tried_lap:
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 055h
  jshi j10, 08000h
  jadd j2, j2, j10
  jld j3, j2, 0
  jjz j3, tried_new
  jsub j3, j3, j0
  jjz j3, tried_was
  jldi j10, 1
  jadd j1, j1, j10
  jldi j10, 01Fh
  jshi j10, 0FFFFh
  jand j1, j1, j10
  jjmp tried_lap
tried_was:
  jldi j0, 1
  jret
tried_new:
  jld j3, j14, 02C0h
  jldi j10, 010h
  jshi j10, 0
  jsub j10, j3, j10
  jjnn j10, tried_full
  jst j0, j2, 0
  jldi j10, 1
  jadd j3, j3, j10
  jst j3, j14, 02C0h
  jldi j0, 0
  jret
tried_full:
  jldi j0, 2
  jret
r_clear_hash:                   ; a new population: nothing tried in it yet, but its own forms count as tried
  jldi j1, 055h
  jshi j1, 08000h
  jldi j2, 020h
  jshi j2, 0
  jldi j3, 8
  jldi j4, 1
clear_lap:
  jst j14, j1, 0
  jadd j1, j1, j3
  jsub j2, j2, j4
  jjnz j2, clear_lap
  jst j14, j14, 02C0h
  jst j14, j14, 0498h
clear_forms:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j1, j1, j10
  jldi j10, 0800h
  jadd j1, j1, j10
  jldi j10, 192
  jadd j1, j1, j10
  jcall r_hash
  jcall r_tried
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, clear_forms
  jret
; ---- exploration: a walk over every op of every form that may mutate, with a random start and a stride coprime
;      to their number, so it visits each once in an order it does not repeat
r_new_walk:
  jst j14, j14, 02A0h
  jst j14, j14, 02B8h
  jldi j10, 1
  jst j10, j14, 0290h
  jst j14, j14, 0498h
nw_count:
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjnz j10, nw_next
  jldb j1, j9, 192
  jcall r_count
  jld j10, j14, 02A0h
  jadd j10, j10, j0
  jst j10, j14, 02A0h
nw_next:
  jld j10, j14, 0498h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0498h
  jldi j11, 8
  jsub j10, j10, j11
  jjnz j10, nw_count
  jld j1, j14, 02A0h
  jjz j1, nw_none
  jcall r_randmod
  jst j0, j14, 02A8h
  jld j1, j14, 02A0h
  jcall r_randmod
  jjnz j0, nw_stride
  jldi j0, 1
nw_stride:                      ; the next one coprime to the total
  jst j0, j14, 02B0h
  jld j1, j14, 02A0h
nw_gcd:
  jjz j1, nw_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp nw_gcd
nw_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, nw_go
  jld j0, j14, 02B0h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 02A0h
  jsub j10, j0, j1
  jjn j10, nw_stride
  jldi j0, 1
  jjmp nw_stride
nw_go:
  jldi j10, 1
  jst j10, j14, 0230h
  jret
nw_none:                        ; every form rests: nothing to try
  jst j14, j14, 0230h
  jret
r_explore_frame:                ; up to 8 thoughts; a win ends the frame (the population changed)
  jldi j10, 8
  jst j10, j14, 02E0h
ex_lap:
  jcall r_trial
  jjz j0, ex_calm
  jldi j10, 2
  jsub j10, j0, j10
  jjz j10, ex_done
  jld j10, j14, 02E0h
  jldi j11, -1
  jadd j10, j10, j11
  jst j10, j14, 02E0h
  jjnz j10, ex_lap
ex_done:
  jret
ex_calm:
  jst j14, j14, 0230h
  jret
r_trial:                        ; one candidate -> j0 = 0 nothing left to try, 1 lost (or already tried), 2 won
  jld j9, j14, 0290h
  jldi j10, 1
  jsub j10, j9, j10
  jjnz j10, tr_jump
tr_walk:
  jld j9, j14, 02B8h
  jld j10, j14, 02A0h
  jsub j10, j9, j10
  jjnn j10, tr_none
  jld j1, j14, 02B0h
  jmul j1, j1, j9
  jld j10, j14, 02A8h
  jadd j1, j1, j10
  jld j2, j14, 02A0h
  jdiv j3, j1, j2
  jmul j3, j3, j2
  jsub j1, j1, j3
  jst j1, j14, 04B0h
  jld j10, j14, 02B8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02B8h
  jst j14, j14, 0498h
tr_map:                         ; the op FN -> its form and its op in that form
  jld j1, j14, 0498h
  jldi j10, 8
  jshl j9, j1, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j10, j9, 128
  jjnz j10, tr_map_next
  jldb j1, j9, 192
  jcall r_count
  jld j1, j14, 04B0h
  jsub j10, j1, j0
