v_vmb_tail:                       ; insert at the end
  jsub j10, j4, j2
  jjnz j10, v_vmb_end
  jldi j10, 2
  jsub j10, j5, j10
  jjnz j10, v_vmb_none
  jldi j10, 31
  jsub j10, j2, j10
  jjnn j10, v_vmb_none
  jld j8, j14, 02758h
  jldi j11, 06440h
