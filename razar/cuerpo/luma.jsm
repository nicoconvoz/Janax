  jshi j6, 0
  jld j0, j6, 01AC8h
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 01900h
  jldi j10, 1
  jsub j1, j1, j10
  jsub j1, j1, j0
  jjz j1, grow_letter
  jldi j10, 20
  jadd j11, j0, j14
  jldi j12, 0
  jcall r_tocar
  jldi j10, 1
  jadd j1, j13, j10
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 01900h
  jldi j1, 1
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 01908h
