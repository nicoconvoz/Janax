v_bcost_raw:                    ; j1 = a recipe -> j0 = its cost against TI's identity (bits x100; DBMP = its drawing)
  jst j1, j14, 02748h
  jld j9, j14, 02380h
  jld j1, j9, 320
  jldi j2, 02Fh
  jshi j2, 0EC00h
