  jld j10, j14, 0468h
  jstb j10, j11, 1
  jld j10, j14, 0470h
  jstb j10, j11, 2
plot_out:
  jret
r_draw_ghosts:                  ; this frame's thoughts: each candidate's cells, faint, at its form's seed
  jst j14, j14, 0498h
dg_lap:
  jld j1, j14, 0498h
  jld j10, j14, 02D8h
  jsub j10, j1, j10
  jjnn j10, dg_done
  jldi j10, 3
  jshl j2, j1, j10
  jldi j10, 01380h
  jadd j2, j2, j10
  jld j2, j2, 0
  jldi j10, 8
  jshl j9, j2, j10
  jldi j10, 0800h
  jadd j9, j9, j10
  jld j1, j9, 136
  jldi j10, 03Eh
  jadd j1, j1, j10
  jldi j10, 3
  jdiv j1, j1, j10
  jst j1, j14, 0460h
  jld j1, j9, 144
  jldi j10, 09Ch
  jadd j1, j1, j10
  jldi j10, 3
  jdiv j1, j1, j10
