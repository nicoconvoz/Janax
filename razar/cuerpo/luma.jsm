  jshi j6, 0
  jst j13, j6, 01928h
  jldi j10, 1
  jadd j1, j13, j10
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 01900h
grow_heart_has:
  jldi j10, 1
  jsub j1, j1, j10
  jcall r_talk
  ; the kernel's law, known here (never more than she was launched with), and it is asked only if her turn changes
  jldi j6, 015Eh
  jshi j6, 0
  jld j2, j6, 01928h
  jjn j0, grow_heart_top
  jsub j10, j2, j0
  jjnn j10, grow_heart_cut
grow_heart_top:
  jadd j0, j2, j14
grow_heart_cut:                 ; (what the law took back was not changed: it is not said)
  jldi j6, 015Eh
  jshi j6, 0
