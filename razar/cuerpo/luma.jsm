v_attend:                       ; news of j1 bits (x100) at TI: stronger news (or as strong) takes the camera
  jld j2, j14, 02728h
  jsub j10, j1, j2
  jjn j10, v_va2_ret
  jst j1, j14, 02728h
  jld j9, j14, 02380h
  jld j2, j9, 16
