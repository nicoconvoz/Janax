  jadd j4, j4, j1
  jldb j4, j4, 0
  jand j5, j2, j3
  jadd j4, j4, j5
  jadd j5, j1, j2
  jstb j4, j5, 0
  jadd j2, j2, j3
  jldi j5, 256
  jsub j5, j5, j2
  jjnz j5, init_popc
