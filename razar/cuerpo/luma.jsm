grow_arm:                       ; 1-4: an arm towards direction k, turned as the eye is
  jldi j10, 1
  jsub j5, j5, j10
  jld j10, j14, 04F8h
  jadd j5, j5, j10
  jldi j10, 3
  jand j5, j5, j10
