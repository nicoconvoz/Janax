  jjn j10, grow_done
  jldi j1, 015Eh
  jshi j1, 03000h
  jadd j1, j1, j9
  jldb j5, j1, 0
  jst j5, j14, 0348h
  jldb j6, j1, 200h
  jst j6, j14, 0340h
  jldi j10, 14
  jsub j10, j5, j10
  jjnz j10, grow_seen
  ; a cell: E, the two letters of its gear and its tissue. The tissues of her body: 5, where her pen is passes
  ; through the gear (across and down, each on its own) and she goes on from there, as after a hole; 6, where
  ; her pen heads (the quarter turn of what follows) passes through it. Any other tissue draws nothing.
  jldb j2, j1, 1
  jldb j3, j1, 2
  jldb j4, j1, 3
  jldi j10, 9
  jsub j2, j2, j10
  jldi j10, 15
  jmul j2, j2, j10
  jadd j2, j2, j3
  jldi j10, 1
  jsub j2, j2, j10
  jst j2, j14, 0360h
  jst j4, j14, 0368h
  jld j10, j14, 0500h
  jldi j11, 3
  jadd j10, j10, j11
  jst j10, j14, 0500h
  jld j4, j14, 0368h
  jldi j10, 8
  jsub j10, j4, j10
  jjnz j10, grow_cell
  jld j10, j14, 0500h
  jldi j11, 4
  jadd j10, j10, j11
  jst j10, j14, 0500h
grow_cell:
  jld j2, j14, 0360h
  jldi j6, 015Eh
  jshi j6, 0
