  jshi j11, 01428h
  jldi j12, 6
  jcall r_open
  jld j9, j14, 04A8h
  jjn j9, fr_rest
  jldi j10, 6
  jldi j11, 015Eh
  jshi j11, 01428h
  jldi j12, 6
  jcall r_file
  jldi j10, 7
  jcall r_file
  jjmp fr_rest
fr_paint:                       ; she paints herself (the Capitan: "que muestre las gamas de colores que quiera"): a meal
                                ; of hers by her luck, and the form it fed wears another of that meal's colours, by her
                                ; luck too (a form used to wear only the first, the most counted: often a dark outline).
                                ; Nothing pays for it: its wish is 1/2 over (times + 1), never 0. Kept in "libre".
  jldi j6, 015Eh
  jshi j6, 0
  jld j1, j6, 176
  jldi j10, 1
  jadd j1, j1, j10
  jldi j6, 015Eh
  jshi j6, 0
  jst j1, j6, 176
  jld j1, j14, 01BB8h
  jjz j1, fr_p_done
  jcall r_randmod
  jldi j10, 537
  jmul j9, j0, j10
  jld j10, j14, 01A88h
  jadd j9, j9, j10
  jldi j6, 015Eh
  jshi j6, 0
