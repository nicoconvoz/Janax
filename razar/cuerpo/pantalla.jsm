; Janax draws its first screen: a desktop with Razar's and Luma's windows and a taskbar, one particle per cell.
; It is written as a particle cloud in Gotching's format (.nube version 3, no bones, one level, 160x100),
; so the same reader that draws the creatures can draw it. File: "pantalla.nube". Generated by gen_pantalla.py.
; Layout of room 0: 100h the request queue, 200h the label, 01000h the cloud (28 bytes of header, 2000 of cells, 48000 of colour).
include '../../escalon0/janax.inc'
jfirst j1, 10000h
jldi j9, 0                      ; j9 stays 0
jldi j14, 01000h                   ; the header, byte by byte
jldi j2, 04Eh
jcall emit
jldi j2, 055h
jcall emit
jldi j2, 042h
jcall emit
jldi j2, 045h
jcall emit
jldi j2, 03h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 080h
jcall emit
jldi j2, 03Fh
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 01h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 080h
jcall emit
jldi j2, 03Fh
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 0A0h
jcall emit
jldi j2, 00h
jcall emit
jldi j2, 064h
jcall emit
jldi j2, 00h
jcall emit
jldi j14, 0101Ch                   ; every cell holds a particle: all bits set
jldi j2, 0FFh
jldi j12, 2000
bits:
  jcall emit
  jldi j13, 1
  jsub j12, j12, j13
  jjnz j12, bits
jldi j1, 0                      ; the desktop
jldi j2, 0
jldi j3, 160
jldi j4, 100
jldi j5, 01Fh
jldi j6, 04Eh
jldi j7, 05Ah
jcall rect
jldi j1, 23                      ; Razar's window: shadow
jldi j2, 13
jldi j3, 113
jldi j4, 79
jldi j5, 010h
jldi j6, 02Ah
jldi j7, 030h
jcall rect
jldi j1, 20                      ; border
jldi j2, 10
jldi j3, 110
jldi j4, 76
jldi j5, 022h
jldi j6, 022h
jldi j7, 02Ah
jcall rect
jldi j1, 21                      ; body
jldi j2, 18
jldi j3, 109
jldi j4, 75
jldi j5, 0F4h
jldi j6, 0ECh
jldi j7, 0E0h
jcall rect
jldi j1, 21                      ; title bar
jldi j2, 11
jldi j3, 109
jldi j4, 18
jldi j5, 02Fh
jldi j6, 05Fh
jldi j7, 0A8h
jcall rect
jldi j1, 101                      ; close
jldi j2, 12
jldi j3, 107
jldi j4, 17
jldi j5, 0D0h
jldi j6, 040h
jldi j7, 040h
jcall rect
jldi j1, 94                      ; minimize
jldi j2, 12
jldi j3, 100
jldi j4, 17
jldi j5, 0E0h
jldi j6, 0B0h
jldi j7, 030h
jcall rect
jldi j1, 28                      ; a little tower: 1
jldi j2, 26
jldi j3, 36
jldi j4, 34
jldi j5, 0FFh
jldi j6, 06Bh
jldi j7, 06Bh
jcall rect
jldi j1, 36                      ; a little tower: 6
jldi j2, 26
jldi j3, 44
jldi j4, 34
jldi j5, 04Dh
jldi j6, 096h
jldi j7, 0FFh
jcall rect
jldi j1, 52                      ; a little tower: 3
jldi j2, 26
jldi j3, 60
jldi j4, 34
jldi j5, 0FFh
jldi j6, 0D9h
jldi j7, 03Dh
jcall rect
jldi j1, 60                      ; a little tower: 8
jldi j2, 26
jldi j3, 68
jldi j4, 34
jldi j5, 06Bh
jldi j6, 0CBh
jldi j7, 077h
jcall rect
jldi j1, 28                      ; a button
jldi j2, 62
jldi j3, 58
jldi j4, 70
jldi j5, 0C8h
jldi j6, 0C8h
jldi j7, 0D0h
jcall rect
jldi j1, 93                      ; Luma's window: shadow
jldi j2, 47
jldi j3, 153
jldi j4, 93
jldi j5, 010h
jldi j6, 02Ah
jldi j7, 030h
jcall rect
jldi j1, 90                      ; border
jldi j2, 44
jldi j3, 150
jldi j4, 90
jldi j5, 022h
jldi j6, 022h
jldi j7, 02Ah
jcall rect
jldi j1, 91                      ; body
jldi j2, 51
jldi j3, 149
jldi j4, 89
jldi j5, 0E8h
jldi j6, 0F4h
jldi j7, 0ECh
jcall rect
jldi j1, 91                      ; title bar
jldi j2, 45
jldi j3, 149
jldi j4, 51
jldi j5, 03Ah
jldi j6, 09Ah
jldi j7, 05Ah
jcall rect
jldi j1, 142                      ; close
jldi j2, 46
jldi j3, 147
jldi j4, 50
jldi j5, 0D0h
jldi j6, 040h
jldi j7, 040h
jcall rect
jldi j1, 0                      ; the taskbar
jldi j2, 94
jldi j3, 160
jldi j4, 100
jldi j5, 02Ah
jldi j6, 02Ah
jldi j7, 033h
jcall rect
jldi j1, 2                      ; start
jldi j2, 95
jldi j3, 18
jldi j4, 99
jldi j5, 06Bh
jldi j6, 0CBh
jldi j7, 077h
jcall rect
jldi j14, 200h                  ; the label: pantalla.nube
jldi j2, 070h
jcall emit
jldi j2, 061h
jcall emit
jldi j2, 06Eh
jcall emit
jldi j2, 074h
jcall emit
jldi j2, 061h
jcall emit
jldi j2, 06Ch
jcall emit
jldi j2, 06Ch
jcall emit
jldi j2, 061h
jcall emit
jldi j2, 02Eh
jcall emit
jldi j2, 06Eh
jcall emit
jldi j2, 075h
jcall emit
jldi j2, 062h
jcall emit
jldi j2, 065h
jcall emit
jldi j3, 100h                   ; open, write the cloud, close
jldi j4, 1
jldi j5, 32
jldi j10, 4
jldi j11, 200h
jldi j12, 13
jcall tocar
jadd j7, j13, j9                ; the handle
jshl j10, j7, j5
jldi j8, 6
jor j10, j10, j8
jldi j11, 01000h
jldi j12, 0
jshi j12, 0C36Ch               ; 50028 bytes
jcall tocar
jadd j0, j13, j9                ; j0 = bytes written
jshl j10, j7, j5
jldi j8, 7
jor j10, j10, j8
jcall tocar
jhalt
emit:                           ; one byte (j2) at j14, and j14 moves on
  jstb j2, j14, 0
  jldi j13, 1
  jadd j14, j14, j13
  jret
rect:                           ; paints x j1..j3, y j2..j4 (exclusive) with colour j5 j6 j7
  jadd j8, j2, j9
ry:
  jsub j10, j4, j8
  jjz j10, rdone
  jadd j11, j1, j9
rx:
  jsub j10, j3, j11
  jjz j10, rnext
  jldi j12, 160
  jmul j12, j8, j12
  jadd j12, j12, j11
  jldi j13, 3
  jmul j12, j12, j13
  jldi j13, 017ECh
  jadd j12, j12, j13
  jstb j5, j12, 0
  jstb j6, j12, 1
  jstb j7, j12, 2
  jldi j13, 1
  jadd j11, j11, j13
  jjmp rx
rnext:
  jldi j13, 1
  jadd j8, j8, j13
  jjmp ry
rdone:
  jret
tocar:                          ; one request (j10 type, j11 a, j12 b) -> j13 answer
  jst j4, j3, 0
  jst j10, j3, 8
  jst j11, j3, 16
  jst j12, j3, 24
  jsys j14, j3
  jld j13, j3, 32
  jret
