  jadd j1, j1, j2
  jldi j2, 0
  jld j3, j14, 03B8h
  jcall r_archive
  ; the exchange is shown: the piece flies from the teacher to the pupil blinking with its own rhythm, and the
  ; pupil's answer flies back (only for a piece kept: a piece with no effect is not shown)
  jld j1, j14, 03D0h
  jldi j10, 32
  jmul j1, j1, j10
  jld j9, j14, 0388h
