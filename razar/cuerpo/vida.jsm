  jjnz j10, bd_bad
  jldb j1, j9, 4
  jldi j10, 3
  jsub j10, j1, j10
  jjnz j10, bd_bad
  ; the bones (42 bytes each, as NubeViva.cs reads them) are skipped; the levels' count, then level 0's header
  jldb j1, j9, 9
  jldb j2, j9, 10
  jldi j10, 8
  jshl j2, j2, j10
  jor j1, j1, j2
  jldi j10, 42
  jmul j1, j1, j10
  jldi j10, 11
  jadd j1, j1, j10
  jadd j2, j9, j1
  jldb j3, j2, 0
  jjz j3, bd_bad
  jldi j10, 17
  jadd j1, j1, j10
  jadd j2, j9, j1
  jldb j3, j2, -4
  jldb j4, j2, -3
  jldi j10, 8
  jshl j4, j4, j10
  jor j3, j3, j4
  jst j3, j14, 03E0h
  jldb j3, j2, -2
  jldb j4, j2, -1
  jshl j4, j4, j10
  jor j3, j3, j4
  jst j3, j14, 03E8h
  jst j1, j14, 03F0h
  jld j3, j14, 03E0h
  jjz j3, bd_bad
  jld j4, j14, 03E8h
  jjz j4, bd_bad
  jmul j3, j3, j4
  jldi j10, 7
  jadd j3, j3, j10
  jldi j10, 3
  jshr j3, j3, j10
  jadd j3, j3, j1
  jst j3, j14, 03F8h
  jld j9, j14, 0380h
  jld j10, j9, 200
  jsub j10, j10, j3
  jjn j10, bd_bad
  ; the scale that fits B x B, never above 1; centred
  jld j1, j14, 0230h
  jld j3, j14, 03E0h
  jld j4, j14, 03E8h
  jmul j7, j1, j4
  jmul j8, j1, j3
  jsub j10, j8, j7
  jjn j10, bd_h
  jadd j5, j1, j14
  jadd j6, j3, j14
  jjmp bd_cap
bd_h:
  jadd j5, j1, j14
  jadd j6, j4, j14
bd_cap:
  jsub j10, j6, j5
  jjnn j10, bd_ok
  jldi j5, 1
  jldi j6, 1
bd_ok:
  jst j5, j14, 0400h
  jst j6, j14, 0408h
  jld j1, j14, 03E0h
  jmul j1, j1, j5
  jdiv j1, j1, j6
  jld j2, j14, 0230h
  jsub j1, j2, j1
  jldi j10, 1
  jsar j1, j1, j10
  jst j1, j14, 0410h
  jld j1, j14, 03E8h
  jmul j1, j1, j5
  jdiv j1, j1, j6
  jld j2, j14, 0230h
  jsub j1, j2, j1
  jldi j10, 1
  jsar j1, j1, j10
  jst j1, j14, 0418h
  jld j1, j14, 02B8h
  jld j2, j14, 0230h
  jmul j2, j2, j2
  jldi j10, 5
  jmul j2, j2, j10
bd_clr:
  jjz j2, bd_clr_done
  jst j14, j1, 0
  jldi j10, 8
  jadd j1, j1, j10
  jldi j10, 1
  jsub j2, j2, j10
  jjmp bd_clr
bd_clr_done:
  ; every cell of the cloud, in reading order: its body cell counts it (area), a particle adds itself and its colour
  jld j9, j14, 0290h
  jld j10, j14, 03F8h
  jadd j8, j9, j10
  jld j10, j14, 03F0h
  jadd j7, j9, j10
  jldi j6, 0
  jst j14, j14, 0338h
bd_row:
  jld j1, j14, 0338h
  jld j10, j14, 03E8h
  jsub j10, j1, j10
  jjnn j10, bd_rows_done
  jld j2, j14, 0400h
  jmul j1, j1, j2
  jld j2, j14, 0408h
  jdiv j1, j1, j2
  jld j10, j14, 0418h
  jadd j1, j1, j10
  jld j10, j14, 0230h
  jmul j1, j1, j10
  jst j1, j14, 0340h
  jldi j5, 0
bd_cell:
  jld j1, j14, 0400h
  jmul j1, j1, j5
  jld j2, j14, 0408h
  jdiv j1, j1, j2
  jld j10, j14, 0410h
  jadd j1, j1, j10
  jld j10, j14, 0340h
  jadd j1, j1, j10
  jldi j10, 40
  jmul j1, j1, j10
  jld j10, j14, 02B8h
  jadd j1, j1, j10
  jld j10, j1, 0
  jldi j13, 1
  jadd j10, j10, j13
  jst j10, j1, 0
  jldi j10, 3
  jshr j2, j6, j10
  jadd j2, j2, j7
  jldb j2, j2, 0
  jldi j10, 7
  jand j3, j6, j10
  jshr j2, j2, j3
  jand j2, j2, j13
  jjz j2, bd_cell_next
  jld j10, j1, 8
  jadd j10, j10, j13
  jst j10, j1, 8
  jldb j2, j8, 0
  jld j10, j1, 16
  jadd j10, j10, j2
  jst j10, j1, 16
  jldb j2, j8, 1
  jld j10, j1, 24
  jadd j10, j10, j2
  jst j10, j1, 24
  jldb j2, j8, 2
  jld j10, j1, 32
  jadd j10, j10, j2
  jst j10, j1, 32
  jldi j10, 3
  jadd j8, j8, j10
bd_cell_next:
  jadd j6, j6, j13
  jadd j5, j5, j13
  jld j10, j14, 03E0h
  jsub j10, j5, j10
  jjnz j10, bd_cell
  jld j10, j14, 0338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0338h
  jjmp bd_row
bd_rows_done:
  ; the particles: home at the cell's centre relative to the body's (x256), born FALL_B bodies above it
  jld j9, j14, 0380h
  jld j2, j9, 120
  jld j1, j14, 02B8h
  jldi j3, 0
  jldi j4, 0
  jldi j0, 0
  jld j13, j14, 0230h
bd_prow:
  jldi j5, 0
bd_pcell:
  jld j6, j1, 0
  jjz j6, bd_pnext
  jld j7, j1, 8
  jadd j8, j7, j7
  jsub j8, j8, j6
  jjn j8, bd_pnext
  jld j8, j1, 16
  jdiv j8, j8, j7
  jld j11, j1, 24
  jdiv j11, j11, j7
  jldi j10, 8
  jshl j11, j11, j10
  jor j8, j8, j11
  jld j11, j1, 32
  jdiv j11, j11, j7
  jldi j10, 16
  jshl j11, j11, j10
  jor j8, j8, j11
  jst j8, j2, 32
  jldi j10, 8
  jshl j11, j5, j10
  jldi j10, 128
  jadd j11, j11, j10
  jldi j10, 7
  jshl j10, j13, j10
  jsub j11, j11, j10
  jst j11, j2, 0
  jst j11, j2, 16
  jldi j10, 8
  jshl j11, j3, j10
  jldi j10, 128
  jadd j11, j11, j10
  jldi j10, 7
  jshl j10, j13, j10
  jsub j11, j11, j10
  jst j11, j2, 8
  jldi j10, 1024
  jmul j10, j10, j13
  jsub j11, j11, j10
  jst j11, j2, 24
  jldi j10, 48
  jadd j2, j2, j10
  jldi j10, 1
  jadd j0, j0, j10
bd_pnext:
  jldi j10, 40
  jadd j1, j1, j10
  jldi j10, 1
  jadd j5, j5, j10
  jsub j10, j5, j13
  jjnz j10, bd_pcell
  jldi j10, 1
  jadd j3, j3, j10
  jsub j10, j3, j13
  jjnz j10, bd_prow
  jst j0, j9, 128
  jjz j0, bd_bad
  jldi j0, 1
  jret
bd_bad:
  jldi j0, 0
  jret
; ---- the judge: the description length of a gait, in whole bits
r_gam:                          ; j10 = n >= 0 -> j12 = 2 bitlen(n + 1) - 1, the Elias gamma code (uses j13)
  jldi j13, 1
  jadd j13, j10, j13
  jldi j12, 0
  jldi j10, 1
gm_lap:
  jjz j13, gm_done
  jshr j13, j13, j10
  jadd j12, j12, j10
  jjmp gm_lap
gm_done:
  jadd j12, j12, j12
  jsub j12, j12, j10
  jret
r_bitlen:                       ; j10 = n >= 0 -> j12 = its bits (the bits to name one of n + 1; uses j13)
  jadd j13, j10, j14
  jldi j12, 0
  jldi j10, 1
bl_lap:
  jjz j13, bl_done
  jshr j13, j13, j10
  jadd j12, j12, j10
  jjmp bl_lap
bl_done:
  jret
r_zz:                           ; j10 = a difference -> its zigzag (0, -1, 1, -2... -> 0, 1, 2, 3...; uses j13)
  jjn j10, zz_neg
  jadd j10, j10, j10
  jret
zz_neg:
  jsub j10, j14, j10
  jadd j10, j10, j10
  jldi j13, 1
  jsub j10, j10, j13
  jret
r_mcost:                        ; j11 = a rhythm -> j15 = its bits said whole: gamma(P) + gamma(q) + 4
  jld j10, j11, 0
  jcall r_gam
  jadd j15, j12, j14
  jld j10, j11, 8
  jcall r_gam
  jadd j15, j15, j12
  jldi j10, 4
  jadd j15, j15, j10
  jret
r_dist:                         ; j6 = a limb, j9 = a motif -> j15 = the bits to say the limb from the motif
  jld j10, j6, 0
  jld j13, j9, 0
  jsub j10, j10, j13
  jcall r_zz
  jcall r_gam
  jadd j15, j12, j14
  jld j10, j6, 8
  jld j13, j9, 8
  jsub j10, j10, j13
  jcall r_zz
  jcall r_gam
  jadd j15, j15, j12
  jld j10, j6, 16
  jld j13, j9, 16
  jsub j10, j10, j13
  jldi j13, 15
  jand j10, j10, j13
  jldi j13, 8
  jsub j13, j10, j13
  jjn j13, ds_s
  jldi j13, 16
  jsub j10, j10, j13
ds_s:
  jcall r_zz
  jcall r_gam
  jadd j15, j15, j12
  jret
r_dl:                           ; j1 = a model, j2 = K, j3 = the limbs, j4 = L -> j0 = DL (j1..j4 kept)
  jadd j10, j2, j14
  jcall r_gam
  jadd j0, j12, j14
  jadd j9, j1, j14
  jadd j8, j2, j14
dl_mot:
  jjz j8, dl_mot_done
  jadd j11, j9, j14
  jcall r_mcost
  jadd j0, j0, j15
  jldi j10, 32
  jadd j9, j9, j10
  jldi j10, 1
  jsub j8, j8, j10
  jjmp dl_mot
dl_mot_done:
  jadd j10, j2, j14
  jcall r_bitlen
  jadd j5, j12, j14
  jadd j6, j3, j14
  jadd j7, j4, j14
dl_limb:
  jjz j7, dl_done
  jadd j11, j6, j14
  jcall r_mcost
  jadd j8, j15, j14
  jadd j9, j1, j14
  jadd j11, j2, j14
dl_m:
  jjz j11, dl_m_done
  jcall r_dist
  jsub j10, j15, j8
  jjnn j10, dl_m_next
  jadd j8, j15, j14
dl_m_next:
  jldi j10, 32
  jadd j9, j9, j10
  jldi j10, 1
  jsub j11, j11, j10
  jjmp dl_m
dl_m_done:
  jadd j0, j0, j5
  jadd j0, j0, j8
  jldi j10, 32
  jadd j6, j6, j10
  jldi j10, 1
  jsub j7, j7, j10
  jjmp dl_limb
dl_done:
  jret
r_copym:                        ; j1 -> j2, j3 rhythms (uses j10)
cm_lap:
  jjz j3, cm_done
  jld j10, j1, 0
  jst j10, j2, 0
  jld j10, j1, 8
  jst j10, j2, 8
  jld j10, j1, 16
  jst j10, j2, 16
  jldi j10, 32
  jadd j1, j1, j10
  jadd j2, j2, j10
  jldi j10, 1
  jsub j3, j3, j10
  jjmp cm_lap
cm_done:
  jret
r_inlist:                       ; j1 = a rhythm, j2 = a list, j3 = its count -> j0 = 1 if the rhythm is in it
il_lap:
  jjz j3, il_no
  jld j4, j1, 0
  jld j5, j2, 0
  jsub j4, j4, j5
  jjnz j4, il_next
  jld j4, j1, 8
  jld j5, j2, 8
  jsub j4, j4, j5
  jjnz j4, il_next
  jld j4, j1, 16
  jld j5, j2, 16
  jsub j4, j4, j5
  jjnz j4, il_next
  jldi j0, 1
  jret
il_next:
  jldi j10, 32
  jadd j2, j2, j10
  jldi j10, 1
  jsub j3, j3, j10
  jjmp il_lap
il_no:
  jldi j0, 0
  jret
r_own:                          ; TI's first model: add the own limb that shortens DL most, while one does
  jld j9, j14, 0380h
  jst j14, j9, 56
ow_round:
  jld j9, j14, 0380h
  jld j1, j9, 88
  jld j2, j9, 56
  jld j3, j9, 80
  jld j4, j9, 48
  jcall r_dl
  jst j0, j14, 0398h
  jldi j10, -1
  jst j10, j14, 03A8h
  jst j14, j14, 0338h
ow_cand:
  jld j1, j14, 0338h
  jld j9, j14, 0380h
  jld j2, j9, 48
  jsub j10, j1, j2
  jjnn j10, ow_pick
  jldi j10, 32
  jmul j1, j1, j10
  jld j2, j9, 80
  jadd j1, j1, j2
  jst j1, j14, 0390h
  jld j2, j9, 88
  jld j3, j9, 56
  jcall r_inlist
  jjnz j0, ow_next
  jld j9, j14, 0380h
  jld j1, j9, 88
  jld j2, j14, 02A0h
  jld j3, j9, 56
  jcall r_copym
  jld j1, j14, 0390h
  jldi j3, 1
  jcall r_copym
  jld j9, j14, 0380h
  jld j1, j14, 02A0h
  jld j2, j9, 56
  jldi j10, 1
  jadd j2, j2, j10
  jld j3, j9, 80
  jld j4, j9, 48
  jcall r_dl
  jld j1, j14, 0398h
  jsub j10, j0, j1
  jjnn j10, ow_next
  jst j0, j14, 0398h
  jld j1, j14, 0338h
  jst j1, j14, 03A8h
ow_next:
  jld j10, j14, 0338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0338h
  jjmp ow_cand
ow_pick:
  jld j1, j14, 03A8h
  jjn j1, ow_done
  jldi j10, 32
  jmul j1, j1, j10
  jld j9, j14, 0380h
  jld j2, j9, 80
  jadd j1, j1, j2
  jld j3, j9, 56
  jldi j10, 32
  jmul j2, j3, j10
  jld j4, j9, 88
  jadd j2, j2, j4
  jldi j10, 1
  jadd j3, j3, j10
  jst j3, j9, 56
  jldi j3, 1
  jcall r_copym
  jjmp ow_round
ow_done:
  jret
r_eff:                          ; TI's limbs as its model says them (the motion), and the list of distinct ones
  jld j9, j14, 0380h
  jst j14, j9, 64
  jst j14, j14, 0338h
ef_lap:
  jld j9, j14, 0380h
  jld j1, j14, 0338h
  jld j2, j9, 48
  jsub j10, j1, j2
  jjnn j10, ef_done
  jldi j10, 32
  jmul j1, j1, j10
  jld j6, j9, 80
  jadd j6, j6, j1
  jadd j11, j6, j14
  jcall r_mcost
  jadd j8, j15, j14
  jadd j7, j6, j14
  jld j9, j14, 0380h
  jld j1, j9, 56
  jld j9, j9, 88
ef_m:
  jjz j1, ef_m_done
  jcall r_dist
  jsub j10, j15, j8
  jjnn j10, ef_m_next
  jadd j8, j15, j14
  jadd j7, j9, j14
ef_m_next:
  jldi j10, 32
  jadd j9, j9, j10
  jldi j10, 1
  jsub j1, j1, j10
  jjmp ef_m
ef_m_done:
  jld j9, j14, 0380h
  jld j1, j14, 0338h
  jldi j10, 32
  jmul j1, j1, j10
  jld j2, j9, 104
  jadd j2, j2, j1
  jst j7, j14, 0390h
  jadd j1, j7, j14
  jldi j3, 1
  jcall r_copym
  jld j9, j14, 0380h
  jld j1, j14, 0390h
  jld j2, j9, 96
  jld j3, j9, 64
  jcall r_inlist
  jjnz j0, ef_next
  jld j9, j14, 0380h
  jld j3, j9, 64
  jldi j10, 32
  jmul j2, j3, j10
  jld j4, j9, 96
  jadd j2, j2, j4
  jldi j10, 1
  jadd j3, j3, j10
  jst j3, j9, 64
  jld j1, j14, 0390h
  jldi j3, 1
  jcall r_copym
ef_next:
