  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0338h
  jjmp ef_lap
ef_done:
  jret
r_try:                          ; the piece PP in TI's model: added (if K < L), or in place of each motif ->
                                ; TBEST = the shortest DL, TBK its K, TBR the motif replaced (-1: added), PIECEM it
  jldi j10, 0100h
  jshi j10, 0
  jshi j10, 0
  jst j10, j14, 0398h
  jldi j10, -1
  jst j10, j14, 03A8h
  jld j9, j14, 0380h
  jld j1, j9, 56
  jld j2, j9, 48
  jsub j10, j1, j2
  jjnn j10, tr_repl
  jld j1, j9, 88
  jld j2, j14, 02A0h
  jld j3, j9, 56
  jcall r_copym
  jld j1, j14, 0390h
  jldi j3, 1
  jcall r_copym
  jld j9, j14, 0380h
  jld j1, j14, 02A0h
  jld j2, j9, 56
  jldi j10, 1
