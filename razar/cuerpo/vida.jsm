r_lex_add:                      ; j1 = a lexicon, j2 = a melody, j3 = a piece -> j0 = the new entry, score 1, in the
                                ; place of the lowest score (a free place has score 0 or less)
  jadd j8, j1, j14
  jldi j0, 0
  jldi j7, 0100h
  jshi j7, 0
  jshi j7, 0
  jldi j4, 32
