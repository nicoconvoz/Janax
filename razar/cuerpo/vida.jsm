  jshi j10, 0DD1Dh
  jst j10, j14, 0220h
order_done:
  jjmp frame
; ---- the living loop: wait for an event or for the frame's time, then a frame (as vivo.jsm)
main:
  jld j12, j14, 0200h
  jld j9, j14, 0208h
  jjz j9, main_wait
  jldi j12, -1
main_wait:
  jldi j10, 41
  jldi j11, 0140h
  jcall r_tocar
  jst j12, j14, 0210h
  jjn j13, main_bad
  jjz j13, main_time
  jst j14, j14, 0218h
  jcall r_handle
  jld j9, j14, 0208h
  jjz j9, main_timed_ev
  jld j9, j14, 0218h
  jjz j9, main
  jst j14, j14, 0208h
  jjmp frame
main_timed_ev:
  jld j12, j14, 0210h
  jst j12, j14, 0200h
  jjz j12, frame
  jjmp main
main_time:
  jld j9, j14, 0208h
  jjz j9, frame
  jld j0, j14, 0310h
  jhalt                         ; for ever ran out: no window to wait on (JANAX_SIN_VENTANA)
main_bad:
  jldi j0, 0BADh
  jhalt
r_handle:                       ; 5 closed: the end. A button down or a key: a gesture
  jld j9, j14, 0140h
  jldi j10, 5
  jsub j10, j9, j10
  jjnz j10, hd_open
  jcall r_save_lex
  jld j0, j14, 0310h
  jhalt
hd_open:
  jldi j10, 2
  jsub j10, j9, j10
  jjz j10, hd_gesture
  jldi j10, 4
  jsub j10, j9, j10
  jjz j10, hd_gesture
  jret
hd_gesture:                     ; they walk one period of the slowest gait among those here
  jld j1, j14, 0458h
  jldi j10, 33
  jdiv j1, j1, j10
  jldi j10, 1
  jadd j1, j1, j10
  jst j1, j14, 0300h
  jldi j10, 1
  jst j10, j14, 0218h
  jst j14, j14, 0528h
  jret
; ---- one frame: an arrival, the walk, the particles, the picture
frame:
  jld j10, j14, 0320h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0320h
  ; the one arriving has landed: it joins, and the judge looks at it and every one here
  jld j1, j14, 02F0h
  jjn j1, fr_next
  jldi j10, 256
  jmul j9, j1, j10
  jld j10, j14, 0258h
  jadd j9, j9, j10
  jld j2, j9, 176
  jjnz j2, fr_next
  jldi j2, 2
  jst j2, j9, 8
  jst j9, j14, 0380h
  jcall r_rowcol
  jldi j10, -1
  jst j10, j14, 02F0h
  jst j14, j14, 0528h
fr_next:
  jld j1, j14, 02F0h
  jjnn j1, fr_walk
fr_arrive:
  jld j1, j14, 02D8h
  jld j2, j14, 0228h
  jsub j10, j1, j2
  jjnn j10, fr_walk
  jld j3, j14, 02E8h
  jmul j3, j3, j1
  jld j10, j14, 02E0h
  jadd j3, j3, j10
  jdiv j4, j3, j2
  jmul j4, j4, j2
  jsub j3, j3, j4
  jst j3, j14, 0460h
  jld j10, j14, 02D8h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 02D8h
  jcall r_arrive
  jjz j0, fr_arrive
  jld j1, j14, 0460h
  jst j1, j14, 02F0h
fr_walk:
  ; a lesson is searched for while something new happened within the time the average walker here needs to
  ; cross the world (W / mean speed): longer than that with nothing new, the ones left live apart
  jcall r_searching
  jjnz j0, fr_go
  jld j1, j14, 0300h
  jjz j1, fr_parts
fr_go:
  jcall r_walk_all
  ; the search's time: W / the mean speed of those here (frames)
  jld j1, j14, 0548h
  jld j2, j14, 0540h
  jjz j2, fr_vs0
  jldi j10, 0140h
  jshi j10, 0
  jmul j1, j1, j10
  jdiv j1, j1, j2
  jjmp fr_vs
fr_vs0:
  jldi j1, 0
fr_vs:
  jst j1, j14, 0538h
  ; something new (a piece kept) wakes the search again
  jld j1, j14, 0310h
  jld j2, j14, 0530h
  jst j1, j14, 0530h
  jsub j1, j1, j2
  jjz j1, fr_q
  jst j14, j14, 0528h
  jjmp fr_parts
fr_q:
  jld j10, j14, 0528h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0528h
fr_parts:
  jcall r_packets
  jcall r_particles
  jcall r_draw
  jcall r_draw_packets
  jldi j10, 40
  jldi j11, 1
  jshi j11, 4
  jldi j12, 3
  jshi j12, 0D5Ch
  jcall r_tocar
  jld j1, j14, 0300h
  jjz j1, fr_alive
  jldi j10, 1
  jsub j1, j1, j10
  jst j1, j14, 0300h
fr_alive:                       ; alive while one arrives, one waits to, a lesson is pending, a gesture walks, a
                                ; particle moves
  jld j1, j14, 02F0h
  jldi j10, 1
  jadd j1, j1, j10
  jld j2, j14, 0228h
  jld j3, j14, 02D8h
  jsub j2, j2, j3
  jor j1, j1, j2
  jst j1, j14, 0338h
  jcall r_searching
  jld j1, j14, 0338h
  jor j1, j1, j0
  jld j2, j14, 0300h
  jor j1, j1, j2
  jld j2, j14, 0308h
  jor j1, j1, j2
  jld j2, j14, 0558h
  jor j1, j1, j2
  jjz j1, fr_calm
  jldi j10, 021h
  jst j10, j14, 0200h
  jst j14, j14, 0208h
  jjmp main
fr_calm:                        ; nothing new: the lexicons to the folder (calming is an event), then wait for ever
  jcall r_save_lex
  jldi j10, 1
  jst j10, j14, 0208h
  jjmp main
; ---- the list ("lista", written by vida.sh): a header and a line per creature,
;      "<.nube bytes 9> <.oido bytes 9> <.nube path>TAB<.oido path>"; every table sized from it (plastic)
r_load_list:
