r_dialogue:                     ; DSP names one of its dreams to DLIS with a melody; DLIS rebuilds a piece from the
                                ; melody alone, tries it on its body (MDL), keeps it only if it shortens its description
  jld j9, j14, 05B8h
  jcall r_first_dream
  jjn j0, dg_ret
  jst j0, j14, 05F0h
  jst j2, j14, 0618h
  jld j9, j14, 05B8h
  jld j1, j9, 0
  jldi j10, 1280
  jmul j1, j1, j10
  jld j10, j14, 0568h
  jadd j1, j1, j10
  jld j2, j14, 0618h
  jcall r_lex_piece
  jjnz j0, dg_has
  jcall r_rand
  jldi j11, 63
  jand j2, j10, j11
  jld j9, j14, 05B8h
  jld j1, j9, 0
  jldi j10, 1280
  jmul j1, j1, j10
  jld j10, j14, 0568h
  jadd j1, j1, j10
  jld j3, j14, 0618h
  jcall r_lex_add
dg_has:
  jst j0, j14, 05C8h
  jld j1, j0, 0
  jst j1, j14, 05D8h
  jst j1, j14, 05E0h
  ; the control's melody is drawn in both builds, so both worlds use their generator the same
  jcall r_rand
  jldi j11, 63
  jand j10, j10, j11
  jld j9, j14, 05C0h
  jld j1, j9, 0
  jldi j10, 1280
  jmul j1, j1, j10
  jld j10, j14, 0568h
  jadd j1, j1, j10
  jld j2, j14, 05E0h
  jcall r_lex_mel
  jst j0, j14, 05D0h
  jldi j10, -1
  jst j10, j14, 05E8h
  jld j0, j14, 05D0h
  jjnz j0, dg_guess
  ; a melody it does not know: it imagines, with its own first dream
  jld j9, j14, 05C0h
  jcall r_first_dream
  jjn j0, dg_none
  jst j0, j14, 05E8h
  jadd j3, j2, j14
  jld j9, j14, 05C0h
