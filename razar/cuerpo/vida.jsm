pa_lap:
  jld j1, j14, 0338h
  jld j2, j14, 0228h
  jsub j10, j1, j2
  jjnn j10, pa_done
  jldi j10, 256
  jmul j9, j1, j10
  jld j10, j14, 0258h
  jadd j9, j9, j10
  jld j10, j9, 8
  jjz j10, pa_next
  ; the lean: theta (1e-5 rad) to a table step, its cos and sin (x4096)
  jld j1, j9, 144
  jldi j10, 256
  jmul j1, j1, j10
  jldi j10, 9
  jshi j10, 0965Fh
  jdiv j1, j1, j10
  jldi j10, 255
  jand j1, j1, j10
  ; settled and leaning as in the last frame: nothing to move
  jld j2, j9, 232
  jst j1, j9, 232
  jsub j2, j2, j1
  jjnz j2, pa_go
  jld j2, j9, 176
  jjz j2, pa_next
pa_go:
  jldi j10, 64
  jadd j2, j1, j10
  jldi j10, 255
  jand j2, j2, j10
  jldi j10, 3
  jshl j1, j1, j10
  jshl j2, j2, j10
  jldi j10, 0800h
  jadd j1, j1, j10
  jadd j2, j2, j10
  jld j11, j1, 0
  jld j12, j2, 0
  jld j1, j9, 120
  jld j2, j9, 128
  jldi j0, 0
  jldi j15, 32
pa_p:
  jjz j2, pa_p_done
  jld j3, j1, 0
  jld j4, j1, 8
  jmul j5, j3, j12
  jmul j6, j4, j11
  jsub j5, j5, j6
  jldi j10, 12
  jsar j5, j5, j10
  jmul j6, j3, j11
  jmul j7, j4, j12
  jadd j6, j6, j7
  jsar j6, j6, j10
  jld j3, j1, 16
  jsub j7, j5, j3
  jld j4, j1, 24
  jsub j8, j6, j4
  jldi j13, 0
  jadd j10, j7, j15
  jjn j10, pa_ax_9_m
  jsub j10, j15, j7
  jjn j10, pa_ax_9_m
  jst j5, j1, 16
  jjmp pa_ax_9
pa_ax_9_m:
  jldi j10, 2
  jsar j7, j7, j10
  jjnz j7, pa_ax_9_s
  jldi j7, 1
pa_ax_9_s:
  jadd j3, j3, j7
  jst j3, j1, 16
  jldi j13, 1
pa_ax_9:
  jadd j10, j8, j15
  jjn j10, pa_ax_10_m
  jsub j10, j15, j8
  jjn j10, pa_ax_10_m
  jst j6, j1, 24
  jjmp pa_ax_10
pa_ax_10_m:
  jldi j10, 2
  jsar j8, j8, j10
  jjnz j8, pa_ax_10_s
  jldi j8, 1
pa_ax_10_s:
  jadd j4, j4, j8
  jst j4, j1, 24
  jldi j13, 1
pa_ax_10:
  jadd j0, j0, j13
  jldi j10, 48
  jadd j1, j1, j10
  jldi j10, 1
  jsub j2, j2, j10
  jjmp pa_p
pa_p_done:
  jst j0, j9, 176
  jld j10, j14, 0308h
  jadd j10, j10, j0
  jst j10, j14, 0308h
pa_next:
  jld j10, j14, 0338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0338h
  jjmp pa_lap
pa_done:
  jret
r_draw:                         ; the ground, then every body that is here (later ones in front), on the torus
  jldi j1, 1
  jshi j1, 01F60h
  jldi j2, 4
  jshi j2, 0D60h
  jldi j3, 02214h
  jshi j3, 02622h
  jshi j3, 01426h
  jshi j3, 02214h
  jldi j4, 01426h
  jshi j4, 02214h
  jshi j4, 02622h
  jshi j4, 01426h
  jldi j5, 02622h
  jshi j5, 01426h
  jshi j5, 02214h
  jshi j5, 02622h
  jldi j6, 24
dr_fill:
  jst j3, j1, 0
  jst j4, j1, 8
  jst j5, j1, 16
  jadd j1, j1, j6
  jsub j7, j2, j1
  jjnz j7, dr_fill
  jst j14, j14, 0338h
dr_lap:
  jld j1, j14, 0338h
  jld j2, j14, 0228h
  jsub j10, j1, j2
  jjnn j10, dr_done
  jldi j10, 256
  jmul j9, j1, j10
  jld j10, j14, 0258h
  jadd j9, j9, j10
  jld j10, j9, 8
  jjz j10, dr_next
  jld j3, j9, 16
  jldi j10, 8
  jsar j3, j3, j10
  jld j4, j9, 24
  jsar j4, j4, j10
  jld j1, j9, 120
  jld j2, j9, 128
  jldi j8, 1
  jshi j8, 01F60h
dr_p:
  jjz j2, dr_next
  jld j5, j1, 16
  jadd j5, j5, j3
  jldi j10, 128
  jadd j5, j5, j10
  jldi j10, 8
  jsar j5, j5, j10
  jjnn j5, dr_x_lo
  jldi j10, 320
  jadd j5, j5, j10
dr_x_lo:
  jldi j10, 320
  jsub j11, j5, j10
  jjn j11, dr_x_hi
  jadd j5, j11, j14
dr_x_hi:
  jjn j5, dr_p_next
  jldi j10, 320
  jsub j11, j5, j10
  jjnn j11, dr_p_next
  jld j6, j1, 24
  jadd j6, j6, j4
  jldi j10, 128
  jadd j6, j6, j10
  jldi j10, 8
  jsar j6, j6, j10
  jjnn j6, dr_y_lo
  jldi j10, 200
  jadd j6, j6, j10
dr_y_lo:
  jldi j10, 200
  jsub j11, j6, j10
  jjn j11, dr_y_hi
  jadd j6, j11, j14
dr_y_hi:
  jjn j6, dr_p_next
  jldi j10, 200
  jsub j11, j6, j10
  jjnn j11, dr_p_next
  jldi j10, 320
  jmul j6, j6, j10
  jadd j6, j6, j5
  jldi j10, 3
  jmul j6, j6, j10
  jadd j6, j6, j8
  jld j7, j1, 32
  jstb j7, j6, 0
  jldi j10, 8
  jshr j7, j7, j10
  jstb j7, j6, 1
  jshr j7, j7, j10
  jstb j7, j6, 2
dr_p_next:
  jldi j10, 48
  jadd j1, j1, j10
  jldi j10, 1
  jsub j2, j2, j10
  jjmp dr_p
dr_next:
  jld j10, j14, 0338h
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j14, 0338h
  jjmp dr_lap
dr_done:
  jret
; ---- small things
r_isqrt:                        ; j1 = n >= 0 (< 2^62) -> j0 = floor sqrt n (uses j1, j2, j3, j10)
  jldi j0, 0
  jldi j2, 1
  jldi j10, 62
  jshl j2, j2, j10
is_hi:
  jjz j2, is_done
  jsub j10, j1, j2
  jjnn j10, is_lap
  jldi j10, 2
  jshr j2, j2, j10
  jjmp is_hi
is_lap:
  jjz j2, is_done
  jadd j3, j0, j2
  jsub j10, j1, j3
  jjn j10, is_no
  jadd j1, j10, j14
  jldi j10, 1
  jshr j0, j0, j10
  jadd j0, j0, j2
  jjmp is_step
is_no:
  jldi j10, 1
  jshr j0, j0, j10
is_step:
  jldi j10, 2
  jshr j2, j2, j10
  jjmp is_lap
is_done:
  jret
r_alloc:                        ; j1 = bytes -> j0 = a new environment of that size (request 2), its address
  jldi j10, 8
  jsub j10, j1, j10
  jjnn j10, alloc_go
  jldi j1, 8
alloc_go:
  jadd j11, j1, j14
  jldi j10, 2
  jldi j12, 0
  jcall r_tocar
  jadd j0, j13, j14
  jjnn j0, alloc_ok
  jldi j0, 0BADh
  jhalt
alloc_ok:
  jret
r_read_all:                     ; FH, j11 = where, j12 = bytes -> j0 = bytes read (reads until all or none)
  jst j11, j14, 0368h
  jst j12, j14, 0370h
  jst j14, j14, 0378h
ra_lap:
  jld j12, j14, 0370h
  jld j10, j14, 0378h
  jsub j12, j12, j10
  jjz j12, ra_done
  jld j11, j14, 0368h
  jld j10, j14, 0378h
  jadd j11, j11, j10
  jldi j10, 5
  jcall r_file
  jjn j13, ra_done
  jjz j13, ra_done
  jld j10, j14, 0378h
  jadd j10, j10, j13
  jst j10, j14, 0378h
  jjmp ra_lap
ra_done:
  jld j0, j14, 0378h
  jret
r_fnv:                          ; j1 = bytes, j2 = how many -> j0 = their FNV-1a print, never 0 (uses j3, j4, j10)
  jldi j0, -13326
  jshi j0, 09CE4h
  jshi j0, 08422h
  jshi j0, 02325h
  jldi j4, 0100h
  jshi j4, 0
  jshi j4, 01B3h
fnv_lap:
  jjz j2, fnv_done
  jldb j3, j1, 0
  jxor j0, j0, j3
  jmul j0, j0, j4
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp fnv_lap
fnv_done:
  jldi j10, 1
  jor j0, j0, j10
  jret
r_put_hex:                      ; j1 = a number, j2 = hex digits, j3 = where (uses j4, j5, j10)
ph_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, ph_done
  jldi j10, 15
  jand j5, j1, j10
  jldi j10, 10
  jsub j10, j5, j10
  jjn j10, ph_digit
  jldi j10, 39
  jadd j5, j5, j10
ph_digit:
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jldi j10, 4
  jshr j1, j1, j10
  jjmp ph_lap
ph_done:
  jret
r_get_hex:                      ; j1 = where, j2 = hex digits -> j0 (uses j3, j10)
  jldi j0, 0
gh_lap:
  jjz j2, gh_done
  jldi j10, 4
  jshl j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 58
  jsub j10, j3, j10
  jjn j10, gh_digit
  jldi j10, 39
  jsub j3, j3, j10
gh_digit:
  jldi j10, 48
  jsub j3, j3, j10
  jldi j10, 15
  jand j3, j3, j10
  jor j0, j0, j3
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp gh_lap
gh_done:
  jret
r_put_num:                      ; j1 = a number >= 0, j2 = digits, j3 = where (uses j4, j5, j10)
pn_lap:
  jldi j10, 1
  jsub j2, j2, j10
  jjn j2, pn_done
  jldi j10, 10
  jdiv j4, j1, j10
  jmul j5, j4, j10
  jsub j5, j1, j5
  jldi j10, 48
  jadd j5, j5, j10
  jadd j10, j3, j2
  jstb j5, j10, 0
  jadd j1, j4, j14
  jjmp pn_lap
pn_done:
  jret
r_get_num:                      ; j1 = where, j2 = digits -> j0 (a non-digit counts as 0; uses j3, j10)
  jldi j0, 0
gnm_lap:
  jjz j2, gnm_done
  jldi j10, 10
  jmul j0, j0, j10
  jldb j3, j1, 0
  jldi j10, 48
  jsub j3, j3, j10
  jjn j3, gnm_skip
  jldi j10, 10
  jsub j10, j3, j10
  jjnn j10, gnm_skip
  jadd j0, j0, j3
gnm_skip:
  jldi j10, 1
  jadd j1, j1, j10
  jsub j2, j2, j10
  jjmp gnm_lap
gnm_done:
  jret
r_open:                         ; j11 = a label, j12 = its bytes -> FH = the handle (or -1)
  jldi j10, 4
  jcall r_tocar
  jst j13, j14, 0328h
  jret
r_file:                         ; j10 = request (5 read, 6 write, 7 close, 38 go to), FH = the handle, j11, j12 -> j13
  jldi j9, 32
  jld j8, j14, 0328h
  jshl j8, j8, j9
  jor j10, j10, j8
  jcall r_tocar
  jret
r_coprime:                      ; j1 = a total > 0 -> j0 = a random stride coprime to it
  jst j1, j14, 0360h
  jcall r_randmod
  jjnz j0, cp_try
  jldi j0, 1
cp_try:
  jst j0, j14, 0358h
  jld j1, j14, 0360h
cp_gcd:
  jjz j1, cp_gcd_done
  jdiv j2, j0, j1
  jmul j2, j2, j1
  jsub j2, j0, j2
  jadd j0, j1, j14
  jadd j1, j2, j14
  jjmp cp_gcd
cp_gcd_done:
  jldi j10, 1
  jsub j10, j0, j10
  jjz j10, cp_go
  jld j0, j14, 0358h
  jldi j10, 1
  jadd j0, j0, j10
  jld j1, j14, 0360h
  jsub j10, j0, j1
  jjn j10, cp_try
  jldi j0, 1
  jjmp cp_try
cp_go:
  jld j0, j14, 0358h
  jret
r_randmod:                      ; j1 = n > 0 -> j0 in [0, n) from the generator (uses j10..j12)
  jcall r_rand
  jldi j11, 1
  jshr j10, j10, j11
  jdiv j0, j10, j1
  jmul j0, j0, j1
  jsub j0, j10, j0
  jret
r_rand:                         ; j10 = the next of the generator (xorshift64); uses j11, j12
  jld j10, j14, 0220h
  jldi j12, 13
  jshl j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 7
  jshr j11, j10, j12
  jxor j10, j10, j11
  jldi j12, 17
  jshl j11, j10, j12
  jxor j10, j10, j11
  jst j10, j14, 0220h
  jret
r_tocar:                        ; one request (j10 type, j11 a, j12 b) -> j13 answer, j12 = b as it came back
  jldi j13, 100h
  jldi j15, 1
  jst j15, j13, 0
  jst j10, j13, 8
  jst j11, j13, 16
  jst j12, j13, 24
  jsys j15, j13
  jld j12, j13, 24
  jld j13, j13, 32
  jret
