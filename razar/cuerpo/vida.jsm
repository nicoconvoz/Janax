sh_apply:
  jld j1, j14, 03D0h
  jjn j1, sh_done
  ; the winner: the motif it replaces goes to the archive, the piece is kept, the motion follows the new model
  jld j1, j14, 03C8h
  jjn j1, sh_kept
  jldi j10, 32
  jmul j1, j1, j10
  jld j9, j14, 0380h
  jld j2, j9, 88
