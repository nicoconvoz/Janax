r_lex_piece:                    ; j1 = a lexicon, j2 = a piece -> j0 = its entry of highest score > 0 (0: none)
  jldi j0, 0
  jldi j3, 0
  jldi j4, 32
lp_lap:
  jjz j4, lp_done
  jld j5, j1, 32
