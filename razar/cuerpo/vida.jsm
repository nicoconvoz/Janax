r_first_dream:                  ; j9 = a creature -> j0 = its first dream's slot (-1: none), j2 = its address
  jld j2, j9, 0
  jldi j10, 128
  jmul j2, j2, j10
  jld j10, j14, 0560h
  jadd j2, j2, j10
  jldi j0, 0
