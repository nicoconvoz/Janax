  jld j1, j14, 05D0h
  jldi j10, 8
  jadd j1, j1, j10
  jldi j2, 02820h
  jldi j3, 1
  jcall r_copym
  ; exact: the piece it rebuilt is the dream that was named
  jldi j10, 1
  jst j10, j14, 0620h
  jldi j1, 02820h
  jld j2, j14, 0618h
  jld j3, j1, 0
  jld j4, j2, 0
  jsub j3, j3, j4
  jjz j3, dg_eq0
  jst j14, j14, 0620h
dg_eq0:
  jld j3, j1, 8
  jld j4, j2, 8
  jsub j3, j3, j4
  jjz j3, dg_eq1
  jst j14, j14, 0620h
