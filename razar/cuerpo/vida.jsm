  jldi j0, 0
  jldi j3, 0
  jldb j2, j1, 0
  jldi j10, 45
  jsub j10, j2, j10
  jjnz j10, dc_int
  jldi j3, 1
  jldi j10, 1
  jadd j1, j1, j10
dc_int:
  jldb j2, j1, 0
  jldi j10, 48
  jsub j2, j2, j10
  jjn j2, dc_frac
  jldi j10, 10
  jsub j10, j2, j10
  jjnn j10, dc_frac
  jldi j10, 10
  jmul j0, j0, j10
  jadd j0, j0, j2
  jldi j10, 1
  jadd j1, j1, j10
  jjmp dc_int
dc_frac:
  jldi j4, 5
  jldb j2, j1, 0
  jldi j10, 46
  jsub j10, j2, j10
  jjnz j10, dc_pad
  jldi j10, 1
  jadd j1, j1, j10
dc_flap:
  jjz j4, dc_rest
  jldb j2, j1, 0
  jldi j10, 48
  jsub j2, j2, j10
  jjn j2, dc_pad
  jldi j10, 10
  jsub j10, j2, j10
  jjnn j10, dc_pad
  jldi j10, 10
  jmul j0, j0, j10
  jadd j0, j0, j2
  jldi j10, 1
  jadd j1, j1, j10
  jsub j4, j4, j10
  jjmp dc_flap
dc_pad:
  jjz j4, dc_rest
  jldi j10, 10
  jmul j0, j0, j10
  jldi j10, 1
  jsub j4, j4, j10
  jjmp dc_pad
dc_rest:                        ; more decimals than five: skipped (the rest of this token only)
  jldb j2, j1, 0
  jldi j10, 33
  jsub j10, j2, j10
  jjn j10, dc_sign
  jldi j10, 1
  jadd j1, j1, j10
  jjmp dc_rest
dc_sign:
  jjz j3, dc_done
  jsub j0, j14, j0
dc_done:
  jret
r_body:                         ; NUBB -> TI's body: its finest level fitted relative to its own size into B x B,
                                ; a particle per cell where at least half is particle, its mean colour -> j0 = 1
  jld j9, j14, 0290h
  jldb j1, j9, 0
  jldb j2, j9, 1
  jldi j10, 8
  jshl j2, j2, j10
  jor j1, j1, j2
  jldb j2, j9, 2
  jldi j10, 16
  jshl j2, j2, j10
  jor j1, j1, j2
  jldb j2, j9, 3
