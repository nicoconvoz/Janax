include '../../escalon0/janax.inc'
jfirst j1, 10000h              ; first order: room 0

jldi j11, S_CRUCE               ; how the world is crossed, if the house says ("cruce": how many pairs back)
jldi j12, 5
jcall en_read
jldi j1, 0
jldi j2, 1
jst j2, j1, HCRS
jld j2, j1, PRN
jjz j2, hl_cr
jcall hl_tread
jldi j1, 0
jld j2, j1, HTK
jjz j2, hl_cr
jst j2, j1, HCRS
hl_cr:
jldi j11, S_SUSP                ; a rule suspended, if the house says ("suspende": its number, as the rules are said)
jldi j12, 8
jcall en_read
jldi j1, 0
jst j1, j1, HSUSF
jld j2, j1, PRN
jjz j2, hl_su
jcall hl_tread
jldi j1, 0
jld j2, j1, HTK
jldi j3, 1
jadd j2, j2, j3
jst j2, j1, HSUSF
jldi j1, S_SUSPD
jcall puts
jld j2, j1, HSUSF
jldi j3, 1
jsub j2, j2, j3
jcall putnum
jldi j2, 10
jcall putch
hl_su:
jldi j11, S_TANDA               ; a tanda for the cube, if the house asks for one
jldi j12, 5
jcall en_read
jldi j1, 0
jst j1, j1, HTANDA
jld j2, j1, PRN
jjz j2, hl_book
jcall hl_tread
jldi j1, 0
jldi j2, 1
jst j2, j1, HTANDA
hl_book:
jldi j11, S_SIGNS               ; the signs kept, if the house asks (Capitan: "help the context so that it deduces the
jldi j12, 6                     ; rules"): the reader stops throwing away what is not a letter
jcall en_read
jldi j1, 0
jld j2, j1, PRN
jst j2, j1, HSIG
jldi j11, S_PARES
jldi j12, 5
jcall en_read
jldi j1, 0
jld j2, j1, PRN
jjnz j2, hl_go
jldi j1, S_NOBOOK
jcall puts
jjmp finish
hl_go:
jcall en_lines
jcall hl_half
jcall hl_pmaybe                 ; (the pieces of words, if the house asks: nothing else then)
jjnz j2, finish
jcall hl_facts
jcall hl_rooms
jcall hl_known
jcall hl_pending
jcall hl_say0
jldi j1, 0
jld j2, j1, HTANDA
jjz j2, hl_while
jcall hl_groups
jcall hl_agree
jcall hl_tanda
jjmp finish
hl_while:
jldi j1, 0
jldi j2, 1
jst j2, j1, HTURN
jwhile j2                      ; while a turn joins something
  jcall hl_groups
  jcall hl_agree
  jcall hl_pinject
  jcall hl_props
  jcall hl_derive
  jcall hl_merge
  jldi j1, 0
  jld j2, j1, HTURN
  jldi j3, 1
  jadd j2, j2, j3
  jst j2, j1, HTURN
  jld j2, j1, HNMRG
  jld j3, j1, HNDER
  jadd j2, j2, j3
  jld j3, j1, HNREF
  jadd j2, j2, j3
jwend
jcall hl_end
jcall hl_icheck
jcall hl_inventa
jcall hl_ksave
jcall hl_psave
jjmp finish

; Each word's times, the half (the words said most that make half of what the book says: HHC the fewest times one
; of them has, as mp_head does) and, by word, if it is of the half (HHF). Uses j1-j14.
hl_half:
  jldi j2, HWC
  jldi j3, 16
  jcall pl_new
  jldi j1, 0
  jst j1, j1, HMAX
  jst j1, j1, HI
  hh_lap:
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, ZNWD
    jsub j3, j2, j3
    jjz j3, hh_his
    jldi j3, 24
    jmul j3, j2, j3
    jld j4, j1, ZWD
    jadd j3, j3, j4
    jld j5, j3, 0
    jldi j2, HWC
    jcall pl_take
    jldi j1, 0
    jld j7, j4, 8
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j4, 8
    jld j8, j1, HMAX
    jsub j8, j8, j7
    jldi j6, 63
    jsar j8, j8, j6
    jjz j8, hh_n
    jst j7, j1, HMAX
  hh_n:
    jld j2, j1, HI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HI
    jjmp hh_lap
hh_his:
  jld j2, j1, ZNWD
  jst j2, j1, HTOT
  jld j11, j1, HMAX
  jldi j2, 2
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HHIS
  jldi j2, HWC                  ; how many words are said each number of times
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jld j4, j2, 0
  jld j5, j2, 24
  hh_w:
    jjz j3, hh_wd
    jld j6, j4, 0
    jjz j6, hh_wn
    jld j6, j4, 8
    jldi j7, 3
    jshl j6, j6, j7
    jld j7, j1, HHIS
    jadd j6, j6, j7
    jld j7, j6, 0
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j6, 0
  hh_wn:
    jadd j4, j4, j5
    jldi j6, 1
    jsub j3, j3, j6
    jjmp hh_w
hh_wd:
  jld j2, j1, HMAX              ; from the most times down, until half of what is said
  jldi j3, 0
  jst j2, j1, HHC
  hh_c:
    jjz j2, hh_cd
    jldi j4, 3
    jshl j4, j2, j4
    jld j5, j1, HHIS
    jadd j4, j4, j5
    jld j4, j4, 0
    jmul j4, j4, j2
    jadd j3, j3, j4
    jst j2, j1, HHC
    jadd j4, j3, j3
    jld j5, j1, HTOT
    jsub j4, j4, j5
    jldi j5, 63
    jsar j4, j4, j5
    jjz j4, hh_cd
    jldi j4, 1
    jsub j2, j2, j4
    jjmp hh_c
hh_cd:
  jld j11, j1, ZNWD
  jldi j2, 8
  jadd j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HHF
  jst j1, j1, HI
  hh_f:
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, ZNWD
    jsub j3, j2, j3
    jjz j3, hh_fd
    jldi j3, 24
    jmul j3, j2, j3
    jld j4, j1, ZWD
    jadd j3, j3, j4
    jld j5, j3, 0
    jldi j2, HWC
    jcall pl_find
    jldi j1, 0
    jld j5, j4, 8
    jld j6, j1, HHC
    jsub j5, j5, j6
    jldi j6, 63
    jsar j5, j5, j6
    jldi j6, 1
    jadd j5, j5, j6               ; 1 if its times reach the half's (0 if fewer)
    jld j2, j1, HI
    jld j3, j1, HHF
    jadd j3, j3, j2
    jstb j5, j3, 0
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HI
    jjmp hh_f
hh_fd:
  jret

; j2 = the print of word j2 (of all the book's), j3 = 1 if it is of the half. Uses j2-j4.
hl_wd:
  jldi j3, 0
  jld j3, j3, HHF
  jadd j3, j3, j2
  jldb j3, j3, 0
  jldi j4, 24
  jmul j4, j2, j4
  jldi j2, 0
  jld j2, j2, ZWD
  jadd j4, j4, j2
  jld j2, j4, 0
  jret

; j5 = j5 * 1000003 xor j6. Uses j5, j7.
hl_mix:
  jldi j7, 0Fh
  jshi j7, 4243h
  jmul j5, j5, j7
  jxor j5, j5, j6
  jret

; The pairs: every form "_ <one to three words> _" in a line, its places holding two words not of the half and not the
; same: the form by its words (HMID, HMA), the pair once by form (HFT, HFL). Uses j1-j14.
hl_facts:
  jldi j1, 0
  jld j11, j1, ZNWD
  jldi j2, 3
  jmul j11, j11, j2
  jldi j2, 2
  jadd j11, j11, j2
  jst j11, j1, HT1
  jldi j2, 48
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HMA
  jld j11, j1, HT1
  jldi j2, 32
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HFL
  jldi j2, HMID
  jldi j3, 16
  jcall pl_new
  jldi j2, HFT
  jldi j3, 8
  jcall pl_new
  jldi j1, 0
  jst j1, j1, HNM
  jst j1, j1, HNF
  jst j1, j1, HL
  hf_line:
    jldi j1, 0
    jld j2, j1, HL
    jld j3, j1, ZNLN
    jsub j3, j2, j3
    jjz j3, hf_done
    jcall en_rec
    jldi j1, 0
    jst j3, j1, HT2               ; the line's record
    jst j1, j1, HI
    hf_i:
      jldi j1, 0
      jld j2, j1, HI
      jld j3, j1, HT2
      jld j4, j3, 16
      jsub j4, j2, j4
      jjz j4, hf_lnext
      jld j4, j3, 8
      jadd j2, j2, j4
      jst j2, j1, HT3             ; the word's place in the book
      jcall hl_wd
      jjnz j3, hf_inext           ; of the half: no place
      jldi j1, 0
      jst j2, j1, HA
      jldi j2, 1
      jst j2, j1, HK
      hf_k:
        jldi j1, 0
        jld j2, j1, HK
        jldi j3, 4
        jsub j3, j2, j3
        jjz j3, hf_inext          ; (three words at most between)
        jld j3, j1, HI
        jadd j3, j3, j2
        jldi j4, 1
        jadd j3, j3, j4           ; the second place, in the line
        jld j4, j1, HT2
        jld j4, j4, 16
        jsub j4, j3, j4
        jldi j5, 63
        jsar j4, j4, j5
        jjz j4, hf_inext          ; past the line
        jld j2, j1, HT3
        jld j4, j1, HK
        jadd j2, j2, j4
        jldi j4, 1
        jadd j2, j2, j4
        jcall hl_wd
        jjnz j3, hf_knext
        jldi j1, 0
        jld j3, j1, HA
        jsub j3, j3, j2
        jjz j3, hf_knext          ; the same word
        jst j2, j1, HB
        jld j5, j1, HK            ; the form's key: how many words, and them
        jst j1, j1, HJ
        hf_m:
          jldi j1, 0
          jld j2, j1, HJ
          jld j3, j1, HK
          jsub j3, j2, j3
          jjz j3, hf_md
          jld j3, j1, HT3
          jadd j2, j2, j3
          jldi j3, 1
          jadd j2, j2, j3
          jst j5, j1, HKEY
          jcall hl_wd
          jldi j1, 0
          jld j5, j1, HKEY
          jadd j6, j2, j1
          jcall hl_mix
          jld j2, j1, HJ
          jldi j3, 1
          jadd j2, j2, j3
          jst j2, j1, HJ
          jjmp hf_m
      hf_md:
        jjnz j5, hf_mk
        jldi j5, 1
      hf_mk:
        jst j5, j1, HKEY
        jldi j2, HMID
        jcall pl_take
        jldi j1, 0
        jjz j6, hf_old
        jld j6, j1, HNM           ; a new form: its number, where it is
        jst j6, j4, 8
        jldi j7, 48
        jmul j7, j6, j7
        jld j8, j1, HMA
        jadd j7, j7, j8
        jld j8, j1, HKEY
        jst j8, j7, 0
        jld j8, j1, HT2
        jst j8, j7, 8
        jld j8, j1, HI
        jldi j9, 1
        jadd j8, j8, j9
        jst j8, j7, 16
        jld j8, j1, HK
        jst j8, j7, 24
        jst j1, j7, 32
        jldi j8, -1
        jst j8, j7, 40
        jldi j8, 1
        jadd j6, j6, j8
        jst j6, j1, HNM
      hf_old:
        jld j6, j4, 8
        jst j6, j1, HM
        jld j5, j1, HKEY          ; the pair's key: the form's, its two words
        jld j6, j1, HA
        jcall hl_mix
        jld j6, j1, HB
        jcall hl_mix
        jjnz j5, hf_fk
        jldi j5, 1
      hf_fk:
        jldi j2, HFT
        jcall pl_take
        jldi j1, 0
        jjz j6, hf_knext          ; (said already by this form)
        jld j6, j1, HNF
        jldi j7, 5
        jshl j7, j6, j7
        jld j8, j1, HFL
        jadd j7, j7, j8
        jld j8, j1, HM
        jst j8, j7, 0
        jld j9, j1, HA
        jst j9, j7, 8
        jld j9, j1, HB
        jst j9, j7, 16
        jldi j9, 48
        jmul j9, j8, j9
        jld j10, j1, HMA
        jadd j9, j9, j10
        jld j10, j9, 40
        jst j10, j7, 24
        jst j6, j9, 40
        jld j10, j9, 32
        jldi j11, 1
        jadd j10, j10, j11
        jst j10, j9, 32
        jadd j6, j6, j11
        jst j6, j1, HNF
      hf_knext:
        jldi j1, 0
        jld j2, j1, HK
        jldi j3, 1
        jadd j2, j2, j3
        jst j2, j1, HK
        jjmp hf_k
    hf_inext:
      jldi j1, 0
      jld j2, j1, HI
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HI
      jjmp hf_i
  hf_lnext:
    jldi j1, 0
    jld j2, j1, HL
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HL
    jjmp hf_line
hf_done:
  jret

; The pair HA, HB of form HM (HTG 1 if crossed) by its two words, either way (HKEY; HDIR 1 if HA is the first). Pass
; HPASS 1: counted (HGT); 2: put where its words' pairs go (HGE). Uses j1-j14.
hl_entry:
  jcall hl_pkey
  jjmp he_k

; The key of the pair HA, HB by its two words either way -> HKEY, j5 (HDIR 1 if HA is the first). Uses j1-j7.
hl_pkey:
  jldi j1, 0
  jld j2, j1, HA
  jld j3, j1, HB
  jldi j4, 1
  jshr j5, j2, j4
  jshr j6, j3, j4
  jsub j5, j5, j6
  jjnz j5, he_cmp
  jand j5, j2, j4
  jand j6, j3, j4
  jsub j5, j5, j6
he_cmp:
  jldi j6, 63
  jsar j5, j5, j6               ; -1 if HA comes first
  jldi j6, 1
  jand j5, j5, j6
  jst j5, j1, HDIR
  jjnz j5, he_ab
  jadd j4, j3, j1               ; (the first, the second)
  jadd j3, j2, j1
  jadd j2, j4, j1
he_ab:
  jadd j5, j2, j1
  jadd j6, j3, j1
  jcall hl_mix
  jldi j6, 7
  jcall hl_mix
  jjnz j5, hpk_k
  jldi j5, 1
hpk_k:
  jst j5, j1, HKEY
  jret
he_k:
  jldi j1, 0
  jld j2, j1, HPASS
  jldi j3, 1
  jsub j2, j2, j3
  jjnz j2, he_put
  jldi j2, HGT
  jcall pl_take
  jldi j1, 0
  jld j7, j4, 8
  jldi j8, 1
  jadd j7, j7, j8
  jst j7, j4, 8
  jret
he_put:
  jldi j2, HGT
  jcall pl_find
  jldi j1, 0
  jld j7, j4, 16
  jld j8, j4, 24
  jadd j7, j7, j8
  jldi j9, 1
  jadd j8, j8, j9
  jst j8, j4, 24
  jldi j8, 24
  jmul j7, j7, j8
  jld j8, j1, HGE
  jadd j7, j7, j8
  jld j8, j1, HM
  jst j8, j7, 0
  jld j8, j1, HDIR
  jst j8, j7, 8
  jld j8, j1, HTG
  jst j8, j7, 16
  jret

; Every pair of a form said by two, and its crossed one (the second word of the form's pair before it, the last for
; the first one), by its two words: counted, given their places, put (HGT, HGE). Uses j1-j14.
hl_groups:
  jldi j2, HGT
  jcall hl_clear
  jldi j1, 0
  jldi j2, 1
  jst j2, j1, HPASS
  hg_pass:
    jldi j1, 0
    jst j1, j1, HI
    hg_lap:
      jldi j1, 0
      jld j2, j1, HI
      jld j3, j1, HNF
      jsub j3, j2, j3
      jjz j3, hg_pend
      jldi j3, 5
      jshl j3, j2, j3
      jld j4, j1, HFL
      jadd j3, j3, j4
      jst j3, j1, HT4             ; the pair
      jld j5, j3, 0
      jst j5, j1, HM
      jldi j6, 48
      jmul j6, j5, j6
      jld j7, j1, HMA
      jadd j6, j6, j7
      jst j6, j1, HT5             ; its form
      jld j7, j6, 32
      jldi j8, 2
      jsub j7, j7, j8
      jldi j8, 63
      jsar j7, j7, j8
      jjnz j7, hg_next            ; said by one: a memory
      jld j2, j1, HM              ; its relation, and if it is turned against it
      jcall hl_find
      jldi j1, 0
      jst j2, j1, HM
      jst j3, j1, HT1
      jld j3, j1, HT4
      jld j7, j3, 8
      jld j8, j3, 16
      jld j9, j1, HT1
      jjz j9, hg_or
      jadd j9, j7, j1
      jadd j7, j8, j1
      jadd j8, j9, j1
  hg_or:
      jst j7, j1, HA
      jst j8, j1, HB
      jst j1, j1, HTG
      jcall hl_entry
      jldi j1, 0
      jld j2, j1, HTANDA
      jjz j2, hg_next             ; (crossed pairs only for the tanda: the while does not shuffle)
      jldi j1, 0                  ; crossed: the second word of the pair HCRS before it (round its form's pairs)
      jld j3, j1, HT4
      jld j10, j1, HCRS
      jadd j7, j3, j1
  hg_cs:
      jjz j10, hg_csd
      jld j7, j7, 24
      jldi j8, 63
      jsar j8, j7, j8
      jjz j8, hg_prev
      jld j6, j1, HT5
      jld j7, j6, 40
  hg_prev:
      jldi j8, 5
      jshl j7, j7, j8
      jld j8, j1, HFL
      jadd j7, j7, j8
      jldi j8, 1
      jsub j10, j10, j8
      jjmp hg_cs
  hg_csd:
      jld j7, j7, 16              ; the crossed second word
      jld j8, j3, 8               ; its first
      jsub j9, j8, j7
      jjz j9, hg_next
      jld j9, j1, HT1
      jjz j9, hg_cor
      jadd j9, j7, j1
      jadd j7, j8, j1
      jadd j8, j9, j1
  hg_cor:
      jst j8, j1, HA
      jst j7, j1, HB
      jldi j7, 1
      jst j7, j1, HTG
      jcall hl_entry
    hg_next:
      jldi j1, 0
      jld j2, j1, HI
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HI
      jjmp hg_lap
  hg_pend:
    jld j2, j1, HPASS
    jldi j3, 2
    jsub j3, j2, j3
    jjz j3, hg_done
    jldi j2, HGT                  ; each pair of words its place: where the ones before end
    jld j3, j2, 8
    jldi j4, 1
    jadd j3, j3, j4
    jld j4, j2, 0
    jld j5, j2, 24
    jldi j6, 0
    hg_s:
      jjz j3, hg_sd
      jld j7, j4, 0
      jjz j7, hg_sn
      jst j6, j4, 16
      jst j1, j4, 24
      jld j7, j4, 8
      jadd j6, j6, j7
    hg_sn:
      jadd j4, j4, j5
      jldi j7, 1
      jsub j3, j3, j7
      jjmp hg_s
  hg_sd:
    jst j6, j1, HNGE
    jldi j2, 2
    jst j2, j1, HPASS
    jjmp hg_pass
hg_done:
  jret

; Two forms that hold the same pair of words: the same way (1) or the other way round (2), as read or crossed (HAG:
; how many read alike, how many with one of them crossed, how many with both crossed: what chance alone gives them). Uses j1-j14.
hl_agree:
  jldi j2, HAG
  jcall hl_clear
  jldi j1, 0
  jld j2, j1, HNM               ; (no relation is glue until it says a pair both ways)
  jld j3, j1, HNANT
  ha_z:
    jjz j2, ha_zd
    jst j1, j3, 0
    jldi j4, 8
    jadd j3, j3, j4
    jldi j4, 1
    jsub j2, j2, j4
    jjmp ha_z
ha_zd:
  jldi j2, HGT
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HT1               ; places left
  jld j4, j2, 0
  jst j4, j1, HT2               ; the place
  ha_g:
    jldi j1, 0
    jld j3, j1, HT1
    jjz j3, ha_done
    jld j4, j1, HT2
    jld j5, j4, 0
    jjz j5, ha_gn
    jld j5, j4, 8
    jldi j6, 2
    jsub j6, j5, j6
    jldi j7, 63
    jsar j6, j6, j7
    jjnz j6, ha_gn
    jst j1, j1, HI
    ha_x:
      jldi j1, 0
      jld j4, j1, HT2
      jld j2, j1, HI
      jld j3, j4, 8
      jsub j3, j2, j3
      jjz j3, ha_gn
      jldi j3, 1
      jadd j3, j2, j3
      jst j3, j1, HJ
      ha_y:
        jldi j1, 0
        jld j4, j1, HT2
        jld j3, j1, HJ
        jld j5, j4, 8
        jsub j5, j3, j5
        jjz j5, ha_xn
        jld j5, j4, 16
        jld j6, j1, HI
        jadd j6, j6, j5
        jldi j7, 24
        jmul j6, j6, j7
        jld j8, j1, HGE
        jadd j6, j6, j8           ; x
        jadd j9, j3, j5
        jmul j9, j9, j7
        jadd j9, j9, j8           ; y
        jld j10, j6, 0
        jld j11, j9, 0
        jsub j12, j10, j11
        jjnz j12, ha_two
        jld j12, j6, 16           ; one relation with itself: a pair it says both ways makes it glue
        jld j13, j9, 16
        jor j12, j12, j13
        jjnz j12, ha_yn
        jld j12, j6, 8
        jld j13, j9, 8
        jsub j12, j12, j13
        jjz j12, ha_yn
        jldi j12, 3
        jshl j12, j10, j12
        jld j13, j1, HNANT
        jadd j12, j12, j13
        jldi j13, 1
        jst j13, j12, 0
        jjmp ha_yn
      ha_two:
        jld j12, j6, 16
        jld j13, j9, 16
        jadd j14, j12, j13
        jst j14, j1, HTG          ; how many of the two are crossed (both: the all-crossed world)
        jld j12, j6, 8
        jld j13, j9, 8
        jsub j12, j12, j13
        jldi j13, 1
        jjz j12, ha_same
        jldi j13, 2
      ha_same:
        jst j13, j1, HDIR
        jsub j12, j10, j11        ; the first form, the second
        jldi j14, 63
        jsar j12, j12, j14
        jjnz j12, ha_ord
        jadd j12, j10, j1
        jadd j10, j11, j1
        jadd j11, j12, j1
      ha_ord:
        jst j10, j1, HA
        jst j11, j1, HB
        jadd j5, j10, j1
        jadd j6, j11, j1
        jcall hl_mix
        jld j6, j1, HDIR
        jcall hl_mix
        jjnz j5, ha_k
        jldi j5, 1
      ha_k:
        jldi j2, HAG
        jcall pl_take
        jldi j1, 0
        jjz j6, ha_old
        jld j7, j1, HA
        jst j7, j4, 8
        jld j7, j1, HB
        jst j7, j4, 16
        jld j7, j1, HDIR
        jst j7, j4, 24
      ha_old:
        jld j7, j1, HTG
        jldi j8, 3
        jshl j7, j7, j8
        jadd j7, j7, j4
        jld j8, j7, 32
        jldi j9, 1
        jadd j8, j8, j9
        jst j8, j7, 32
      ha_yn:
        jldi j1, 0
        jld j3, j1, HJ
        jldi j4, 1
        jadd j3, j3, j4
        jst j3, j1, HJ
        jjmp ha_y
    ha_xn:
      jldi j1, 0
      jld j2, j1, HI
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HI
      jjmp ha_x
  ha_gn:
    jldi j1, 0
    jld j4, j1, HT2
    jldi j5, HGT
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HT2
    jld j3, j1, HT1
    jldi j4, 1
    jsub j3, j3, j4
    jst j3, j1, HT1
    jjmp ha_g
ha_done:
  jret

; The words of relation j2 (its own form: the first of it). Uses j1-j14.
hl_sayroot:
  jjmp hl_sayform

; The words of form j2 (by its number). Uses j1-j14.
hl_sayform:
  jldi j3, 48
  jmul j3, j2, j3
  jldi j1, 0
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j4, j3, 24
  jldi j5, 63
  jsar j5, j4, j5
  jjz j5, hsf_read
  jld j2, j3, 16                ; deduced: its relation, chained ("<it> + <it>")
  jld j4, j1, HSFD
  jldi j5, 3
  jshl j5, j4, j5
  jadd j5, j5, j1
  jst j2, j5, HSFS
  jldi j5, 1
  jadd j4, j4, j5
  jst j4, j1, HSFD
  jcall hl_sayroot
  jldi j1, S_MAS
  jcall puts
  jld j4, j1, HSFD
  jldi j5, 1
  jsub j4, j4, j5
  jst j4, j1, HSFD
  jldi j5, 3
  jshl j5, j4, j5
  jadd j5, j5, j1
  jld j2, j5, HSFS
  jjmp hl_sayroot
hsf_read:
  jld j2, j3, 8
  jld j4, j3, 24
  jld j3, j3, 16
  jadd j4, j3, j4
  jldi j5, -1
  jjmp en_saywords

; The tanda (Capitan, 2026-11-08: "that the 7^3 cube learns 16 relations at a time"): the forms of the strongest
; relations of relations (each brings its two), until HTK of them. For each, the three bottom pieces (of HTN^2) its
; pairs fall on most, a pair by its two words either way (A xor B), as the cube's "cosa"; a form with fewer pieces than
; three is filled with pieces of its own key (nothing it holds, but not another's); and the same for its pairs crossed
; (the null). Said "T: i p p p | words", "N: i p p p", and the relations of relations among them, "R: i j way pairs".
; And each form whole, as a song (Capitan, 2026-11-08: "that it hears it"): each of its pairs a note of three pieces
; (from its two words either way), "P: i p p p" a note, "Q: i p p p" a note of its pairs crossed. Only relations whose
; forms fit in a song are taken: 255 notes at most, what a melody holds (measured: a melody joins up to 255 greetings).
; Then the new ones, for the cube to hear without learning them: forms not chosen that relate to a chosen one (the
; strongest first, as many as the chosen at most), "U: j r way pairs | words" (r the chosen one it relates to), and
; their songs, "V: j p p p" ("W:" crossed). And each one's cap and surname (Capitan, 2026-11-08: "we look at the
; surname: two distinctions, the cap's color and the surname, and we can tell even brothers apart"): its cap, a note a
; word of the form itself ("G: i p p p"; "H:" for the new ones), what only it has; its surname, a note a word its
; pairs say, the words said by two of its pairs or more (the most said, if they do not fit in a song with its cap)
; ("A: i p p p"; "B:" for the new ones), what its relatives share: "hijo de" and "padre de" share three pairs, but
; the names of the same family; a new one's surname leaves out the pairs a chosen one holds too (what made them
; relatives). And, counted here and not by the cube, which chosen one each new one shares the most
; surname with: "F: j r plain shared weighted shared", plain by how many names, weighted by how rare each name is
; (1000000 over how many of all the surnames say it: a name every family says tells nothing of which one). Uses
; j1-j14.
hl_tanda:
  jldi j1, 0
  jld j11, j1, HTK
  jadd j11, j11, j11
  jldi j2, 2
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jst j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HCH
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HUS
  jld j11, j1, HTN
  jmul j11, j11, j11
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HCNT
  jld j11, j1, HTK              ; the surnames: 256 words by form, how many; the relative by new one
  jadd j11, j11, j11
  jldi j2, 2
  jadd j11, j11, j2
  jst j11, j1, HT1
  jldi j2, 11
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HSUR
  jld j11, j1, HT1
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HSUN
  jld j11, j1, HT1
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HRELS
  jst j1, j1, HNCH
  jst j1, j1, HNUS
  ht_pick:                      ; the strongest relation of relations not taken yet
    jldi j1, 0
    jld j2, j1, HNCH
    jld j3, j1, HTK
    jsub j3, j2, j3
    jjz j3, ht_picked
    jst j1, j1, HTBEST
    jst j1, j1, HTE
    jldi j2, HAG
    jld j3, j2, 8
    jldi j5, 1
    jadd j3, j3, j5
    jst j3, j1, HTI
    jld j4, j2, 0
    jst j4, j1, HTJ
    ht_s:
      jldi j1, 0
      jld j3, j1, HTI
      jjz j3, ht_sd
      jld j4, j1, HTJ
      jld j5, j4, 0
      jjz j5, ht_sn
      jcall hl_score
      jldi j1, 0
      jjz j6, ht_sn
      jld j7, j4, 8               ; (both forms fit in a song)
      jcall ht_fits
      jjz j7, ht_sn
      jld j7, j4, 16
      jcall ht_fits
      jjz j7, ht_sn
      jld j7, j1, HTBEST
      jsub j7, j7, j6
      jldi j8, 63
      jsar j7, j7, j8
      jjz j7, ht_sn
      jld j7, j1, HNUS            ; (not taken)
      jld j8, j1, HUS
      ht_u:
        jjz j7, ht_new
        jld j9, j8, 0
        jsub j9, j9, j4
        jjz j9, ht_sn
        jldi j9, 8
        jadd j8, j8, j9
        jldi j9, 1
        jsub j7, j7, j9
        jjmp ht_u
    ht_new:
      jst j6, j1, HTBEST
      jst j4, j1, HTE
    ht_sn:
      jldi j1, 0
      jld j4, j1, HTJ
      jldi j5, HAG
      jld j5, j5, 24
      jadd j4, j4, j5
      jst j4, j1, HTJ
      jld j3, j1, HTI
      jldi j5, 1
      jsub j3, j3, j5
      jst j3, j1, HTI
      jjmp ht_s
  ht_sd:
    jld j4, j1, HTE
    jjz j4, ht_picked             ; none left
    jld j5, j1, HNUS
    jldi j6, 3
    jshl j6, j5, j6
    jld j7, j1, HUS
    jadd j6, j6, j7
    jst j4, j6, 0
    jldi j6, 1
    jadd j5, j5, j6
    jst j5, j1, HNUS
    jldi j9, 8
    ht_side:                      ; its two forms, if not chosen yet
      jldi j1, 0
      jld j2, j1, HNCH
      jld j3, j1, HTK
      jsub j3, j2, j3
      jjz j3, ht_pick
      jld j4, j1, HTE
      jadd j4, j4, j9
      jld j4, j4, 0
      jldi j5, 3
      jshl j5, j4, j5
      jld j6, j1, HBST
      jadd j5, j5, j6
      jld j6, j5, 0
      jjnz j6, ht_sidn
      jldi j6, 1
      jst j6, j5, 0
      jldi j5, 3
      jshl j5, j2, j5
      jld j6, j1, HCH
      jadd j5, j5, j6
      jst j4, j5, 0
      jldi j5, 1
      jadd j2, j2, j5
      jst j2, j1, HNCH
    ht_sidn:
      jldi j5, 16
      jsub j5, j9, j5
      jjz j5, ht_pick
      jldi j9, 16
      jjmp ht_side
ht_picked:
  jldi j2, HAG                  ; the relations of relations among them
  jld j3, j2, 8
  jldi j5, 1
  jadd j3, j3, j5
  jst j3, j1, HTI
  jld j4, j2, 0
  jst j4, j1, HTJ
  ht_r:
    jldi j1, 0
    jld j3, j1, HTI
    jjz j3, ht_rd
    jld j4, j1, HTJ
    jld j5, j4, 0
    jjz j5, ht_rn
    jcall hl_score
    jldi j1, 0
    jjz j6, ht_rn
    jld j2, j4, 8
    jcall ht_index
    jldi j7, 63
    jsar j7, j6, j7
    jjnz j7, ht_rn
    jst j6, j1, HP1
    jld j4, j1, HTJ
    jld j2, j4, 16
    jcall ht_index
    jldi j7, 63
    jsar j7, j6, j7
    jjnz j7, ht_rn
    jst j6, j1, HP2
    jldi j1, S_RT
    jcall puts
    jld j2, j1, HP1
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j2, j1, HP2
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j4, j1, HTJ
    jld j2, j4, 24
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j4, j1, HTJ
    jld j2, j4, 32
    jcall putnum
    jldi j2, 10
    jcall putch
  ht_rn:
    jldi j1, 0
    jld j4, j1, HTJ
    jldi j5, HAG
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HTJ
    jld j3, j1, HTI
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HTI
    jjmp ht_r
ht_rd:
  jldi j2, S_PT
  jst j2, j1, HSR
  jldi j2, S_QT
  jst j2, j1, HSC
  jst j1, j1, HTI
  ht_c:                         ; each form's pieces, read and crossed
    jldi j1, 0
    jld j2, j1, HTI
    jld j3, j1, HNCH
    jsub j3, j2, j3
    jjz j3, ht_done
    jst j2, j1, HTSAY
    jst j1, j1, HTG
    jcall ht_code
    jldi j1, S_TT
    jcall ht_say
    jld j2, j1, HTI
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCH
    jadd j3, j3, j4
    jld j2, j3, 0
    jcall hl_sayform
    jldi j2, 10
    jcall putch
    jldi j1, 0
    jldi j2, 1
    jst j2, j1, HTG
    jcall ht_code
    jldi j1, S_NT
    jcall ht_say
    jldi j2, 10
    jcall putch
    jldi j1, 0
    jst j1, j1, HTG
    jcall ht_song
    jldi j1, 0
    jldi j2, 1
    jst j2, j1, HTG
    jcall ht_song
    jldi j1, S_GT
    jcall ht_cap
    jldi j1, S_AT
    jcall ht_surname
    jldi j1, 0
    jld j2, j1, HTI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HTI
    jjmp ht_c
ht_done:
  jcall ht_news
  jcall ht_family
  jret

; Which chosen one each new one shares the most surname with, by names and by rare names: "F: j r plain shared
; weighted shared". Uses j1-j14.
ht_family:
  jldi j1, 0
  jld j2, j1, HNCH
  jld j3, j1, HNNEW
  jadd j2, j2, j3
  jst j2, j1, HFT
  jst j1, j1, HFJ
  hf2_j:
    jldi j1, 0
    jld j2, j1, HFJ
    jld j3, j1, HNNEW
    jsub j3, j2, j3
    jjz j3, hf2_done
    jst j1, j1, HFBP
    jst j1, j1, HFSP
    jst j1, j1, HFBW
    jst j1, j1, HFSW
    jldi j2, -1
    jst j2, j1, HFBP
    jst j2, j1, HFBW
    jst j1, j1, HFI
    hf2_i:                      ; each chosen one
      jldi j1, 0
      jld j2, j1, HFI
      jld j3, j1, HNCH
      jsub j3, j2, j3
      jjz j3, hf2_say
      jld j2, j1, HNCH          ; the new one's surname
      jld j3, j1, HFJ
      jadd j2, j2, j3
      jcall hf2_list            ; j9 its words, j10 how many
      jadd j12, j9, j1
      jadd j13, j10, j1
      jld j2, j1, HFI
      jcall hf2_list            ; the chosen one's: j9, j10
      jldi j14, 0               ; plain
      jst j1, j1, HT1           ; weighted
      hf2_w:
        jjz j13, hf2_wd
        jld j5, j12, 0
        jadd j6, j9, j1
        jadd j7, j10, j1
        hf2_in:
          jjz j7, hf2_wn
          jld j8, j6, 0
          jsub j8, j8, j5
          jjz j8, hf2_hit
          jldi j8, 8
          jadd j6, j6, j8
          jldi j8, 1
          jsub j7, j7, j8
          jjmp hf2_in
      hf2_hit:
        jldi j8, 1
        jadd j14, j14, j8
        jst j9, j1, HT2
        jst j10, j1, HT3
        jst j12, j1, HT4
        jst j13, j1, HT5
        jst j14, j1, HDIR
        jcall hf2_weight        ; j5's weight -> j2
        jldi j1, 0
        jld j3, j1, HT1
        jadd j3, j3, j2
        jst j3, j1, HT1
        jld j9, j1, HT2
        jld j10, j1, HT3
        jld j12, j1, HT4
        jld j13, j1, HT5
        jld j14, j1, HDIR
      hf2_wn:
        jldi j8, 8
        jadd j12, j12, j8
        jldi j8, 1
        jsub j13, j13, j8
        jjmp hf2_w
    hf2_wd:
      jld j3, j1, HFSP          ; the most names
      jsub j3, j3, j14
      jldi j4, 63
      jsar j3, j3, j4
      jjz j3, hf2_pw
      jst j14, j1, HFSP
      jld j2, j1, HFI
      jst j2, j1, HFBP
    hf2_pw:
      jld j3, j1, HFSW          ; the rarest names
      jld j5, j1, HT1
      jsub j3, j3, j5
      jldi j4, 63
      jsar j3, j3, j4
      jjz j3, hf2_in2
      jst j5, j1, HFSW
      jld j2, j1, HFI
      jst j2, j1, HFBW
    hf2_in2:
      jld j2, j1, HFI
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HFI
      jjmp hf2_i
  hf2_say:
    jldi j1, S_FT
    jcall puts
    jld j2, j1, HFJ
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j2, j1, HFJ
    jldi j3, 3
    jshl j2, j2, j3
    jld j3, j1, HRELS
    jadd j2, j2, j3
    jld j2, j2, 0
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j2, j1, HFBP
    jcall hf2_num
    jld j2, j1, HFSP
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j2, j1, HFBW
    jcall hf2_num
    jld j2, j1, HFSW
    jcall putnum
    jldi j2, 10
    jcall putch
    jldi j1, 0
    jld j2, j1, HFJ
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HFJ
    jjmp hf2_j
hf2_done:
  jret

; j2 (-1: "-") and a space. Uses j1-j4.
hf2_num:
  jldi j3, 63
  jsar j3, j2, j3
  jjz j3, hfn_n
  jldi j2, 45
  jcall putch
  jjmp hfn_s
hfn_n:
  jcall putnum
hfn_s:
  jldi j2, 32
  jcall putch
  jret

; The surname of form j2 of the tanda -> j9 its words, j10 how many. Uses j2-j4, j9, j10.
hf2_list:
  jldi j3, 3
  jshl j3, j2, j3
  jldi j4, 0
  jld j4, j4, HSUN
  jadd j3, j3, j4
  jld j10, j3, 0
  jldi j3, 11
  jshl j9, j2, j3
  jldi j4, 0
  jld j4, j4, HSUR
  jadd j9, j9, j4
  jret

; The weight of name j5: 1000000 over how many of the tanda's surnames say it -> j2. Uses j1-j11.
hf2_weight:
  jldi j1, 0
  jldi j11, 0                   ; how many say it
  jld j8, j1, HFT
  hfw_f:
    jjz j8, hfw_d
    jldi j2, 1
    jsub j2, j8, j2
    jcall hf2_list
    hfw_w:
      jjz j10, hfw_fn
      jld j6, j9, 0
      jsub j6, j6, j5
      jjz j6, hfw_has
      jldi j6, 8
      jadd j9, j9, j6
      jldi j6, 1
      jsub j10, j10, j6
      jjmp hfw_w
  hfw_has:
    jldi j6, 1
    jadd j11, j11, j6
  hfw_fn:
    jldi j6, 1
    jsub j8, j8, j6
    jjmp hfw_f
hfw_d:
  jldi j2, 15
  jshi j2, 4240h
  jjz j11, hfw_z
  jdiv j2, j2, j11
hfw_z:
  jret

; The new ones: forms not chosen that relate to a chosen one (the strongest first, as many as the chosen at most),
; each said "U: j r way pairs | words" and sung ("V:", "W:" crossed). Uses j1-j14.
ht_news:
  jldi j1, 0
  jst j1, j1, HNNEW
  jldi j2, S_VT
  jst j2, j1, HSR
  jldi j2, S_WT
  jst j2, j1, HSC
  hn_pick:
    jldi j1, 0
    jld j2, j1, HNNEW
    jld j3, j1, HNCH
    jsub j3, j2, j3
    jjz j3, hn_done
    jst j1, j1, HTBEST
    jst j1, j1, HTE
    jldi j2, HAG
    jld j3, j2, 8
    jldi j5, 1
    jadd j3, j3, j5
    jst j3, j1, HTI
    jld j4, j2, 0
    jst j4, j1, HTJ
    hn_s:
      jldi j1, 0
      jld j3, j1, HTI
      jjz j3, hn_sd
      jld j4, j1, HTJ
      jld j5, j4, 0
      jjz j5, hn_sn
      jcall hl_score
      jldi j1, 0
      jjz j6, hn_sn
      jld j7, j1, HTBEST
      jsub j7, j7, j6
      jldi j8, 63
      jsar j7, j7, j8
      jjz j7, hn_sn
      jld j7, j4, 8               ; one chosen, the other neither chosen nor new, and fitting in a song
      jcall hn_flag
      jadd j9, j7, j1
      jld j7, j4, 16
      jcall hn_flag
      jadd j10, j7, j1
      jadd j11, j9, j10
      jldi j12, 1
      jsub j11, j11, j12
      jjnz j11, hn_sn
      jjz j9, hn_c2
      jld j7, j4, 16
      jjmp hn_cf
    hn_c2:
      jld j7, j4, 8
    hn_cf:
      jcall ht_fits
      jjz j7, hn_sn
      jst j6, j1, HTBEST
      jst j4, j1, HTE
    hn_sn:
      jldi j1, 0
      jld j4, j1, HTJ
      jldi j5, HAG
      jld j5, j5, 24
      jadd j4, j4, j5
      jst j4, j1, HTJ
      jld j3, j1, HTI
      jldi j5, 1
      jsub j3, j3, j5
      jst j3, j1, HTI
      jjmp hn_s
  hn_sd:
    jld j4, j1, HTE
    jjz j4, hn_done
    jld j7, j4, 8                 ; which is the new one, which the chosen
    jcall hn_flag
    jjz j7, hn_first
    jld j2, j4, 16
    jld j3, j4, 8
    jjmp hn_put
  hn_first:
    jld j2, j4, 8
    jld j3, j4, 16
  hn_put:
    jldi j5, 3
    jshl j5, j2, j5
    jld j6, j1, HBST
    jadd j5, j5, j6
    jldi j6, 2
    jst j6, j5, 0                 ; (new now)
    jld j5, j1, HNCH
    jld j6, j1, HNNEW
    jadd j5, j5, j6
    jst j5, j1, HTI
    jldi j6, 3
    jshl j6, j5, j6
    jld j7, j1, HCH
    jadd j6, j6, j7
    jst j2, j6, 0
    jadd j2, j3, j1
    jcall ht_index
    jldi j1, 0
    jst j6, j1, HP1
    jld j2, j1, HNNEW
    jldi j3, 3
    jshl j2, j2, j3
    jld j3, j1, HRELS
    jadd j2, j2, j3
    jst j6, j2, 0
    jldi j1, S_UT
    jcall puts
    jld j2, j1, HNNEW
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j2, j1, HP1
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j4, j1, HTE
    jld j2, j4, 24
    jcall putnum
    jldi j2, 32
    jcall putch
    jld j4, j1, HTE
    jld j2, j4, 32
    jcall putnum
    jldi j1, S_BARR
    jcall puts
    jld j2, j1, HTI
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCH
    jadd j3, j3, j4
    jld j2, j3, 0
    jcall hl_sayform
    jldi j2, 10
    jcall putch
    jldi j1, 0
    jld j2, j1, HNNEW
    jst j2, j1, HTSAY
    jst j1, j1, HTG
    jcall ht_song
    jldi j1, 0
    jldi j2, 1
    jst j2, j1, HTG
    jcall ht_song
    jldi j1, S_HT
    jcall ht_cap
    jldi j1, S_BT
    jcall ht_surname
    jldi j1, 0
    jld j2, j1, HNNEW
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HNNEW
    jjmp hn_pick
hn_done:
  jret

; The three pieces of a note from value j7 (a print, or the two words of a pair): all different, of HTN^2 -> HP1-HP3.
; Uses j1, j7-j13.
ht_pieces:
  jldi j1, 0
  jldi j8, 4
  jshr j7, j7, j8
  jld j8, j1, HTN
  jmul j8, j8, j8
  jdiv j9, j7, j8
  jmul j10, j9, j8
  jsub j10, j7, j10
  jst j10, j1, HP1
  jdiv j7, j9, j8
  jmul j11, j7, j8
  jsub j11, j9, j11
  jsub j12, j11, j10
  jjnz j12, hpc_2
  jldi j12, 1
  jadd j11, j11, j12
  jsub j12, j11, j8
  jjnz j12, hpc_2
  jldi j11, 0
hpc_2:
  jst j11, j1, HP2
  jdiv j9, j7, j8
  jmul j12, j9, j8
  jsub j12, j7, j12
  hpc_3:
    jsub j13, j12, j10
    jjz j13, hpc_3n
    jsub j13, j12, j11
    jjnz j13, hpc_3d
  hpc_3n:
    jldi j13, 1
    jadd j12, j12, j13
    jsub j13, j12, j8
    jjnz j13, hpc_3
    jldi j12, 0
    jjmp hpc_3
hpc_3d:
  jst j12, j1, HP3
  jret

; The cap of form HTI (of HCH), said with the text at j1: a note a word of the form. Uses j1-j14.
ht_cap:
  jldi j2, 0
  jst j1, j2, HSX
  jldi j1, 0
  jld j2, j1, HTI
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCH
  jadd j3, j3, j4
  jld j2, j3, 0
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jst j3, j1, HT3
  jst j1, j1, HTJ
  hcp_lap:
    jldi j1, 0
    jld j3, j1, HT3
    jld j4, j3, 24
    jld j5, j1, HTJ
    jsub j4, j5, j4
    jjz j4, hcp_done
    jld j2, j3, 8
    jld j4, j3, 16
    jadd j3, j4, j5
    jcall en_word
    jadd j7, j5, j1
    jcall ht_pieces
    jld j1, j1, HSX
    jcall ht_say
    jldi j2, 10
    jcall putch
    jldi j1, 0
    jld j2, j1, HTJ
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HTJ
    jjmp hcp_lap
hcp_done:
  jret

; The surname of form HTI, said with the text at j1: a note a word its pairs say, the words said by two of its pairs or
; more; if they do not fit in a song with its cap (255 notes), the most said (the fewest times raised until they fit).
; Uses j1-j14.
ht_surname:
  jldi j2, 0
  jst j1, j2, HSX
  jldi j2, HWX
  jld j3, j2, 0
  jjnz j3, hsn_have
  jldi j3, 16
  jcall pl_new
  jjmp hsn_count
hsn_have:
  jcall hl_clear
hsn_count:
  jldi j1, 0
  jld j2, j1, HTI
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCH
  jadd j3, j3, j4
  jld j2, j3, 0
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jst j3, j1, HT3
  jld j2, j3, 40
  hsn_p:                        ; each word of its pairs, counted
    jldi j1, 0
    jst j2, j1, HTJ
    jldi j3, 63
    jsar j3, j2, j3
    jjnz j3, hsn_pd
    jcall hsn_shared
    jjnz j6, hsn_pn
    jldi j1, 0
    jld j2, j1, HTJ
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j5, j3, 8
    jcall hsn_one
    jldi j1, 0
    jld j2, j1, HTJ
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j5, j3, 16
    jcall hsn_one
  hsn_pn:
    jldi j1, 0
    jld j2, j1, HTJ
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j2, j3, 24
    jjmp hsn_p
hsn_pd:
  jldi j2, 2                    ; the fewest times: two, raised until they fit with its cap
  jst j2, j1, HSCUT
  hsn_c:
    jldi j1, 0
    jst j1, j1, HSWN
    jldi j2, HWX
    jld j3, j2, 8
    jldi j4, 1
    jadd j3, j3, j4
    jld j4, j2, 0
    jld j5, j2, 24
    jld j6, j1, HSCUT
    hsn_w:
      jjz j3, hsn_wd
      jld j7, j4, 0
      jjz j7, hsn_wn
      jld j7, j4, 8
      jsub j7, j7, j6
      jldi j8, 63
      jsar j7, j7, j8
      jjnz j7, hsn_wn
      jld j7, j1, HSWN
      jldi j8, 1
      jadd j7, j7, j8
      jst j7, j1, HSWN
    hsn_wn:
      jadd j4, j4, j5
      jldi j7, 1
      jsub j3, j3, j7
      jjmp hsn_w
  hsn_wd:
    jld j3, j1, HT3
    jld j3, j3, 24
    jld j2, j1, HSWN
    jadd j2, j2, j3
    jldi j3, 256
    jsub j2, j2, j3
    jldi j3, 63
    jsar j2, j2, j3
    jjnz j2, hsn_say
    jld j2, j1, HSCUT
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HSCUT
    jjmp hsn_c
hsn_say:
  jldi j2, HWX
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HT4
  jld j4, j2, 0
  jst j4, j1, HT5
  hsn_s:
    jldi j1, 0
    jld j3, j1, HT4
    jjz j3, hsn_done
    jld j4, j1, HT5
    jld j7, j4, 0
    jjz j7, hsn_sn
    jld j8, j4, 8
    jld j9, j1, HSCUT
    jsub j8, j8, j9
    jldi j9, 63
    jsar j8, j8, j9
    jjnz j8, hsn_sn
    jld j8, j1, HTI               ; (kept, for the count)
    jldi j9, 3
    jshl j9, j8, j9
    jld j10, j1, HSUN
    jadd j9, j9, j10
    jld j10, j9, 0
    jldi j11, 11
    jshl j8, j8, j11
    jld j11, j1, HSUR
    jadd j8, j8, j11
    jldi j11, 3
    jshl j11, j10, j11
    jadd j8, j8, j11
    jst j7, j8, 0
    jldi j11, 1
    jadd j10, j10, j11
    jst j10, j9, 0
    jcall ht_pieces
    jld j1, j1, HSX
    jcall ht_say
    jldi j2, 10
    jcall putch
  hsn_sn:
    jldi j1, 0
    jld j4, j1, HT5
    jldi j5, HWX
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HT5
    jld j3, j1, HT4
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HT4
    jjmp hsn_s
hsn_done:
  jret

; j6 = 1 if pair HTJ is of a new one and a chosen one holds it too: what made them relatives is not their surname (the
; count would find it by what it was given). Uses j1-j14.
hsn_shared:
  jldi j1, 0
  jld j2, j1, HTI
  jld j3, j1, HNCH
  jsub j3, j2, j3
  jldi j4, 63
  jsar j3, j3, j4
  jldi j6, 0
  jjnz j3, hsh_done             ; (a chosen one: all its pairs)
  jld j2, j1, HTJ
  jldi j3, 5
  jshl j3, j2, j3
  jld j4, j1, HFL
  jadd j3, j3, j4
  jld j5, j3, 8
  jst j5, j1, HA
  jld j5, j3, 16
  jst j5, j1, HB
  jcall hl_pkey
  jldi j2, HGT
  jcall pl_find
  jldi j1, 0
  jldi j6, 0
  jld j7, j4, 0
  jld j8, j1, HKEY
  jsub j7, j7, j8
  jjnz j7, hsh_done
  jld j9, j4, 16                ; its entries: a chosen one's, read?
  jld j10, j4, 8
  hsh_lap:
    jjz j10, hsh_done
    jldi j11, 24
    jmul j11, j9, j11
    jld j12, j1, HGE
    jadd j11, j11, j12
    jld j12, j11, 16
    jjnz j12, hsh_next
    jld j7, j11, 0
    jcall hn_flag
    jldi j8, 1
    jsub j7, j7, j8
    jjnz j7, hsh_next
    jldi j6, 1
    jjmp hsh_done
  hsh_next:
    jldi j11, 1
    jadd j9, j9, j11
    jsub j10, j10, j11
    jjmp hsh_lap
hsh_done:
  jret

; Word j5 of a pair counted in HWX. Uses j1-j8.
hsn_one:
  jldi j2, HWX
  jcall pl_take
  jldi j1, 0
  jld j7, j4, 8
  jldi j8, 1
  jadd j7, j7, j8
  jst j7, j4, 8
  jret

; j7 = the flag of form j7 (0 nothing, 1 chosen, 2 new). Uses j7, j8.
hn_flag:
  jldi j8, 3
  jshl j7, j7, j8
  jldi j8, 0
  jld j8, j8, HBST
  jadd j7, j7, j8
  jld j7, j7, 0
  jret

; j7 = 1 if form j7 fits in a song (255 pairs at most). Uses j7, j8.
ht_fits:
  jldi j8, 48
  jmul j7, j7, j8
  jldi j8, 0
  jld j8, j8, HMA
  jadd j7, j7, j8
  jld j7, j7, 32
  jldi j8, 256
  jsub j7, j7, j8
  jldi j8, 63
  jsar j7, j7, j8
  jldi j8, 1
  jand j7, j7, j8
  jret

; The chosen form HTI as a song, a note a pair (HTG 1: its pairs crossed): "P: i p p p" ("Q:" crossed), the three
; pieces of a pair from its two words either way (A xor B), all different. Uses j1-j14.
ht_song:
  jldi j1, 0
  jld j2, j1, HTN
  jmul j2, j2, j2
  jst j2, j1, HT2
  jld j2, j1, HTI
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCH
  jadd j3, j3, j4
  jld j2, j3, 0
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jst j3, j1, HT3
  jld j2, j3, 40
  hsg_lap:
    jldi j1, 0
    jst j2, j1, HTJ
    jldi j3, 63
    jsar j3, j2, j3
    jjnz j3, hsg_done
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j5, j3, 8
    jld j6, j3, 16
    jld j7, j1, HTG
    jjz j7, hsg_k
    jld j7, j3, 24
    jldi j8, 63
    jsar j8, j7, j8
    jjz j8, hsg_pv
    jld j8, j1, HT3
    jld j7, j8, 40
  hsg_pv:
    jldi j8, 5
    jshl j7, j7, j8
    jadd j7, j7, j4
    jld j6, j7, 16
  hsg_k:
    jsub j7, j5, j6
    jjz j7, hsg_next
    jxor j7, j5, j6
    jldi j8, 4
    jshr j7, j7, j8
    jld j8, j1, HT2
    jdiv j9, j7, j8             ; the first piece
    jmul j10, j9, j8
    jsub j10, j7, j10
    jst j10, j1, HP1
    jdiv j7, j9, j8             ; the second, not the first
    jmul j11, j7, j8
    jsub j11, j9, j11
    jsub j12, j11, j10
    jjnz j12, hsg_2
    jldi j12, 1
    jadd j11, j11, j12
    jsub j12, j11, j8
    jjnz j12, hsg_2
    jldi j11, 0
  hsg_2:
    jst j11, j1, HP2
    jdiv j9, j7, j8             ; the third, not the others
    jmul j12, j9, j8
    jsub j12, j7, j12
    hsg_3:
      jsub j13, j12, j10
      jjz j13, hsg_3n
      jsub j13, j12, j11
      jjnz j13, hsg_3d
    hsg_3n:
      jldi j13, 1
      jadd j12, j12, j13
      jsub j13, j12, j8
      jjnz j13, hsg_3
      jldi j12, 0
      jjmp hsg_3
  hsg_3d:
    jst j12, j1, HP3
    jld j2, j1, HTG
    jld j3, j1, HSR
    jjz j2, hsg_say
    jld j3, j1, HSC
  hsg_say:
    jadd j1, j3, j1
    jcall ht_say
    jldi j2, 10
    jcall putch
  hsg_next:
    jldi j1, 0
    jld j2, j1, HTJ
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j2, j3, 24
    jjmp hsg_lap
hsg_done:
  jret

; The place of form j2 among the chosen -> j6 (-1: not chosen). Uses j6-j8.
ht_index:
  jldi j6, 0
  hti_lap:
    jldi j7, 0
    jld j7, j7, HNCH
    jsub j7, j6, j7
    jjz j7, hti_no
    jldi j7, 3
    jshl j7, j6, j7
    jldi j8, 0
    jld j8, j8, HCH
    jadd j7, j7, j8
    jld j7, j7, 0
    jsub j7, j7, j2
    jjz j7, hti_yes
    jldi j7, 1
    jadd j6, j6, j7
    jjmp hti_lap
hti_yes:
  jret
hti_no:
  jldi j6, -1
  jret

; The text at j1, then "i p p p" (HTI, HP1-HP3), then " | ". Uses j1-j14.
ht_say:
  jcall puts
  jld j2, j1, HTSAY
  jcall putnum
  jldi j2, 32
  jcall putch
  jld j2, j1, HP1
  jcall putnum
  jldi j2, 32
  jcall putch
  jld j2, j1, HP2
  jcall putnum
  jldi j2, 32
  jcall putch
  jld j2, j1, HP3
  jcall putnum
  jldi j1, S_BARR
  jcall puts
  jret

; The three pieces of the chosen form HTI, by its pairs (HTG 1: crossed) -> HP1, HP2, HP3. Uses j1-j14.
ht_code:
  jldi j1, 0
  jld j2, j1, HTN
  jmul j2, j2, j2
  jst j2, j1, HT2               ; n^2
  jld j3, j1, HCNT
  jadd j4, j2, j1
  htz:
    jjz j4, htz_d
    jst j1, j3, 0
    jldi j5, 8
    jadd j3, j3, j5
    jldi j5, 1
    jsub j4, j4, j5
    jjmp htz
htz_d:
  jld j2, j1, HTI
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCH
  jadd j3, j3, j4
  jld j2, j3, 0
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jst j3, j1, HT3               ; its form
  jld j2, j3, 40                ; its last pair
  htp:
    jldi j3, 63
    jsar j3, j2, j3
    jjnz j3, htp_d
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j5, j3, 8               ; A
    jld j6, j3, 16              ; B
    jld j7, j1, HTG
    jjz j7, htp_k
    jld j7, j3, 24              ; crossed: the B of the pair before (the last's, for the first)
    jldi j8, 63
    jsar j8, j7, j8
    jjz j8, htp_pv
    jld j8, j1, HT3
    jld j7, j8, 40
  htp_pv:
    jldi j8, 5
    jshl j7, j7, j8
    jadd j7, j7, j4
    jld j6, j7, 16
  htp_k:
    jsub j7, j5, j6
    jjz j7, htp_n
    jxor j7, j5, j6
    jldi j8, 20
    jshr j7, j7, j8
    jld j8, j1, HT2
    jdiv j9, j7, j8
    jmul j9, j9, j8
    jsub j7, j7, j9
    jldi j8, 3
    jshl j7, j7, j8
    jld j8, j1, HCNT
    jadd j7, j7, j8
    jld j8, j7, 0
    jldi j9, 1
    jadd j8, j8, j9
    jst j8, j7, 0
  htp_n:
    jld j2, j3, 24
    jjmp htp
htp_d:
  jldi j2, -1
  jst j2, j1, HP1
  jst j2, j1, HP2
  jst j2, j1, HP3
  jldi j10, HP1
  jldi j11, 3
  htt:                          ; three times: the most hit not taken (none: one of its own key)
    jjz j11, htt_d
    jldi j12, -1
    jldi j13, 0
    jldi j14, 0
    htx:
      jld j2, j1, HT2
      jsub j2, j14, j2
      jjz j2, htx_d
      jadd j2, j14, j1
      jcall ht_taken
      jjnz j6, htx_n
      jldi j2, 3
      jshl j2, j14, j2
      jld j3, j1, HCNT
      jadd j2, j2, j3
      jld j2, j2, 0
      jsub j3, j13, j2
      jldi j4, 63
      jsar j3, j3, j4
      jjz j3, htx_n
      jadd j12, j14, j1
      jadd j13, j2, j1
    htx_n:
      jldi j2, 1
      jadd j14, j14, j2
      jjmp htx
  htx_d:
    jldi j2, 63
    jsar j2, j12, j2
    jjz j2, htt_put
    jld j3, j1, HT3             ; of its own key
    jld j2, j3, 0
    jldi j4, 1
    jshr j2, j2, j4
    htk:
      jld j4, j1, HT2
      jdiv j5, j2, j4
      jmul j5, j5, j4
      jsub j12, j2, j5
      jadd j2, j12, j1
      jcall ht_taken
      jjz j6, htt_put
      jldi j4, 7
      jadd j2, j12, j4
      jjmp htk
  htt_put:
    jst j12, j10, 0
    jldi j2, 8
    jadd j10, j10, j2
    jldi j2, 1
    jsub j11, j11, j2
    jjmp htt
htt_d:
  jret

; j6 = 1 if piece j2 is one of HP1-HP3. Uses j6, j7.
ht_taken:
  jldi j6, 0
  jld j7, j6, HP1
  jsub j7, j7, j2
  jjz j7, htk_y
  jld j7, j6, HP2
  jsub j7, j7, j2
  jjz j7, htk_y
  jld j7, j6, HP3
  jsub j7, j7, j2
  jjz j7, htk_y
  jret
htk_y:
  jldi j6, 1
  jret

; The two numbers of the house's "tanda" (how many forms, the cube's side) in PRB, PRN -> HTK, HTN. Uses j1-j6.
hl_tread:
  jldi j1, 0
  jst j1, j1, HTK
  jst j1, j1, HTN
  jld j2, j1, PRB
  jld j3, j1, PRN
  jldi j4, HTK
  jldi j5, 0                    ; in a number
  htr_lap:
    jjz j3, htr_done
    jldb j6, j2, 0
    jldi j7, 48
    jsub j7, j6, j7
    jldi j8, 63
    jsar j8, j7, j8
    jjnz j8, htr_gap
    jldi j8, 10
    jsub j8, j7, j8
    jldi j9, 63
    jsar j8, j8, j9
    jjz j8, htr_gap
    jld j8, j4, 0
    jldi j9, 10
    jmul j8, j8, j9
    jadd j8, j8, j7
    jst j8, j4, 0
    jldi j5, 1
    jjmp htr_next
  htr_gap:
    jjz j5, htr_next
    jldi j5, 0
    jldi j8, HTN
    jsub j8, j4, j8
    jjz j8, htr_done
    jldi j4, HTN
  htr_next:
    jldi j6, 1
    jadd j2, j2, j6
    jsub j3, j3, j6
    jjmp htr_lap
htr_done:
  jret

; The properties each relation shows in the book, and what they refute (Capitan, 2026-11-08: reasoning, not chance).
; What a relation says of a word (on its A side: the B's it gives it; on its B side: the A's) is confirmed when two
; say it. A relation is "one B for each A" when two words at least have one confirmed B, and none has two confirmed
; B's (a counterexample breaks it only if it is confirmed too: one stray pair of the raw text, as "fue" taken for a
; father in "rosa fue padre de sol", refutes nothing). Joining two relations so that a word whose B is confirmed in
; one, where that one is so, gets another B from the other is a contradiction (HCFT, by the two and which way). The
; same for "one A for each B". Uses j1-j14.
hl_props:
  jldi j2, HFT2
  jcall hl_clear
  jldi j2, HFV
  jcall hl_clear
  jldi j2, HWGT
  jcall hl_clear
  jldi j2, HCFT
  jcall hl_clear
  jldi j1, 0
  jld j2, j1, HNM
  jadd j2, j2, j2
  jld j3, j1, HSUPP
  jld j4, j1, HBROK
  jld j6, j1, HPBP
  jld j7, j1, HPBW
  hp_z:
    jjz j2, hp_zd
    jst j1, j3, 0
    jst j1, j4, 0
    jst j1, j6, 0
    jst j1, j7, 0
    jldi j5, 8
    jadd j3, j3, j5
    jadd j4, j4, j5
    jadd j6, j6, j5
    jadd j7, j7, j5
    jldi j5, 1
    jsub j2, j2, j5
    jjmp hp_z
hp_zd:
  jld j2, j1, HSUSF             ; the suspended rule: in the relation its form is in now, on its side as it is there
  jjz j2, hp_sud
  jldi j3, 1
  jsub j2, j2, j3
  jand j4, j2, j3
  jst j4, j1, HSUSS
  jshr j2, j2, j3
  jcall hl_find
  jldi j1, 0
  jst j2, j1, HSUSR
  jld j4, j1, HSUSS
  jxor j4, j4, j3
  jst j4, j1, HSUSS
hp_sud:
  jldi j1, 0
  jld j2, j1, HNM               ; (no pairs by relation yet)
  jld j3, j1, HCCNT
  hp_cz:
    jjz j2, hp_czd
    jst j1, j3, 0
    jldi j4, 8
    jadd j3, j3, j4
    jldi j4, 1
    jsub j2, j2, j4
    jjmp hp_cz
hp_czd:
  jst j1, j1, HQ1               ; each pair of a form said by two, by its relation, turned to it: how many say it
  hp_f:
    jldi j1, 0
    jld j2, j1, HQ1
    jld j3, j1, HNF
    jsub j3, j2, j3
    jjz j3, hp_fd
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jst j3, j1, HQ2
    jld j2, j3, 0
    jldi j4, 48
    jmul j4, j2, j4
    jld j5, j1, HMA
    jadd j4, j4, j5
    jld j4, j4, 32
    jldi j5, 2
    jsub j4, j4, j5
    jldi j5, 63
    jsar j4, j4, j5
    jjnz j4, hp_fn
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HQ3               ; its relation
    jld j4, j1, HQ2
    jld j5, j4, 8
    jld j6, j4, 16
    jjz j3, hp_or
    jadd j7, j5, j1
    jadd j5, j6, j1
    jadd j6, j7, j1
  hp_or:
    jst j5, j1, HQ4               ; A
    jst j6, j1, HQ5               ; B
    jld j7, j1, HQ3               ; (one pair more of its relation)
    jldi j8, 3
    jshl j7, j7, j8
    jld j8, j1, HCCNT
    jadd j7, j7, j8
    jld j8, j7, 0
    jldi j9, 1
    jadd j8, j8, j9
    jst j8, j7, 0
    jst j1, j1, HQ6
    jadd j7, j5, j1
    jadd j8, j6, j1
    jcall hp_val
    jldi j1, 0
    jldi j2, 1
    jst j2, j1, HQ6
    jld j7, j1, HQ5
    jld j8, j1, HQ4
    jcall hp_val
  hp_fn:
    jldi j1, 0
    jld j2, j1, HQ1
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HQ1
    jjmp hp_f
hp_fd:
  jcall hp_place
  jldi j1, 0
  jldi j2, HFV                  ; what each relation says of each word: its values, the confirmed ones
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HQ1
  jld j4, j2, 0
  jst j4, j1, HQ2
  hp_v:
    jldi j1, 0
    jld j3, j1, HQ1
    jjz j3, hp_vd
    jld j4, j1, HQ2
    jld j5, j4, 0
    jjz j5, hp_vn
    jld j5, j4, 8                 ; its relation, side, word
    jld j6, j4, 16
    jcall hl_mix
    jld j6, j4, 24
    jcall hl_mix
    jjnz j5, hp_vk
    jldi j5, 1
  hp_vk:
    jldi j2, HFT2
    jcall pl_take
    jldi j1, 0
    jld j8, j1, HQ2
    jjz j6, hp_vold
    jld j7, j8, 8
    jst j7, j4, 8
    jld j7, j8, 16
    jst j7, j4, 16
    jld j7, j8, 24
    jst j7, j4, 24
    jld j7, j8, 32
    jst j7, j4, 56                ; a value it says
  hp_vold:
    jld j7, j4, 48                ; one value more
    jldi j9, 1
    jadd j7, j7, j9
    jst j7, j4, 48
    jld j7, j8, 40
    jldi j9, 2
    jsub j7, j7, j9
    jldi j9, 63
    jsar j7, j7, j9
    jjnz j7, hp_vn
    jld j7, j4, 40                ; confirmed (two say it)
    jldi j9, 1
    jadd j7, j7, j9
    jst j7, j4, 40
    jld j7, j8, 32
    jst j7, j4, 32
  hp_vn:
    jldi j1, 0
    jld j4, j1, HQ2
    jldi j5, HFV
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HQ2
    jld j3, j1, HQ1
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HQ1
    jjmp hp_v
hp_vd:
  jldi j2, HFT2                 ; what each relation is: shown (words with one confirmed value), broken (two)
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jld j4, j2, 0
  jld j5, j2, 24
  hp_p:
    jjz j3, hp_pd
    jld j6, j4, 0
    jjz j6, hp_pn
    jld j6, j4, 8
    jadd j6, j6, j6
    jld j7, j4, 16
    jadd j6, j6, j7
    jldi j7, 3
    jshl j6, j6, j7
    jld j7, j4, 40
    jjz j7, hp_pn
    jldi j8, 1
    jsub j8, j7, j8
    jjz j8, hp_pk
    jld j7, j1, HBROK
    jadd j7, j7, j6
    jldi j8, 1
    jst j8, j7, 0
    jjmp hp_pn
  hp_pk:
    jld j7, j1, HSUPP
    jadd j7, j7, j6
    jld j8, j7, 0
    jldi j9, 1
    jadd j8, j8, j9
    jst j8, j7, 0
  hp_pn:
    jadd j4, j4, j5
    jldi j6, 1
    jsub j3, j3, j6
    jjmp hp_p
hp_pd:
  jldi j2, 1                    ; by word: the relations that say it, on which side
  jst j2, j1, HQ7
  hp_w:
    jldi j1, 0
    jldi j2, HFT2
    jld j3, j2, 8
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HQ1
    jld j4, j2, 0
    jst j4, j1, HQ2
    hp_wl:
      jldi j1, 0
      jld j3, j1, HQ1
      jjz j3, hp_wld
      jld j4, j1, HQ2
      jld j6, j4, 0
      jjz j6, hp_wn
      jld j5, j4, 24
      jld j6, j1, HQ7
      jldi j7, 1
      jsub j6, j6, j7
      jjnz j6, hp_wput
      jldi j2, HWGT
      jcall pl_take
      jldi j1, 0
      jld j7, j4, 8
      jldi j8, 1
      jadd j7, j7, j8
      jst j7, j4, 8
      jjmp hp_wn
    hp_wput:
      jldi j2, HWGT
      jcall pl_find
      jldi j1, 0
      jld j7, j4, 16
      jld j8, j4, 24
      jadd j7, j7, j8
      jldi j9, 1
      jadd j8, j8, j9
      jst j8, j4, 24
      jldi j8, 24
      jmul j7, j7, j8
      jld j8, j1, HWGE
      jadd j7, j7, j8
      jld j4, j1, HQ2
      jld j8, j4, 8
      jst j8, j7, 0
      jld j8, j4, 16
      jst j8, j7, 8
      jst j4, j7, 16                ; (what it says of the word, there)
    hp_wn:
      jldi j1, 0
      jld j4, j1, HQ2
      jldi j5, HFT2
      jld j5, j5, 24
      jadd j4, j4, j5
      jst j4, j1, HQ2
      jld j3, j1, HQ1
      jldi j5, 1
      jsub j3, j3, j5
      jst j3, j1, HQ1
      jjmp hp_wl
  hp_wld:
    jld j2, j1, HQ7
    jldi j3, 2
    jsub j3, j2, j3
    jjz j3, hp_c
    jldi j2, HWGT
    jld j3, j2, 8
    jldi j4, 1
    jadd j3, j3, j4
    jld j4, j2, 0
    jld j5, j2, 24
    jldi j6, 0
    hp_s:
      jjz j3, hp_sd
      jld j7, j4, 0
      jjz j7, hp_sn
      jst j6, j4, 16
      jst j1, j4, 24
      jld j7, j4, 8
      jadd j6, j6, j7
    hp_sn:
      jadd j4, j4, j5
      jldi j7, 1
      jsub j3, j3, j7
      jjmp hp_s
  hp_sd:
    jldi j2, 2
    jst j2, j1, HQ7
    jjmp hp_w
hp_c:
  jldi j2, HWGT                 ; the contradictions, word by word
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HQ1
  jld j4, j2, 0
  jst j4, j1, HQ2
  hp_g:
    jldi j1, 0
    jld j3, j1, HQ1
    jjz j3, hp_done
    jld j4, j1, HQ2
    jld j5, j4, 0
    jjz j5, hp_gn
    jld j5, j4, 8
    jldi j6, 2
    jsub j6, j5, j6
    jldi j7, 63
    jsar j6, j6, j7
    jjnz j6, hp_gn
    jst j1, j1, HQ3
    hp_x:
      jldi j1, 0
      jld j4, j1, HQ2
      jld j2, j1, HQ3
      jld j3, j4, 8
      jsub j3, j2, j3
      jjz j3, hp_gn
      jst j1, j1, HQ4
      hp_y:
        jldi j1, 0
        jld j4, j1, HQ2
        jld j3, j1, HQ4
        jld j5, j4, 8
        jsub j5, j3, j5
        jjz j5, hp_xn
        jld j5, j4, 16
        jld j6, j1, HQ3
        jadd j6, j6, j5
        jldi j7, 24
        jmul j6, j6, j7
        jld j8, j1, HWGE
        jadd j6, j6, j8             ; x: the one whose confirmed value is defended
        jadd j9, j3, j5
        jmul j9, j9, j7
        jadd j9, j9, j8             ; y: the one that would give the word another
        jld j10, j6, 0
        jld j11, j9, 0
        jsub j12, j10, j11
        jjz j12, hp_yn              ; one relation
        jld j12, j6, 16
        jld j13, j12, 40
        jldi j14, 1
        jsub j13, j13, j14
        jjnz j13, hp_yn             ; x has not one confirmed value
        jst j6, j1, HQ5
        jst j9, j1, HQ6
        jadd j2, j10, j1            ; and x is so, on its side
        jld j3, j6, 8
        jcall hp_is
        jjz j6, hp_yn
        jldi j1, 0
        jld j6, j1, HQ5
        jld j9, j1, HQ6
        jld j12, j6, 16             ; does y say another value?
        jld j13, j9, 16
        jld j14, j13, 48
        jldi j7, 1
        jsub j14, j14, j7
        jjnz j14, hp_conf           ; more than one: another for sure
        jld j14, j13, 56
        jld j7, j12, 32
        jsub j14, j14, j7
        jjz j14, hp_yn              ; the same one
      hp_conf:
        jld j10, j6, 0
        jld j11, j9, 0
        jld j12, j6, 8
        jld j13, j9, 8
        jsub j12, j12, j13
        jldi j13, 1
        jjz j12, hp_way
        jldi j13, 2
      hp_way:
        jsub j12, j10, j11
        jldi j14, 63
        jsar j12, j12, j14
        jjnz j12, hp_ord
        jadd j12, j10, j1
        jadd j10, j11, j1
        jadd j11, j12, j1
      hp_ord:
        jadd j5, j10, j1
        jadd j6, j11, j1
        jcall hl_mix
        jadd j6, j13, j1
        jcall hl_mix
        jjnz j5, hp_ck
        jldi j5, 1
      hp_ck:
        jldi j2, HCFT
        jcall pl_take
        jldi j1, 0
        jld j7, j4, 8
        jldi j8, 1
        jadd j7, j7, j8
        jst j7, j4, 8
        jld j9, j1, HQ5             ; whose rule it is: x's, on its side (a word more; the first: a pair of relations)
        jld j10, j9, 0
        jadd j10, j10, j10
        jld j11, j9, 8
        jadd j10, j10, j11
        jldi j11, 3
        jshl j10, j10, j11
        jld j11, j1, HPBW
        jadd j11, j11, j10
        jld j12, j11, 0
        jldi j13, 1
        jadd j12, j12, j13
        jst j12, j11, 0
        jsub j7, j7, j13
        jjnz j7, hp_yn
        jld j11, j1, HPBP
        jadd j11, j11, j10
        jld j12, j11, 0
        jadd j12, j12, j13
        jst j12, j11, 0
      hp_yn:
        jldi j1, 0
        jld j3, j1, HQ4
        jldi j4, 1
        jadd j3, j3, j4
        jst j3, j1, HQ4
        jjmp hp_y
    hp_xn:
      jldi j1, 0
      jld j2, j1, HQ3
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HQ3
      jjmp hp_x
  hp_gn:
    jldi j1, 0
    jld j4, j1, HQ2
    jldi j5, HWGT
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HQ2
    jld j3, j1, HQ1
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HQ1
    jjmp hp_g
hp_done:
  jret

; Each relation's pairs, turned to it, in a row by relation (HCOFF where its own start, HCTRI {A, B}). Uses j1-j14.
hp_place:
  jldi j1, 0
  jld j2, j1, HNM
  jld j3, j1, HCCNT
  jld j4, j1, HCOFF
  jldi j5, 0
  hpl_o:
    jjz j2, hpl_od
    jst j5, j4, 0
    jld j6, j3, 0
    jadd j5, j5, j6
    jst j1, j3, 0               ; (counted again while placing)
    jldi j6, 8
    jadd j3, j3, j6
    jadd j4, j4, j6
    jldi j6, 1
    jsub j2, j2, j6
    jjmp hpl_o
hpl_od:
  jst j1, j1, HQ1
  hpl_f:
    jldi j1, 0
    jld j2, j1, HQ1
    jld j3, j1, HNF
    jsub j3, j2, j3
    jjz j3, hpl_done
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jst j3, j1, HQ2
    jld j2, j3, 0
    jldi j4, 48
    jmul j4, j2, j4
    jld j5, j1, HMA
    jadd j4, j4, j5
    jld j4, j4, 32
    jldi j5, 2
    jsub j4, j4, j5
    jldi j5, 63
    jsar j4, j4, j5
    jjnz j4, hpl_n
    jcall hl_find
    jldi j1, 0
    jld j4, j1, HQ2
    jld j5, j4, 8
    jld j6, j4, 16
    jjz j3, hpl_or
    jadd j7, j5, j1
    jadd j5, j6, j1
    jadd j6, j7, j1
  hpl_or:
    jldi j7, 3
    jshl j7, j2, j7
    jld j8, j1, HCCNT
    jadd j8, j8, j7
    jld j9, j8, 0
    jld j10, j1, HCOFF
    jadd j10, j10, j7
    jld j10, j10, 0
    jadd j10, j10, j9
    jldi j11, 1
    jadd j9, j9, j11
    jst j9, j8, 0
    jldi j11, 4
    jshl j10, j10, j11
    jld j11, j1, HCTRI
    jadd j10, j10, j11
    jst j5, j10, 0
    jst j6, j10, 8
  hpl_n:
    jldi j1, 0
    jld j2, j1, HQ1
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HQ1
    jjmp hpl_f
hpl_done:
  jret

; The hypothesis at j4: j6 = 1 if each of its two relations explains more of the other's people than it leaves
; unexplained (what one says of two words the other knows, the A on its A side and the B on its B side, said by the
; other too, against not). Uses j1-j14 (keeps j4).
hl_explains:
  jldi j1, 0
  jst j4, j1, HEW
  jst j1, j1, HCXTN
  jld j2, j4, 8
  jld j3, j4, 16
  jld j5, j4, 24
  jcall hex_dir                 ; the second's, of the first's people
  jldi j1, 0
  jld j2, j1, HCXTN
  jst j2, j1, HCXT1
  jjz j6, hex_no
  jld j4, j1, HEW
  jld j2, j4, 16
  jld j3, j4, 8
  jld j5, j4, 24
  jcall hex_dir                 ; the first's, of the second's people
  jldi j1, 0
  jld j4, j1, HEW
  jret
hex_no:
  jldi j1, 0
  jld j4, j1, HEW
  jldi j6, 0
  jret

; Of what relation j3 says (turned the other way when j5 is 2) of the people of relation j2: j6 = 1 if it explains
; more than it leaves unexplained. Uses j1-j14.
hex_dir:
  jldi j1, 0
  jst j2, j1, HER
  jst j3, j1, HES
  jst j5, j1, HE2
  jst j1, j1, HEX
  jst j1, j1, HEU
  jldi j6, 3
  jshl j6, j3, j6
  jld j7, j1, HCOFF
  jadd j7, j7, j6
  jld j7, j7, 0
  jld j8, j1, HCCNT
  jadd j8, j8, j6
  jld j8, j8, 0
  jst j8, j1, HE1               ; its pairs left
  jldi j6, 4
  jshl j7, j7, j6
  jld j6, j1, HCTRI
  jadd j7, j7, j6
  jst j7, j1, HQ8               ; where they are
  hxd_lap:
    jldi j1, 0
    jld j8, j1, HE1
    jjz j8, hxd_done
    jld j7, j1, HQ8
    jld j9, j7, 0
    jld j10, j7, 8
    jld j6, j1, HE2
    jldi j11, 2
    jsub j6, j6, j11
    jjnz j6, hxd_or
    jadd j11, j9, j1
    jadd j9, j10, j1
    jadd j10, j11, j1
  hxd_or:
    jst j9, j1, HQ4
    jst j10, j1, HQ5
    jld j5, j1, HER             ; does the other know A, on its A side?
    jldi j6, 0
    jcall hl_mix
    jld j6, j1, HQ4
    jcall hl_mix
    jjnz j5, hxd_k1
    jldi j5, 1
  hxd_k1:
    jldi j2, HFT2
    jcall pl_find
    jldi j1, 0
    jld j7, j4, 0
    jsub j7, j7, j5
    jjnz j7, hxd_next
    jld j5, j1, HER             ; and B, on its B side?
    jldi j6, 1
    jcall hl_mix
    jld j6, j1, HQ5
    jcall hl_mix
    jjnz j5, hxd_k2
    jldi j5, 1
  hxd_k2:
    jldi j2, HFT2
    jcall pl_find
    jldi j1, 0
    jld j7, j4, 0
    jsub j7, j7, j5
    jjnz j7, hxd_next
    jld j5, j1, HER             ; then the other says A with B, or leaves it unexplained
    jldi j6, 0
    jcall hl_mix
    jld j6, j1, HQ4
    jcall hl_mix
    jld j6, j1, HQ5
    jcall hl_mix
    jjnz j5, hxd_k3
    jldi j5, 1
  hxd_k3:
    jldi j2, HFV
    jcall pl_find
    jldi j1, 0
    jld j7, j4, 0
    jsub j7, j7, j5
    jjnz j7, hxd_un
    jld j7, j1, HEX
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j1, HEX
    jjmp hxd_next
  hxd_un:
    jcall hx_rescue             ; two names for one place?
    jldi j1, 0
    jjz j6, hxd_un2
    jld j7, j1, HEX
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j1, HEX
    jjmp hxd_next
  hxd_un2:
    jld j5, j1, HQ4
    jcall hx_ctx
    jldi j1, 0
    jld j5, j1, HQ5
    jcall hx_ctx
    jldi j1, 0
    jld j7, j1, HEU
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j1, HEU
  hxd_next:
    jldi j1, 0
    jld j7, j1, HQ8
    jldi j8, 16
    jadd j7, j7, j8
    jst j7, j1, HQ8
    jld j8, j1, HE1
    jldi j7, 1
    jsub j8, j8, j7
    jst j8, j1, HE1
    jjmp hxd_lap
hxd_done:
  jld j7, j1, HEU
  jld j8, j1, HEX
  jsub j7, j7, j8
  jldi j8, 63
  jsar j7, j7, j8
  jldi j6, 1
  jand j6, j6, j7
  jret

; The pair HQ4, HQ5 that relation HES says (turned by HE2) and HER does not: j6 = 1 if one of its names is, in HER,
; another name for the same place (Capitan, 2026-11-08: "if it were a slip it would not be written the same twice":
; "jobed", said twice, is how Lucas names who Mateo calls "obed"). HER says HQ4 with b' where HES says HQ5, and b' and
; HQ5 have the same partner on their other side too, one in each (the same father and the same son: two places, as
; two say); or the same with the first word. Said "mismo lugar: <name of HES> = <name of HER>". Uses j1-j14.
hx_rescue:
  jldi j1, 0
  jld j2, j1, HER
  jcall hxr_of
  jldi j1, 0
  jst j9, j1, HAP
  jst j10, j1, HAN
  jld j2, j1, HES
  jcall hxr_of
  jldi j1, 0
  jst j9, j1, HAQ
  jst j10, j1, HAS
  jst j1, j1, HAI               ; the second word: what HER pairs HQ4 with
  hxr_b:
    jldi j1, 0
    jld j3, j1, HAI
    jld j4, j1, HAN
    jsub j4, j3, j4
    jjz j4, hxr_a0
    jld j2, j1, HAP
    jcall hxr_get               ; j5, j6
    jld j7, j1, HQ4
    jsub j7, j5, j7
    jjnz j7, hxr_bn
    jld j7, j1, HQ5
    jsub j7, j6, j7
    jjz j7, hxr_bn
    jst j6, j1, HAB             ; b'
    jst j1, j1, HAJ
    hxr_bs:                     ; HES pairs HQ5 with c, and HER b' with c?
      jldi j1, 0
      jld j3, j1, HAJ
      jld j4, j1, HAS
      jsub j4, j3, j4
      jjz j4, hxr_bn
      jld j2, j1, HAQ
      jcall hxr_get
      jcall hxr_turn
      jld j7, j1, HQ5
      jsub j7, j5, j7
      jjnz j7, hxr_bsn
      jld j8, j1, HAB
      jcall hxr_says            ; HER says j8 with j6?
      jjz j6, hxr_bsn
      jldi j1, 0
      jld j8, j1, HQ5
      jld j9, j1, HAB
      jjmp hxr_yes
    hxr_bsn:
      jldi j1, 0
      jld j3, j1, HAJ
      jldi j4, 1
      jadd j3, j3, j4
      jst j3, j1, HAJ
      jjmp hxr_bs
  hxr_bn:
    jldi j1, 0
    jld j3, j1, HAI
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HAI
    jjmp hxr_b
hxr_a0:
  jst j1, j1, HAI               ; the first word: what HER pairs with HQ5
  hxr_a:
    jldi j1, 0
    jld j3, j1, HAI
    jld j4, j1, HAN
    jsub j4, j3, j4
    jjz j4, hxr_no
    jld j2, j1, HAP
    jcall hxr_get
    jld j7, j1, HQ5
    jsub j7, j6, j7
    jjnz j7, hxr_an
    jld j7, j1, HQ4
    jsub j7, j5, j7
    jjz j7, hxr_an
    jst j5, j1, HAB             ; a'
    jst j1, j1, HAJ
    hxr_as:                     ; HES pairs d with HQ4, and HER d with a'?
      jldi j1, 0
      jld j3, j1, HAJ
      jld j4, j1, HAS
      jsub j4, j3, j4
      jjz j4, hxr_an
      jld j2, j1, HAQ
      jcall hxr_get
      jcall hxr_turn
      jld j7, j1, HQ4
      jsub j7, j6, j7
      jjnz j7, hxr_asn
      jadd j8, j5, j1
      jld j6, j1, HAB
      jcall hxr_says
      jjz j6, hxr_asn
      jldi j1, 0
      jld j8, j1, HQ4
      jld j9, j1, HAB
      jjmp hxr_yes
    hxr_asn:
      jldi j1, 0
      jld j3, j1, HAJ
      jldi j4, 1
      jadd j3, j3, j4
      jst j3, j1, HAJ
      jjmp hxr_as
  hxr_an:
    jldi j1, 0
    jld j3, j1, HAI
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HAI
    jjmp hxr_a
hxr_no:
  jldi j6, 0
  jret
hxr_yes:
  jst j9, j1, HAB
  jst j8, j1, HAJ
  jldi j1, S_MISMO
  jcall puts
  jld j5, j1, HAJ
  jcall en_sayprint
  jldi j1, S_IGUAL
  jcall puts
  jld j5, j1, HAB
  jcall en_sayprint
  jldi j2, 10
  jcall putch
  jldi j6, 1
  jret

; Relation j2's pairs -> j9 where they are, j10 how many. Uses j2-j4, j9, j10.
hxr_of:
  jldi j3, 3
  jshl j3, j2, j3
  jldi j4, 0
  jld j9, j4, HCOFF
  jadd j9, j9, j3
  jld j9, j9, 0
  jld j10, j4, HCCNT
  jadd j10, j10, j3
  jld j10, j10, 0
  jldi j3, 4
  jshl j9, j9, j3
  jld j4, j4, HCTRI
  jadd j9, j9, j4
  jret

; Pair j3 of the pairs at j2 -> j5 its A, j6 its B. Uses j4-j6.
hxr_get:
  jldi j4, 4
  jshl j4, j3, j4
  jadd j4, j4, j2
  jld j5, j4, 0
  jld j6, j4, 8
  jret

; j5, j6 turned when HE2 is 2 (the hypothesis the other way round). Uses j4-j7.
hxr_turn:
  jldi j4, 0
  jld j4, j4, HE2
  jldi j7, 2
  jsub j4, j4, j7
  jjnz j4, hxt_done
  jldi j4, 0
  jadd j7, j5, j4
  jadd j5, j6, j4
  jadd j6, j7, j4
hxt_done:
  jret

; j6 = 1 if relation HER says j8 with j6 (A, B). Uses j1-j8.
hxr_says:
  jldi j1, 0
  jst j6, j1, HAC
  jld j5, j1, HER
  jldi j6, 0
  jcall hl_mix
  jadd j6, j8, j1
  jcall hl_mix
  jld j6, j1, HAC
  jcall hl_mix
  jjnz j5, hxs_k
  jldi j5, 1
hxs_k:
  jldi j2, HFV
  jcall pl_find
  jldi j1, 0
  jld j7, j4, 0
  jsub j7, j7, j5
  jldi j6, 0
  jjnz j7, hxs_done
  jldi j6, 1
hxs_done:
  jret

; Relation j2, side j3 (0: one B for each A; 1: one A for each B): j6 = 1 if it is so (two words with one confirmed
; value, none with two). Uses j6-j8.
hp_is:
  jldi j7, 0                    ; (the rule suspended is not, whatever the book shows)
  jld j6, j7, HSUSF
  jjz j6, hpi_go
  jld j6, j7, HSUSR
  jsub j6, j6, j2
  jjnz j6, hpi_go
  jld j6, j7, HSUSS
  jsub j6, j6, j3
  jjz j6, hpi_no
hpi_go:
  jadd j6, j2, j2
  jadd j6, j6, j3
  jldi j7, 3
  jshl j6, j6, j7
  jldi j7, 0
  jld j8, j7, HBROK
  jadd j8, j8, j6
  jld j8, j8, 0
  jjnz j8, hpi_no
  jld j8, j7, HSUPP
  jadd j8, j8, j6
  jld j8, j8, 0
  jldi j7, 2
  jsub j8, j8, j7
  jldi j7, 63
  jsar j8, j8, j7
  jjnz j8, hpi_no
  jldi j6, 1
  jret
hpi_no:
  jldi j6, 0
  jret

; Relation HQ3, side HQ6, word j7, value j8: once more (HFV {key, relation, side, word, value, how many}). Uses j1-j8.
hp_val:
  jldi j1, 0
  jst j7, j1, HQ8
  jst j8, j1, HKEY
  jld j5, j1, HQ3
  jld j6, j1, HQ6
  jcall hl_mix
  jld j6, j1, HQ8
  jcall hl_mix
  jld j6, j1, HKEY
  jcall hl_mix
  jjnz j5, hpv_k
  jldi j5, 1
hpv_k:
  jldi j2, HFV
  jcall pl_take
  jldi j1, 0
  jjz j6, hpv_old
  jld j7, j1, HQ3
  jst j7, j4, 8
  jld j7, j1, HQ6
  jst j7, j4, 16
  jld j7, j1, HQ8
  jst j7, j4, 24
  jld j7, j1, HKEY
  jst j7, j4, 32
hpv_old:
  jld j7, j4, 40
  jldi j8, 1
  jadd j7, j7, j8
  jst j7, j4, 40
  jret

; What is proved becomes a premise (Capitan, 2026-11-08: "it does not accumulate yet"; "with a touch of magic: plastic,
; it grows and prunes, so it does not grow exponentially"). After each turn, every relation proved (born of a join)
; that asserts something (a property of it is so, and it is not glue) and changed since it was last chained is chained with itself: where it says
; a with b and b with c, the deduced relation "<it> + <it>" says a with c. Nobody wrote it: it is a relation like the
; others in the next turn, and it lives if it is used (a join takes it: the book confirms and it explains); one nobody
; uses is dead from the next turn on (it holds no pairs), and what can be deduced again is not kept, it is deduced
; again (Razar reads in a second: speed buys the right to forget). It grows where what it proved bears weight. Said
; "deduce: <it> + <it> | pares n". -> HNDER how many deduced in this turn. Uses j1-j14.
hl_derive:
  jldi j1, 0
  jst j1, j1, HNDER
  jld j2, j1, HDFROM2           ; the deduced ones tried in the turn before and not taken: dead
  hd_dead:
    jld j3, j1, HDFROM
    jsub j3, j2, j3
    jjz j3, hd_deadd
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCLS
    jadd j4, j4, j3
    jld j4, j4, 0
    jsub j4, j4, j2
    jjnz j4, hd_dn              ; (joined: it lives)
    jld j4, j1, HSIZE
    jadd j4, j4, j3
    jld j4, j4, 0
    jldi j5, 1
    jsub j4, j4, j5
    jjnz j4, hd_dn              ; (others joined it)
    jldi j4, 48
    jmul j4, j2, j4
    jld j5, j1, HMA
    jadd j4, j4, j5
    jld j5, j4, 32
    jjz j5, hd_dn
    jst j1, j4, 32              ; it holds no pairs any more: waiting, without a witness (it can be deduced again)
    jld j5, j1, HNESP
    jldi j6, 1
    jadd j5, j5, j6
    jst j5, j1, HNESP
  hd_dn:
    jldi j3, 1
    jadd j2, j2, j3
    jjmp hd_dead
hd_deadd:
  jld j2, j1, HDFROM
  jst j2, j1, HDFROM2
  jld j2, j1, HNM
  jst j2, j1, HDFROM
  jst j1, j1, HDC
  hd_lap:                       ; each relation that asserts something and changed
    jldi j1, 0
    jld j2, j1, HDC
    jld j3, j1, HDFROM
    jsub j3, j2, j3
    jjz j3, hd_done
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCLS
    jadd j4, j4, j3
    jld j4, j4, 0
    jsub j4, j4, j2
    jjnz j4, hd_next            ; not a relation of its own
    jld j4, j1, HSIZE
    jadd j4, j4, j3
    jld j4, j4, 0
    jld j5, j1, HDVER
    jadd j5, j5, j3
    jld j6, j5, 0
    jsub j6, j6, j4
    jjz j6, hd_next             ; chained already as it is
    jldi j6, 2
    jsub j6, j4, j6
    jldi j7, 63
    jsar j6, j6, j7
    jjnz j6, hd_next            ; one form alone: not proved (only what a join proved is a premise)
    jld j6, j1, HNANT
    jadd j6, j6, j3
    jld j6, j6, 0
    jjnz j6, hd_next            ; glue
    jld j6, j1, HCCNT
    jadd j6, j6, j3
    jld j6, j6, 0
    jldi j7, 2
    jsub j7, j6, j7
    jldi j8, 63
    jsar j7, j7, j8
    jjnz j7, hd_next
    jldi j3, 0
    jcall hp_is
    jjnz j6, hd_so
    jldi j1, 0
    jld j2, j1, HDC
    jldi j3, 1
    jcall hp_is
    jjz j6, hd_next             ; it asserts nothing
  hd_so:
    jldi j1, 0
    jld j2, j1, HDC
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HSIZE
    jadd j4, j4, j3
    jld j4, j4, 0
    jld j5, j1, HDVER
    jadd j5, j5, j3
    jst j4, j5, 0
    jcall hd_chain
  hd_next:
    jldi j1, 0
    jld j2, j1, HDC
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HDC
    jjmp hd_lap
hd_done:
  jret

; Relation HDC chained with itself, as a new form (if there is room for it and it holds two pairs). Uses j1-j14.
hd_chain:
  jldi j1, 0
  jld j2, j1, HNM
  jld j3, j1, HDCAP
  jsub j3, j2, j3
  jjz j3, hdc_none              ; (no room for one more form)
  jst j2, j1, HDF               ; its number
  jld j2, j1, HDC
  jldi j5, 0Dh
  jadd j6, j2, j1
  jcall hl_mix
  jjnz j5, hdc_k
  jldi j5, 1
hdc_k:
  jst j5, j1, HKEY
  jld j2, j1, HDF               ; the form: no line of its own, its relation, "chained"
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jst j5, j3, 0
  jldi j4, -1
  jst j4, j3, 8
  jld j4, j1, HDC
  jst j4, j3, 16
  jldi j4, -1
  jst j4, j3, 24
  jst j1, j3, 32
  jldi j4, -1
  jst j4, j3, 40
  jld j2, j1, HDC
  jcall hxr_of
  jldi j1, 0
  jst j9, j1, HAP
  jst j10, j1, HAN
  jst j1, j1, HAI
  hdc_i:
    jldi j1, 0
    jld j3, j1, HAI
    jld j4, j1, HAN
    jsub j4, j3, j4
    jjz j4, hdc_id
    jld j2, j1, HAP
    jcall hxr_get
    jldi j1, 0
    jst j5, j1, HQ4             ; a
    jst j6, j1, HQ5             ; b
    jst j1, j1, HAJ
    hdc_j:
      jldi j1, 0
      jld j3, j1, HAJ
      jld j4, j1, HAN
      jsub j4, j3, j4
      jjz j4, hdc_in
      jld j2, j1, HAP
      jcall hxr_get
      jldi j1, 0
      jld j7, j1, HQ5
      jsub j7, j5, j7
      jjnz j7, hdc_jn             ; b with c?
      jld j7, j1, HQ4
      jsub j7, j6, j7
      jjz j7, hdc_jn              ; (not back to a)
      jst j6, j1, HAB
      jcall hdc_put
    hdc_jn:
      jldi j1, 0
      jld j3, j1, HAJ
      jldi j4, 1
      jadd j3, j3, j4
      jst j3, j1, HAJ
      jjmp hdc_j
  hdc_in:
    jldi j1, 0
    jld j3, j1, HAI
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HAI
    jjmp hdc_i
hdc_id:
  jld j2, j1, HDF
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j4, j3, 32
  jldi j5, 2
  jsub j4, j4, j5
  jldi j5, 63
  jsar j4, j4, j5
  jjnz j4, hdc_none             ; fewer than two: not a relation
  jld j4, j1, HNM               ; a form now
  jldi j5, 1
  jadd j4, j4, j5
  jst j4, j1, HNM
  jld j4, j1, HNDER
  jadd j4, j4, j5
  jst j4, j1, HNDER
  jldi j1, S_DEDUCE
  jcall puts
  jld j2, j1, HDF
  jcall hl_sayform
  jldi j1, S_PARES2
  jcall puts
  jld j2, j1, HDF
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j2, j3, 32
  jcall putnum
  jldi j2, 10
  jcall putch
  jret
hdc_none:
  jldi j1, 0
  jld j2, j1, HDF               ; (its pairs, if any, belong to no form: held by none)
  jret

; The pair HQ4, HAB of the deduced form HDF, once. Uses j1-j14.
hdc_put:
  jldi j1, 0
  jld j2, j1, HNF
  jld j3, j1, HFCAP
  jsub j3, j2, j3
  jjz j3, hdp_done              ; (no room for one more pair)
  jld j5, j1, HKEY
  jld j6, j1, HQ4
  jcall hl_mix
  jld j6, j1, HAB
  jcall hl_mix
  jjnz j5, hdp_k
  jldi j5, 1
hdp_k:
  jldi j2, HFT
  jcall pl_take
  jldi j1, 0
  jjz j6, hdp_done              ; (said already)
  jld j6, j1, HNF
  jldi j7, 5
  jshl j7, j6, j7
  jld j8, j1, HFL
  jadd j7, j7, j8
  jld j8, j1, HDF
  jst j8, j7, 0
  jld j9, j1, HQ4
  jst j9, j7, 8
  jld j9, j1, HAB
  jst j9, j7, 16
  jldi j9, 48
  jmul j9, j8, j9
  jld j10, j1, HMA
  jadd j9, j9, j10
  jld j10, j9, 40
  jst j10, j7, 24
  jst j6, j9, 40
  jld j10, j9, 32
  jldi j11, 1
  jadd j10, j10, j11
  jst j10, j9, 32
  jadd j6, j6, j11
  jst j6, j1, HNF
hdp_done:
  jret

; What it read: the words, the half, the forms said by two. Uses j1-j14.
hl_say0:
  jldi j1, 0
  jst j1, j1, HT1
  jst j1, j1, HI
  hs_m:
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hs_md
    jldi j3, 48
    jmul j3, j2, j3
    jld j4, j1, HMA
    jadd j3, j3, j4
    jld j3, j3, 32
    jldi j4, 2
    jsub j3, j3, j4
    jldi j4, 63
    jsar j3, j3, j4
    jjnz j3, hs_mn
    jld j3, j1, HT1
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HT1
  hs_mn:
    jld j2, j1, HI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HI
    jjmp hs_m
hs_md:
  jldi j1, S_PAL
  jcall puts
  jld j2, j1, HTOT
  jcall putnum
  jldi j1, S_MITAD
  jcall puts
  jld j2, j1, HHC
  jcall putnum
  jldi j1, S_VECES
  jcall puts
  jld j2, j1, HT1
  jcall putnum
  jldi j1, S_DE
  jcall puts
  jld j2, j1, HNM
  jcall putnum
  jldi j2, 10
  jcall putch
  jret

; The rooms the while uses: by form the one it joined, if turned, how many forms; the strongest by relation; where the
; pairs go by their words (each pair and its crossed one, at most); the tables. Uses j1-j14.
hl_rooms:
  jldi j1, 0
  jld j2, j1, HNM               ; room for deduced forms and pairs: twice what was read, as far as the rooms go
  jst j2, j1, HNM0
  jld j3, j1, HNF
  jst j3, j1, HNF0
  jld j4, j1, ZNWD
  jldi j5, 3
  jmul j4, j4, j5
  jadd j2, j2, j2
  jsub j5, j2, j4
  jldi j6, 63
  jsar j5, j5, j6
  jjnz j5, hro_c1
  jadd j2, j4, j1
hro_c1:
  jst j2, j1, HDCAP
  jst j2, j1, HNM
  jadd j3, j3, j3
  jsub j5, j3, j4
  jsar j5, j5, j6
  jjnz j5, hro_c2
  jadd j3, j4, j1
hro_c2:
  jst j3, j1, HFCAP
  jst j3, j1, HNF
  jldi j1, 0
  jld j11, j1, HNM
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jst j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HCLS
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HPAR
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HSIZE
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HBST
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HBSE
  jld j11, j1, HNF
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 48
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HGE
  jldi j2, HGT
  jldi j3, 32
  jcall pl_new
  jldi j2, HAG
  jldi j3, 56
  jcall pl_new
  jldi j1, 0
  jld j11, j1, HNM              ; by relation, the most chance gives it (the bar)
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HTMX
  jld j11, j1, HNM
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HNANT
  jld j11, j1, HNM              ; what each relation is: rooms and tables
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 4
  jshl j11, j11, j2
  jst j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HSUPP
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HBROK
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HPBP
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HPBW
  jld j11, j1, HNF
  jadd j11, j11, j11
  jldi j2, 2
  jadd j11, j11, j2
  jldi j2, 24
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HWGE
  jldi j2, HFT2
  jldi j3, 64
  jcall pl_new
  jldi j2, HFV
  jldi j3, 48
  jcall pl_new
  jldi j2, HREF
  jldi j3, 56
  jcall pl_new
  jldi j2, HWT
  jldi j3, 16
  jcall pl_new
  jldi j1, 0
  jld j11, j1, HNF
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 4
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HCXT
  jld j11, j1, HNF
  jldi j2, 1
  jadd j11, j11, j2
  jst j11, j1, HCXCAP
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HCXW
  jst j1, j1, HCXWN
  jldi j1, 0
  jld j11, j1, HNM
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jst j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HCCNT
  jld j11, j1, HT1
  jcall room
  jldi j1, 0
  jst j13, j1, HCOFF
  jld j11, j1, HNF
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 4
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HCTRI
  jldi j2, HWGT
  jldi j3, 32
  jcall pl_new
  jldi j2, HCFT
  jldi j3, 16
  jcall pl_new
  jldi j1, 0
  jst j1, j1, HI
  hro_lap:                      ; every form its own relation, of one form
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hro_done
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCLS
    jadd j4, j4, j3
    jst j2, j4, 0
    jld j4, j1, HSIZE
    jadd j4, j4, j3
    jldi j5, 1
    jst j5, j4, 0
    jadd j2, j2, j5
    jst j2, j1, HI
    jjmp hro_lap
hro_done:
  jldi j1, 0
  jld j11, j1, HDCAP            ; by relation, its size when last chained
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 3
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HDVER
  jld j2, j1, HNM0
  jst j2, j1, HNM
  jst j2, j1, HDFROM
  jst j2, j1, HDFROM2
  jld j2, j1, HNF0
  jst j2, j1, HNF
  jret

; The growing table at j2 emptied, in the places it has. Uses j3-j6.
hl_clear:
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jld j4, j2, 24
  jmul j3, j3, j4
  jldi j4, 3
  jshr j3, j3, j4
  jld j4, j2, 0
  jldi j5, 0
  jst j5, j2, 16
  hcl_lap:
    jjz j3, hcl_done
    jst j5, j4, 0
    jldi j6, 8
    jadd j4, j4, j6
    jldi j6, 1
    jsub j3, j3, j6
    jjmp hcl_lap
hcl_done:
  jret

; The relation of form j2 -> j2, and j3 = 1 if the form is turned against it. Uses j2-j5.
hl_find:
  jldi j3, 0
  hfd_lap:
    jldi j4, 3
    jshl j4, j2, j4
    jldi j5, 0
    jld j5, j5, HCLS
    jadd j5, j5, j4
    jld j5, j5, 0
    jsub j5, j5, j2
    jjz j5, hfd_done
    jldi j5, 0
    jld j5, j5, HPAR
    jadd j5, j5, j4
    jld j5, j5, 0
    jxor j3, j3, j5
    jldi j5, 0
    jld j5, j5, HCLS
    jadd j5, j5, j4
    jld j2, j5, 0
    jjmp hfd_lap
hfd_done:
  jret

; j6 = the score of the relation of relations at j4 (twice read alike, minus crossed), 0 if it does not beat its null
; or two pairs do not say it. Uses j6-j8.
hl_score:
  jld j6, j4, 32
  jldi j7, 2
  jsub j7, j6, j7
  jldi j8, 63
  jsar j7, j7, j8
  jjnz j7, hsc_no
  jadd j6, j6, j6
  jld j7, j4, 40
  jsub j6, j6, j7
  jsar j7, j6, j8
  jjnz j7, hsc_no
  jjz j6, hsc_no
  jret
hsc_no:
  jldi j6, 0
  jret

; One turn's joins: of the relations of relations that beat their null, each relation's strongest; two relations whose
; strongest is each other join (the second into the first, turned if they relate the other way round). Each join said.
; -> HNMRG how many, HNACC how many beat their null. Uses j1-j14.
hl_merge:
  jldi j1, 0
  jst j1, j1, HNREF
  jst j1, j1, HNMRG
  jst j1, j1, HNACC
  jst j1, j1, HI
  hm_z:                         ; no strongest yet
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hm_zd
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HBST
    jadd j4, j4, j3
    jst j1, j4, 0
    jld j4, j1, HBSE
    jadd j4, j4, j3
    jst j1, j4, 0
    jld j4, j1, HTMX
    jadd j4, j4, j3
    jst j1, j4, 0
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HI
    jjmp hm_z
hm_zd:
  jldi j2, HAG
  jld j3, j2, 8
  jldi j5, 1
  jadd j3, j3, j5
  jst j3, j1, HT1
  jld j4, j2, 0
  jst j4, j1, HT2
  hm_a:                         ; each relation's strongest
    jldi j1, 0
    jld j3, j1, HT1
    jjz j3, hm_ad
    jld j4, j1, HT2
    jld j5, j4, 0
    jjz j5, hm_an
    jcall hl_reason
    jldi j1, 0
    jjz j6, hm_an
    jld j5, j1, HNACC
    jldi j7, 1
    jadd j5, j5, j7
    jst j5, j1, HNACC
    jldi j9, 8
    hm_side:                    ; (its first relation, then its second)
      jadd j10, j4, j9
      jld j10, j10, 0
      jldi j7, 3
      jshl j10, j10, j7
      jld j7, j1, HBST
      jadd j7, j7, j10
      jld j8, j7, 0
      jsub j8, j8, j6
      jldi j11, 63
      jsar j8, j8, j11
      jjz j8, hm_sn
      jst j6, j7, 0
      jld j7, j1, HBSE
      jadd j7, j7, j10
      jst j4, j7, 0
    hm_sn:
      jldi j7, 16
      jsub j7, j9, j7
      jjz j7, hm_an
      jldi j9, 16
      jjmp hm_side
  hm_an:
    jldi j1, 0
    jld j4, j1, HT2
    jldi j5, HAG
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HT2
    jld j3, j1, HT1
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HT1
    jjmp hm_a
hm_ad:
  jldi j2, HAG                  ; the ones both chose
  jld j3, j2, 8
  jldi j5, 1
  jadd j3, j3, j5
  jst j3, j1, HT1
  jld j4, j2, 0
  jst j4, j1, HT2
  hm_b:
    jldi j1, 0
    jld j3, j1, HT1
    jjz j3, hm_bd
    jld j4, j1, HT2
    jld j5, j4, 0
    jjz j5, hm_bn
    jld j5, j4, 8
    jldi j7, 3
    jshl j5, j5, j7
    jld j7, j1, HBSE
    jadd j7, j7, j5
    jld j7, j7, 0
    jsub j7, j7, j4
    jjnz j7, hm_bn
    jld j5, j4, 16
    jldi j7, 3
    jshl j5, j5, j7
    jld j7, j1, HBSE
    jadd j7, j7, j5
    jld j7, j7, 0
    jsub j7, j7, j4
    jjnz j7, hm_bn
    jcall hl_explains           ; it must explain the same people, both ways
    jldi j1, 0
    jjnz j6, hm_expl
    jld j4, j1, HT2             ; refuted for good: never again
    jld j5, j4, 8
    jld j6, j4, 16
    jcall hl_mix
    jld j6, j4, 24
    jcall hl_mix
    jjnz j5, hm_rk
    jldi j5, 1
  hm_rk:
    jldi j2, HREF
    jcall pl_take
    jldi j1, 0                  ; when it fell, and its context: what it left unexplained
    jst j6, j1, HQ6             ; (refuted for the first time: the turn changed who chooses whom)
    jld j5, j1, HTURN
    jst j5, j4, 8
    jld j5, j1, HT2
    jld j6, j5, 8
    jst j6, j4, 32
    jld j6, j5, 16
    jst j6, j4, 40
    jld j6, j5, 24
    jst j6, j4, 48
    jst j4, j1, HAE
    jcall hm_absurd
    jldi j1, 0
    jld j4, j1, HAE
    jcall hm_keepctx
    jldi j1, 0
    jld j6, j1, HQ6
    jld j5, j1, HNREF
    jadd j5, j5, j6
    jst j5, j1, HNREF
    jjmp hm_bn
  hm_expl:
    jld j4, j1, HT2             ; what the second brings is said about its people: they are touched
    jld j2, j4, 16
    jcall hm_touchrel
    jldi j1, 0
    jld j4, j1, HT2
    jld j5, j4, 8               ; the second into the first
    jld j6, j4, 16
    jldi j7, 3
    jshl j8, j6, j7
    jld j9, j1, HCLS
    jadd j9, j9, j8
    jst j5, j9, 0
    jld j9, j4, 24
    jldi j10, 1
    jsub j9, j9, j10
    jld j10, j1, HPAR
    jadd j10, j10, j8
    jst j9, j10, 0
    jld j10, j1, HSIZE
    jadd j10, j10, j8
    jld j11, j10, 0
    jshl j12, j5, j7
    jld j13, j1, HSIZE
    jadd j13, j13, j12
    jld j14, j13, 0
    jadd j14, j14, j11
    jst j14, j13, 0
    jld j5, j1, HNMRG
    jldi j7, 1
    jadd j5, j5, j7
    jst j5, j1, HNMRG
    jcall hl_sayjoin
  hm_bn:
    jldi j1, 0
    jld j4, j1, HT2
    jldi j5, HAG
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HT2
    jld j3, j1, HT1
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HT1
    jjmp hm_b
hm_bd:
  jldi j1, S_VUELTA
  jcall puts
  jld j2, j1, HTURN
  jcall putnum
  jldi j1, S_GANAN
  jcall puts
  jld j2, j1, HNACC
  jcall putnum
  jldi j1, S_SEUNEN
  jcall puts
  jld j2, j1, HNMRG
  jcall putnum
  jldi j2, 10
  jcall putch
  jret

; The hypothesis at j4 ("the second relation is the first", the same way or the other way round) -> j6 its
; confirmations (the pairs the book says as it deduces), 0 if it does not stand: fewer than two confirmations, a
; contradiction (a pair the book says the other way round, or a property of either that the join would break: an A
; with two B's where one of them has one B for each A), or a relation of it that is glue. Uses j1-j8 (keeps j4).
hl_reason:
  jldi j1, 0
  jst j4, j1, HT5               ; (refuted for good?)
  jld j5, j4, 8
  jld j6, j4, 16
  jcall hl_mix
  jld j6, j4, 24
  jcall hl_mix
  jjnz j5, hrs_r
  jldi j5, 1
hrs_r:
  jldi j2, HREF
  jcall pl_find
  jldi j1, 0
  jld j7, j4, 0
  jsub j7, j7, j5
  jjnz j7, hrs_awake            ; never refuted
  jcall hrs_wakes               ; refuted: in a coma unless its people came back
  jldi j1, 0
  jjz j6, hrs_coma
hrs_awake:
  jldi j1, 0
  jld j4, j1, HT5
  jld j6, j4, 32
  jldi j7, 2
  jsub j7, j6, j7
  jldi j8, 63
  jsar j7, j7, j8
  jjnz j7, hrs_no               ; two confirm it, at least
  jld j7, j4, 8
  jcall hrs_glue
  jjnz j7, hrs_no
  jld j7, j4, 16
  jcall hrs_glue
  jjnz j7, hrs_no
  jst j4, j1, HT5               ; the contradiction: the same two the other way
  jst j6, j1, HT4
  jld j5, j4, 8
  jld j6, j4, 16
  jcall hl_mix
  jld j6, j4, 24
  jldi j7, 3
  jsub j6, j7, j6
  jcall hl_mix
  jjnz j5, hrs_k
  jldi j5, 1
hrs_k:
  jldi j2, HAG
  jcall pl_find
  jldi j1, 0
  jld j7, j4, 0
  jsub j7, j7, j5
  jjnz j7, hrs_ok               ; (no such entry: nothing says it the other way)
  jld j7, j4, 32
  jjnz j7, hrs_no2
hrs_ok:
  jld j4, j1, HT5               ; and no property of either refutes it
  jld j5, j4, 8
  jld j6, j4, 16
  jcall hl_mix
  jld j6, j4, 24
  jcall hl_mix
  jjnz j5, hrs_k2
  jldi j5, 1
hrs_k2:
  jldi j2, HCFT
  jcall pl_find
  jldi j1, 0
  jld j7, j4, 0
  jsub j7, j7, j5
  jjnz j7, hrs_yes
  jld j7, j4, 8
  jjnz j7, hrs_no2
hrs_yes:
  jld j4, j1, HT5
  jld j6, j1, HT4
  jret
hrs_coma:
  jld j4, j1, HT5
  jjmp hrs_no
hrs_no2:
  jld j4, j1, HT5
hrs_no:
  jldi j6, 0
  jret

; The refuted hypothesis at j4 (its HREF entry): j6 = 1 if it is awake (awake already, or a word of its context was
; touched after it fell: then it wakes, and says so). Uses j1-j14 (HT5 the hypothesis).
hrs_wakes:
  jldi j1, 0
  jst j4, j1, HQ7
  jld j2, j4, 8
  jldi j3, 63
  jsar j3, j2, j3
  jjnz j3, hwk_yes              ; (awake already)
  jld j9, j4, 16
  jld j10, j4, 24
  hwk_lap:
    jjz j10, hwk_no
    jldi j3, 3
    jshl j3, j9, j3
    jld j5, j1, HCXW
    jadd j3, j3, j5
    jld j5, j3, 0
    jldi j2, HWT
    jcall pl_find
    jldi j1, 0
    jld j7, j4, 0
    jsub j7, j7, j5
    jjnz j7, hwk_n
    jld j7, j4, 8
    jld j8, j1, HQ7
    jld j8, j8, 8
    jsub j7, j8, j7
    jldi j8, 63
    jsar j7, j7, j8
    jjnz j7, hwk_wake           ; touched after it fell
  hwk_n:
    jldi j3, 1
    jadd j9, j9, j3
    jsub j10, j10, j3
    jjmp hwk_lap
hwk_wake:
  jld j4, j1, HQ7
  jldi j2, -1
  jst j2, j4, 8
  jldi j1, S_DESP
  jcall puts
  jld j4, j1, HT5
  jld j2, j4, 8
  jcall hl_sayform
  jldi j1, S_TIL
  jcall puts
  jld j4, j1, HT5
  jld j2, j4, 16
  jcall hl_sayform
  jldi j2, 10
  jcall putch
hwk_yes:
  jldi j6, 1
  jret
hwk_no:
  jldi j6, 0
  jret

; Word j5 into the context of the hypothesis being judged. (Not touched: stumbling on someone brings nothing new about
; them, and a hypothesis woken by that falls again and holds another's choice meanwhile; only a join brings news.)
; Uses j1-j8.
hx_ctx:
  jldi j1, 0
  jld j2, j1, HCXTN
  jld j3, j1, HCXCAP
  jsub j3, j2, j3
  jjz j3, hxc_t
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCXT
  jadd j3, j3, j4
  jst j5, j3, 0
  jldi j3, 1
  jadd j2, j2, j3
  jst j2, j1, HCXTN
hxc_t:
  jret

; Word j5 touched in this turn. Uses j1-j8.
hm_touch:
  jldi j2, HWT
  jcall pl_take
  jldi j1, 0
  jld j7, j1, HTURN
  jst j7, j4, 8
  jret

; The pairs of relation j2 (as this turn's props hold them): their words touched. Uses j1-j14.
hm_touchrel:
  jcall hxr_of
  jldi j1, 0
  jst j9, j1, HQ8
  jst j10, j1, HE1
  hmt_lap:
    jldi j1, 0
    jld j10, j1, HE1
    jjz j10, hmt_done
    jld j9, j1, HQ8
    jld j5, j9, 0
    jcall hm_touch
    jldi j1, 0
    jld j9, j1, HQ8
    jld j5, j9, 8
    jcall hm_touch
    jldi j1, 0
    jld j9, j1, HQ8
    jldi j10, 16
    jadd j9, j9, j10
    jst j9, j1, HQ8
    jld j10, j1, HE1
    jldi j9, 1
    jsub j10, j10, j9
    jst j10, j1, HE1
    jjmp hmt_lap
hmt_done:
  jret

; The instrument for the absurd (Capitan: "if something starts as an absurd, the answer may be there"): of the holes of
; the hypothesis just refuted (HT2; HCXT, the first's people up to HCXT1, the second's after), how many the other
; relation of a hypothesis in a coma that shares a relation with it would explain (it says the pair). Counted (HHOL,
; HABS), not used: whether the absurd has anything to find, before building what would use it. Uses j1-j14.
hm_absurd:
  jldi j1, 0
  jst j1, j1, HAX               ; (the hole walking)
  hab_lap:
    jldi j1, 0
    jld j2, j1, HAX
    jld j3, j1, HCXTN
    jsub j3, j2, j3
    jjz j3, hab_done
    jld j3, j1, HCXT
    jldi j4, 3
    jshl j4, j2, j4
    jadd j3, j3, j4
    jld j5, j3, 0
    jld j6, j3, 8
    jst j5, j1, HQ4
    jst j6, j1, HQ5
    jld j4, j1, HT2             ; whose people: the first's up to HCXT1
    jld j7, j4, 8
    jld j8, j1, HCXT1
    jsub j8, j2, j8
    jldi j9, 63
    jsar j8, j8, j9
    jjnz j8, hab_r
    jld j7, j4, 16
  hab_r:
    jst j7, j1, HAR
    jld j7, j1, HHOL
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j1, HHOL
    jcall hab_one
    jldi j1, 0
    jjz j6, hab_next
    jld j7, j1, HABS
    jldi j8, 1
    jadd j7, j7, j8
    jst j7, j1, HABS
  hab_next:
    jld j2, j1, HAX
    jldi j3, 2
    jadd j2, j2, j3
    jst j2, j1, HAX
    jjmp hab_lap
hab_done:
  jret

; j6 = 1 if a hypothesis in a coma (other than HAE) shares relation HAR and its other relation says HQ4 with HQ5 (in
; HAR's way). Uses j1-j14.
hab_one:
  jldi j2, HREF
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jldi j1, 0
  jst j3, j1, HAEN
  jld j4, j2, 0
  jst j4, j1, HAB
  hbo_lap:
    jldi j1, 0
    jld j3, j1, HAEN
    jjz j3, hbo_no
    jld j4, j1, HAB
    jld j5, j4, 0
    jjz j5, hbo_n
    jld j5, j1, HAE
    jsub j5, j5, j4
    jjz j5, hbo_n
    jld j5, j4, 8
    jldi j6, 63
    jsar j6, j5, j6
    jjnz j6, hbo_n              ; awake: not sleeping
    jld j2, j4, 32              ; its two, as relations now, and which way they are
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HAC
    jst j3, j1, HAP
    jld j4, j1, HAB
    jld j2, j4, 40
    jcall hl_find
    jldi j1, 0
    jld j4, j1, HAB
    jld j5, j4, 48
    jldi j6, 2
    jsub j5, j5, j6
    jldi j6, 1
    jjnz j5, hbo_w
    jldi j6, 0
  hbo_w:
    jxor j6, j6, j3             ; 1 the same way, as relations now
    jld j7, j1, HAP
    jxor j6, j6, j7
    jld j7, j1, HAC
    jsub j8, j7, j2
    jjz j8, hbo_n
    jld j8, j1, HAR
    jsub j9, j7, j8
    jjz j9, hbo_t2
    jsub j9, j2, j8
    jjnz j9, hbo_n
    jadd j2, j7, j1             ; (the other is the first)
  hbo_t2:
    jst j6, j1, HAQ
    jjz j6, hbo_rev
    jld j8, j1, HQ4
    jld j6, j1, HQ5
    jjmp hbo_say
  hbo_rev:
    jld j8, j1, HQ5
    jld j6, j1, HQ4
  hbo_say:
    jst j2, j1, HAI
    jld j9, j1, HER
    jst j9, j1, HAN
    jst j2, j1, HER
    jcall hxr_says
    jldi j1, 0
    jld j9, j1, HAN
    jst j9, j1, HER
    jjnz j6, hbo_yes
  hbo_n:
    jldi j1, 0
    jld j4, j1, HAB
    jldi j5, HREF
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HAB
    jld j3, j1, HAEN
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HAEN
    jjmp hbo_lap
hbo_yes:
  jldi j6, 1
  jret
hbo_no:
  jldi j6, 0
  jret

; The context of the hypothesis just refuted (HCXT) kept for its HREF entry at j4. Uses j1-j10.
hm_keepctx:
  jldi j1, 0
  jld j5, j1, HCXWN
  jst j5, j4, 16
  jld j6, j1, HCXTN
  jld j7, j1, HCXCAP
  jsub j7, j7, j5
  jsub j8, j7, j6
  jldi j9, 63
  jsar j8, j8, j9
  jjz j8, hkc_fit
  jadd j6, j7, j1               ; (what fits)
hkc_fit:
  jst j6, j4, 24
  jld j7, j1, HCXT
  jldi j8, 3
  jshl j9, j5, j8
  jld j10, j1, HCXW
  jadd j9, j9, j10
  hkc_lap:
    jjz j6, hkc_done
    jld j10, j7, 0
    jst j10, j9, 0
    jldi j10, 8
    jadd j7, j7, j10
    jadd j9, j9, j10
    jldi j10, 1
    jadd j5, j5, j10
    jsub j6, j6, j10
    jjmp hkc_lap
hkc_done:
  jst j5, j1, HCXWN
  jret

; j6 = the size of relation j6 (how many forms it holds). Uses j6, j7.
hm_size:
  jldi j7, 3
  jshl j6, j6, j7
  jldi j7, 0
  jld j7, j7, HSIZE
  jadd j6, j6, j7
  jld j6, j6, 0
  jret

; j7 = 1 if relation j7 is glue. Uses j7, j8.
hrs_glue:
  jldi j8, 3
  jshl j7, j7, j8
  jldi j8, 0
  jld j8, j8, HNANT
  jadd j7, j7, j8
  jld j7, j7, 0
  jret

; "vuelta t une: <first> ~ <second> | misma | lo dicen n | nulo x" for the relation of relations at HT2. Uses j1-j14.
hl_sayjoin:
  jldi j1, S_VUELTA
  jcall puts
  jld j2, j1, HTURN
  jcall putnum
  jldi j1, S_UNE
  jcall puts
  jld j4, j1, HT2
  jld j2, j4, 8
  jcall hl_sayform
  jldi j1, S_TIL
  jcall puts
  jld j4, j1, HT2
  jld j2, j4, 16
  jcall hl_sayform
  jldi j1, 0
  jld j4, j1, HT2
  jld j2, j4, 24
  jldi j3, 1
  jsub j2, j2, j3
  jldi j1, S_MISMA
  jjz j2, hsj_way
  jldi j1, S_REVES
hsj_way:
  jcall puts
  jldi j1, S_CONF
  jcall puts
  jld j4, j1, HT2
  jld j2, j4, 32
  jcall putnum
  jldi j1, S_NADA
  jcall puts
hsj_nl:
  jldi j2, 10
  jcall putch
  jret

; The while's end: the turn it stopped in, how many relations hold two forms or more, and the largest. Uses j1-j14.
hl_end:
  jldi j1, S_PARO
  jcall puts
  jld j2, j1, HTURN
  jldi j3, 1
  jsub j2, j2, j3
  jcall putnum
  jldi j1, S_PAROB
  jcall puts
  jst j1, j1, HT1               ; how many
  jst j1, j1, HT3               ; the largest's forms
  jst j1, j1, HT4               ; the largest
  jst j1, j1, HI
  he_lap:
    jldi j1, 0
    jld j2, j1, HI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, he_done
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCLS
    jadd j4, j4, j3
    jld j4, j4, 0
    jsub j4, j4, j2
    jjnz j4, he_next
    jld j4, j1, HSIZE
    jadd j4, j4, j3
    jld j4, j4, 0
    jldi j5, 2
    jsub j5, j4, j5
    jldi j6, 63
    jsar j5, j5, j6
    jjnz j5, he_next
    jld j5, j1, HT1
    jldi j6, 1
    jadd j5, j5, j6
    jst j5, j1, HT1
    jld j5, j1, HT3
    jsub j5, j5, j4
    jldi j6, 63
    jsar j5, j5, j6
    jjz j5, he_next
    jst j4, j1, HT3
    jst j2, j1, HT4
  he_next:
    jld j2, j1, HI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HI
    jjmp he_lap
he_done:
  jldi j1, S_CLASES
  jcall puts
  jld j2, j1, HT1
  jcall putnum
  jld j2, j1, HT1
  jjz j2, he_nl
  jldi j1, S_GRANDE
  jcall puts
  jld j2, j1, HT3
  jcall putnum
  jldi j1, S_FORMAS
  jcall puts
  jld j2, j1, HT4
  jcall hl_sayform
he_nl:
  jldi j1, S_COMA
  jcall puts
  jldi j2, HREF
  jld j2, j2, 16
  jcall putnum
  jldi j1, S_ESPERA
  jcall puts
  jld j2, j1, HNESP
  jcall putnum
  jldi j1, S_HUECO
  jcall puts
  jld j2, j1, HHOL
  jcall putnum
  jldi j1, S_ABSU
  jcall puts
  jld j2, j1, HABS
  jcall putnum
  jldi j2, 10
  jcall putch
  jjmp hl_rules

; The rules that keep relations apart (Capitan: "suspend one and deduce again; the rule whose suspension frees the most
; is the one worth breaking"): each relation and side whose rule forbids a pair of relations, as the last turn left
; them: "regla" its number (to suspend it), its first form, which way, how many pairs of relations it keeps apart and
; how many words are in conflict. Uses j1-j14.
hl_rules:
  jldi j1, 0
  jst j1, j1, HPI
  hru_lap:
    jldi j1, 0
    jld j2, j1, HPI
    jld j3, j1, HNM
    jadd j3, j3, j3
    jsub j3, j2, j3
    jjz j3, hru_done
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HPBP
    jadd j4, j4, j3
    jld j4, j4, 0
    jjz j4, hru_next
    jldi j1, S_REGLA
    jcall puts
    jld j2, j1, HPI
    jcall putnum
    jldi j2, 58
    jcall putch
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HPI
    jldi j3, 1
    jshr j2, j2, j3
    jcall hl_sayform
    jldi j1, 0
    jld j2, j1, HPI
    jldi j3, 1
    jand j2, j2, j3
    jldi j1, S_LADO0
    jjz j2, hru_side
    jldi j1, S_LADO1
  hru_side:
    jcall puts
    jldi j1, S_FRENA
    jcall puts
    jld j2, j1, HPI
    jldi j3, 3
    jshl j2, j2, j3
    jld j3, j1, HPBP
    jadd j3, j3, j2
    jld j2, j3, 0
    jcall putnum
    jldi j1, S_UNION
    jcall puts
    jld j2, j1, HPI
    jldi j3, 3
    jshl j2, j2, j3
    jld j3, j1, HPBW
    jadd j3, j3, j2
    jld j2, j3, 0
    jcall putnum
    jldi j1, S_PALAB
    jcall puts
  hru_next:
    jldi j1, 0
    jld j2, j1, HPI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HPI
    jjmp hru_lap
hru_done:
  jret

; What it proved in the books before (Capitan: "that it takes it with it"): the house's "sabido", a line each join
; {the form's key, the key of the one it joined, 1 the same way or 2 the other way round, and its words to read}, the
; keys in sixteen hexadecimal digits (a form's key comes from its words' prints, so it is the same in every book). Each
; line whose two forms this book has is joined again before the first turn, as a premise ("sabe:"); one whose forms
; this book does not have is kept as it is, for the next book. Uses j1-j14.
hl_known:
  jldi j11, S_SABIDO
  jldi j12, 6
  jcall en_read
  jldi j1, 0
  jld j2, j1, PRB
  jst j2, j1, HKB
  jld j2, j1, PRN
  jst j2, j1, HKN
  jst j1, j1, HKA
  jst j1, j1, HKU
  jldi j3, 16                   ; (the lines not used: {where, bytes}; a line is 36 bytes or more)
  jadd j11, j2, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HKL
  jld j11, j1, HKN
  jldi j3, 16
  jadd j11, j11, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HKZ
  jst j1, j1, HKZN
  jst j1, j1, HKD
  jst j1, j1, HKWK
  jld j2, j1, HKB
  jst j2, j1, HKP
  jld j3, j1, HKN
  jadd j3, j2, j3
  jst j3, j1, HKE
  hk_lap:
    jldi j1, 0
    jld j4, j1, HKP
    jld j5, j1, HKE
    jsub j5, j5, j4
    jjz j5, hk_done
    jadd j7, j4, j1             ; where the line ends (after its line end)
    hk_eol:
      jld j5, j1, HKE
      jsub j5, j5, j7
      jjz j5, hk_eold
      jldb j5, j7, 0
      jldi j6, 1
      jadd j7, j7, j6
      jldi j6, 10
      jsub j5, j5, j6
      jjnz j5, hk_eol
  hk_eold:
    jst j7, j1, HKX
    jsub j5, j7, j4             ; 36 bytes at least
    jldi j6, 36
    jsub j6, j5, j6
    jldi j8, 63
    jsar j6, j6, j8
    jjnz j6, hk_next
    jcall hk_hex                ; the form, the one it joined, which way
    jldi j1, 0
    jst j9, j1, HKKF
    jld j4, j1, HKP
    jldi j2, 17
    jadd j4, j4, j2
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HKKP
    jld j4, j1, HKP
    jldb j2, j4, 34
    jldi j3, 50
    jsub j2, j2, j3
    jldi j3, 1
    jjz j2, hk_way
    jldi j3, 0
  hk_way:
    jst j3, j1, HKW
    jld j4, j1, HKP             ; asleep: " dormida" after its way
    jldb j2, j4, 36
    jldi j3, 100
    jsub j2, j2, j3
    jldi j3, 0
    jjnz j2, hk_aw
    jldb j2, j4, 37
    jldi j3, 111
    jsub j2, j2, j3
    jldi j3, 0
    jjnz j2, hk_aw
    jldi j3, 1
  hk_aw:
    jst j3, j1, HKAS
    jld j5, j1, HKKF            ; its two forms in this book
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKF
    jsub j6, j6, j5
    jjnz j6, hk_keep
    jld j6, j4, 8
    jst j6, j1, HKFF
    jld j5, j1, HKKP
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKP
    jsub j6, j6, j5
    jjnz j6, hk_keep
    jld j6, j4, 8
    jst j6, j1, HKFP
    jcall hk_judge              ; what this book says of it
    jldi j1, 0
    jld j2, j1, HKAS
    jjnz j2, hk_asleep
    jld j2, j1, HKXX            ; awake: more against it than for it, it sleeps (Capitan: "pruning is sleeping for a
    jld j3, j1, HKC             ; while, not removing: nothing is thrown away")
    jsub j2, j3, j2
    jldi j3, 63
    jsar j2, j2, j3
    jjz j2, hk_apply
    jld j2, j1, HKZN
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HKZ
    jadd j3, j3, j4
    jld j4, j1, HKP
    jst j4, j3, 0
    jld j5, j1, HKX
    jsub j5, j5, j4
    jst j5, j3, 8
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKZN
    jld j2, j1, HKD
    jadd j2, j2, j3
    jst j2, j1, HKD
    jldi j1, S_DUERME
    jcall puts
    jld j2, j1, HKFF
    jcall hl_sayform
    jldi j1, S_TIL
    jcall puts
    jld j2, j1, HKFP
    jcall hl_sayform
    jldi j1, S_ENC
    jcall puts
    jld j2, j1, HKXX
    jcall putnum
    jldi j1, S_AFAV
    jcall puts
    jld j2, j1, HKC
    jcall putnum
    jldi j2, 10
    jcall putch
    jjmp hk_next
  hk_asleep:                    ; asleep: it wakes when a book confirms it as a join is confirmed (two, none against)
    jld j2, j1, HKXX
    jjnz j2, hk_keep
    jld j2, j1, HKC
    jldi j3, 2
    jsub j2, j2, j3
    jldi j3, 63
    jsar j2, j2, j3
    jjnz j2, hk_keep
    jld j2, j1, HKWK
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKWK
    jldi j1, S_DESPS
    jcall puts
  hk_apply:
    jcall hk_join
    jjmp hk_next
  hk_keep:                      ; not in this book: kept as it is
    jldi j1, 0
    jld j2, j1, HKU
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HKL
    jadd j3, j3, j4
    jld j4, j1, HKP
    jst j4, j3, 0
    jld j5, j1, HKX
    jsub j5, j5, j4
    jst j5, j3, 8
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKU
  hk_next:
    jldi j1, 0
    jld j2, j1, HKX
    jst j2, j1, HKP
    jjmp hk_lap
hk_done:
  jld j2, j1, HKN
  jjz j2, hk_quiet
  jldi j1, S_SABN
  jcall puts
  jld j2, j1, HKA
  jcall putnum
  jldi j1, S_APL
  jcall puts
  jld j2, j1, HKU
  jcall putnum
  jldi j1, S_SINU
  jcall puts
  jldi j1, S_SABN
  jcall puts
  jld j2, j1, HKD
  jcall putnum
  jldi j1, S_DUER2
  jcall puts
  jld j2, j1, HKWK
  jcall putnum
  jldi j1, S_DESP2
  jcall puts
hk_quiet:
  jldi j1, 0
  jret

; What this book says of the line (form HKFF with form HKFP, HKW the way): each pair of the first, as the second says
; it (turned if the way is), confirms it if the second says it so, and is against it if the second says it only the
; other way -> HKC, HKXX. Uses j1-j14.
hk_judge:
  jldi j1, 0
  jst j1, j1, HKC
  jst j1, j1, HKXX
  jld j2, j1, HKFF
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j2, j3, 40
  jst j2, j1, HKJ
  hkg_lap:
    jldi j1, 0
    jld j2, j1, HKJ
    jldi j3, 63
    jsar j3, j2, j3
    jjnz j3, hkg_done
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HFL
    jadd j3, j3, j4
    jld j5, j3, 8
    jld j6, j3, 16
    jld j7, j3, 24
    jst j7, j1, HKJ
    jld j7, j1, HKW
    jjz j7, hkg_so
    jadd j7, j5, j1
    jadd j5, j6, j1
    jadd j6, j7, j1
  hkg_so:
    jst j5, j1, HKJA
    jst j6, j1, HKJB
    jcall hkg_has               ; the second says it so: it confirms
    jldi j1, 0
    jjz j6, hkg_rev
    jld j2, j1, HKC
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKC
    jjmp hkg_lap
  hkg_rev:
    jld j5, j1, HKJB
    jld j6, j1, HKJA
    jst j5, j1, HKJA
    jst j6, j1, HKJB
    jcall hkg_has
    jldi j1, 0
    jjz j6, hkg_lap
    jld j2, j1, HKXX
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKXX
    jjmp hkg_lap
hkg_done:
  jldi j1, 0
  jret

; j6 = 1 if form HKFP says the pair {HKJA, HKJB}. Uses j1-j8.
hkg_has:
  jldi j1, 0
  jld j2, j1, HKFP
  jldi j3, 48
  jmul j3, j2, j3
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j5, j3, 0
  jld j6, j1, HKJA
  jcall hl_mix
  jld j6, j1, HKJB
  jcall hl_mix
  jjnz j5, hkh_k
  jldi j5, 1
hkh_k:
  jst j5, j1, HKEY
  jldi j2, HFT
  jcall pl_find
  jldi j1, 0
  jld j6, j4, 0
  jld j5, j1, HKEY
  jsub j6, j6, j5
  jldi j7, 1
  jjz j6, hkh_yes
  jldi j7, 0
hkh_yes:
  jadd j6, j7, j1
  jret

; Sixteen hexadecimal digits at j4 -> j9. Uses j2, j3, j4, j8, j9.
hk_hex:
  jldi j9, 0
  jldi j8, 16
  hkh_lap:
    jjz j8, hkh_done
    jldb j2, j4, 0
    jldi j3, 97
    jsub j3, j2, j3
    jldi j1, 63
    jsar j3, j3, j1
    jldi j1, 48
    jjnz j3, hkh_dig
    jldi j1, 87
  hkh_dig:
    jsub j2, j2, j1
    jldi j3, 4
    jshl j9, j9, j3
    jor j9, j9, j2
    jldi j3, 1
    jadd j4, j4, j3
    jsub j8, j8, j3
    jjmp hkh_lap
hkh_done:
  jldi j1, 0
  jret

; Form HKFF joined to form HKFP again, HKW the way the first is to the second: their relations, one into the other, as
; a join of a turn does (the second's relation into the first's). Said "sabe:". Uses j1-j14.
hk_join:
  jldi j1, 0
  jld j2, j1, HKFP
  jcall hl_find
  jldi j1, 0
  jst j2, j1, HKRA
  jst j3, j1, HKPA
  jld j2, j1, HKFF
  jcall hl_find
  jldi j1, 0
  jld j4, j1, HKRA
  jsub j4, j4, j2
  jjz j4, hkj_done              ; (together already)
  jld j4, j1, HKPA              ; its way, against the first's relation
  jxor j3, j3, j4
  jld j4, j1, HKW
  jxor j3, j3, j4
  jst j2, j1, HKRB
  jst j3, j1, HKPB
  jldi j4, 3
  jshl j4, j2, j4
  jld j5, j1, HCLS
  jadd j5, j5, j4
  jld j6, j1, HKRA
  jst j6, j5, 0
  jld j5, j1, HPAR
  jadd j5, j5, j4
  jst j3, j5, 0
  jld j5, j1, HSIZE
  jadd j5, j5, j4
  jld j7, j5, 0
  jldi j8, 3
  jshl j8, j6, j8
  jld j9, j1, HSIZE
  jadd j9, j9, j8
  jld j10, j9, 0
  jadd j10, j10, j7
  jst j10, j9, 0
  jld j2, j1, HKA
  jldi j3, 1
  jadd j2, j2, j3
  jst j2, j1, HKA
  jldi j1, S_SABE
  jcall puts
  jld j2, j1, HKRA
  jcall hl_sayform
  jldi j1, S_TIL
  jcall puts
  jld j2, j1, HKRB
  jcall hl_sayform
  jldi j1, 0
  jld j2, j1, HKPB
  jldi j1, S_MISMA
  jjz j2, hkj_way
  jldi j1, S_REVES
hkj_way:
  jcall puts
  jldi j2, 10
  jcall putch
hkj_done:
  jldi j1, 0
  jret

; What it knows now, into the house's "sabido" for the next book: each form joined to another (one line each: its key,
; the key of the one it joined, the way, its words), and the lines of the books before it could not use, as they were.
; A form deduced here is not written (it is deduced again). Uses j1-j14.
hl_ksave:
  jcall flush
  jldi j10, 12
  jldi j11, S_SABIDO
  jldi j12, 6
  jcall ask
  jldi j10, 4
  jldi j11, S_SABIDO
  jldi j12, 6
  jcall ask
  jldi j1, 0
  jldi j2, 63
  jshr j2, j13, j2
  jjnz j2, hks_done
  jst j13, j1, HKH
  jldi j2, 1
  jadd j2, j13, j2
  jst j2, j1, SINK
  jst j1, j1, HKI
  hks_lap:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hks_old
    jldi j3, 3
    jshl j3, j2, j3
    jld j4, j1, HCLS
    jadd j4, j4, j3
    jld j4, j4, 0
    jsub j5, j4, j2
    jjz j5, hks_next            ; a relation of its own
    jst j4, j1, HKFP
    jld j5, j1, HPAR
    jadd j5, j5, j3
    jld j5, j5, 0
    jst j5, j1, HKW
    jadd j2, j2, j1             ; neither deduced
    jcall hk_deduced
    jjnz j6, hks_next
    jldi j1, 0
    jld j2, j1, HKFP
    jcall hk_deduced
    jjnz j6, hks_next
    jldi j1, 0
    jld j2, j1, HKI
    jcall hk_key
    jcall hk_puthex
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKFP
    jcall hk_key
    jcall hk_puthex
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKW
    jldi j3, 49
    jadd j2, j2, j3
    jcall putch
    jldi j2, 32
    jcall putch
    jldi j2, 124
    jcall putch
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKI
    jcall hl_sayform
    jldi j1, S_TIL
    jcall puts
    jld j2, j1, HKFP
    jcall hl_sayform
    jldi j2, 10
    jcall putch
  hks_next:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hks_lap
hks_old:
  jldi j1, 0
  jst j1, j1, HKI
  hks_o:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HKU
    jsub j3, j2, j3
    jjz j3, hks_close
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HKL
    jadd j3, j3, j4
    jld j4, j3, 0
    jld j5, j3, 8
    hks_b:
      jjz j5, hks_bn
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jsub j5, j5, j3
      jjmp hks_b
  hks_bn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hks_o
hks_close:
  jldi j1, 0                    ; the lines put to sleep here, " dormida" after their way
  jst j1, j1, HKI
  hks_z:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HKZN
    jsub j3, j2, j3
    jjz j3, hks_end
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HKZ
    jadd j3, j3, j4
    jld j4, j3, 0
    jld j5, j3, 8
    jldi j6, 35
    hks_z1:
      jjz j6, hks_zm
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jsub j5, j5, j3
      jsub j6, j6, j3
      jjmp hks_z1
  hks_zm:
    jldi j1, S_DORM
    jcall puts
    hks_z2:
      jjz j5, hks_zn
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jsub j5, j5, j3
      jjmp hks_z2
  hks_zn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hks_z
hks_end:
  jcall flush
  jldi j1, 0
  jst j1, j1, SINK
  jld j10, j1, HKH
  jldi j2, 32
  jshl j10, j10, j2
  jldi j2, 7
  jor j10, j10, j2
  jcall ask
hks_done:
  jldi j1, 0
  jret

; j6 = 1 if form j2 was deduced here (not read). Uses j1, j3, j4, j6.
hk_deduced:
  jldi j3, 48
  jmul j3, j2, j3
  jldi j1, 0
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j4, j3, 24
  jldi j6, 63
  jsar j6, j4, j6
  jjz j6, hkd_no
  jldi j6, 1
hkd_no:
  jret

; j2 = the key of form j2. Uses j1, j3, j4.
hk_key:
  jldi j3, 48
  jmul j3, j2, j3
  jldi j1, 0
  jld j4, j1, HMA
  jadd j3, j3, j4
  jld j2, j3, 0
  jret

; j2 in sixteen hexadecimal digits, the highest first. Uses j1-j5.
hk_puthex:
  jldi j1, 0
  jst j2, j1, HKKF
  jldi j5, 16
  hkp_lap:
    jjz j5, hkp_done
    jldi j1, 0
    jld j2, j1, HKKF
    jldi j3, 60
    jshr j2, j2, j3
    jldi j3, 10
    jsub j3, j2, j3
    jldi j4, 63
    jsar j3, j3, j4
    jldi j4, 48
    jjnz j3, hkp_dig
    jldi j4, 87
  hkp_dig:
    jadd j2, j2, j4
    jcall putch
    jldi j1, 0
    jld j2, j1, HKKF
    jldi j3, 4
    jshl j2, j2, j3
    jst j2, j1, HKKF
    jldi j3, 1
    jsub j5, j5, j3
    jjmp hkp_lap
hkp_done:
  jret

; What was left to solve (Capitan: "the ones without a partner, put them to sleep and look in the next book if they
; have one: it leaves something on its mind to solve, and when it finds where to check it, it checks it"): the house's
; "pendiente", two forms that held one pair alike in a book before (one confirmation: not enough to join), a line each
; as in "sabido", kept as it is. The ones whose two forms this book has sit the same exam as any join (Capitan: "the
; same ones"): in every turn the pair the book before saw counts as one more read alike for them (hl_pinject), and
; they join only if they beat chance, choose each other, nothing contradicts them and they explain. Uses j1-j14.
hl_pending:
  jldi j11, S_PEND
  jldi j12, 9
  jcall en_read
  jldi j1, 0
  jld j2, j1, PRB
  jst j2, j1, HQB
  jld j2, j1, PRN
  jst j2, j1, HQN
  jst j1, j1, HQU
  jst j1, j1, HQV
  jldi j3, 16
  jadd j11, j2, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HQL
  jld j11, j1, HQN              ; (24 bytes each, a line is 36 or more)
  jldi j3, 24
  jadd j11, j11, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HQA
  jst j1, j1, HQAN
  jld j2, j1, HQB
  jst j2, j1, HKP
  jld j3, j1, HQN
  jadd j3, j2, j3
  jst j3, j1, HKE
  hq_lap:
    jldi j1, 0
    jld j4, j1, HKP
    jld j5, j1, HKE
    jsub j5, j5, j4
    jjz j5, hq_done
    jadd j7, j4, j1
    hq_eol:
      jld j5, j1, HKE
      jsub j5, j5, j7
      jjz j5, hq_eold
      jldb j5, j7, 0
      jldi j6, 1
      jadd j7, j7, j6
      jldi j6, 10
      jsub j5, j5, j6
      jjnz j5, hq_eol
  hq_eold:
    jst j7, j1, HKX
    jsub j5, j7, j4
    jldi j6, 36
    jsub j6, j5, j6
    jldi j8, 63
    jsar j6, j6, j8
    jjnz j6, hq_next
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HKKF
    jld j4, j1, HKP
    jldi j2, 17
    jadd j4, j4, j2
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HKKP
    jld j4, j1, HKP
    jldb j2, j4, 34
    jldi j3, 50
    jsub j2, j2, j3
    jldi j3, 1
    jjz j2, hq_way
    jldi j3, 0
  hq_way:
    jst j3, j1, HKW
    jld j5, j1, HKKF
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKF
    jsub j6, j6, j5
    jjnz j6, hq_keep
    jld j6, j4, 8
    jst j6, j1, HKFF
    jld j5, j1, HKKP
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKP
    jsub j6, j6, j5
    jjnz j6, hq_keep
    jld j6, j4, 8
    jst j6, j1, HKFP
    jld j2, j1, HQAN            ; this book can judge it: listed, for its turns (hl_pinject)
    jldi j3, 24
    jmul j3, j2, j3
    jld j4, j1, HQA
    jadd j3, j3, j4
    jld j4, j1, HKFF
    jst j4, j3, 0
    jld j4, j1, HKFP
    jst j4, j3, 8
    jld j4, j1, HKW
    jst j4, j3, 16
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HQAN
  hq_keep:
    jldi j1, 0
    jld j2, j1, HQU
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HQL
    jadd j3, j3, j4
    jld j4, j1, HKP
    jst j4, j3, 0
    jld j5, j1, HKX
    jsub j5, j5, j4
    jst j5, j3, 8
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HQU
  hq_next:
    jldi j1, 0
    jld j2, j1, HKX
    jst j2, j1, HKP
    jjmp hq_lap
hq_done:
  jldi j1, 0
  jret

; This turn's relations of relations: each pending one this book has, between the relations its two forms are in now,
; one read alike more (the pair the book before saw), if this book holds a pair of them alike too (a hypothesis to
; judge: the pending one adds to it, never makes one by itself). Uses j1-j14.
hl_pinject:
  jldi j1, 0
  jst j1, j1, HKI
  hpi_lap:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HQAN
    jsub j3, j2, j3
    jjz j3, hpi_done
    jldi j3, 24
    jmul j3, j2, j3
    jld j4, j1, HQA
    jadd j3, j3, j4
    jst j3, j1, HKP
    jld j2, j3, 0
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HKRA
    jst j3, j1, HKPA
    jld j4, j1, HKP
    jld j2, j4, 8
    jcall hl_find
    jldi j1, 0
    jld j4, j1, HKRA
    jsub j4, j4, j2
    jjz j4, hpi_next            ; (one relation already)
    jld j4, j1, HKPA            ; their way, as relations now: 1 the same, 2 the other
    jxor j3, j3, j4
    jld j4, j1, HKP
    jld j4, j4, 16
    jxor j3, j3, j4
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, HDIR
    jld j10, j1, HKRA           ; the smaller first, as hl_agree keys them
    jadd j11, j2, j1
    jsub j12, j10, j11
    jldi j14, 63
    jsar j12, j12, j14
    jjnz j12, hpi_ord
    jadd j12, j10, j1
    jadd j10, j11, j1
    jadd j11, j12, j1
  hpi_ord:
    jadd j5, j10, j1
    jadd j6, j11, j1
    jcall hl_mix
    jld j6, j1, HDIR
    jcall hl_mix
    jjnz j5, hpi_k
    jldi j5, 1
  hpi_k:
    jst j5, j1, HKEY
    jldi j2, HAG
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKEY
    jsub j6, j6, j5
    jjnz j6, hpi_next
    jld j6, j4, 32
    jldi j7, 1
    jadd j6, j6, j7
    jst j6, j4, 32
  hpi_next:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hpi_lap
hpi_done:
  jldi j1, 0
  jret

; The pending ones this book joined (they passed the exam): checked ("verifica:"), counted. Uses j1-j14.
hl_pchecked:
  jldi j1, 0
  jst j1, j1, HQV
  jst j1, j1, HKI
  hpc_lap:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HQAN
    jsub j3, j2, j3
    jjz j3, hpc_done
    jldi j3, 24
    jmul j3, j2, j3
    jld j4, j1, HQA
    jadd j3, j3, j4
    jst j3, j1, HKP
    jld j2, j3, 0
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HKRA
    jld j4, j1, HKP
    jld j2, j4, 8
    jcall hl_find
    jldi j1, 0
    jld j4, j1, HKRA
    jsub j4, j4, j2
    jjnz j4, hpc_next
    jld j2, j1, HQV
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HQV
    jldi j1, S_VERIF
    jcall puts
    jld j4, j1, HKP
    jld j2, j4, 0
    jcall hl_sayform
    jldi j1, S_TIL
    jcall puts
    jld j4, j1, HKP
    jld j2, j4, 8
    jcall hl_sayform
    jldi j2, 10
    jcall putch
  hpc_next:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hpc_lap
hpc_done:
  jldi j1, 0
  jret

; What is left to solve now, into "pendiente" for the next book: the lines still pending (one whose two forms joined in
; this book is solved, and goes), then two forms of this book's last turn that held one pair alike and none crossed
; (one confirmation), whose relations are not one. Each two forms once (Capitan: "do not keep duplicates"). Uses
; j1-j14.
hl_psave:
  jcall hl_pchecked
  jldi j2, HPDS
  jldi j3, 16
  jcall pl_new
  jldi j1, 0
  jst j1, j1, HPDN
  jcall flush
  jldi j10, 12
  jldi j11, S_PEND
  jldi j12, 9
  jcall ask
  jldi j10, 4
  jldi j11, S_PEND
  jldi j12, 9
  jcall ask
  jldi j1, 0
  jldi j2, 63
  jshr j2, j13, j2
  jjnz j2, hps_done
  jst j13, j1, HKH
  jldi j2, 1
  jadd j2, j13, j2
  jst j2, j1, SINK
  jst j1, j1, HKI
  hps_old:                      ; the ones still pending
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HQU
    jsub j3, j2, j3
    jjz j3, hps_new
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HQL
    jadd j3, j3, j4
    jld j4, j3, 0
    jst j4, j1, HKP
    jld j5, j3, 8
    jst j5, j1, HKX
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HKKF
    jld j4, j1, HKP
    jldi j2, 17
    jadd j4, j4, j2
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HKKP
    jld j5, j1, HKKF            ; (once each, either way round)
    jld j6, j1, HKKP
    jcall hp_order
    jcall hl_mix
    jjnz j5, hps_k
    jldi j5, 1
  hps_k:
    jldi j2, HPDS
    jcall pl_take
    jldi j1, 0
    jjz j6, hps_on
    jld j5, j1, HKKF            ; joined in this book: solved
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKF
    jsub j6, j6, j5
    jjnz j6, hps_put
    jld j2, j4, 8
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HKRA
    jld j5, j1, HKKP
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKP
    jsub j6, j6, j5
    jjnz j6, hps_put
    jld j2, j4, 8
    jcall hl_find
    jldi j1, 0
    jld j3, j1, HKRA
    jsub j3, j3, j2
    jjz j3, hps_on
  hps_put:
    jldi j1, 0
    jld j4, j1, HKP
    jld j5, j1, HKX
    hps_b:
      jjz j5, hps_on
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jsub j5, j5, j3
      jjmp hps_b
  hps_on:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hps_old
hps_new:                        ; this book's: one pair alike, none crossed
  jldi j2, HAG
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HKI
  jld j4, j2, 0
  jst j4, j1, HKP
  hps_n:
    jldi j1, 0
    jld j3, j1, HKI
    jjz j3, hps_close
    jld j4, j1, HKP
    jld j5, j4, 0
    jjz j5, hps_nn
    jld j5, j4, 32
    jldi j6, 1
    jsub j5, j5, j6
    jjnz j5, hps_nn
    jld j5, j4, 40
    jjnz j5, hps_nn
    jld j2, j4, 8
    jst j2, j1, HKFF
    jld j2, j4, 16
    jst j2, j1, HKFP
    jld j2, j4, 24
    jst j2, j1, HKW
    jld j2, j1, HKFF
    jcall hk_deduced
    jjnz j6, hps_nn
    jldi j1, 0
    jld j2, j1, HKFP
    jcall hk_deduced
    jjnz j6, hps_nn
    jldi j1, 0
    jld j2, j1, HKFF
    jcall hl_find
    jldi j1, 0
    jst j2, j1, HKRA
    jld j2, j1, HKFP
    jcall hl_find
    jldi j1, 0
    jld j3, j1, HKRA
    jsub j3, j3, j2
    jjz j3, hps_nn              ; (one relation already)
    jld j2, j1, HKFF
    jcall hk_key
    jldi j1, 0
    jst j2, j1, HKKF
    jld j2, j1, HKFP
    jcall hk_key
    jldi j1, 0
    jst j2, j1, HKKP
    jld j5, j1, HKKF
    jld j6, j1, HKKP
    jcall hp_order
    jcall hl_mix
    jjnz j5, hps_k2
    jldi j5, 1
  hps_k2:
    jldi j2, HPDS
    jcall pl_take
    jldi j1, 0
    jjz j6, hps_nn
    jld j2, j1, HPDN
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HPDN
    jld j2, j1, HKKF
    jcall hk_puthex
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKKP
    jcall hk_puthex
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKW
    jldi j3, 48
    jadd j2, j2, j3
    jcall putch
    jldi j2, 32
    jcall putch
    jldi j2, 124
    jcall putch
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j2, j1, HKFF
    jcall hl_sayform
    jldi j1, S_TIL
    jcall puts
    jld j2, j1, HKFP
    jcall hl_sayform
    jldi j2, 10
    jcall putch
  hps_nn:
    jldi j1, 0
    jld j4, j1, HKP
    jldi j5, HAG
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HKP
    jld j3, j1, HKI
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HKI
    jjmp hps_n
hps_close:
  jcall flush
  jldi j1, 0
  jst j1, j1, SINK
  jld j10, j1, HKH
  jldi j2, 32
  jshl j10, j10, j2
  jldi j2, 7
  jor j10, j10, j2
  jcall ask
  jldi j1, S_PENN
  jcall puts
  jld j2, j1, HQV
  jcall putnum
  jldi j1, S_PVER
  jcall puts
  jld j2, j1, HQU
  jld j3, j1, HQV
  jsub j2, j2, j3
  jcall putnum
  jldi j1, S_PSIG
  jcall puts
  jld j2, j1, HPDN
  jcall putnum
  jldi j1, S_PNUE
  jcall puts
hps_done:
  jldi j1, 0
  jret

; j5, j6 in order, the smaller first (two forms are the same two, either way round). Uses j5-j8.
hp_order:
  jsub j7, j6, j5
  jldi j8, 63
  jsar j7, j7, j8
  jjz j7, hpo_done
  jsub j8, j8, j8
  jadd j7, j5, j8
  jadd j5, j6, j8
  jadd j6, j7, j8
hpo_done:
  jret

; What each form of grammar does, found by Razar itself in what it proved (Capitan: "'y' joins two things that are
; alike: that is the instruction; joined to other gears they make a mechanism"; and the house's rule: Razar makes
; its own rules, we do not give them). Its roles first: in every relation it proved (two forms or more), each word is
; the B of its A or the A of its B. Two words are alike when they hold one same role (the same relation, the same
; side, the same other word: "isaac" and "ismael", both sons of "abraham"). A form joins alike things when, of its
; pairs whose two words both hold roles, more than half are alike, two at least, and more than its pairs crossed (each
; A with the B of the next pair: what chance gives): "instruccion: y | une iguales 7 de 9 (mezcladas 1 de 9)". Then
; it imagines with it: where "a y b" and a holds a role b does not, b holds it too ("imagina: abraham padre de ismael").
; Each one imagined is an open vote, into the house's "imaginado" for the books after, and so is each one its crossed
; pairs would imagine (chance's, to know how much of it is luck). Uses j1-j14.
hl_instr:
  jldi j2, HROL
  jldi j3, 16
  jcall pl_new
  jldi j2, HWRH
  jldi j3, 16
  jcall pl_new
  jldi j2, HIMG
  jldi j3, 16
  jcall pl_new
  jldi j1, 0
  jst j1, j1, HRLN
  jst j1, j1, HINS
  jst j1, j1, HIC
  jst j1, j1, HIC0
  jst j1, j1, HKI               ; the room for the roles: two for each pair of a relation it proved
  jst j1, j1, HIQ
  hin_c:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hin_cd
    jcall hin_proved
    jjz j6, hin_cn
    jldi j1, 0
    jld j2, j1, HKI
    jcall hxr_of
    jldi j1, 0
    jld j2, j1, HIQ
    jadd j2, j2, j10
    jst j2, j1, HIQ
  hin_cn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hin_c
hin_cd:
  jld j11, j1, HIQ
  jadd j11, j11, j11
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 5
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HRL
  jst j1, j1, HKI
  hin_r:                        ; the roles
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hin_rd
    jcall hin_proved
    jjz j6, hin_rn
    jldi j1, 0
    jld j2, j1, HKI
    jcall hxr_of
    jldi j1, 0
    jst j9, j1, HIP
    jst j10, j1, HIN
    hin_p:
      jldi j1, 0
      jld j10, j1, HIN
      jjz j10, hin_rn
      jld j9, j1, HIP
      jld j2, j1, HKI           ; B is the B of A
      jldi j3, 0
      jld j4, j9, 0
      jld j5, j9, 8
      jcall hin_role
      jldi j1, 0
      jld j9, j1, HIP
      jld j2, j1, HKI           ; A is the A of B
      jldi j3, 1
      jld j4, j9, 8
      jld j5, j9, 0
      jcall hin_role
      jldi j1, 0
      jld j9, j1, HIP
      jldi j2, 16
      jadd j9, j9, j2
      jst j9, j1, HIP
      jld j10, j1, HIN
      jldi j2, 1
      jsub j10, j10, j2
      jst j10, j1, HIN
      jjmp hin_p
  hin_rn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hin_r
hin_rd:
  jld j11, j1, HNF              ; a form's pairs, as they are walked
  jldi j2, 1
  jadd j11, j11, j2
  jldi j2, 4
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, HIPR
  jst j1, j1, HKI
  hin_f:                        ; each form: does it join alike things?
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HNM
    jsub j3, j2, j3
    jjz j3, hin_done
    jcall hk_deduced
    jjnz j6, hin_fn
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 48
    jmul j3, j2, j3
    jld j4, j1, HMA
    jadd j3, j3, j4
    jld j5, j3, 32
    jldi j6, 2
    jsub j5, j5, j6
    jldi j6, 63
    jsar j5, j5, j6
    jjnz j5, hin_fn             ; (two pairs at least)
    jld j2, j3, 40              ; its pairs, into HIPR
    jst j1, j1, HIN
    hin_l:
      jldi j3, 63
      jsar j3, j2, j3
      jjnz j3, hin_ld
      jldi j3, 5
      jshl j3, j2, j3
      jld j4, j1, HFL
      jadd j3, j3, j4
      jld j5, j1, HIN
      jldi j6, 4
      jshl j6, j5, j6
      jld j7, j1, HIPR
      jadd j6, j6, j7
      jld j7, j3, 8
      jst j7, j6, 0
      jld j7, j3, 16
      jst j7, j6, 8
      jldi j7, 1
      jadd j5, j5, j7
      jst j5, j1, HIN
      jld j2, j3, 24
      jjmp hin_l
  hin_ld:
    jst j1, j1, HIJ
    jst j1, j1, HIS
    jst j1, j1, HIJ0
    jst j1, j1, HIS0
    jst j1, j1, HIK
    hin_m:                      ; each pair, and the pair crossed (its A with the next one's B)
      jldi j1, 0
      jld j2, j1, HIK
      jld j3, j1, HIN
      jsub j3, j2, j3
      jjz j3, hin_judge
      jcall hin_pair
      jldi j1, 0
      jld j2, j1, HIA
      jld j3, j1, HIB
      jcall hin_alike
      jldi j1, 0
      jld j2, j1, HIJ
      jadd j2, j2, j7
      jst j2, j1, HIJ
      jld j2, j1, HIS
      jadd j2, j2, j6
      jst j2, j1, HIS
      jld j2, j1, HIA
      jld j3, j1, HIB0
      jcall hin_alike
      jldi j1, 0
      jld j2, j1, HIJ0
      jadd j2, j2, j7
      jst j2, j1, HIJ0
      jld j2, j1, HIS0
      jadd j2, j2, j6
      jst j2, j1, HIS0
      jld j2, j1, HIK
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HIK
      jjmp hin_m
  hin_judge:
    jld j2, j1, HIS             ; two alike at least, more than half, more than chance
    jldi j3, 2
    jsub j3, j2, j3
    jldi j4, 63
    jsar j3, j3, j4
    jjnz j3, hin_fn
    jadd j3, j2, j2
    jld j5, j1, HIJ
    jsub j3, j5, j3
    jsar j3, j3, j4
    jjz j3, hin_fn
    jld j3, j1, HIS0
    jsub j3, j3, j2
    jsar j3, j3, j4
    jjz j3, hin_fn
    jld j2, j1, HINS
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HINS
    jldi j1, S_INSTR
    jcall puts
    jld j2, j1, HKI
    jcall hl_sayform
    jldi j1, S_UNEIG
    jcall puts
    jld j2, j1, HIS
    jcall putnum
    jldi j1, S_DE
    jcall puts
    jld j2, j1, HIJ
    jcall putnum
    jldi j1, S_MEZC
    jcall puts
    jld j2, j1, HIS0
    jcall putnum
    jldi j1, S_DE
    jcall puts
    jld j2, j1, HIJ0
    jcall putnum
    jldi j2, 41
    jcall putch
    jldi j2, 10
    jcall putch
    jldi j1, 0                  ; and it imagines with it: with its pairs, and with its pairs crossed (chance)
    jst j1, j1, HIK
    hin_i:
      jldi j1, 0
      jld j2, j1, HIK
      jld j3, j1, HIN
      jsub j3, j2, j3
      jjz j3, hin_fn
      jcall hin_pair
      jldi j1, 0
      jldi j2, 105
      jst j2, j1, HIF
      jld j2, j1, HIA
      jld j3, j1, HIB
      jcall hin_imagine
      jldi j1, 0
      jld j2, j1, HIB
      jld j3, j1, HIA
      jcall hin_imagine
      jldi j1, 0
      jldi j2, 97
      jst j2, j1, HIF
      jld j2, j1, HIA
      jld j3, j1, HIB0
      jcall hin_imagine
      jldi j1, 0
      jld j2, j1, HIB0
      jld j3, j1, HIA
      jcall hin_imagine
      jldi j1, 0
      jld j2, j1, HIK
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HIK
      jjmp hin_i
  hin_fn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hin_f
hin_done:
  jldi j1, S_INSN
  jcall puts
  jld j2, j1, HINS
  jcall putnum
  jldi j1, S_INSI
  jcall puts
  jld j2, j1, HIC
  jcall putnum
  jldi j1, S_INSA
  jcall puts
  jld j2, j1, HIC0
  jcall putnum
  jldi j2, 41
  jcall putch
  jldi j2, 10
  jcall putch
  jldi j1, 0
  jret

; The one imagined now {HIR, HISD, HIZ, HIW, HIF} onto the list HIML (it grows to what it holds: full, a room twice as
; big, what it had moved to it). Uses j1-j14.
hin_push:
  jldi j1, 0
  jld j2, j1, HIMN
  jld j3, j1, HIMC
  jsub j3, j2, j3
  jjnz j3, hpu_room
  jld j11, j1, HIMC
  jadd j11, j11, j11
  jldi j2, 8
  jadd j11, j11, j2
  jst j11, j1, HIMC
  jldi j2, 40
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jld j4, j1, HIML
  jadd j5, j13, j1
  jld j6, j1, HIMN
  jldi j7, 40
  jmul j6, j6, j7
  hpu_c:
    jjz j6, hpu_cd
    jldb j7, j4, 0
    jstb j7, j5, 0
    jldi j7, 1
    jadd j4, j4, j7
    jadd j5, j5, j7
    jsub j6, j6, j7
    jjmp hpu_c
hpu_cd:
  jst j13, j1, HIML
hpu_room:
  jld j2, j1, HIMN
  jldi j3, 40
  jmul j3, j2, j3
  jld j4, j1, HIML
  jadd j3, j3, j4
  jld j4, j1, HIR
  jst j4, j3, 0
  jld j4, j1, HISD
  jst j4, j3, 8
  jld j4, j1, HIZ
  jst j4, j3, 16
  jld j4, j1, HIW
  jst j4, j3, 24
  jld j4, j1, HIF
  jst j4, j3, 32
  jldi j4, 1
  jadd j2, j2, j4
  jst j2, j1, HIMN
  jret

; j6 = 1 if form HKI is a relation it proved: its own (not joined to another), of two forms or more, not deduced.
; Uses j1-j8.
hin_proved:
  jldi j1, 0
  jld j2, j1, HKI
  jldi j6, 0
  jldi j3, 3
  jshl j3, j2, j3
  jld j4, j1, HCLS
  jadd j4, j4, j3
  jld j4, j4, 0
  jsub j4, j4, j2
  jjnz j4, hpr_no
  jld j4, j1, HSIZE
  jadd j4, j4, j3
  jld j4, j4, 0
  jldi j5, 2
  jsub j4, j4, j5
  jldi j5, 63
  jsar j4, j4, j5
  jjnz j4, hpr_no
  jcall hk_deduced
  jldi j7, 1
  jxor j6, j6, j7
  jret
hpr_no:
  jldi j6, 0
  jret

; Pair HIK of the form walked -> HIA, HIB, and HIB0 the B of the next (its crossed). Uses j1-j6.
hin_pair:
  jldi j1, 0
  jld j2, j1, HIK
  jldi j3, 4
  jshl j3, j2, j3
  jld j4, j1, HIPR
  jadd j3, j3, j4
  jld j5, j3, 0
  jst j5, j1, HIA
  jld j5, j3, 8
  jst j5, j1, HIB
  jldi j5, 1
  jadd j2, j2, j5
  jld j5, j1, HIN
  jsub j5, j2, j5
  jjnz j5, hpa_n
  jldi j2, 0
hpa_n:
  jldi j3, 4
  jshl j3, j2, j3
  jadd j3, j3, j4
  jld j5, j3, 8
  jst j5, j1, HIB0
  jret

; Word j5 holds role {relation j2, side j3, other word j4}: in the table of roles (HROL) and in its list. Uses j1-j14.
hin_role:
  jldi j1, 0
  jst j2, j1, HIR
  jst j3, j1, HISD
  jst j4, j1, HIZ
  jst j5, j1, HIW
  jcall hin_rkey
  jldi j2, HROL
  jcall pl_take
  jldi j1, 0
  jjz j6, hrl_done
  jld j5, j1, HIW               ; its list: the new role first
  jldi j2, HWRH
  jcall pl_take
  jldi j1, 0
  jld j6, j4, 8
  jld j2, j1, HRLN
  jldi j3, 5
  jshl j3, j2, j3
  jld j7, j1, HRL
  jadd j3, j3, j7
  jld j7, j1, HIR
  jst j7, j3, 0
  jld j7, j1, HISD
  jst j7, j3, 8
  jld j7, j1, HIZ
  jst j7, j3, 16
  jst j6, j3, 24
  jldi j7, 1
  jadd j2, j2, j7
  jst j2, j1, HRLN
  jst j2, j4, 8                 ; (the list's first: its place plus one)
hrl_done:
  jldi j1, 0
  jret

; The key of role {HIR, HISD, HIZ} of word HIW -> j5. Uses j1, j5-j7.
hin_rkey:
  jldi j1, 0
  jld j5, j1, HIR
  jld j6, j1, HISD
  jcall hl_mix
  jld j6, j1, HIZ
  jcall hl_mix
  jld j6, j1, HIW
  jcall hl_mix
  jjnz j5, hrk_k
  jldi j5, 1
hrk_k:
  jret

; Words j2 and j3: j7 = 1 if both hold roles (it can judge them), j6 = 1 if they hold one same role (alike).
; Uses j1-j14.
hin_alike:
  jldi j1, 0
  jst j3, j1, HIW
  jst j3, j1, HIB1
  jadd j5, j2, j1
  jldi j2, HWRH
  jcall pl_find
  jldi j1, 0
  jld j6, j4, 0
  jjz j6, hal_no
  jld j6, j4, 8
  jst j6, j1, HIL
  jld j5, j1, HIB1
  jldi j2, HWRH
  jcall pl_find
  jldi j1, 0
  jld j6, j4, 0
  jjz j6, hal_no
  hal_lap:
    jldi j1, 0
    jld j2, j1, HIL
    jjz j2, hal_none
    jldi j3, 1
    jsub j2, j2, j3
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HRL
    jadd j3, j3, j4
    jld j4, j3, 0
    jst j4, j1, HIR
    jld j4, j3, 8
    jst j4, j1, HISD
    jld j4, j3, 16
    jst j4, j1, HIZ
    jld j4, j3, 24
    jst j4, j1, HIL
    jld j4, j1, HIB1
    jst j4, j1, HIW
    jcall hin_rkey
    jldi j2, HROL
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jsub j6, j6, j5
    jjnz j6, hal_lap
    jldi j7, 1
    jldi j6, 1
    jret
hal_none:
  jldi j7, 1
  jldi j6, 0
  jret
hal_no:
  jldi j7, 0
  jldi j6, 0
  jret

; Where "a" and "b" (j2, j3) are alike by an instruction: each role a holds that b does not, b imagined to hold it
; ("imagina: z <relation> b" for the instruction's own pairs; HIF says which: "i" imagined, "a" chance's), once each,
; into the house's "imaginado". Uses j1-j14.
hin_imagine:
  jldi j1, 0
  jst j3, j1, HIB1
  jadd j5, j2, j1
  jldi j2, HWRH
  jcall pl_find
  jldi j1, 0
  jld j6, j4, 0
  jjz j6, him_done
  jld j6, j4, 8
  jst j6, j1, HIL
  him_lap:
    jldi j1, 0
    jld j2, j1, HIL
    jjz j2, him_done
    jldi j3, 1
    jsub j2, j2, j3
    jldi j3, 5
    jshl j3, j2, j3
    jld j4, j1, HRL
    jadd j3, j3, j4
    jld j4, j3, 0
    jst j4, j1, HIR
    jld j4, j3, 8
    jst j4, j1, HISD
    jld j4, j3, 16
    jst j4, j1, HIZ
    jld j4, j3, 24
    jst j4, j1, HIL
    jld j4, j1, HIB1
    jst j4, j1, HIW
    jcall hin_rkey
    jldi j2, HROL
    jcall pl_find               ; b holds it already: nothing to imagine
    jldi j1, 0
    jld j6, j4, 0
    jsub j6, j6, j5
    jjz j6, him_lap
    jcall hin_rkey              ; once each (and which it is)
    jld j6, j1, HIF
    jcall hl_mix
    jjnz j5, him_k
    jldi j5, 1
  him_k:
    jldi j2, HIMG
    jcall pl_take
    jldi j1, 0
    jjz j6, him_lap
    jld j2, j1, HIF
    jldi j3, 105
    jsub j3, j2, j3
    jjnz j3, him_c0
    jld j2, j1, HIC
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HIC
    jjmp him_w
  him_c0:
    jld j2, j1, HIC0
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HIC0
  him_w:
    jcall hin_push
    jjmp him_lap
him_done:
  jldi j1, 0
  jret

; One imagined into the open "imaginado" (SINK): "<the relation's key> <side> <z> <b> <i|a> | z <relation> b". The
; relation by the key of its own form, the words by their prints (both the same in every book). Uses j1-j14.
hin_iwrite:
  jldi j1, 0
  jld j2, j1, HIR
  jcall hk_key
  jcall hk_puthex
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HISD
  jldi j3, 48
  jadd j2, j2, j3
  jcall putch
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HIZ
  jcall hk_puthex
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HIW
  jcall hk_puthex
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HIF
  jcall putch
  jldi j2, 32
  jcall putch
  jldi j2, 124
  jcall putch
  jldi j2, 32
  jcall putch
  jldi j1, 0                    ; (said as it reads: z relation b, or b relation z)
  jld j2, j1, HISD
  jjnz j2, hiw_ab
  jld j5, j1, HIZ
  jcall en_sayprint
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HIR
  jcall hl_sayform
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j5, j1, HIW
  jcall en_sayprint
  jjmp hiw_nl
hiw_ab:
  jld j5, j1, HIW
  jcall en_sayprint
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j2, j1, HIR
  jcall hl_sayform
  jldi j2, 32
  jcall putch
  jldi j1, 0
  jld j5, j1, HIZ
  jcall en_sayprint
hiw_nl:
  jldi j2, 10
  jjmp putch

; What it imagined in the books before, against this one (Capitan: "an open vote to test it when it repeats: if one
; that repeats explains what it imagined, there we have it, it works"): each line whose relation this book proved and
; whose word z this book gives that relation on that side can be tested; it is confirmed if the relation says it so
; ("confirma:"). Counted apart, imagined ("i") and chance's ("a"). Every line not confirmed is kept for the books after
; (an open vote: never thrown away). Uses j1-j14.
hl_icheck:
  jldi j11, S_IMAG
  jldi j12, 9
  jcall en_read
  jldi j1, 0
  jld j2, j1, PRB
  jst j2, j1, HVB
  jld j2, j1, PRN
  jst j2, j1, HVN
  jst j1, j1, HVT
  jst j1, j1, HVC
  jst j1, j1, HVT0
  jst j1, j1, HVC0
  jst j1, j1, HVU
  jldi j3, 16
  jadd j11, j2, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HVL
  jld j2, j1, HVB
  jst j2, j1, HKP
  jld j3, j1, HVN
  jadd j3, j2, j3
  jst j3, j1, HKE
  hvc_lap:
    jldi j1, 0
    jld j4, j1, HKP
    jld j5, j1, HKE
    jsub j5, j5, j4
    jjz j5, hvc_done
    jadd j7, j4, j1
    hvc_eol:
      jld j5, j1, HKE
      jsub j5, j5, j7
      jjz j5, hvc_eold
      jldb j5, j7, 0
      jldi j6, 1
      jadd j7, j7, j6
      jldi j6, 10
      jsub j5, j5, j6
      jjnz j5, hvc_eol
  hvc_eold:
    jst j7, j1, HKX
    jsub j5, j7, j4
    jldi j6, 55
    jsub j6, j5, j6
    jldi j8, 63
    jsar j6, j6, j8
    jjnz j6, hvc_next
    jcall hk_hex                ; the relation's key, its side, z, b, which
    jldi j1, 0
    jst j9, j1, HKKF
    jld j4, j1, HKP
    jldb j2, j4, 17
    jldi j3, 48
    jsub j2, j2, j3
    jst j2, j1, HISD
    jldi j2, 19
    jadd j4, j4, j2
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HIZ
    jld j4, j1, HKP
    jldi j2, 36
    jadd j4, j4, j2
    jcall hk_hex
    jldi j1, 0
    jst j9, j1, HIW
    jld j4, j1, HKP
    jldb j2, j4, 53
    jst j2, j1, HIF
    jld j5, j1, HKKF            ; the relation in this book
    jldi j2, HMID
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jld j5, j1, HKKF
    jsub j6, j6, j5
    jjnz j6, hvc_keep
    jld j2, j4, 8
    jcall hl_find
    jldi j1, 0
    jld j4, j1, HISD            ; (its side as the relation is now)
    jxor j4, j4, j3
    jst j4, j1, HISD
    jst j2, j1, HIR
    jld j2, j1, HIR
    jcall hxr_of
    jldi j1, 0
    jldi j8, 0                  ; walk its pairs: z on its side (testable), and z with b (confirmed)
    hvc_p:
      jjz j10, hvc_pd
      jld j5, j9, 0
      jld j6, j9, 8
      jld j7, j1, HISD
      jjz j7, hvc_so
      jadd j7, j5, j1
      jadd j5, j6, j1
      jadd j6, j7, j1
    hvc_so:
      jld j7, j1, HIZ
      jsub j7, j5, j7
      jjnz j7, hvc_pn
      jldi j8, 1
      jld j7, j1, HIW
      jsub j7, j6, j7
      jjz j7, hvc_yes
    hvc_pn:
      jldi j7, 16
      jadd j9, j9, j7
      jldi j7, 1
      jsub j10, j10, j7
      jjmp hvc_p
  hvc_pd:
    jjz j8, hvc_keep            ; not testable here: kept
    jld j2, j1, HIF             ; testable, not confirmed: counted, kept
    jldi j3, 105
    jsub j3, j2, j3
    jjnz j3, hvc_t0
    jld j2, j1, HVT
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HVT
    jjmp hvc_keep
  hvc_t0:
    jld j2, j1, HVT0
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HVT0
    jjmp hvc_keep
  hvc_yes:
    jld j2, j1, HIF
    jldi j3, 105
    jsub j3, j2, j3
    jjnz j3, hvc_y0
    jld j2, j1, HVT
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HVT
    jld j2, j1, HVC
    jadd j2, j2, j3
    jst j2, j1, HVC
    jldi j1, S_CONFI            ; it works: said, and not kept as a vote
    jcall puts
    jld j4, j1, HKP
    jldi j2, 57
    jadd j4, j4, j2
    jld j5, j1, HKX
    hvc_say:
      jsub j6, j5, j4
      jjz j6, hvc_next
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jjmp hvc_say
  hvc_y0:
    jld j2, j1, HVT0
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HVT0
    jld j2, j1, HVC0
    jadd j2, j2, j3
    jst j2, j1, HVC0
    jjmp hvc_next
  hvc_keep:
    jldi j1, 0
    jld j2, j1, HVU
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HVL
    jadd j3, j3, j4
    jld j4, j1, HKP
    jst j4, j3, 0
    jld j5, j1, HKX
    jsub j5, j5, j4
    jst j5, j3, 8
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HVU
  hvc_next:
    jldi j1, 0
    jld j2, j1, HKX
    jst j2, j1, HKP
    jjmp hvc_lap
hvc_done:
  jld j2, j1, HVN
  jjz j2, hvc_quiet
  jldi j1, S_IMGN               ; "imaginado: C confirmadas de T comprobables | azar: C0 de T0"
  jcall puts
  jld j2, j1, HVC
  jcall putnum
  jldi j1, S_CONFS
  jcall puts
  jld j2, j1, HVT
  jcall putnum
  jldi j1, S_AZAR
  jcall puts
  jld j2, j1, HVC0
  jcall putnum
  jldi j1, S_DE
  jcall puts
  jld j2, j1, HVT0
  jcall putnum
  jldi j2, 10
  jcall putch
hvc_quiet:
  jldi j1, 0
  jret

; The house's "imaginado" written again: the votes still open (as they were), then this book's new ones (hl_instr
; writes them as it imagines). Opens it, the old ones in; the caller writes on and closes it (hl_iclose). Uses j1-j14.
hl_iopen:
  jcall flush
  jldi j10, 12
  jldi j11, S_IMAG
  jldi j12, 9
  jcall ask
  jldi j10, 4
  jldi j11, S_IMAG
  jldi j12, 9
  jcall ask
  jldi j1, 0
  jldi j2, 63
  jshr j2, j13, j2
  jjnz j2, hio_no
  jst j13, j1, HKH
  jldi j2, 1
  jadd j2, j13, j2
  jst j2, j1, SINK
  jst j1, j1, HKI
  hio_o:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HVU
    jsub j3, j2, j3
    jjz j3, hio_yes
    jldi j3, 4
    jshl j3, j2, j3
    jld j4, j1, HVL
    jadd j3, j3, j4
    jld j4, j3, 0
    jld j5, j3, 8
    hio_b:
      jjz j5, hio_bn
      jldb j2, j4, 0
      jcall putch
      jldi j3, 1
      jadd j4, j4, j3
      jsub j5, j5, j3
      jjmp hio_b
  hio_bn:
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hio_o
hio_yes:
  jldi j2, 1
  jret
hio_no:
  jldi j2, 0
  jret

; "imaginado" closed, the text to the console again. Uses j1-j14.
hl_iclose:
  jcall flush
  jldi j1, 0
  jst j1, j1, SINK
  jld j10, j1, HKH
  jldi j2, 32
  jshl j10, j10, j2
  jldi j2, 7
  jor j10, j10, j2
  jcall ask
  jldi j1, 0
  jret

; The instructions found and what they imagined (to the console), then "imaginado" written: the votes still open
; and the new ones. Uses j1-j14.
hl_inventa:
  jldi j1, 0
  jst j1, j1, HIMN
  jst j1, j1, HIMC
  jst j1, j1, HIML
  jcall hl_instr
  jcall hl_iopen
  jjz j2, hlv_done
  jldi j1, 0
  jst j1, j1, HKI
  hlv_lap:
    jldi j1, 0
    jld j2, j1, HKI
    jld j3, j1, HIMN
    jsub j3, j2, j3
    jjz j3, hlv_close
    jldi j3, 40
    jmul j3, j2, j3
    jld j4, j1, HIML
    jadd j3, j3, j4
    jld j4, j3, 0
    jst j4, j1, HIR
    jld j4, j3, 8
    jst j4, j1, HISD
    jld j4, j3, 16
    jst j4, j1, HIZ
    jld j4, j3, 24
    jst j4, j1, HIW
    jld j4, j3, 32
    jst j4, j1, HIF
    jcall hin_iwrite
    jldi j1, 0
    jld j2, j1, HKI
    jldi j3, 1
    jadd j2, j2, j3
    jst j2, j1, HKI
    jjmp hlv_lap
hlv_close:
  jcall hl_iclose
hlv_done:
  jldi j1, 0
  jret

; Whether the house asks for the pieces ("partes", not empty): then they are found (hl_partes) and j2 = 1. Uses
; j1-j14.
hl_pmaybe:
  jldi j11, S_PARTES
  jldi j12, 6
  jcall en_read
  jldi j1, 0
  jld j2, j1, PRN
  jjz j2, hpm_no
  jcall hl_partes
  jldi j2, 1
  jret
hpm_no:
  jldi j2, 0
  jret

; The pieces of words (Capitan: "take by context what each instruction does: each word, letter, ending, beginning,
; punctuation; recombine to explain mechanisms"), the first step: endings. Every word said twice or more is cut at
; its end in each way (any ending, never in the middle of a letter, the root three bytes or more): the
; root and the ending. Two words of one root that end differently are a change of ending ("rápid|o" and
; "rápid|amente": "o" into "amente"), and a change is a piece by how many roots it works for (none given: each found
; in the book). Into the house's "piezas", a line each {how many roots, one ending, the other, a root it works for};
; the most said said. And the same at its beginning ("re|hacer", "in|útil"), and a letter anywhere ("est|a|" and
; "est|á|": the place not counted): each piece says which it is. Only when
; the house asks ("partes"): then nothing else is done. Uses j1-j14.
hl_partes:
  jldi j2, HPB
  jldi j3, 16
  jcall pl_new
  jldi j2, HPS
  jldi j3, 72
  jcall pl_new
  jldi j1, 0                    ; (two cuts, an end and a beginning, for each byte of its words, 56 bytes each: counted
                                ; first)
  jldi j2, ZWT
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jld j4, j2, 0
  jldi j11, 1
  hpt_n:
    jjz j3, hpt_nd
    jld j5, j4, 0
    jjz j5, hpt_nn
    jld j5, j4, 16
    jadd j11, j11, j5
  hpt_nn:
    jldi j5, ZWT
    jld j5, j5, 24
    jadd j4, j4, j5
    jldi j5, 1
    jsub j3, j3, j5
    jjmp hpt_n
hpt_nd:
  jldi j3, 168
  jmul j11, j11, j3
  jcall room
  jldi j1, 0
  jst j13, j1, HPE
  jst j1, j1, HPEN
  jldi j2, ZWT
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HPK
  jld j4, j2, 0
  jst j4, j1, HPW
  hpt_w:                        ; each word, each cut
    jldi j1, 0
    jld j3, j1, HPK
    jjz j3, hpt_wd
    jld j4, j1, HPW
    jld j5, j4, 0
    jjz j5, hpt_wn
    jldi j2, HWC                ; said twice or more
    jcall pl_find
    jldi j1, 0
    jld j6, j4, 0
    jjz j6, hpt_wn
    jld j6, j4, 8
    jldi j7, 2
    jsub j6, j6, j7
    jldi j7, 63
    jsar j6, j6, j7
    jjnz j6, hpt_wn
    jld j4, j1, HPW
    jld j2, j4, 8
    jst j2, j1, HPP
    jld j2, j4, 16
    jst j2, j1, HPNN
    jst j1, j1, HPL
    hpt_c:
      jldi j1, 0
      jld j2, j1, HPL
      jld j3, j1, HPNN          ; the root three bytes or more
      jsub j3, j3, j2
      jldi j4, 3
      jsub j4, j3, j4
      jldi j5, 63
      jsar j4, j4, j5
      jjnz j4, hpt_b0
      jst j3, j1, HPRN
      jld j4, j1, HPP
      jadd j4, j4, j3
      jst j4, j1, HPSP
      jjz j2, hpt_ok            ; (never in the middle of a letter)
      jldb j5, j4, 0
      jldi j6, 192
      jand j5, j5, j6
      jldi j6, 128
      jsub j5, j5, j6
      jjz j5, hpt_cn
    hpt_ok:
      jld j3, j1, HPP           ; the root's print, the ending's
      jld j4, j1, HPRN
      jcall mp_print
      jldi j1, 0
      jst j5, j1, HPHB
      jld j3, j1, HPSP
      jld j4, j1, HPL
      jcall mp_print
      jldi j1, 0
      jst j5, j1, HPHS
      jld j5, j1, HPHB          ; onto the root's list
      jldi j2, HPB
      jcall pl_take
      jldi j1, 0
      jld j6, j4, 8
      jld j2, j1, HPEN
      jldi j3, 56
      jmul j3, j2, j3
      jld j7, j1, HPE
      jadd j3, j3, j7
      jld j7, j1, HPHS
      jst j7, j3, 0
      jld j7, j1, HPSP
      jst j7, j3, 8
      jld j7, j1, HPL
      jst j7, j3, 16
      jld j7, j1, HPP
      jst j7, j3, 24
      jld j7, j1, HPRN
      jst j7, j3, 32
      jst j6, j3, 40
      jst j1, j3, 48            ; (an end)
      jldi j7, 1
      jadd j2, j2, j7
      jst j2, j1, HPEN
      jst j2, j4, 8
    hpt_cn:
      jldi j1, 0
      jld j2, j1, HPL
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HPL
      jjmp hpt_c
  hpt_b0:                       ; the beginnings: the same, cut at its start ("re|hacer"; the rest three bytes or more)
    jldi j1, 0
    jst j1, j1, HPL
    hpt_g:
      jldi j1, 0
      jld j2, j1, HPL
      jld j3, j1, HPNN
      jsub j3, j3, j2
      jldi j4, 3
      jsub j4, j3, j4
      jldi j5, 63
      jsar j4, j4, j5
      jjnz j4, hpt_m0
      jst j3, j1, HPRN
      jld j4, j1, HPP
      jadd j4, j4, j2
      jst j4, j1, HPSP          ; (here: where the rest starts)
      jjz j2, hpt_gok
      jldb j5, j4, 0
      jldi j6, 192
      jand j5, j5, j6
      jldi j6, 128
      jsub j5, j5, j6
      jjz j5, hpt_gn
    hpt_gok:
      jld j3, j1, HPSP          ; the rest's print and the beginning's, marked apart from the ends
      jld j4, j1, HPRN
      jcall mp_print
      jldi j6, 2
      jcall hl_mix
      jldi j1, 0
      jst j5, j1, HPHB
      jld j3, j1, HPP
      jld j4, j1, HPL
      jcall mp_print
      jldi j6, 2
      jcall hl_mix
      jldi j1, 0
      jst j5, j1, HPHS
      jld j5, j1, HPHB
      jldi j2, HPB
      jcall pl_take
      jldi j1, 0
      jld j6, j4, 8
      jld j2, j1, HPEN
      jldi j3, 56
      jmul j3, j2, j3
      jld j7, j1, HPE
      jadd j3, j3, j7
      jld j7, j1, HPHS
      jst j7, j3, 0
      jld j7, j1, HPP           ; the piece: the beginning
      jst j7, j3, 8
      jld j7, j1, HPL
      jst j7, j3, 16
      jld j7, j1, HPSP          ; the root: the rest
      jst j7, j3, 24
      jld j7, j1, HPRN
      jst j7, j3, 32
      jst j6, j3, 40
      jldi j7, 1
      jst j7, j3, 48            ; (a beginning)
      jadd j2, j2, j7
      jst j2, j1, HPEN
      jst j2, j4, 8
    hpt_gn:
      jldi j1, 0
      jld j2, j1, HPL
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HPL
      jjmp hpt_g
  hpt_m0:                       ; a letter anywhere (Capitan: "an 'é' is the same in any place"): the word without it,
    jldi j1, 0                  ; the part before and the part after, is the root; the place is not counted
    jst j1, j1, HPL
    hpt_m:
      jldi j1, 0
      jld j2, j1, HPL
      jld j3, j1, HPNN
      jsub j3, j3, j2
      jjz j3, hpt_wn
      jld j4, j1, HPP
      jadd j4, j4, j2
      jst j4, j1, HPSP          ; (the letter)
      jldb j5, j4, 0
      jldi j6, 192
      jand j6, j5, j6
      jldi j7, 128
      jsub j6, j6, j7
      jjz j6, hpt_mn1           ; (inside a letter: on to the next byte)
      jcall pc_len
      jldi j1, 0
      jst j7, j1, HPCL
      jld j3, j1, HPNN          ; the root three bytes or more
      jsub j3, j3, j7
      jldi j4, 3
      jsub j4, j3, j4
      jldi j5, 63
      jsar j4, j4, j5
      jjnz j4, hpt_mn
      jld j3, j1, HPP           ; the root's print: the part before, the part after, marked apart
      jld j4, j1, HPL
      jcall mp_print
      jldi j1, 0
      jst j5, j1, HPHB
      jld j3, j1, HPSP
      jld j4, j1, HPCL
      jadd j3, j3, j4
      jld j4, j1, HPNN
      jld j6, j1, HPL
      jsub j4, j4, j6
      jld j6, j1, HPCL
      jsub j4, j4, j6
      jcall mp_print
      jldi j1, 0
      jadd j6, j5, j1
      jld j5, j1, HPHB
      jcall hl_mix
      jldi j6, 3
      jcall hl_mix
      jldi j1, 0
      jst j5, j1, HPHB
      jld j3, j1, HPSP          ; the letter's print
      jld j4, j1, HPCL
      jcall mp_print
      jldi j6, 3
      jcall hl_mix
      jldi j1, 0
      jst j5, j1, HPHS
      jld j5, j1, HPHB
      jldi j2, HPB
      jcall pl_take
      jldi j1, 0
      jld j6, j4, 8
      jld j2, j1, HPEN
      jldi j3, 56
      jmul j3, j2, j3
      jld j7, j1, HPE
      jadd j3, j3, j7
      jld j7, j1, HPHS
      jst j7, j3, 0
      jld j7, j1, HPSP          ; the piece: the letter
      jst j7, j3, 8
      jld j7, j1, HPCL
      jst j7, j3, 16
      jld j7, j1, HPP           ; the root: the word
      jst j7, j3, 24
      jld j7, j1, HPNN
      jst j7, j3, 32
      jst j6, j3, 40
      jldi j7, 2
      jst j7, j3, 48            ; (a letter anywhere)
      jldi j7, 1
      jadd j2, j2, j7
      jst j2, j1, HPEN
      jst j2, j4, 8
    hpt_mn:
      jldi j1, 0
      jld j2, j1, HPL
      jld j3, j1, HPCL
      jadd j2, j2, j3
      jst j2, j1, HPL
      jjmp hpt_m
    hpt_mn1:
      jld j2, j1, HPL
      jldi j3, 1
      jadd j2, j2, j3
      jst j2, j1, HPL
      jjmp hpt_m
  hpt_wn:
    jldi j1, 0
    jld j4, j1, HPW
    jldi j5, ZWT
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HPW
    jld j3, j1, HPK
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HPK
    jjmp hpt_w
hpt_wd:
  jldi j2, HPB                  ; each root: each two of its endings, a change
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HPK
  jld j4, j2, 0
  jst j4, j1, HPW
  hpt_r:
    jldi j1, 0
    jld j3, j1, HPK
    jjz j3, hpt_out
    jld j4, j1, HPW
    jld j5, j4, 0
    jjz j5, hpt_rn
    jld j2, j4, 8
    jst j2, j1, HPA
    hpt_a:
      jldi j1, 0
      jld j2, j1, HPA
      jjz j2, hpt_rn
      jldi j3, 1
      jsub j2, j2, j3
      jldi j3, 56
      jmul j3, j2, j3
      jld j4, j1, HPE
      jadd j3, j3, j4
      jst j3, j1, HPX
      jld j2, j3, 40
      jst j2, j1, HPA
      jst j2, j1, HPBB
      hpt_b:
        jldi j1, 0
        jld j2, j1, HPBB
        jjz j2, hpt_a
        jldi j3, 1
        jsub j2, j2, j3
        jldi j3, 56
        jmul j3, j2, j3
        jld j4, j1, HPE
        jadd j3, j3, j4
        jst j3, j1, HPY
        jld j2, j3, 40
        jst j2, j1, HPBB
        jld j4, j1, HPX         ; (the smaller ending first: the same change either way)
        jld j5, j4, 0
        jld j6, j3, 0
        jsub j7, j5, j6
        jjz j7, hpt_b
        jcall hp_order
        jcall hl_mix
        jjnz j5, hpt_k
        jldi j5, 1
      hpt_k:
        jldi j2, HPS
        jcall pl_take
        jldi j1, 0
        jjz j6, hpt_old
        jld j5, j1, HPX         ; new: its two endings, a root (from the first)
        jld j6, j1, HPY
        jld j7, j5, 0
        jld j8, j6, 0
        jsub j7, j7, j8
        jldi j8, 63
        jsar j7, j7, j8
        jjnz j7, hpt_xo
        jadd j7, j5, j1
        jadd j5, j6, j1
        jadd j6, j7, j1
      hpt_xo:
        jld j7, j5, 8
        jst j7, j4, 16
        jld j7, j5, 16
        jst j7, j4, 24
        jld j7, j6, 8
        jst j7, j4, 32
        jld j7, j6, 16
        jst j7, j4, 40
        jld j7, j5, 24
        jst j7, j4, 48
        jld j7, j5, 32
        jst j7, j4, 56
        jld j7, j5, 48
        jst j7, j4, 64
      hpt_old:
        jld j7, j4, 8
        jldi j8, 1
        jadd j7, j7, j8
        jst j7, j4, 8
        jjmp hpt_b
  hpt_rn:
    jldi j1, 0
    jld j4, j1, HPW
    jldi j5, HPB
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HPW
    jld j3, j1, HPK
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HPK
    jjmp hpt_r
hpt_out:                        ; into "piezas": the changes of two roots or more
  jcall flush
  jldi j10, 12
  jldi j11, S_PIEZ
  jldi j12, 6
  jcall ask
  jldi j10, 4
  jldi j11, S_PIEZ
  jldi j12, 6
  jcall ask
  jldi j1, 0
  jldi j2, 63
  jshr j2, j13, j2
  jjnz j2, hpt_top
  jst j13, j1, HKH
  jldi j2, 1
  jadd j2, j13, j2
  jst j2, j1, SINK
  jldi j2, HPS
  jld j3, j2, 8
  jldi j4, 1
  jadd j3, j3, j4
  jst j3, j1, HPK
  jld j4, j2, 0
  jst j4, j1, HPW
  hpt_f:
    jldi j1, 0
    jld j3, j1, HPK
    jjz j3, hpt_fd
    jld j4, j1, HPW
    jld j5, j4, 0
    jjz j5, hpt_fn
    jld j2, j4, 8
    jldi j3, 2
    jsub j3, j2, j3
    jldi j5, 63
    jsar j3, j3, j5
    jjnz j3, hpt_fn
    jcall hp_say
  hpt_fn:
    jldi j1, 0
    jld j4, j1, HPW
    jldi j5, HPS
    jld j5, j5, 24
    jadd j4, j4, j5
    jst j4, j1, HPW
    jld j3, j1, HPK
    jldi j5, 1
    jsub j3, j3, j5
    jst j3, j1, HPK
    jjmp hpt_f
hpt_fd:
  jcall flush
  jldi j1, 0
  jst j1, j1, SINK
  jld j10, j1, HKH
  jldi j2, 32
  jshl j10, j10, j2
  jldi j2, 7
  jor j10, j10, j2
  jcall ask
hpt_top:                        ; to the console: the twenty that work for the most roots
  jldi j1, 0
  jldi j2, 20
  jst j2, j1, HPL
  hpt_t:
    jldi j1, 0
    jld j2, j1, HPL
    jjz j2, hpt_done
    jldi j2, HPS
    jld j3, j2, 8
    jldi j4, 1
    jadd j3, j3, j4
    jld j4, j2, 0
    jldi j6, 0                  ; (the best so far, and where)
    jldi j7, 0
    hpt_s:
      jjz j3, hpt_sd
      jld j5, j4, 0
      jjz j5, hpt_sn
      jld j5, j4, 8
      jsub j8, j6, j5
      jldi j9, 63
      jsar j8, j8, j9
      jjz j8, hpt_sn
      jadd j6, j5, j1
      jadd j7, j4, j1
    hpt_sn:
      jldi j5, HPS
      jld j5, j5, 24
      jadd j4, j4, j5
      jldi j5, 1
      jsub j3, j3, j5
      jjmp hpt_s
  hpt_sd:
    jjz j7, hpt_done
    jst j7, j1, HPW
    jldi j1, S_PIEZA
    jcall puts
    jld j4, j1, HPW
    jcall hp_say
    jldi j1, 0
    jld j4, j1, HPW             ; (said: out of the race)
    jld j5, j4, 8
    jldi j6, 0
    jsub j5, j6, j5
    jst j5, j4, 8
    jld j2, j1, HPL
    jldi j3, 1
    jsub j2, j2, j3
    jst j2, j1, HPL
    jjmp hpt_t
hpt_done:
  jldi j1, 0
  jret

; The change at j4: "<roots>\t<ending>\t<ending>\t<a root>" ("_" for no ending), and a line end. Uses j1-j10.
hp_say:
  jldi j1, 0
  jst j4, j1, HPZ
  jld j2, j4, 8
  jldi j3, 63
  jsar j3, j2, j3
  jjz j3, hps_pos
  jldi j3, 0
  jsub j2, j3, j2
hps_pos:
  jcall putnum
  jldi j2, 9
  jcall putch
  jldi j1, 0
  jld j4, j1, HPZ
  jld j9, j4, 16
  jld j10, j4, 24
  jcall hp_text
  jldi j2, 9
  jcall putch
  jldi j1, 0
  jld j4, j1, HPZ
  jld j9, j4, 32
  jld j10, j4, 40
  jcall hp_text
  jldi j2, 9
  jcall putch
  jldi j1, 0
  jld j4, j1, HPZ
  jld j9, j4, 48
  jld j10, j4, 56
  jcall hp_text
  jldi j2, 9
  jcall putch
  jldi j1, 0
  jld j4, j1, HPZ
  jld j2, j4, 64
  jldi j1, S_PFIN
  jjz j2, hpy_k
  jldi j1, S_PINI
  jldi j3, 1
  jsub j3, j2, j3
  jjz j3, hpy_k
  jldi j1, S_PLET
hpy_k:
  jcall puts
  jldi j2, 10
  jjmp putch

; How many bytes the letter whose first byte is j5 has -> j7. Uses j6, j7.
pc_len:
  jldi j7, 1
  jldi j6, 128
  jand j6, j5, j6
  jjz j6, pcl_done
  jldi j7, 2
  jldi j6, 32
  jand j6, j5, j6
  jjz j6, pcl_done
  jldi j7, 3
  jldi j6, 16
  jand j6, j5, j6
  jjz j6, pcl_done
  jldi j7, 4
pcl_done:
  jret

; The j10 bytes at j9 into the text ("_" if none). Uses j1-j3, j9, j10.
hp_text:
  jjnz j10, hpx_lap
  jldi j2, 95
  jjmp putch
  hpx_lap:
    jjz j10, hpx_done
    jldb j2, j9, 0
    jcall putch
    jldi j1, 1
    jadd j9, j9, j1
    jsub j10, j10, j1
    jjmp hpx_lap
hpx_done:
  jldi j1, 0
  jret

; The house's file named by the j12 bytes at j11 -> PRB, PRN (0: none). Uses j1-j14.
en_read:
  jldi j1, 0
  jst j1, j1, PRN
  jldi j10, 4
  jcall ask
  jldi j1, 0
  jldi j2, 63
  jshr j2, j13, j2
  jjnz j2, enr_done
  jst j13, j1, PRH
  jldi j11, 1                   ; (64 KB to start)
  jldi j2, 16
  jshl j11, j11, j2
  jst j11, j1, PRC
  jcall room
  jldi j1, 0
  jst j13, j1, PRB
  enr_lap:
    jld j10, j1, PRH
    jldi j2, 32
    jshl j10, j10, j2
    jldi j2, 5
    jor j10, j10, j2
    jld j11, j1, PRB
    jld j2, j1, PRN
    jadd j11, j11, j2
    jld j12, j1, PRC
    jsub j12, j12, j2
    jcall ask
    jldi j1, 0
    jldi j2, 63
    jsar j2, j13, j2
    jldi j3, -1
    jxor j2, j2, j3
    jand j13, j13, j2
    jld j2, j1, PRN
    jadd j2, j2, j13
    jst j2, j1, PRN
    jld j3, j1, PRC
    jsub j3, j2, j3
    jjnz j3, enr_close
    jld j11, j1, PRC
    jadd j11, j11, j11
    jcall room
    jldi j1, 0
    jld j3, j1, PRB
    jld j4, j1, PRN
    jldi j5, 0
    enr_mv:
      jsub j6, j5, j4
      jjz j6, enr_moved
      jadd j6, j3, j5
      jldb j6, j6, 0
      jadd j7, j13, j5
      jstb j6, j7, 0
      jldi j6, 1
      jadd j5, j5, j6
      jjmp enr_mv
    enr_moved:
    jst j13, j1, PRB
    jld j2, j1, PRC
    jadd j2, j2, j2
    jst j2, j1, PRC
    jjmp enr_lap
enr_close:
  jld j10, j1, PRH
  jldi j2, 32
  jshl j10, j10, j2
  jldi j2, 7
  jor j10, j10, j2
  jcall ask
enr_done:
  jldi j1, 0
  jret

; The book's lines ("Q:", "O:", "R:"; the rest is not read) and their words (ZLN, ZWD), each word's text by its print
; (ZWT). Uses j1-j14.
en_lines:
  jldi j1, 0
  jld j11, j1, PRN
  jldi j2, 2
  jadd j11, j11, j2
  jldi j2, 5
  jshl j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, ZLN
  jld j11, j1, PRN
  jldi j2, 2
  jadd j11, j11, j2
  jldi j2, 24
  jmul j11, j11, j2
  jcall room
  jldi j1, 0
  jst j13, j1, ZWD
  jldi j2, ZWT
  jldi j3, 24
  jcall pl_new
  jldi j1, 0
  jst j1, j1, ZNLN
  jst j1, j1, ZNWD
  jld j2, j1, PRB
  jst j2, j1, ZEP
  jld j3, j1, PRN
  jadd j3, j2, j3
  jst j3, j1, ZEEND
el_line:
  jldi j1, 0
  jld j2, j1, ZEP
  jld j3, j1, ZEEND
  jsub j4, j2, j3
  jjz j4, el_done
  jldi j5, 1
  jadd j5, j2, j5
  jsub j6, j5, j3
  jjz j6, el_skip
  jldb j6, j5, 0
  jldi j7, 58                   ; ":"
  jsub j6, j6, j7
  jjnz j6, el_skip
  jldb j6, j2, 0
  jldi j9, 1
  jldi j7, 81                   ; "Q"
  jsub j7, j6, j7
  jjz j7, el_typed
  jldi j9, 2
  jldi j7, 79                   ; "O"
  jsub j7, j6, j7
  jjz j7, el_typed
  jldi j9, 3
  jldi j7, 82                   ; "R"
  jsub j7, j6, j7
  jjnz j7, el_skip
el_typed:
  jld j3, j1, ZNLN
  jldi j4, 5
  jshl j3, j3, j4
  jld j4, j1, ZLN
  jadd j3, j3, j4
  jst j3, j1, ZELR
  jst j9, j3, 0
  jld j4, j1, ZNWD
  jst j4, j3, 8
  jst j1, j3, 16
  jst j2, j3, 24
  jld j4, j1, ZNLN
  jldi j5, 1
  jadd j4, j4, j5
  jst j4, j1, ZNLN
  jldi j5, 2
  jadd j2, j2, j5
  jst j2, j1, ZEP
el_word:
  jldi j1, 0
  jld j9, j1, ZEP
  jld j10, j1, ZEEND
  jsub j2, j9, j10
  jjz j2, el_done
  jldb j3, j9, 0
  jldi j2, 10
  jsub j2, j3, j2
  jjz j2, el_nl
  jcall mp_isletter
  jjnz j2, el_w
  jldi j1, 0                    ; not a letter: with the signs kept, every one but a space is a piece of its own
  jld j2, j1, HSIG
  jjz j2, el_skip1
  jldi j2, 32
  jsub j2, j3, j2
  jjz j2, el_skip1
  jldi j2, 13
  jsub j2, j3, j2
  jjz j2, el_skip1
  jldi j8, 1
  jjmp el_wh
el_skip1:
  jldi j2, 1
  jadd j9, j9, j2
  jldi j1, 0
  jst j9, j1, ZEP
  jjmp el_word
el_w:
  jldi j8, 0
  el_wl:
    jadd j2, j9, j8
    jsub j4, j2, j10
    jjz j4, el_wh
    jldb j3, j2, 0
    jcall mp_isletter
    jjz j2, el_wh
    jldi j2, 1
    jadd j8, j8, j2
    jjmp el_wl
el_wh:
  jldi j1, 0
  jst j8, j1, ZEWL
  jadd j3, j9, j1
  jadd j4, j8, j1
  jcall mp_print
  jldi j1, 0
  jld j2, j1, ZNWD
  jldi j3, 24
  jmul j3, j2, j3
  jld j4, j1, ZWD
  jadd j3, j3, j4
  jst j5, j3, 0
  jld j9, j1, ZEP
  jst j9, j3, 8
  jld j8, j1, ZEWL
  jst j8, j3, 16
  jldi j3, 1
  jadd j2, j2, j3
  jst j2, j1, ZNWD
  jld j3, j1, ZELR
  jld j4, j3, 16
  jldi j6, 1
  jadd j4, j4, j6
  jst j4, j3, 16
  jldi j2, ZWT
  jcall pl_take
  jldi j1, 0
  jjz j6, el_wnext
  jld j9, j1, ZEP
  jst j9, j4, 8
  jld j8, j1, ZEWL
  jst j8, j4, 16
el_wnext:
  jld j9, j1, ZEP
  jld j8, j1, ZEWL
  jadd j9, j9, j8
  jst j9, j1, ZEP
  jjmp el_word
el_nl:
  jldi j2, 1
  jadd j9, j9, j2
  jldi j1, 0
  jst j9, j1, ZEP
  jjmp el_line
el_skip:
  jldi j1, 0
  jld j9, j1, ZEP
  jld j10, j1, ZEEND
  els_lap:
    jsub j2, j9, j10
    jjz j2, el_done
    jldb j3, j9, 0
    jldi j2, 1
    jadd j9, j9, j2
    jldi j2, 10
    jsub j2, j3, j2
    jjnz j2, els_lap
  jst j9, j1, ZEP
  jjmp el_line
el_done:
  jldi j1, 0
  jret

; Line j2's record -> j3. Uses j3, j4.
en_rec:
  jldi j4, 5
  jshl j3, j2, j4
  jldi j4, 0
  jld j4, j4, ZLN
  jadd j3, j3, j4
  jret

; The print of word j3 of the line whose record is at j2 -> j5. Uses j4, j5.
en_word:
  jld j4, j2, 8
  jadd j4, j4, j3
  jldi j5, 24
  jmul j4, j4, j5
  jldi j5, 0
  jld j5, j5, ZWD
  jadd j4, j4, j5
  jld j5, j4, 0
  jret

; The words of line j2 from word j3 to word j4 (not included), one space between, word j5 said "_". Uses j1-j14.
en_saywords:
  jldi j1, 0
  jst j2, j1, ZSLR
  jst j3, j1, ZSLI
  jst j3, j1, ZSLF
  jst j4, j1, ZSLE
  jst j5, j1, ZSLS
  esw_lap:
    jldi j1, 0
    jld j3, j1, ZSLI
    jld j4, j1, ZSLE
    jsub j4, j3, j4
    jjz j4, esw_done
    jld j4, j1, ZSLF
    jsub j4, j3, j4
    jjz j4, esw_ns
    jldi j2, 32
    jcall putch
    jldi j1, 0
    jld j3, j1, ZSLI
  esw_ns:
    jld j4, j1, ZSLS
    jsub j4, j3, j4
    jjnz j4, esw_w
    jldi j2, 95
    jcall putch
    jjmp esw_next
  esw_w:
    jld j2, j1, ZSLR
    jcall en_word
    jcall en_sayprint
  esw_next:
    jldi j1, 0
    jld j3, j1, ZSLI
    jldi j4, 1
    jadd j3, j3, j4
    jst j3, j1, ZSLI
    jjmp esw_lap
esw_done:
  jret

; The text of the word whose print is j5. Uses j1-j10.
en_sayprint:
  jldi j2, ZWT
  jcall pl_find
  jldi j1, 0
  jld j9, j4, 8
  jld j10, j4, 16
  esp_lap:
    jjz j10, esp_done
    jldb j2, j9, 0
    jcall putch
    jldi j1, 1
    jadd j9, j9, j1
    jsub j10, j10, j1
    jjmp esp_lap
esp_done:
  jldi j1, 0
  jret

; A word's print: FNV-1a over the j4 bytes at j3 -> j5 (never 0). Uses j3-j7.
mp_print:
  jldi j5, 0
  jshi j5, 0CBF2h
  jshi j5, 9CE4h
  jshi j5, 8422h
  jshi j5, 2325h
  jldi j6, 0
  jshi j6, 100h
  jshi j6, 0
  jshi j6, 1B3h
  mpf_lap:
    jjz j4, mpf_done
    jldb j7, j3, 0
    jxor j5, j5, j7
    jmul j5, j5, j6
    jldi j7, 1
    jadd j3, j3, j7
    jsub j4, j4, j7
    jjmp mpf_lap
mpf_done:
  jjnz j5, mpf_out
  jldi j5, 1
mpf_out:
  jret

; j2 = 1 if byte j3 is a letter of a word (a..z, or a byte of an accented letter, 80h and over). Uses j2, j4, j5.
mp_isletter:
  jldi j4, 128
  jsub j4, j3, j4
  jldi j5, 63
  jsar j4, j4, j5
  jjz j4, mpi_yes
  jldi j4, 97
  jsub j4, j3, j4
  jsar j4, j4, j5
  jjnz j4, mpi_no
  jldi j4, 123
  jsub j4, j3, j4
  jsar j4, j4, j5
  jjz j4, mpi_no
mpi_yes:
  jldi j2, 1
  jret
mpi_no:
  jldi j2, 0
  jret

include '../lectura/crece.inc'
include '../lectura/lectura.inc'
